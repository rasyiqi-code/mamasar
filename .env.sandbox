# ==============================================================================
# Mamasar - Sandbox / Staging Configuration
# ==============================================================================
HOST=0.0.0.0
PORT=4321
SITE_URL=https://staging.mamasar.nusumenep.or.id

# Neon Serverless Database (Branch: sandbox/staging)
DATABASE_URL=postgresql://neondb_owner:sample_sandbox_pass@ep-staging-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:sample_sandbox_pass@ep-staging.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Media & Image CDN (Staging folder)
IMAGEKIT_PUBLIC_KEY=public_sandbox_key_xxxxx
IMAGEKIT_PRIVATE_KEY=private_sandbox_key_xxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/mamasar-staging

# Auth Configurations
GOOGLE_CLIENT_ID=sample_staging_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-sample_staging_secret_xxxxx
GOOGLE_REDIRECT_URI=https://staging.mamasar.nusumenep.or.id/api/auth/callback/google

NEON_AUTH_BASE_URL=https://ep-staging.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-staging.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Neon S3 Bucket (Staging)
AWS_ENDPOINT_URL_S3=https://ep-staging.s3.ap-southeast-1.aws.neon.tech
AWS_ACCESS_KEY_ID=sample_staging_key
AWS_SECRET_ACCESS_KEY=sample_staging_secret
AWS_REGION=ap-southeast-1

# Operations
WHATSAPP_HELP=6281234567890
SUPERADMIN_EMAIL=staging-admin.lpnu@nusumenep.or.id
