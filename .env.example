# ==============================================================================
# Mamasar - Direktori UMKM Warga NU Sumenep - Environment Variables
# ==============================================================================
# Salin file ini menjadi `.env` sebelum menjalankan aplikasi:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Server & Network Configuration (Vercel / Node.js)
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=4321
SITE_URL=http://localhost:4321

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Mode Cloud Produksi (Neon Serverless PostgreSQL):
# Dapatkan connection string dari dashboard: https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Runtime aplikasi (src/lib/db.ts) WAJIB memakai Neon PostgreSQL via DATABASE_URL.
# Tanpa variabel ini, semua query data akan gagal dengan error eksplisit.

# ------------------------------------------------------------------------------
# 3. Media & Image CDN (ImageKit.io)
# ------------------------------------------------------------------------------
# Dapatkan API keys dari dashboard: https://imagekit.io/dashboard/developer/api-keys
IMAGEKIT_PUBLIC_KEY=public_sample_key_xxxxx
IMAGEKIT_PRIVATE_KEY=private_sample_key_xxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/mamasar

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 (alur legacy, login utama memakai Neon Auth di bagian 5)
# ------------------------------------------------------------------------------
# Dapatkan kredensial dari: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=sample_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-sample_client_secret_xxxxx
GOOGLE_REDIRECT_URI=http://localhost:4321/api/auth/callback/google

# ------------------------------------------------------------------------------
# 5. Neon Auth (Login Google & Email/Password untuk Dashboard)
# ------------------------------------------------------------------------------
# Base URL project Neon Auth, contoh:
# https://ep-xxxx.neonauth.ap-southeast-1.aws.neon.tech/neondb/auth
NEON_AUTH_BASE_URL=
# JWKS dipakai endpoint health check /api/neon/services
NEON_AUTH_JWKS_URL=

# ------------------------------------------------------------------------------
# 6. Neon Object Storage (S3-compatible, bucket "assets" untuk foto profil)
# ------------------------------------------------------------------------------
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1

# ------------------------------------------------------------------------------
# 7. Neon Functions & Realtime (opsional, dipakai health check)
# ------------------------------------------------------------------------------
NEON_BRANCH_ID=
NEON_FUNCTION_HOST_SUFFIX=.compute.c-1.ap-southeast-1.aws.neon.tech
NEON_REALTIME_SECRET=
NEON_REALTIME_URL=

# ------------------------------------------------------------------------------
# 8. Operasional
# ------------------------------------------------------------------------------
# WhatsApp Helpdesk PCNU
WHATSAPP_HELP=6281234567890
# Email Superadmin (Full Access)
SUPERADMIN_EMAIL=admin.lpnu@nusumenep.or.id
