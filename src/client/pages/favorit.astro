---
import Layout from '../layouts/Layout.astro';
import AppIcon from '../components/common/AppIcon.astro';
import { getUserFromSession, getUserFavoriteIds, getProductsByIds } from '../../lib/db';
import { DEFAULT_PRODUCT_IMAGE } from '../../lib/constants';

const sessionCookie = Astro.cookies.get('mamasar_session')?.value;
const user = sessionCookie ? await getUserFromSession(sessionCookie) : null;

let serverFavorites: Array<{
  id: number;
  slug: string;
  name: string;
  price: number;
  image_url: string;
  zone_name: string;
  umkm_name: string;
  umkm_phone: string;
}> = [];

if (user) {
  const favoriteIds = await getUserFavoriteIds(user.id);
  if (favoriteIds.length > 0) {
    const products = await getProductsByIds(favoriteIds);
    serverFavorites = products.map((p) => ({
      id: p.id,
      slug: p.slug,
      name: p.name,
      price: p.price,
      image_url: p.image_url || DEFAULT_PRODUCT_IMAGE,
      zone_name: p.zone_name,
      umkm_name: p.umkm_name,
      umkm_phone: p.umkm_phone,
    }));
  }
}

function formatRupiah(amount: number) {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    maximumFractionDigits: 0,
  }).format(amount);
}
---

<Layout
  title="Iklan Produk Favorit Tersimpan | Mamasar Sumenep"
  description="Daftar produk UMKM Nahdliyin yang Anda simpan untuk dibeli atau dihubungi via WhatsApp."
  noindex={true}
>
  <div class="pb-10">
    <!-- Full-Bleed Top Header -->
    <section class="w-screen relative left-1/2 -translate-x-1/2 bg-white border-b border-slate-200">
      <div class="max-w-site mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-4">
        <div class="flex items-center justify-between text-xs text-slate-600">
          <nav aria-label="Breadcrumb" class="flex items-center gap-2">
            <a href="/" class="hover:text-emerald-700">Beranda</a>
            <span aria-hidden="true">›</span>
            <span class="text-slate-900 font-bold">Favorit</span>
          </nav>

          <a
            href="/"
            class="text-xs font-semibold text-slate-600 hover:text-emerald-700 transition inline-flex items-center gap-1"
          >
            <span>← Katalog</span>
          </a>
        </div>

        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div class="space-y-1">
            <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
              <AppIcon name="star" size="lg" class="text-amber-500" />
              <span>Produk Tersimpan</span>
            </h1>
            <p class="text-xs sm:text-sm text-slate-600">
              {user ? (
                <span>Tersimpan di akun <strong>{user.email || user.name}</strong> dan tersinkronisasi lintas perangkat.</span>
              ) : (
                <span>Tersimpan di browser perangkat ini. Masuk ke akun untuk sinkronisasi lintas perangkat.</span>
              )}
            </p>
          </div>

          <button
            id="btn-clear-favorites"
            type="button"
            class={`min-h-[44px] px-3.5 py-2 rounded-lg border border-rose-200 bg-rose-50 hover:bg-rose-100 text-xs text-rose-700 font-bold cursor-pointer inline-flex items-center gap-1.5 transition ${
              serverFavorites.length === 0 ? 'hidden' : ''
            }`}
          >
            <AppIcon name="trash" size="xs" />
            <span>Kosongkan</span>
          </button>
        </div>
      </div>
    </section>

    <div class="max-w-site mx-auto px-3 sm:px-6 lg:px-8 pt-6 space-y-6">
    <!-- Container Grid: Server Rendered when logged in, or populated via client script -->
    <div id="favorites-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4">
      {serverFavorites.map((p) => {
        const formattedPrice = formatRupiah(p.price);
        const waMsg = encodeURIComponent(
          `Halo *${p.umkm_name}*, saya tertarik dengan produk Anda di Mamasar: *${p.name}* (${formattedPrice}). Apakah masih tersedia?`
        );
        return (
          <div
            id={`fav-card-${p.id}`}
            class="bg-white border border-slate-200 rounded-lg overflow-hidden hover:border-emerald-400 transition flex flex-col justify-between group relative"
          >
            <button
              type="button"
              title="Hapus dari simpanan"
              aria-label={`Hapus ${p.name} dari favorit`}
              data-remove-fav={p.id}
              class="absolute top-1.5 right-1.5 z-20 min-w-[36px] min-h-[36px] rounded-full bg-white/95 hover:bg-white text-rose-700 border border-slate-200 flex items-center justify-center shadow-xs cursor-pointer"
            >
              <AppIcon name="x" size="xs" />
            </button>

            <div>
              <a href={`/produk/${p.slug}`} class="block relative aspect-4/3 bg-slate-100 overflow-hidden">
                <img
                  src={p.image_url}
                  alt={p.name}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                />
                <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/85 to-transparent p-2.5 text-white font-extrabold text-xs font-mono tabular-nums">
                  {formattedPrice}
                </div>
              </a>

              <div class="p-3 space-y-1">
                <span class="text-xs text-slate-600 truncate flex items-center gap-1">
                  <AppIcon name="map-pin" size="xs" class="text-slate-500" />
                  <span class="truncate">{p.zone_name}</span>
                </span>
                <a
                  href={`/produk/${p.slug}`}
                  class="font-bold text-xs sm:text-sm text-slate-900 group-hover:text-emerald-700 line-clamp-2 leading-tight block"
                >
                  {p.name}
                </a>
                <span class="text-xs text-slate-600 truncate flex items-center gap-1">
                  <AppIcon name="store" size="xs" class="text-slate-500" />
                  <span class="truncate">{p.umkm_name}</span>
                </span>
              </div>
            </div>

            <div class="p-3 pt-0">
              <a
                href={`https://wa.me/${p.umkm_phone}?text=${waMsg}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full min-h-[40px] py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold flex items-center justify-center gap-1 transition"
              >
                <span>WhatsApp</span>
              </a>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Empty State (Shown if no favorites) -->
    <div
      id="empty-favorites"
      class={`bg-white border-y sm:border border-slate-200 sm:rounded-lg p-8 sm:p-10 text-center space-y-3 ${
        serverFavorites.length > 0 ? 'hidden' : ''
      }`}
    >
      <div class="w-12 h-12 mx-auto rounded-lg bg-amber-50 border border-amber-200 text-amber-700 flex items-center justify-center">
        <AppIcon name="star" size="lg" />
      </div>
      <h3 class="font-extrabold text-slate-900 text-base">Belum Ada Produk Tersimpan</h3>
      <p class="text-xs sm:text-sm text-slate-600 max-w-sm mx-auto leading-relaxed">
        Jelajahi katalog produk warga NU di beranda dan simpan produk yang Anda minati.
      </p>
      <a
        href="/"
        class="inline-flex min-h-[44px] items-center justify-center mt-2 text-xs font-bold bg-emerald-700 hover:bg-emerald-800 text-white px-5 py-2.5 rounded-lg transition gap-1.5"
      >
        <span>Jelajahi Katalog</span>
        <AppIcon name="arrow-right" size="xs" />
      </a>
    </div>

    <div
      id="favorites-meta"
      data-logged-in={user ? '1' : '0'}
      data-initial-count={String(serverFavorites.length)}
      class="hidden"
      aria-hidden="true"
    ></div>

    </div>
  </div>

  <!-- Client Script for Favorites management & Guest Sync -->
  <script>
    import { confirmAction } from '../../lib/dialog';

    const metaEl = document.getElementById('favorites-meta');
    const isLoggedIn = metaEl?.getAttribute('data-logged-in') === '1';
    const initialServerCount = Number(metaEl?.getAttribute('data-initial-count') || '0');

    const container = document.getElementById('favorites-container');
    const emptyState = document.getElementById('empty-favorites');
    const clearBtn = document.getElementById('btn-clear-favorites');

    function getLocalFavorites(): number[] {
      try {
        const raw = localStorage.getItem('mamasar_favorites');
        const parsed = raw ? JSON.parse(raw) : [];
        return Array.isArray(parsed) ? parsed.filter((id: unknown): id is number => typeof id === 'number') : [];
      } catch {
        return [];
      }
    }

    function formatPriceIDR(value: number): string {
      return new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        maximumFractionDigits: 0,
      }).format(value);
    }

    function createFavCard(p: { id: number; slug: string; name: string; price: number; image_url?: string; zone_name?: string; umkm_name?: string; umkm_phone?: string }) {
      const formattedPrice = formatPriceIDR(p.price);
      const waMsg = encodeURIComponent(
        'Halo *' + (p.umkm_name || 'Penjual') + '*, saya tertarik dengan produk Anda di Mamasar: *' +
          p.name +
          '* (' +
          formattedPrice +
          '). Apakah masih tersedia?'
      );
      const detailHref = '/produk/' + encodeURIComponent(p.slug);

      const card = document.createElement('div');
      card.id = 'fav-card-' + p.id;
      card.className =
        'bg-white border border-slate-200 rounded-lg overflow-hidden hover:border-emerald-400 transition flex flex-col justify-between group relative';

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.title = 'Hapus dari simpanan';
      removeBtn.setAttribute('aria-label', 'Hapus ' + p.name + ' dari favorit');
      removeBtn.setAttribute('data-remove-fav', String(p.id));
      removeBtn.className =
        'absolute top-1.5 right-1.5 z-20 min-w-[36px] min-h-[36px] rounded-full bg-white/95 hover:bg-white text-rose-700 border border-slate-200 flex items-center justify-center shadow-xs cursor-pointer';
      removeBtn.innerHTML =
        '<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>';
      card.appendChild(removeBtn);

      const top = document.createElement('div');

      const imgLink = document.createElement('a');
      imgLink.href = detailHref;
      imgLink.className = 'block relative aspect-4/3 bg-slate-100 overflow-hidden';

      const img = document.createElement('img');
      img.src = p.image_url || '/placeholder-product.svg';
      img.alt = p.name;
      img.loading = 'lazy';
      img.className = 'w-full h-full object-cover group-hover:scale-105 transition duration-300';
      imgLink.appendChild(img);

      const priceOverlay = document.createElement('div');
      priceOverlay.className =
        'absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/85 to-transparent p-2.5 text-white font-extrabold text-xs font-mono tabular-nums';
      priceOverlay.textContent = formattedPrice;
      imgLink.appendChild(priceOverlay);

      top.appendChild(imgLink);

      const body = document.createElement('div');
      body.className = 'p-3 space-y-1';

      const zone = document.createElement('span');
      zone.className = 'text-xs text-slate-600 truncate block';
      zone.textContent = p.zone_name || 'Sumenep';

      const titleLink = document.createElement('a');
      titleLink.href = detailHref;
      titleLink.className =
        'font-bold text-xs sm:text-sm text-slate-900 group-hover:text-emerald-700 line-clamp-2 leading-tight block';
      titleLink.textContent = p.name;

      const seller = document.createElement('span');
      seller.className = 'text-xs text-slate-600 block truncate';
      seller.textContent = p.umkm_name || 'Toko Warga NU';

      body.append(zone, titleLink, seller);
      top.appendChild(body);
      card.appendChild(top);

      const foot = document.createElement('div');
      foot.className = 'p-3 pt-0';

      const waLink = document.createElement('a');
      waLink.href = 'https://wa.me/' + encodeURIComponent(String(p.umkm_phone || '')) + '?text=' + waMsg;
      waLink.target = '_blank';
      waLink.rel = 'noopener noreferrer';
      waLink.className =
        'w-full min-h-[40px] py-1.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-xs font-bold flex items-center justify-center gap-1 transition';

      const waLabel = document.createElement('span');
      waLabel.textContent = 'WhatsApp';
      waLink.appendChild(waLabel);

      foot.appendChild(waLink);
      card.appendChild(foot);

      return card;
    }

    async function loadGuestFavorites() {
      const favIds = getLocalFavorites();
      if (!favIds || favIds.length === 0) {
        if (initialServerCount === 0) {
          emptyState?.classList.remove('hidden');
          clearBtn?.classList.add('hidden');
        }
        return;
      }

      // If user is logged in, sync them with backend
      if (isLoggedIn) {
        try {
          const res = await fetch('/api/favorites/sync', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ guestProductIds: favIds }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            localStorage.removeItem('mamasar_favorites');
            if (data.syncedCount > 0) {
              window.location.reload();
              return;
            }
          }
        } catch (e) {
          console.error('Failed to sync favorites', e);
        }
      }

      // If not logged in, fetch product cards from API
      if (!isLoggedIn) {
        try {
          const res = await fetch('/api/favorites/list?ids=' + favIds.join(','));
          const data = await res.json();
          if (res.ok && data.success && data.products && data.products.length > 0) {
            if (container) {
              container.innerHTML = '';
              const fragment = document.createDocumentFragment();
              for (const p of data.products) {
                fragment.appendChild(createFavCard(p));
              }
              container.appendChild(fragment);
            }
            emptyState?.classList.add('hidden');
            clearBtn?.classList.remove('hidden');
          } else {
            emptyState?.classList.remove('hidden');
            clearBtn?.classList.add('hidden');
          }
        } catch (e) {
          console.error('Failed to load guest favorites', e);
        }
      }
    }

    // Handle remove favorite
    container?.addEventListener('click', async (e) => {
      const btn = (e.target as HTMLElement | null)?.closest('[data-remove-fav]');
      if (!btn) return;
      const id = Number(btn.getAttribute('data-remove-fav'));

      // Remove from localStorage
      const currentFavs = getLocalFavorites().filter((fid) => fid !== id);
      localStorage.setItem('mamasar_favorites', JSON.stringify(currentFavs));

      // Remove from database if logged in
      if (isLoggedIn) {
        try {
          await fetch('/api/favorites/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId: id }),
          });
        } catch (err) {
          console.error(err);
        }
      }

      // Remove DOM card
      const card = document.getElementById('fav-card-' + id);
      card?.remove();

      if (container && container.children.length === 0) {
        emptyState?.classList.remove('hidden');
        clearBtn?.classList.add('hidden');
      }
    });

    clearBtn?.addEventListener('click', async () => {
      const confirmed = await confirmAction({
        title: 'Kosongkan Daftar Favorit',
        message: 'Hapus semua daftar produk favorit yang tersimpan?',
        confirmLabel: 'Ya, Hapus Semua',
        tone: 'danger',
      });
      if (!confirmed) return;
      localStorage.removeItem('mamasar_favorites');

      if (isLoggedIn) {
        // Toggle off all visible favorites
        const cards = document.querySelectorAll('[data-remove-fav]');
        for (const card of cards) {
          const id = Number(card.getAttribute('data-remove-fav'));
          try {
            await fetch('/api/favorites/toggle', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ productId: id }),
            });
          } catch {}
        }
      }

      if (container) container.innerHTML = '';
      emptyState?.classList.remove('hidden');
      clearBtn?.classList.add('hidden');
    });

    if (!isLoggedIn || getLocalFavorites().length > 0) {
      loadGuestFavorites();
    }
  </script>
</Layout>
