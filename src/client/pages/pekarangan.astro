---
import Layout from '../layouts/Layout.astro';
import AppIcon from '../components/common/AppIcon.astro';
import ProductCard from '../components/ProductCard.astro';
import { getProducts } from '../../lib/db';

// Ambil produk etalase kategori Pertanian / Pekarangan jika ada
const pekaranganProducts = await getProducts({
  category: 'Pertanian & Perkebunan',
  limit: 4,
});

const pageTitle = 'Ekonomi Pekarangan | Mamasar';
const pageDescription =
  'Gagasan kemandirian pangan keluarga berbasis 4 pilar karya Moh. Luthfi: Rumah Pangan Mandiri, Kandang Produktif, Apotek Hidup, dan Rumah Produksi Pekarangan.';
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="py-3 sm:py-6 space-y-6 sm:space-y-8">
    <!-- HERO SECTION: Clean, Crisp & Anti-Slop -->
    <section class="px-3 sm:px-0">
      <div class="bg-white border border-slate-200 rounded-2xl sm:rounded-3xl p-5 sm:p-7 space-y-4 shadow-2xs">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 text-xs font-semibold border border-emerald-200/70">
          <AppIcon name="sprout" size="xs" class="text-emerald-700" />
          <span>Gagasan Kemandirian Pangan • Moh. Luthfi</span>
        </div>

        <div class="max-w-2xl space-y-1.5">
          <h1 class="text-2xl sm:text-3xl lg:text-4xl font-black tracking-tight text-slate-900 leading-tight">
            Kemandirian Pangan dari Pekarangan Rumah
          </h1>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Amankan belanja dapur keluarga, penuhi gizi sehat mandiri, dan pasarkan surplus olahan pekarangan langsung ke warga.
          </p>
        </div>

        <!-- Tombol Aksi Langsung -->
        <div class="flex flex-wrap items-center gap-2.5 pt-1">
          <a
            href="https://pekarangan.pages.dev/?install=1#install"
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[42px] px-5 py-2.5 rounded-xl bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] text-white font-extrabold text-xs sm:text-sm shadow-xs transition inline-flex items-center gap-2 cursor-pointer"
          >
            <AppIcon name="download" size="sm" />
            <span>Pasang Aplikasi (PWA)</span>
          </a>
          <a
            href="https://github.com/crediblemark-official/pekarangan/releases/tag/v2.1.0"
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[42px] px-4 py-2.5 rounded-xl bg-white hover:bg-slate-50 active:scale-[0.98] text-slate-800 font-bold text-xs sm:text-sm border border-slate-300 transition inline-flex items-center gap-1.5 cursor-pointer shadow-2xs"
          >
            <AppIcon name="download" size="sm" class="text-emerald-700" />
            <span>Unduh APK Android</span>
          </a>
        </div>

        <!-- Quick Status Strip -->
        <div class="pt-3 border-t border-slate-100 flex flex-wrap items-center gap-4 text-xs text-slate-500 font-mono">
          <span class="flex items-center gap-1.5">
            <AppIcon name="check" size="xs" class="text-emerald-700" />
            4 Pilar Mandiri
          </span>
          <span class="flex items-center gap-1.5">
            <AppIcon name="check" size="xs" class="text-emerald-700" />
            100% Offline
          </span>
          <span class="flex items-center gap-1.5">
            <AppIcon name="check" size="xs" class="text-emerald-700" />
            Gratis &amp; Tanpa Iklan
          </span>
        </div>
      </div>
    </section>

    <!-- SECTION: 4 PILAR UTAMA (Buku Moh. Luthfi, hlm. 9) -->
    <section class="px-3 sm:px-0 space-y-3">
      <div class="flex items-center justify-between border-b border-slate-200/80 pb-2">
        <h2 class="text-sm sm:text-base font-black text-slate-900 tracking-tight">
          Empat Pilar Gerakan
        </h2>
        <span class="text-xs text-slate-500 font-mono">Buku Moh. Luthfi • hlm. 9</span>
      </div>

      <!-- Swiss Grid: Single docked container with hairline borders -->
      <div class="bg-white border border-slate-200/90 rounded-2xl overflow-hidden grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 divide-slate-200/80 shadow-2xs">
        <!-- Pilar 1 -->
        <div class="p-4 sm:p-5 space-y-2 sm:border-r sm:border-b border-slate-200/80 hover:bg-slate-50/50 transition">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center">
                <AppIcon name="sprout" size="xs" />
              </span>
              <h3 class="font-bold text-slate-900 text-sm">Rumah Pangan Mandiri (RPM)</h3>
            </div>
            <span class="font-mono text-xs text-slate-400">hlm. 10</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            Budidaya sayur daun, cabai, tomat, dan umbi pekarangan untuk mengamankan kebutuhan dapur harian keluarga.
          </p>
        </div>

        <!-- Pilar 2 -->
        <div class="p-4 sm:p-5 space-y-2 sm:border-b border-slate-200/80 hover:bg-slate-50/50 transition">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center">
                <AppIcon name="package" size="xs" />
              </span>
              <h3 class="font-bold text-slate-900 text-sm">Kandang Keluarga Produktif</h3>
            </div>
            <span class="font-mono text-xs text-slate-400">hlm. 20</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            Peternakan unggas pekarangan dan kolam lele terpal hemat air sebagai sumber protein mandiri &amp; tabungan hidup.
          </p>
        </div>

        <!-- Pilar 3 -->
        <div class="p-4 sm:p-5 space-y-2 sm:border-r border-slate-200/80 hover:bg-slate-50/50 transition">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center">
                <AppIcon name="herbal" size="xs" />
              </span>
              <h3 class="font-bold text-slate-900 text-sm">Apotek Hidup</h3>
            </div>
            <span class="font-mono text-xs text-slate-400">hlm. 26</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            Tanaman Obat Keluarga (TOGA: jahe, kunyit, temulawak, serai) untuk kedaulatan pertolongan pertama kesehatan alami.
          </p>
        </div>

        <!-- Pilar 4 -->
        <div class="p-4 sm:p-5 space-y-2 hover:bg-slate-50/50 transition">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-6 h-6 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center">
                <AppIcon name="store" size="xs" />
              </span>
              <h3 class="font-bold text-slate-900 text-sm">Rumah Produksi Pekarangan (RPP)</h3>
            </div>
            <span class="font-mono text-xs text-slate-400">hlm. 34</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            Pengolahan panen mentah menjadi produk bernilai tambah (sambal kemasan, keripik, jamu bubuk) untuk dipasarkan ke warga.
          </p>
        </div>
      </div>
    </section>

    <!-- SECTION: PRODUK OLAHAN DI MAMASAR (Jika ada) -->
    {pekaranganProducts.length > 0 && (
      <section class="px-3 sm:px-0 space-y-3">
        <div class="flex items-center justify-between border-b border-slate-200/80 pb-2">
          <div class="space-y-0.5">
            <h2 class="text-sm sm:text-base font-black text-slate-900 tracking-tight">
              Produk Olahan &amp; Panen Pekarangan Warga
            </h2>
            <p class="text-xs text-slate-500">Hasil produksi mandiri yang dipasarkan di Mamasar</p>
          </div>
          <a href="/?kategori=Pertanian+%26+Perkebunan" class="text-xs font-bold text-emerald-700 hover:text-emerald-800 inline-flex items-center gap-1">
            <span>Lihat Semua</span>
            <AppIcon name="arrow-right" size="xs" />
          </a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
          {pekaranganProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </section>
    )}

    <!-- SECTION: APP CALLOUT (BOTTOM) -->
    <section class="px-3 sm:px-0">
      <div class="bg-slate-900 text-white rounded-2xl p-5 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <div class="space-y-1">
          <h3 class="text-base sm:text-lg font-black text-white tracking-tight">
            Mulai Catat &amp; Kelola Pekarangan Anda
          </h3>
          <p class="text-xs text-slate-300">
            Aplikasi gratis, 100% offline, tanpa iklan, dan langsung dapat digunakan.
          </p>
        </div>
        <div class="flex items-center gap-2.5 shrink-0">
          <a
            href="https://pekarangan.pages.dev/?install=1#install"
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[40px] px-4 py-2 bg-emerald-600 hover:bg-emerald-500 text-white font-extrabold text-xs sm:text-sm rounded-xl transition shadow-sm active:scale-95 cursor-pointer"
          >
            Pasang PWA
          </a>
          <a
            href="https://github.com/crediblemark-official/pekarangan/releases/tag/v2.1.0"
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[40px] px-4 py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-xs sm:text-sm rounded-xl border border-slate-700 transition active:scale-95 cursor-pointer"
          >
            Unduh APK
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
