---
import Layout from '../../layouts/Layout.astro';
import AppIcon from '../../components/common/AppIcon.astro';
import { getEvents, getAllZones, isSuperadmin } from '../../../lib/db';
import { resolveUser } from '../../../lib/neon-auth';

const url = new URL(Astro.request.url);
const currentZone = url.searchParams.get('zona') || 'semua';

const zones = await getAllZones();
const events = await getEvents({ zoneSlug: currentZone });
const activeZone = zones.find((z) => z.slug === currentZone);
const user = await resolveUser(Astro.request);
const isPengurus = !!user && (isSuperadmin(user) || user.role === 'mwcnu');
---

<Layout
  title="Direktori Kegiatan NU & Pasar Konsumsi Warga | Mamasar Sumenep"
  description="Jadwal pengajian, Lailatul Ijtima, Harlah, dan kegiatan NU se-Kabupaten Sumenep. Pusat pesanan konsumsi berkat dan peluang buka lapak bazar warga."
>
  <div class="pb-12 space-y-6">
    {/* Compact Directory Header & Zone Filter */}
    <header class="w-screen relative left-1/2 -translate-x-1/2 bg-white border-b border-slate-200">
      <div class="max-w-site mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-4">
        <div class="flex items-center justify-between text-xs text-slate-600">
          <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 flex-wrap">
            <a href="/" class="hover:text-emerald-700 font-medium">Beranda</a>
            <AppIcon name="chevron-right" size="xs" class="text-slate-400" />
            <span class="text-slate-900 font-bold">Kegiatan NU</span>
            {activeZone && (
              <>
                <AppIcon name="chevron-right" size="xs" class="text-slate-400" />
                <span class="text-emerald-700 font-bold">{activeZone.name}</span>
              </>
            )}
          </nav>

          <a
            href="/toko"
            class="hidden sm:inline-flex text-xs font-bold text-emerald-700 hover:text-emerald-800 transition items-center gap-1.5"
          >
            <AppIcon name="store" size="xs" />
            <span>Direktori Toko</span>
          </a>
        </div>

        <div class="flex flex-wrap items-center justify-between gap-2 sm:gap-3">
          <div class="space-y-1">
            <h1 class="text-xl sm:text-3xl font-black text-slate-900 tracking-tight">
              Kegiatan NU
            </h1>
            <p class="hidden sm:block text-xs sm:text-sm text-slate-600">
              Jadwal agenda MWC, pesanan konsumsi, dan lapak warga.
            </p>
          </div>

          <div class="flex items-center gap-2.5 shrink-0">
            <span class="text-xs font-semibold text-slate-600 font-mono tabular-nums">
              {events.length} agenda
            </span>
            {isPengurus && (
              <a
                href="/admin#events"
                class="min-h-[44px] inline-flex items-center justify-center gap-1.5 px-4 bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] text-white font-bold text-xs rounded-lg transition"
              >
                <AppIcon name="sliders" size="xs" />
                <span>Kelola</span>
              </a>
            )}
          </div>
        </div>

        <div
          class="pt-2 border-t border-slate-100 flex items-center gap-1.5 overflow-x-auto snap-x snap-mandatory no-scrollbar pb-1"
          style="mask-image: linear-gradient(to right, black 92%, transparent 100%);"
        >
          <a
            href="/kegiatan"
            class={`snap-start px-3.5 py-2 min-h-[44px] inline-flex items-center rounded-lg text-xs font-bold whitespace-nowrap transition shrink-0 ${
              currentZone === 'semua'
                ? 'bg-emerald-700 text-white'
                : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
            }`}
          >
            Semua
          </a>
          {zones.map((z) => (
            <a
              href={`/kegiatan?zona=${z.slug}`}
              class={`snap-start px-3.5 py-2 min-h-[44px] inline-flex items-center rounded-lg text-xs font-bold whitespace-nowrap transition shrink-0 ${
                currentZone === z.slug
                  ? 'bg-emerald-700 text-white'
                  : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
              }`}
            >
              {z.name}
            </a>
          ))}
        </div>
      </div>
    </header>

    <div class="px-0">
      {events.length > 0 ? (
        <div class="bg-white border-y sm:border border-slate-200 sm:rounded-lg divide-y divide-slate-200">
          {events.map((ev) => {
            const evDate = new Date(ev.event_date);
            const dayNum = evDate.toLocaleDateString('id-ID', { day: 'numeric' });
            const monthStr = evDate.toLocaleDateString('id-ID', { month: 'short' }).toUpperCase();
            const isPast = evDate.getTime() < Date.now();

            return (
              <article
                class={`p-4 sm:px-5 sm:py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-5 hover:bg-slate-50/70 transition ${
                  isPast ? 'opacity-75' : ''
                }`}
              >
                <div class="flex items-start gap-3.5 min-w-0 flex-1">
                  <div
                    class={`w-13 h-13 rounded-lg border flex flex-col items-center justify-center font-black text-center shrink-0 font-mono tabular-nums ${
                      isPast
                        ? 'bg-slate-100 text-slate-600 border-slate-200'
                        : 'bg-emerald-50 text-emerald-800 border-emerald-200'
                    }`}
                  >
                    <span class="text-base leading-none">{dayNum}</span>
                    <span class="text-xs uppercase tracking-wider mt-0.5">{monthStr}</span>
                  </div>

                  <div class="min-w-0 flex-1 space-y-1">
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-600">
                      <span class="font-bold text-emerald-800">{ev.zone_name}</span>
                      <span aria-hidden="true" class="text-slate-300">·</span>
                      <span class="truncate">{ev.organizer}</span>
                      {Boolean(ev.allow_stalls) && (
                        <>
                          <span aria-hidden="true" class="text-slate-300">·</span>
                          <span class="font-semibold text-emerald-700">Lapak</span>
                        </>
                      )}
                      {isPast && (
                        <>
                          <span aria-hidden="true" class="text-slate-300">·</span>
                          <span class="font-semibold text-slate-600">Selesai</span>
                        </>
                      )}
                    </div>

                    <a
                      href={`/kegiatan/${ev.slug}`}
                      class="font-bold text-sm sm:text-base text-slate-900 hover:text-emerald-700 transition line-clamp-1 block leading-snug"
                    >
                      {ev.title}
                    </a>

                    <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-slate-600">
                      <span class="inline-flex items-center gap-1">
                        <AppIcon name="clock" size="xs" class="text-slate-500 shrink-0" />
                        <span>{ev.time_description}</span>
                      </span>
                      <span class="inline-flex items-center gap-1 min-w-0">
                        <AppIcon name="map-pin" size="xs" class="text-slate-500 shrink-0" />
                        <span class="truncate">{ev.location_name}</span>
                      </span>
                      <span class="inline-flex items-center gap-1 font-mono tabular-nums font-semibold text-slate-700">
                        <AppIcon name="users" size="xs" class="text-emerald-700 shrink-0" />
                        <span>~{ev.estimated_attendance}</span>
                      </span>
                      {ev.consumption_needed && (
                        <span class="inline-flex items-center gap-1 text-slate-700 min-w-0 max-w-full">
                          <AppIcon name="food" size="xs" class="text-amber-700 shrink-0" />
                          <span class="truncate">{ev.consumption_needed}</span>
                        </span>
                      )}
                    </div>
                  </div>
                </div>

                <div class="flex items-center justify-end shrink-0 pl-16 sm:pl-0">
                  <a
                    href={`/kegiatan/${ev.slug}`}
                    class="w-full sm:w-auto min-h-[44px] bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] text-white font-bold text-xs px-5 py-2 rounded-lg transition inline-flex items-center justify-center"
                  >
                    Detail
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="bg-white border-y sm:border border-slate-200 sm:rounded-lg p-10 text-center space-y-2">
          <div class="w-11 h-11 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center mx-auto">
            <AppIcon name="calendar" size="md" />
          </div>
          <h2 class="font-bold text-slate-900 text-sm">Belum Ada Agenda</h2>
          <p class="text-xs text-slate-600 max-w-sm mx-auto">
            Belum ada kegiatan terjadwal untuk wilayah ini.
          </p>
        </div>
      )}
    </div>
  </div>
</Layout>
