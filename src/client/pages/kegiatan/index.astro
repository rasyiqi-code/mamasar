---
import Layout from '../../layouts/Layout.astro';
import AppIcon from '../../components/common/AppIcon.astro';
import { getEvents, getAllZones, isSuperadmin } from '../../../lib/db';
import { resolveUser } from '../../../lib/neon-auth';

const url = new URL(Astro.request.url);
const currentZone = url.searchParams.get('zona') || 'semua';

const zones = await getAllZones();
const events = await getEvents({ zoneSlug: currentZone });
const activeZone = zones.find((z) => z.slug === currentZone);
const user = await resolveUser(Astro.request);
const isPengurus = !!user && (isSuperadmin(user) || user.role === 'mwcnu');
---

<Layout
  title="Direktori Kegiatan NU & Pasar Konsumsi Warga | Mamasar Sumenep"
  description="Jadwal pengajian, Lailatul Ijtima, Harlah, dan kegiatan NU se-Kabupaten Sumenep. Pusat pesanan konsumsi berkat dan peluang buka lapak bazar warga."
>
  <div class="pb-12 space-y-8">
    {/* Full-bleed Directory Header & Filter Strip */}
    <header class="w-screen relative left-1/2 -translate-x-1/2 bg-white border-b border-slate-200">
      <div class="max-w-site mx-auto px-3 sm:px-6 lg:px-8 py-5 sm:py-8 space-y-5">
        <div class="flex items-center justify-between text-xs text-slate-600 pb-3 border-b border-slate-100">
          <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 flex-wrap">
            <a href="/" class="hover:text-emerald-700 font-medium">Beranda</a>
            <AppIcon name="chevron-right" size="xs" class="text-slate-400" />
            <span class="text-slate-900 font-bold">Direktori Kegiatan NU</span>
            {activeZone && (
              <>
                <AppIcon name="chevron-right" size="xs" class="text-slate-400" />
                <span class="text-emerald-700 font-bold">{activeZone.name}</span>
              </>
            )}
          </nav>

          <a
            href="/toko?kategori=Makanan%20%26%20Minuman"
            class="hidden sm:inline-flex text-xs font-bold text-emerald-700 hover:text-emerald-800 transition items-center gap-1.5"
          >
            <AppIcon name="food" size="xs" />
            <span>Cari Katering Acara</span>
          </a>
        </div>

        {isPengurus && (
          <div class="bg-emerald-50 border border-emerald-200 rounded-lg p-3.5 sm:p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-lg bg-emerald-700 text-white flex items-center justify-center font-black text-xs shrink-0">
                NU
              </div>
              <div>
                <h2 class="text-xs font-black text-emerald-950">Mode Pengurus PCNU Aktif</h2>
                <p class="text-xs text-emerald-800">Kelola jadwal agenda kegiatan NU secara terpusat di Konsol Admin.</p>
              </div>
            </div>
            <a
              href="/admin#events"
              class="min-h-[40px] inline-flex items-center justify-center gap-1.5 py-2 px-3.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs rounded-lg transition shrink-0"
            >
              <AppIcon name="sliders" size="xs" />
              <span>Kelola Agenda</span>
              <AppIcon name="arrow-right" size="xs" />
            </a>
          </div>
        )}

        <div class="space-y-2 max-w-3xl">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-amber-50 text-amber-900 border border-amber-300 text-xs font-bold">
            <AppIcon name="tent" size="xs" class="text-amber-700" />
            <span>Setiap Kegiatan NU adalah Potensi Pasar Mamasar</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
            Direktori Kegiatan NU & Pusat Konsumsi Warga
          </h1>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Temukan jadwal pengajian, Lailatul Ijtima&apos;, dan peringatan hari besar NU se-Kabupaten Sumenep. Panitia dapat memesan katering langsung dari UMKM warga, dan pedagang dapat membuka lapak bazar jamaah.
          </p>
        </div>

        {/* Hairline Two-Sided Split */}
        <div class="bg-slate-50 border border-slate-200 rounded-lg grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-slate-200">
          <div class="p-3.5 sm:p-4 text-xs space-y-1">
            <span class="font-bold text-emerald-900 flex items-center gap-1.5">
              <AppIcon name="food" size="xs" class="text-emerald-700" />
              <span>Untuk Panitia Pengajian & Acara</span>
            </span>
            <p class="text-slate-700 leading-relaxed">
              Pesan nasi berkat, snack box kue tradisional, dan air minum langsung dari pelaku UMKM warga di MWC setempat agar dana berputar di jamaah.
            </p>
          </div>
          <div class="p-3.5 sm:p-4 text-xs space-y-1">
            <span class="font-bold text-amber-950 flex items-center gap-1.5">
              <AppIcon name="store" size="xs" class="text-amber-700" />
              <span>Untuk Pedagang & Pelaku UMKM</span>
            </span>
            <p class="text-slate-700 leading-relaxed">
              Ketahui titik keramaian jamaah untuk membuka lapak camilan, kopi, kopyah, batik, atau hasil bumi langsung ke pengunjung.
            </p>
          </div>
        </div>

        <div class="space-y-2 pt-1">
          <span class="text-xs font-bold text-slate-700 block">Pilih Wilayah MWC:</span>
          <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
            <a
              href="/kegiatan"
              class={`px-3.5 py-2 min-h-[40px] inline-flex items-center rounded-lg text-xs font-bold whitespace-nowrap transition shrink-0 ${
                currentZone === 'semua'
                  ? 'bg-emerald-700 text-white'
                  : 'bg-white text-slate-700 hover:bg-slate-50 border border-slate-200'
              }`}
            >
              Semua Wilayah
            </a>
            {zones.map((z) => (
              <a
                href={`/kegiatan?zona=${z.slug}`}
                class={`px-3.5 py-2 min-h-[40px] inline-flex items-center rounded-lg text-xs font-bold whitespace-nowrap transition shrink-0 ${
                  currentZone === z.slug
                    ? 'bg-emerald-700 text-white'
                    : 'bg-white text-slate-700 hover:bg-slate-50 border border-slate-200'
                }`}
              >
                {z.name}
              </a>
            ))}
          </div>
        </div>
      </div>
    </header>

    <div class="px-3 sm:px-0 space-y-4">
      <div class="flex items-center justify-between border-b border-slate-200 pb-3">
        <h2 class="text-sm sm:text-base font-black text-slate-900 tracking-tight flex items-center gap-2">
          <AppIcon name="calendar" size="sm" class="text-emerald-700" />
          <span>Agenda Kegiatan Mendatang (<span class="font-mono tabular-nums">{events.length}</span>)</span>
        </h2>
      </div>

      {events.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-5">
          {events.map((ev) => {
            const evDate = new Date(ev.event_date);
            const dayNum = evDate.toLocaleDateString('id-ID', { day: 'numeric' });
            const monthStr = evDate.toLocaleDateString('id-ID', { month: 'short' }).toUpperCase();
            const isPast = evDate.getTime() < Date.now();

            return (
              <article class={`-mx-3 sm:mx-0 bg-white border-y sm:border sm:rounded-lg p-4 sm:p-5 transition flex flex-col justify-between group space-y-4 ${isPast ? 'border-slate-200 opacity-80' : 'border-slate-200 hover:border-emerald-600'}`}>
                <div class="space-y-3">
                  <div class="flex items-start gap-3.5">
                    <div class={`w-14 h-14 rounded-lg border flex flex-col items-center justify-center font-black text-center shrink-0 font-mono tabular-nums ${isPast ? 'bg-slate-100 text-slate-600 border-slate-300' : 'bg-emerald-50 text-emerald-800 border-emerald-200'}`}>
                      <span class="text-lg leading-none">{dayNum}</span>
                      <span class="text-xs uppercase tracking-wider mt-0.5">{monthStr}</span>
                    </div>

                    <div class="space-y-1.5 min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-1.5">
                        <span class="inline-flex items-center gap-1 text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200 px-2 py-0.5 rounded-md">
                          <AppIcon name="map-pin" size="xs" class="text-emerald-700" />
                          <span>{ev.zone_name}</span>
                        </span>
                        <span class="text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 px-2 py-0.5 rounded-md">
                          {ev.organizer}
                        </span>
                        {isPast && (
                          <span class="text-xs font-semibold bg-slate-200 text-slate-700 border border-slate-300 px-2 py-0.5 rounded-md">
                            Selesai
                          </span>
                        )}
                      </div>
                      <a
                        href={`/kegiatan/${ev.slug}`}
                        class="font-black text-sm sm:text-base text-slate-900 group-hover:text-emerald-700 transition line-clamp-2 leading-snug block"
                      >
                        {ev.title}
                      </a>
                    </div>
                  </div>

                  <div class="text-xs text-slate-700 space-y-1.5 pt-2 border-t border-slate-100">
                    <div class="flex items-center gap-2">
                      <AppIcon name="clock" size="xs" class="text-slate-500 shrink-0" />
                      <span>{ev.time_description}</span>
                    </div>
                    <div class="flex items-center gap-2">
                      <AppIcon name="map-pin" size="xs" class="text-slate-500 shrink-0" />
                      <span class="truncate">{ev.location_name} ({ev.location_address})</span>
                    </div>
                    <div class="flex items-center gap-2 font-bold text-slate-800">
                      <AppIcon name="users" size="xs" class="text-emerald-700 shrink-0" />
                      <span>Estimasi Jamaah: ~<span class="font-mono tabular-nums">{ev.estimated_attendance}</span> Orang</span>
                    </div>
                  </div>

                  {ev.consumption_needed && (
                    <div class="p-3 bg-amber-50/70 border border-amber-200 rounded-lg text-xs space-y-1">
                      <span class="font-bold text-amber-950 flex items-center gap-1.5">
                        <AppIcon name="food" size="xs" class="text-amber-800" />
                        <span>Kebutuhan Konsumsi Panitia:</span>
                      </span>
                      <p class="text-amber-900 leading-relaxed line-clamp-2">
                        {ev.consumption_needed}
                      </p>
                    </div>
                  )}
                </div>

                <div class="pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2">
                  {Boolean(ev.allow_stalls) ? (
                    <span class="inline-flex items-center gap-1 text-xs font-bold text-emerald-800 bg-emerald-50 px-2.5 py-1 rounded-md border border-emerald-200">
                      <AppIcon name="check" size="xs" />
                      <span>Lapak Diizinkan</span>
                    </span>
                  ) : (
                    <span />
                  )}
                  <a
                    href={`/kegiatan/${ev.slug}`}
                    class="min-h-[44px] bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs px-4 py-2 rounded-lg transition inline-flex items-center gap-1.5"
                  >
                    <span>Detail &amp; Konsumsi</span>
                    <AppIcon name="arrow-right" size="xs" />
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div class="-mx-3 sm:mx-0 bg-white border-y sm:border border-slate-200 sm:rounded-lg p-10 text-center space-y-2">
          <div class="w-11 h-11 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center mx-auto">
            <AppIcon name="calendar" size="md" />
          </div>
          <h3 class="font-bold text-slate-900 text-sm">Belum Ada Agenda di Wilayah Ini</h3>
          <p class="text-xs text-slate-600 max-w-sm mx-auto">
            Silakan pilih wilayah MWC lainnya atau pantau jadwal pengajian berkala PCNU Sumenep.
          </p>
        </div>
      )}
    </div>
  </div>
</Layout>
