---
import Layout from '../../layouts/Layout.astro';
import AppIcon from '../../components/common/AppIcon.astro';
import NotFoundView from '../../components/common/NotFoundView.astro';
import { getEventBySlug, getProducts, getUserFromSession } from '../../../lib/db';
import { formatPhoneForWhatsApp, getOptimizedImageUrl } from '../../../lib/utils';
import { DEFAULT_PRODUCT_IMAGE } from '../../../lib/constants';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/kegiatan');
}

const event = await getEventBySlug(slug);

if (!event) {
  Astro.response.status = 404;
}

const sessionId = Astro.cookies.get('mamasar_session')?.value;
const currentUser = event && sessionId ? await getUserFromSession(sessionId) : null;

const currentUrl = Astro.url.href;
const coordinatorWaLink = event
  ? `https://wa.me/${formatPhoneForWhatsApp(event.coordinator_phone)}?text=${encodeURIComponent(
      `Assalamu'alaikum ${event.coordinator_name || 'Panitia'}, saya ingin bertanya mengenai partisipasi buka lapak bazar atau kebutuhan konsumsi untuk acara: *${event.title}* di ${event.location_name}.`
    )}`
  : '#';

const localFoodProducts = event
  ? (await getProducts({
      zoneSlug: event.zone_slug,
      category: 'Makanan & Minuman',
    })).slice(0, 4)
  : [];

const foodVendors = event
  ? (localFoodProducts.length > 0
      ? localFoodProducts
      : (await getProducts({ category: 'Makanan & Minuman' })).slice(0, 4))
  : [];

const eventSchema = event
  ? {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: event.title,
      startDate: event.event_date,
      eventStatus: 'https://schema.org/EventScheduled',
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: event.location_name,
        address: {
          '@type': 'PostalAddress',
          streetAddress: event.location_address || event.location_name,
          addressLocality: event.zone_name,
          addressRegion: 'Sumenep, Jawa Timur',
          addressCountry: 'ID',
        },
      },
      organizer: {
        '@type': 'Organization',
        name: event.organizer,
        url: currentUrl,
      },
      description:
        event.consumption_needed ||
        `Kegiatan ${event.title} diselenggarakan oleh ${event.organizer} di ${event.location_name}, Sumenep.`,
    }
  : undefined;

const evDate = event ? new Date(event.event_date) : new Date();
const formattedDate = evDate.toLocaleDateString('id-ID', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Jakarta',
});
---

{!event ? (
  <Layout
    title="Agenda Kegiatan Tidak Ditemukan | Mamasar"
    description="Agenda kegiatan NU yang Anda cari belum tersedia atau sudah selesai."
    noindex={true}
  >
    <NotFoundView
      code="404"
      heading="Agenda Kegiatan Tidak Ditemukan"
      message="Link kegiatan mungkin keliru atau agenda sudah dihapus oleh panitia."
      primaryHref="/kegiatan"
      primaryLabel="Lihat Semua Kegiatan NU"
    />
  </Layout>
) : (
<Layout
  title={`${event.title} | Agenda Kegiatan & Konsumsi | Mamasar`}
  description={`Agenda ${event.title} oleh ${event.organizer} di ${event.location_name}, ${event.zone_name}, Sumenep. Pusat pesanan konsumsi berkat dan info lapak bazar warga.`}
  canonicalUrl={currentUrl}
  schema={eventSchema}
>
  <div class="pb-12 space-y-6">
    {/* Box-Free Hairline Event Header */}
    <header class="-mx-0 sm:-mx-6 lg:-mx-8 px-3 sm:px-6 lg:px-8 py-3.5 sm:py-6 space-y-3 sm:space-y-4 bg-white border-b border-slate-200">
      <div class="hidden md:flex items-center justify-between text-xs text-slate-600">
          <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 min-w-0">
            <a href="/" class="hover:text-emerald-700 font-medium shrink-0">Beranda</a>
            <AppIcon name="chevron-right" size="xs" class="text-slate-400 shrink-0" />
            <a href="/kegiatan" class="hover:text-emerald-700 font-medium shrink-0">Kegiatan</a>
            <AppIcon name="chevron-right" size="xs" class="text-slate-400 shrink-0" />
            <span class="text-slate-900 font-bold truncate max-w-[180px] sm:max-w-md">{event.title}</span>
          </nav>

          <a
            href="/kegiatan"
            class="hidden sm:inline-flex text-xs font-semibold text-slate-600 hover:text-emerald-700 transition shrink-0"
          >
            Semua Agenda
          </a>
        </div>

        <div class="space-y-2">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-slate-600">
            <span class="font-bold text-emerald-800">{event.zone_name}</span>
            <span aria-hidden="true" class="text-slate-300">·</span>
            <span>{event.organizer}</span>
            {Boolean(event.allow_stalls) && (
              <>
                <span aria-hidden="true" class="text-slate-300">·</span>
                <span class="inline-flex items-center gap-1 font-semibold text-emerald-700">
                  <AppIcon name="check" size="xs" />
                  <span>Lapak Diizinkan</span>
                </span>
              </>
            )}
          </div>

          <h1 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-tight max-w-3xl">
            {event.title}
          </h1>
        </div>

        <dl class="pt-4 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-0 sm:divide-x sm:divide-slate-200 text-xs">
          <div class="sm:pr-5 space-y-0.5">
            <dt class="text-slate-600">Waktu</dt>
            <dd class="font-bold text-slate-900 text-sm">{formattedDate}</dd>
            <dd class="text-slate-600">{event.time_description}</dd>
          </div>

          <div class="sm:px-5 space-y-0.5 min-w-0">
            <dt class="text-slate-600">Lokasi</dt>
            <dd class="font-bold text-slate-900 text-sm truncate">{event.location_name}</dd>
            <dd class="text-slate-600 truncate">{event.location_address || event.zone_name}</dd>
          </div>

          <div class="sm:pl-5 space-y-0.5">
            <dt class="text-slate-600">Estimasi Jamaah</dt>
            <dd class="font-bold text-emerald-700 text-sm font-mono tabular-nums">~{event.estimated_attendance} Orang</dd>
            <dd class="text-slate-600">Koordinator: {event.coordinator_name || 'Panitia'}</dd>
          </div>
        </dl>
    </header>

    <div class="px-3 sm:px-0">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-8 space-y-6">
          {/* Kebutuhan Konsumsi Hairline Row (No Nested Box) */}
          <section class="pb-5 border-b border-slate-200 space-y-2">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-2">
                <AppIcon name="food" size="sm" class="text-amber-700 shrink-0" />
                <span>Kebutuhan Konsumsi</span>
              </h2>
              <a
                href={`/?zona=${event.zone_slug}&kategori=Makanan%20%26%20Minuman`}
                class="text-xs font-bold text-emerald-700 hover:text-emerald-800 shrink-0"
              >
                Kuliner MWC
              </a>
            </div>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
              {event.consumption_needed || 'Snack box kue tradisional dan paket nasi berkat jamaah.'}
            </p>
          </section>

          <section class="space-y-4">
            <div class="flex items-center justify-between">
              <h2 class="font-bold text-sm sm:text-base text-slate-900">
                Katering MWC {event.zone_name}
              </h2>
              <span class="text-xs font-mono tabular-nums text-slate-600">
                {foodVendors.length} menu
              </span>
            </div>

            <div class="-mx-3 sm:mx-0 grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
              {foodVendors.map((p) => {
                const orderWaLink = `https://wa.me/${p.umkm_phone}?text=${encodeURIComponent(
                  `Assalamu'alaikum ${p.umkm_name}, kami dari panitia kegiatan *${event.title}* di ${event.zone_name} ingin bertanya mengenai pesanan konsumsi produk *${p.name}* untuk acara tanggal ${formattedDate}. Apakah melayani pesanan jumlah banyak?`
                )}`;

                return (
                  <article class="bg-white border-y sm:border border-slate-200 rounded-none sm:rounded-lg overflow-hidden flex flex-col justify-between">
                    <div>
                      <img
                        src={getOptimizedImageUrl(p.image_url || DEFAULT_PRODUCT_IMAGE, 400)}
                        alt={p.name}
                        width="400"
                        height="250"
                        loading="lazy"
                        decoding="async"
                        class="w-full aspect-16/10 object-cover bg-slate-100 border-b border-slate-100"
                      />
                      <div class="p-3.5 space-y-1">
                        <span class="text-xs text-slate-600 truncate block">{p.umkm_name}</span>
                        <h3 class="font-bold text-sm text-slate-900 line-clamp-1">{p.name}</h3>
                        <p class="text-sm font-extrabold text-emerald-700 font-mono tabular-nums">
                          Rp {p.price.toLocaleString('id-ID')}
                        </p>
                      </div>
                    </div>
                    <div class="px-3.5 pb-3.5">
                      <a
                        href={orderWaLink}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="w-full min-h-[44px] py-2 bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] text-white rounded-lg font-bold text-xs flex items-center justify-center gap-1.5 transition"
                      >
                        <AppIcon name="phone" size="xs" />
                        <span>Pesan</span>
                      </a>
                    </div>
                  </article>
                );
              })}
            </div>
          </section>
        </div>

        {/* Right Docked Sidebar (Box-Free Hairline Layout) */}
        <aside class="lg:col-span-4 space-y-5 border-t border-slate-200 pt-6 lg:border-t-0 lg:pt-0 lg:border-l lg:border-slate-200 lg:pl-8 lg:sticky lg:top-20">
          <div class="space-y-1">
            <h2 class="text-base font-extrabold text-slate-900">Ajukan Konsumsi &amp; Lapak</h2>
            <p class="text-xs text-slate-600">
              {Boolean(event.allow_stalls) ? 'Lapak gratis / infaq sukarela.' : 'Khusus penawaran konsumsi acara.'}
            </p>
          </div>

          <form id="event-order-form" class="space-y-3 text-xs">
            <input type="hidden" name="eventId" value={event.id} />

            <div class="space-y-1">
              <label for="evOrderType" class="block font-bold text-slate-700">Jenis</label>
              <select
                id="evOrderType"
                name="type"
                class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs text-slate-900 focus:border-emerald-700"
              >
                <option value="consumption">Penawaran Konsumsi</option>
                {Boolean(event.allow_stalls) && (
                  <option value="stall">Buka Lapak Bazar</option>
                )}
              </select>
            </div>

            <div class="space-y-1">
              <label for="evSenderName" class="block font-bold text-slate-700">Nama / Toko</label>
              <input
                type="text"
                id="evSenderName"
                name="senderName"
                required
                minlength="2"
                maxlength="80"
                value={currentUser?.umkm?.name || currentUser?.name || ''}
                placeholder="Dapur Kue Bu Siti"
                class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs text-slate-900 focus:border-emerald-700"
              />
            </div>

            <div class="space-y-1">
              <label for="evSenderPhone" class="block font-bold text-slate-700">WhatsApp</label>
              <input
                type="tel"
                id="evSenderPhone"
                name="senderPhone"
                required
                value={currentUser?.umkm?.phone || ''}
                placeholder="081234567890"
                class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs font-mono text-slate-900 focus:border-emerald-700"
              />
            </div>

            <div class="space-y-1">
              <label for="evOrderQty" class="block font-bold text-slate-700">Jumlah / Lapak</label>
              <input
                type="text"
                id="evOrderQty"
                name="quantityOrSlots"
                maxlength="100"
                placeholder="200 kotak atau 1 lapak"
                class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs text-slate-900 focus:border-emerald-700"
              />
            </div>

            <div class="space-y-1">
              <label for="evOrderDesc" class="block font-bold text-slate-700">Menu / Produk</label>
              <textarea
                id="evOrderDesc"
                name="itemDescription"
                required
                minlength="5"
                maxlength="400"
                rows="3"
                placeholder="Snack box Rp 8.000 siap antar pagi."
                class="w-full bg-white border border-slate-300 rounded-lg px-3 py-2 text-xs text-slate-900 focus:border-emerald-700"
              ></textarea>
            </div>

            <div id="event-order-status" role="status" aria-live="polite" class="hidden p-2.5 rounded-lg text-xs font-semibold"></div>

            <button
              type="submit"
              id="btn-submit-event-order"
              class="w-full min-h-[44px] py-2.5 px-4 bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] disabled:opacity-50 text-white rounded-lg font-bold text-xs sm:text-sm flex items-center justify-center transition cursor-pointer"
            >
              Kirim
            </button>
          </form>

          <div class="pt-4 border-t border-slate-200 grid grid-cols-2 gap-2 text-xs">
            <a
              href={coordinatorWaLink}
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] py-2 px-3 bg-white hover:bg-slate-50 text-slate-800 border border-slate-300 rounded-lg font-bold flex items-center justify-center gap-1.5 transition"
            >
              <AppIcon name="phone" size="xs" />
              <span>Panitia</span>
            </a>

            <a
              href={`https://wa.me/?text=${encodeURIComponent(`*${event.title}*\nTanggal: ${formattedDate} (${event.time_description})\nLokasi: ${event.location_name}\n\n${currentUrl}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] py-2 px-3 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 border border-emerald-200 font-bold rounded-lg flex items-center justify-center gap-1.5 transition"
            >
              <AppIcon name="share" size="xs" />
              <span>Bagikan</span>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </div>

  <script>
    const orderForm = document.getElementById('event-order-form') as HTMLFormElement | null;
    const statusBox = document.getElementById('event-order-status');
    const submitBtn = document.getElementById('btn-submit-event-order') as HTMLButtonElement | null;

    orderForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!orderForm) return;

      const formData = new FormData(orderForm);
      const payload = {
        eventId: Number(formData.get('eventId')),
        type: String(formData.get('type') || 'consumption'),
        senderName: String(formData.get('senderName') || '').trim(),
        senderPhone: String(formData.get('senderPhone') || '').trim(),
        quantityOrSlots: String(formData.get('quantityOrSlots') || '').trim(),
        itemDescription: String(formData.get('itemDescription') || '').trim(),
      };

      if (submitBtn) submitBtn.disabled = true;
      if (statusBox) {
        statusBox.className = 'p-2.5 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200';
        statusBox.textContent = 'Mengirim pengajuan ke panitia...';
      }

      try {
        const res = await fetch('/api/events/order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          if (statusBox) {
            statusBox.className = 'p-2.5 rounded-lg text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200';
            statusBox.textContent = data.message;
          }
          const descEl = document.getElementById('evOrderDesc') as HTMLTextAreaElement | null;
          const qtyEl = document.getElementById('evOrderQty') as HTMLInputElement | null;
          if (descEl) descEl.value = '';
          if (qtyEl) qtyEl.value = '';
        } else {
          if (statusBox) {
            statusBox.className = 'p-2.5 rounded-lg text-xs font-semibold bg-rose-50 text-rose-800 border border-rose-200';
            statusBox.textContent = data.message || 'Gagal mengirim pengajuan.';
          }
        }
      } catch {
        if (statusBox) {
          statusBox.className = 'p-2.5 rounded-lg text-xs font-semibold bg-rose-50 text-rose-800 border border-rose-200';
          statusBox.textContent = 'Gangguan jaringan. Periksa koneksi Anda dan coba lagi.';
        }
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  </script>
</Layout>
)}
