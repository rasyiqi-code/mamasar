---
import Layout from '../layouts/Layout.astro';
import AppIcon from '../components/common/AppIcon.astro';
import { getUMKMByUserId } from '../../lib/db';
import { resolveUser } from '../../lib/neon-auth';
import { PRODUCT_CATEGORIES, DEFAULT_PRODUCT_IMAGE } from '../../lib/constants';

const user = await resolveUser(Astro.request);
const userStore = user ? await getUMKMByUserId(user.id) : null;
---

<Layout
  title="Pasang Iklan Produk | Mamasar"
  description="Pasang iklan produk UMKM Anda langsung di direktori Mamasar Sumenep. Transaksi langsung via WhatsApp tanpa potongan biaya komisi."
>
  <div class="pb-12 space-y-6">
    {/* Full-Bleed Hairline Page Header */}
    <header class="w-screen relative left-1/2 -translate-x-1/2 bg-white border-b border-slate-200">
      <div class="max-w-site mx-auto px-3 sm:px-6 lg:px-8 py-3.5 sm:py-5 space-y-2 sm:space-y-3">
        <div class="hidden md:flex items-center justify-between text-xs text-slate-600">
          <nav aria-label="Breadcrumb" class="flex items-center gap-1.5">
            <a href="/" class="hover:text-emerald-700 font-medium">Beranda</a>
            <AppIcon name="chevron-right" size="xs" class="text-slate-400" />
            <span class="text-slate-900 font-bold">Pasang Iklan</span>
          </nav>

          <a
            href="/dashboard"
            class="hidden sm:inline-flex items-center gap-1 text-xs font-bold text-emerald-700 hover:text-emerald-800 transition"
          >
            <AppIcon name="store" size="xs" />
            <span>{userStore ? 'Kelola Toko' : 'Dashboard Toko'}</span>
          </a>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
          <div>
            <h1 class="text-xl sm:text-3xl font-black text-slate-900 tracking-tight">
              Pasang Iklan
            </h1>
            <p class="hidden sm:block text-xs sm:text-sm text-slate-600">
              Terbitkan produk ke katalog Mamasar Sumenep tanpa potongan komisi.
            </p>
          </div>
          {userStore && (
            <div class="text-xs text-slate-700 flex items-center gap-1.5 shrink-0">
              <AppIcon name="store" size="xs" class="text-emerald-700" />
              <strong class="text-slate-900">{userStore.name}</strong>
              <span aria-hidden="true" class="text-slate-300">·</span>
              <span>{userStore.zone_name}</span>
            </div>
          )}
        </div>
      </div>
    </header>

    <div class="px-3 sm:px-0 space-y-5">
      {!userStore && (
        <div class="p-4 rounded-lg bg-amber-50 border border-amber-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
          <div class="flex items-center gap-2.5 text-amber-950">
            <AppIcon name="info" size="sm" class="text-amber-700 shrink-0" />
            <span>
              {user
                ? 'Lengkapi profil toko dulu agar nomor WhatsApp toko Anda tampil di katalog.'
                : 'Masuk terlebih dahulu untuk melengkapi toko sebelum menerbitkan iklan.'}
            </span>
          </div>
          <a
            href="/dashboard"
            class="shrink-0 min-h-[44px] px-4 py-2 bg-amber-800 hover:bg-amber-900 text-white font-bold rounded-lg transition inline-flex items-center justify-center"
          >
            {user ? 'Lengkapi Profil' : 'Masuk'}
          </a>
        </div>
      )}

      {/* Notification Alert */}
      <div id="form-alert" role="status" aria-live="polite" class="hidden p-4 rounded-lg text-xs font-semibold"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        {/* Left: Pure Product Form */}
        <form id="product-form" class="lg:col-span-8 space-y-6">
          <input type="hidden" id="productImageBase64" name="imageBase64" />
          <input type="hidden" id="galleryImagesInput" name="galleryImages" value="[]" />
          {userStore && <input type="hidden" name="umkmId" value={userStore.id} />}

          {/* Section: Detail Produk */}
          <div class="space-y-4">
            <div class="pb-2 border-b border-slate-200 flex items-center justify-between">
              <h2 class="text-xs font-black uppercase tracking-wider text-slate-800 flex items-center gap-2">
                <AppIcon name="box" size="xs" class="text-emerald-700" />
                <span>Informasi Produk</span>
              </h2>
              <span class="text-xs text-slate-600">* Wajib</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="productName" class="block text-xs font-bold text-slate-700">
                  Nama Produk <span class="text-rose-600">*</span>
                </label>
                <input
                  type="text"
                  id="productName"
                  name="productName"
                  required
                  placeholder="Contoh: Keripik Pisang Madu 250gr"
                  class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs sm:text-sm text-slate-900 placeholder:text-slate-500 focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 transition"
                />
              </div>

              <div class="space-y-1.5">
                <label for="category" class="block text-xs font-bold text-slate-700">
                  Kategori <span class="text-rose-600">*</span>
                </label>
                <select
                  id="category"
                  name="category"
                  required
                  class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs sm:text-sm font-semibold text-slate-900 focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 cursor-pointer transition"
                >
                  <option value="" disabled selected>Pilih Kategori</option>
                  {PRODUCT_CATEGORIES.map((cat) => (
                    <option value={cat}>{cat}</option>
                  ))}
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div class="space-y-1.5">
                <label for="price" class="block text-xs font-bold text-slate-700">
                  Harga (Rp) <span class="text-rose-600">*</span>
                </label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-600">Rp</span>
                  <input
                    type="number"
                    id="price"
                    name="price"
                    required
                    min="0"
                    step="500"
                    placeholder="16000"
                    class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg p-2.5 pl-9 text-xs sm:text-sm font-mono font-bold text-slate-900 placeholder:text-slate-500 focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 transition"
                  />
                </div>
              </div>

              <div class="space-y-1.5">
                <label for="originalPrice" class="block text-xs font-bold text-slate-700">
                  Harga Coret (Opsional)
                </label>
                <div class="relative">
                  <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-600">Rp</span>
                  <input
                    type="number"
                    id="originalPrice"
                    name="originalPrice"
                    min="0"
                    step="500"
                    placeholder="20000"
                    class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg p-2.5 pl-9 text-xs sm:text-sm font-mono text-slate-900 placeholder:text-slate-500 focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 transition"
                  />
                </div>
              </div>

              <div class="space-y-1.5">
                <label for="shopeeUrl" class="block text-xs font-bold text-slate-700">
                  Link Toko Online (Opsional)
                </label>
                <input
                  type="url"
                  id="shopeeUrl"
                  name="shopeeUrl"
                  placeholder="https://shopee.co.id/..."
                  class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs sm:text-sm text-slate-900 placeholder:text-slate-500 focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 transition"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-1.5">
                <label for="stockStatus" class="block text-xs font-bold text-slate-700">
                  Status Stok <span class="text-rose-600">*</span>
                </label>
                <select
                  id="stockStatus"
                  name="stockStatus"
                  required
                  class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs sm:text-sm font-semibold text-slate-900 focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 cursor-pointer transition"
                >
                  <option value="ready" selected>Ready Stock</option>
                  <option value="po">Pre-Order</option>
                  <option value="sold_out">Habis</option>
                </select>
              </div>

              <div class="space-y-1.5">
                <label for="productionCapacity" class="block text-xs font-bold text-slate-700">
                  Kapasitas / Estimasi (Opsional)
                </label>
                <input
                  type="text"
                  id="productionCapacity"
                  name="productionCapacity"
                  placeholder="Contoh: 50 bungkus/hari atau PO 2 hari"
                  class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs sm:text-sm text-slate-900 placeholder:text-slate-500 focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 transition"
                />
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="description" class="block text-xs font-bold text-slate-700">
                Deskripsi Produk <span class="text-rose-600">*</span>
              </label>
              <textarea
                id="description"
                name="description"
                required
                rows="4"
                placeholder="Jelaskan rasa, komposisi, berat bersih, varian, dan pengiriman..."
                class="w-full bg-white border border-slate-300 rounded-lg p-3 text-xs sm:text-sm text-slate-900 placeholder:text-slate-500 focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 transition"
              ></textarea>
            </div>
          </div>

          {/* Section: Foto Produk (Multi-Foto hingga 4 foto) */}
          <div class="space-y-4 pt-2">
            <div class="pb-2 border-b border-slate-200 flex items-center justify-between">
              <h2 class="text-xs font-black uppercase tracking-wider text-slate-800 flex items-center gap-2">
                <AppIcon name="camera" size="xs" class="text-slate-600" />
                <span>Foto Produk (Maks. 4)</span>
              </h2>
              <span id="photo-counter" class="text-xs font-semibold text-slate-600 font-mono tabular-nums">0 / 4</span>
            </div>

            <div class="space-y-3">
              <div id="upload-boxes" class="flex flex-col sm:flex-row gap-3">
                <label for="imageInput" class="flex-1 min-h-[44px] border-2 border-dashed border-slate-300 hover:border-emerald-600 rounded-lg p-4 text-center cursor-pointer transition bg-white hover:bg-slate-50 group">
                  <input type="file" id="imageInput" accept="image/*" multiple class="sr-only" />
                  <div class="space-y-1 flex flex-col items-center">
                    <AppIcon name="upload" size="lg" class="text-slate-600 group-hover:text-emerald-700 transition" />
                    <span class="text-xs font-bold text-slate-800 group-hover:text-emerald-700">Pilih dari Galeri</span>
                    <span class="text-xs text-slate-600">JPG, PNG, WebP</span>
                  </div>
                </label>

                <label for="cameraInput" class="flex-1 min-h-[44px] border-2 border-dashed border-slate-300 hover:border-emerald-600 rounded-lg p-4 text-center cursor-pointer transition bg-white hover:bg-slate-50 group">
                  <input type="file" id="cameraInput" accept="image/*" capture="environment" class="sr-only" />
                  <div class="space-y-1 flex flex-col items-center">
                    <AppIcon name="camera" size="lg" class="text-slate-600 group-hover:text-emerald-700 transition" />
                    <span class="text-xs font-bold text-slate-800 group-hover:text-emerald-700">Kamera Langsung</span>
                    <span class="text-xs text-slate-600">Foto langsung produk</span>
                  </div>
                </label>
              </div>

              <p id="compress-status" class="hidden text-xs font-semibold text-emerald-700 animate-pulse"></p>

              <div id="photos-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-3"></div>
            </div>
          </div>

          <label for="productPrivacyConsent" class="flex items-start gap-2.5 pt-2 cursor-pointer text-xs text-slate-700">
            <input
              type="checkbox"
              id="productPrivacyConsent"
              required
              class="mt-0.5 w-4 h-4 accent-emerald-700 shrink-0 rounded border-slate-300"
            />
            <span>
              Saya menyetujui <a href="/privasi" target="_blank" class="text-emerald-700 font-semibold underline">Kebijakan Privasi Mamasar</a> dan memastikan data produk serta nomor WhatsApp usaha ini benar untuk ditampilkan di direktori publik.
            </span>
          </label>

          {/* Action Buttons */}
          <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
            <a
              href="/"
              class="w-full sm:w-auto min-h-[44px] inline-flex items-center justify-center px-5 py-2.5 text-xs font-bold text-slate-700 hover:text-slate-900 border border-slate-300 rounded-lg text-center hover:bg-slate-50 transition"
            >
              Batal
            </a>

            <button
              type="submit"
              id="btn-submit-product"
              class="w-full sm:w-auto min-h-[44px] px-6 py-2.5 bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] disabled:opacity-50 text-white font-bold text-xs sm:text-sm rounded-lg transition flex items-center justify-center cursor-pointer"
            >
              Terbitkan
            </button>
          </div>
        </form>

        {/* Right Docked Sidebar: Live Card Preview (Desktop) + Checklist & Collapsible Tips */}
        <aside class="lg:col-span-4 space-y-6 border-t border-slate-200 pt-6 lg:border-t-0 lg:pt-0 lg:border-l lg:border-slate-200 lg:pl-8 lg:sticky lg:top-20">
          {/* Live Katalog Preview (Hidden on Mobile to Keep Form Compact) */}
          <section aria-labelledby="preview-heading" class="hidden lg:block space-y-3">
            <div class="flex items-center justify-between">
              <h2 id="preview-heading" class="text-xs font-black uppercase tracking-wider text-slate-800">
                Pratinjau Katalog
              </h2>
              <span class="text-xs text-slate-600">Otomatis</span>
            </div>

            <div class="bg-white border border-slate-200 rounded-lg overflow-hidden" aria-hidden="true">
              <div class="relative aspect-4/3 bg-slate-100 overflow-hidden">
                <img
                  id="preview-img"
                  src={DEFAULT_PRODUCT_IMAGE}
                  alt=""
                  width="400"
                  height="300"
                  class="w-full h-full object-cover"
                />

                <span
                  id="preview-stock-badge"
                  class="hidden absolute top-2.5 left-2.5 text-xs font-bold px-2 py-0.5 rounded-md shadow-xs"
                ></span>

                <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent pt-7 pb-2.5 px-3 flex items-end justify-between gap-2">
                  <div class="flex items-baseline gap-1.5 flex-wrap">
                    <span id="preview-price" class="text-sm sm:text-base font-extrabold tracking-tight text-white font-mono tabular-nums">
                      Rp 16.000
                    </span>
                    <span id="preview-original-price" class="hidden text-xs text-slate-200 line-through font-mono tabular-nums"></span>
                  </div>
                  <span id="preview-photo-count" class="text-xs font-semibold text-white bg-black/50 px-2 py-0.5 rounded-md font-mono tabular-nums shrink-0">
                    1 foto
                  </span>
                </div>
              </div>

              <div class="p-3.5 space-y-2">
                <div class="flex items-center justify-between gap-2 text-xs text-slate-600">
                  <span id="preview-category" class="font-semibold text-emerald-800 truncate">Kategori Produk</span>
                  <span class="truncate text-slate-500">{userStore?.zone_name || 'Sumenep'}</span>
                </div>

                <p id="preview-title" class="font-bold text-sm text-slate-900 line-clamp-2 leading-snug">
                  Keripik Pisang Madu 250gr
                </p>

                <div class="pt-2 border-t border-slate-100 flex items-center justify-between gap-2 text-xs text-slate-600">
                  <span class="truncate font-medium text-slate-700">{userStore?.name || 'Nama Toko Anda'}</span>
                  <span class="shrink-0 px-2.5 py-1 rounded-md bg-emerald-700 text-white font-bold">
                    WhatsApp
                  </span>
                </div>
              </div>
            </div>
          </section>

          {/* Checklist Kelengkapan Live */}
          <section aria-labelledby="checklist-heading" class="lg:pt-5 lg:border-t lg:border-slate-200 space-y-2.5">
            <h2 id="checklist-heading" class="text-xs font-black uppercase tracking-wider text-slate-800">
              Kelengkapan Iklan
            </h2>
            <ul class="grid grid-cols-2 gap-2 text-xs" id="readiness-list">
              <li id="chk-title" class="flex items-center gap-1.5 text-slate-600">
                <span class="w-2 h-2 rounded-full bg-slate-300 shrink-0" data-dot></span>
                <span>Nama produk</span>
              </li>
              <li id="chk-category" class="flex items-center gap-1.5 text-slate-600">
                <span class="w-2 h-2 rounded-full bg-slate-300 shrink-0" data-dot></span>
                <span>Kategori</span>
              </li>
              <li id="chk-price" class="flex items-center gap-1.5 text-slate-600">
                <span class="w-2 h-2 rounded-full bg-slate-300 shrink-0" data-dot></span>
                <span>Harga valid</span>
              </li>
              <li id="chk-photo" class="flex items-center gap-1.5 text-slate-600">
                <span class="w-2 h-2 rounded-full bg-slate-300 shrink-0" data-dot></span>
                <span>Foto produk</span>
              </li>
            </ul>
          </section>

          {/* Tips Input (Collapsible on Mobile, Auto-Open on Desktop) */}
          <details id="tips-input-details" class="pt-5 border-t border-slate-200 group">
            <summary class="min-h-[44px] flex items-center justify-between cursor-pointer list-none select-none text-xs font-black uppercase tracking-wider text-slate-800">
              <span class="flex items-center gap-1.5">
                <AppIcon name="info" size="xs" class="text-emerald-700" />
                <span>Tips Input Produk</span>
              </span>
              <AppIcon name="chevron-down" size="xs" class="text-slate-500 transition-transform group-open:rotate-180 lg:hidden" />
            </summary>
            <ul class="mt-2 divide-y divide-slate-100 text-xs text-slate-700">
              <li class="py-2 first:pt-0 space-y-0.5">
                <strong class="text-slate-900 block">Judul spesifik</strong>
                <span>Cantumkan nama, varian, dan berat bersih (mis. 250gr / 1 liter).</span>
              </li>
              <li class="py-2 space-y-0.5">
                <strong class="text-slate-900 block">Foto pencahayaan cukup</strong>
                <span>Foto pertama otomatis tampil di sampul katalog; tambahkan detail kemasan.</span>
              </li>
              <li class="py-2 space-y-0.5">
                <strong class="text-slate-900 block">Harga transparan</strong>
                <span>Isi Harga Coret hanya bila produk sedang promo, dengan nilai di atas harga jual.</span>
              </li>
              <li class="py-2 last:pb-0 space-y-0.5">
                <strong class="text-slate-900 block">Deskripsi jelas</strong>
                <span>Sebutkan bahan, daya tahan, minimal pesan, dan area antar sekitar.</span>
              </li>
            </ul>
          </details>
        </aside>
      </div>
    </div>
  </div>

  <script>
    const productForm = document.getElementById('product-form') as HTMLFormElement | null;
    const alertBox = document.getElementById('form-alert');

    // Product Multi-Photo State (up to 4 photos)
    let photos: string[] = [];
    const imageInput = document.getElementById('imageInput') as HTMLInputElement | null;
    const cameraInput = document.getElementById('cameraInput') as HTMLInputElement | null;
    const base64Input = document.getElementById('productImageBase64') as HTMLInputElement | null;
    const galleryImagesInput = document.getElementById('galleryImagesInput') as HTMLInputElement | null;
    const photosGrid = document.getElementById('photos-grid');
    const photoCounter = document.getElementById('photo-counter');
    const uploadBoxes = document.getElementById('upload-boxes');
    const compressStatusEl = document.getElementById('compress-status');
    const btnSubmitProduct = document.getElementById('btn-submit-product') as HTMLButtonElement | null;

    function showAlert(msg: string, isError = false) {
      if (!alertBox) return;
      alertBox.textContent = msg;
      alertBox.classList.remove('hidden', 'bg-rose-50', 'text-rose-900', 'border-rose-200', 'bg-emerald-50', 'text-emerald-900', 'border-emerald-200');
      if (isError) {
        alertBox.classList.add('bg-rose-50', 'text-rose-900', 'border', 'border-rose-200');
      } else {
        alertBox.classList.add('bg-emerald-50', 'text-emerald-900', 'border', 'border-emerald-200');
      }
      alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function syncHiddenInputs() {
      if (photos.length > 0) {
        if (base64Input) base64Input.value = photos[0];
        if (galleryImagesInput) galleryImagesInput.value = JSON.stringify(photos.slice(1));
      } else {
        if (base64Input) base64Input.value = '';
        if (galleryImagesInput) galleryImagesInput.value = '[]';
      }
      renderPhotosGrid();
    }

    function renderPhotosGrid() {
      if (!photosGrid) return;
      photosGrid.innerHTML = '';

      if (photoCounter) {
        photoCounter.textContent = `${photos.length} / 4`;
      }

      if (uploadBoxes) {
        if (photos.length >= 4) {
          uploadBoxes.classList.add('hidden');
        } else {
          uploadBoxes.classList.remove('hidden');
        }
      }

      photos.forEach((dataUrl, idx) => {
        const item = document.createElement('div');
        item.className = 'relative group rounded-xl overflow-hidden border border-slate-200 bg-slate-50 aspect-square flex items-center justify-center';

        const img = document.createElement('img');
        img.src = dataUrl;
        img.alt = `Foto ${idx + 1}`;
        img.className = 'w-full h-full object-cover';
        item.appendChild(img);

        const badge = document.createElement('span');
        badge.className = `absolute bottom-1.5 left-1.5 text-xs font-bold px-1.5 py-0.5 rounded shadow-xs ${
          idx === 0 ? 'bg-emerald-700 text-white' : 'bg-slate-900/80 text-white backdrop-blur-xs'
        }`;
        badge.textContent = idx === 0 ? 'Foto Utama' : `Foto ${idx + 1}`;
        item.appendChild(badge);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'absolute top-1.5 right-1.5 w-7 h-7 rounded-md bg-rose-700 hover:bg-rose-800 text-white flex items-center justify-center shadow-sm cursor-pointer transition';
        removeBtn.setAttribute('aria-label', `Hapus foto ${idx + 1}`);
        removeBtn.innerHTML = '<svg viewBox="0 0 24 24" class="w-3.5 h-3.5 stroke-current" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12"/></svg>';
        removeBtn.onclick = (e) => {
          e.preventDefault();
          photos.splice(idx, 1);
          syncHiddenInputs();
        };
        item.appendChild(removeBtn);

        photosGrid.appendChild(item);
      });

      updatePreview();
    }

    function compressFileToDataUrl(file: File): Promise<string> {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            const maxDim = 1200;
            let w = img.width;
            let h = img.height;

            if (w > maxDim || h > maxDim) {
              if (w > h) {
                h = Math.round((h * maxDim) / w);
                w = maxDim;
              } else {
                w = Math.round((w * maxDim) / h);
                h = maxDim;
              }
            }

            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext('2d');
            ctx?.drawImage(img, 0, 0, w, h);

            resolve(canvas.toDataURL('image/jpeg', 0.82));
          };
          img.onerror = reject;
          img.src = e.target?.result as string;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    async function handleFiles(files: FileList | null) {
      if (!files || files.length === 0) return;
      const remainingSlots = 4 - photos.length;
      if (remainingSlots <= 0) {
        showAlert('Maksimal 4 foto per produk telah tercapai.', true);
        return;
      }

      const filesToProcess = Array.from(files).slice(0, remainingSlots);
      if (compressStatusEl) {
        compressStatusEl.textContent = `Mengompres ${filesToProcess.length} foto otomatis...`;
        compressStatusEl.classList.remove('hidden');
      }

      for (const file of filesToProcess) {
        try {
          const dataUrl = await compressFileToDataUrl(file);
          if (photos.length < 4) {
            photos.push(dataUrl);
          }
        } catch (err) {
          console.error('Failed to compress image:', err);
        }
      }

      if (compressStatusEl) compressStatusEl.classList.add('hidden');
      syncHiddenInputs();
    }

    imageInput?.addEventListener('change', () => {
      handleFiles(imageInput.files);
      imageInput.value = '';
    });

    cameraInput?.addEventListener('change', () => {
      handleFiles(cameraInput.files);
      cameraInput.value = '';
    });

    const DRAFT_KEY = 'mamasar_ad_draft';
    const draftFields = ['productName', 'category', 'price', 'originalPrice', 'shopeeUrl', 'stockStatus', 'productionCapacity', 'description'];

    function saveAdDraft() {
      try {
        const draft: Record<string, string> = {};
        for (const id of draftFields) {
          const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
          if (el) draft[id] = el.value;
        }
        localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
      } catch {}
    }

    function restoreAdDraft() {
      try {
        const raw = localStorage.getItem(DRAFT_KEY);
        if (!raw) return;
        const draft = JSON.parse(raw) as Record<string, string>;
        for (const id of draftFields) {
          const el = document.getElementById(id) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
          if (el && typeof draft[id] === 'string' && draft[id] !== '') {
            el.value = draft[id];
          }
        }
      } catch {}
    }

    const previewImg = document.getElementById('preview-img') as HTMLImageElement | null;
    const defaultPreviewImg = previewImg?.getAttribute('src') || '';
    const previewStockBadge = document.getElementById('preview-stock-badge');
    const previewPrice = document.getElementById('preview-price');
    const previewOriginalPrice = document.getElementById('preview-original-price');
    const previewPhotoCount = document.getElementById('preview-photo-count');
    const previewCategory = document.getElementById('preview-category');
    const previewTitle = document.getElementById('preview-title');

    function setChecklistState(itemId: string, done: boolean) {
      const item = document.getElementById(itemId);
      if (!item) return;
      const dot = item.querySelector('[data-dot]');
      if (dot) {
        dot.classList.toggle('bg-emerald-600', done);
        dot.classList.toggle('bg-slate-300', !done);
      }
      item.classList.toggle('text-emerald-800', done);
      item.classList.toggle('font-semibold', done);
      item.classList.toggle('text-slate-600', !done);
    }

    function updatePreview() {
      const nameVal = (document.getElementById('productName') as HTMLInputElement | null)?.value.trim() || '';
      const categoryVal = (document.getElementById('category') as HTMLSelectElement | null)?.value.trim() || '';
      const rawPrice = (document.getElementById('price') as HTMLInputElement | null)?.value || '';
      const rawOriginal = (document.getElementById('originalPrice') as HTMLInputElement | null)?.value || '';
      const stockVal = (document.getElementById('stockStatus') as HTMLSelectElement | null)?.value || 'ready';

      const priceNum = Number(rawPrice);
      const originalNum = Number(rawOriginal);
      const hasValidPrice = Number.isFinite(priceNum) && priceNum > 0;

      if (previewImg) {
        previewImg.src = photos.length > 0 ? photos[0] : defaultPreviewImg;
      }

      if (previewStockBadge) {
        if (stockVal === 'po') {
          previewStockBadge.textContent = 'Pre-Order';
          previewStockBadge.className = 'text-[10px] font-bold px-2 py-0.5 rounded bg-amber-500 text-white shadow-sm';
        } else if (stockVal === 'sold_out') {
          previewStockBadge.textContent = 'Habis';
          previewStockBadge.className = 'text-[10px] font-bold px-2 py-0.5 rounded bg-rose-600 text-white shadow-sm';
        } else {
          previewStockBadge.textContent = '';
          previewStockBadge.className = 'hidden';
        }
      }

      if (previewPrice) {
        previewPrice.textContent = hasValidPrice
          ? `Rp ${priceNum.toLocaleString('id-ID')}`
          : 'Rp 16.000';
      }

      if (previewOriginalPrice) {
        if (hasValidPrice && Number.isFinite(originalNum) && originalNum > priceNum) {
          previewOriginalPrice.textContent = `Rp ${originalNum.toLocaleString('id-ID')}`;
          previewOriginalPrice.classList.remove('hidden');
        } else {
          previewOriginalPrice.textContent = '';
          previewOriginalPrice.classList.add('hidden');
        }
      }

      if (previewPhotoCount) {
        previewPhotoCount.textContent = `${photos.length} foto`;
      }

      if (previewCategory) {
        previewCategory.textContent = categoryVal || 'Kategori Produk';
      }

      if (previewTitle) {
        previewTitle.textContent = nameVal || 'Keripik Pisang Madu 250gr';
      }

      setChecklistState('chk-title', nameVal.length >= 3);
      setChecklistState('chk-category', Boolean(categoryVal));
      setChecklistState('chk-price', hasValidPrice);
      setChecklistState('chk-photo', photos.length > 0);
    }

    restoreAdDraft();
    updatePreview();
    for (const id of draftFields) {
      document.getElementById(id)?.addEventListener('input', () => {
        saveAdDraft();
        updatePreview();
      });
      document.getElementById(id)?.addEventListener('change', () => {
        saveAdDraft();
        updatePreview();
      });
    }

    // Submit Iklan Produk
    productForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (btnSubmitProduct) {
        btnSubmitProduct.disabled = true;
        btnSubmitProduct.innerHTML = '<span>Menerbitkan Produk...</span>';
      }

      try {
        const formData = new FormData(productForm);
        const res = await fetch('/api/products', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json();

        if (res.ok && data.success) {
          try {
            localStorage.removeItem(DRAFT_KEY);
          } catch {}
          showAlert('Alhamdulillah! Iklan produk berhasil diterbitkan. Mengalihkan ke halaman produk...', false);
          setTimeout(() => {
            window.location.href = `/produk/${data.slug}`;
          }, 900);
        } else {
          if (res.status === 401) {
            showAlert('Sesi Anda belum aktif. Silakan masuk terlebih dahulu dengan Google/Email.', true);
            setTimeout(() => {
              window.location.href = '/dashboard';
            }, 1800);
          } else {
            showAlert(data.message || 'Gagal menerbitkan produk. Silakan periksa kembali formulir.', true);
          }
        }
      } catch (err: any) {
        showAlert(err.message || 'Terjadi gangguan koneksi internet. Silakan coba kembali.', true);
      } finally {
        if (btnSubmitProduct) {
          btnSubmitProduct.disabled = false;
          btnSubmitProduct.innerHTML = '<span>Terbitkan</span>';
        }
      }
    });

    const tipsDetails = document.getElementById('tips-input-details') as HTMLDetailsElement | null;
    if (tipsDetails && window.matchMedia('(min-width: 1024px)').matches) {
      tipsDetails.open = true;
    }
  </script>
</Layout>
