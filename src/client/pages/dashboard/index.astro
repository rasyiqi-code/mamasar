---
import AppLayout from '../../layouts/AppLayout.astro';
import {
  getUMKMByUserId,
  getAllZones,
  getCashbookSummary,
  getCashbookEntries,
  getAdOrdersByUmkm,
  getBumpLedgerByUmkm,
  getNotificationsForUser,
  isSuperadmin,
  isPetugas,
} from '../../../lib/db';
import { resolveUser } from '../../../lib/neon-auth';
import { resolveAvatarUrl } from '../../../lib/storage';

import AuthCard from '../../components/dashboard/AuthCard.astro';
import StoreSetupCard from '../../components/dashboard/StoreSetupCard.astro';
import DashboardSidebar from '../../components/dashboard/DashboardSidebar.astro';
import ProductsPanel from '../../components/dashboard/ProductsPanel.astro';
import CashbookPanel from '../../components/dashboard/CashbookPanel.astro';
import ProfilePanel from '../../components/dashboard/ProfilePanel.astro';
import ServicesPanel from '../../components/dashboard/ServicesPanel.astro';
import ProductModals from '../../components/dashboard/ProductModals.astro';
import AdPromotionModal from '../../components/dashboard/AdPromotionModal.astro';
import AppIcon from '../../components/common/AppIcon.astro';

const user = await resolveUser(Astro.request);
const store = user ? await getUMKMByUserId(user.id) : undefined;
const zones = await getAllZones();
const avatarUrl = await resolveAvatarUrl(user?.avatar_url);

const cashbookSummary = user
  ? await getCashbookSummary(user.id, store?.id)
  : { totalIncome: 0, totalExpense: 0, balance: 0 };
const cashbookEntries = user ? await getCashbookEntries(user.id, 50, store?.id) : [];
const adOrders = store ? await getAdOrdersByUmkm(store.id) : [];
const bumpLedger = store ? await getBumpLedgerByUmkm(store.id, 10) : [];
const notifications = user ? await getNotificationsForUser(user.id, 5) : [];

const authError = Astro.url.searchParams.get('error');
const isLoggedOut = Astro.url.searchParams.get('logged_out') === '1';
const intent = Astro.url.searchParams.get('intent');
const initialOnboardTab = intent === 'daftar-kader' ? 'kader' : 'store';
const isSuper = isSuperadmin(user);
const isCadre = isPetugas(user);
const assignedZone = user ? zones.find((z) => z.id === user.assigned_zone_id) : undefined;
---

<AppLayout
  title={user ? (store ? `Dashboard Toko: ${store.name} | Mamasar` : `Akun & Pendaftaran Peran: ${user.name} | Mamasar`) : 'Masuk atau Daftar Akun | Mamasar'}
  description="Portal swalayan pemilik UMKM Nahdliyin, Kader Ranting, Pengurus MWC, dan Admin PCNU Sumenep."
>
  <!-- Banner Akses Terbatas /admin -->
  {user && authError === 'unauthorized_admin' && (
    <div role="alert" class="bg-amber-50 border-b border-amber-300 px-4 py-3 text-xs text-amber-950">
      <div class="max-w-5xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <p class="font-semibold">
          Halaman Portal Admin & Kader (<code>/admin</code>) khusus untuk Kader Ranting, Pengurus MWC, atau Admin PCNU yang sudah disetujui.
        </p>
        <a href="/petugas" class="shrink-0 font-bold text-emerald-800 underline hover:text-emerald-900 inline-flex items-center gap-1">
          <span>Ajukan Peran Kader MWC</span>
          <AppIcon name="arrow-right" size="xs" />
        </a>
      </div>
    </div>
  )}

  <!-- KONDISI 1: Belum Login -->
  {!user && <AuthCard authError={authError} isLoggedOut={isLoggedOut} intent={intent} />}

  <!-- KONDISI 2: Sudah Login, Belum Punya Profil Toko -->
  {user && !store && (
    <StoreSetupCard
      user={user}
      zones={zones}
      assignedZone={assignedZone}
      isSuper={isSuper}
      isCadre={isCadre}
      initialTab={initialOnboardTab}
    />
  )}

  <!-- KONDISI 3: Workspace Toko Siap (/my-skill Shell, 1080px Max Width) -->
  {user && store && (
    <div class="min-h-screen bg-white flex flex-col">
      {/* Desktop Top Utility Bar (Full-bleed hairline, inner max-w-site aligned) */}
      <header class="hidden md:block sticky top-0 z-30 bg-white/95 backdrop-blur-xs border-b border-slate-200">
        <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-4">
          <div class="flex items-center gap-3 min-w-0">
            <a href="/" class="flex items-center gap-2 shrink-0 group">
              <span class="w-7 h-7 rounded-lg bg-emerald-700 text-white font-extrabold text-xs flex items-center justify-center group-hover:bg-emerald-800 transition">
                NU
              </span>
              <span class="font-bold text-sm text-slate-900">Mamasar</span>
            </a>
            <span class="text-slate-300" aria-hidden="true">/</span>
            <span class="text-xs font-medium text-slate-600 truncate">Dashboard Toko · {store.name}</span>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <a
              href={`/toko/${store.slug || store.id}`}
              target="_blank"
              class="min-h-[38px] px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700 transition inline-flex items-center gap-1.5"
            >
              <span>Etalase Toko</span>
              <AppIcon name="external-link" size="xs" />
            </a>
            <a
              href="/pasang-iklan"
              class="min-h-[38px] px-3.5 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold transition inline-flex items-center gap-1.5"
            >
              <AppIcon name="plus" size="xs" />
              <span>Pasang Iklan</span>
            </a>
          </div>
        </div>
      </header>

      <div class="flex-1 w-full max-w-site mx-auto md:px-6 lg:px-8 flex flex-col md:flex-row">
        <!-- Sidebar Navigasi -->
        <DashboardSidebar
          user={user}
          store={store}
          avatarUrl={avatarUrl}
          isSuper={isSuper}
          isCadre={isCadre}
          productCount={store.products?.length || 0}
          cashbookCount={cashbookEntries.length}
        />

        <!-- Workspace Utama -->
        <main id="main" tabindex="-1" class="flex-1 min-w-0 py-5 px-4 sm:px-6 md:py-7 md:pl-8 md:pr-0 space-y-6">
          <h1 class="sr-only">Dashboard Toko {store.name}</h1>

          <!-- Status Notification Box -->
          <div id="action-status" role="status" aria-live="polite" class="hidden p-3 rounded-lg text-xs font-semibold"></div>

          <!-- Tab 1: Katalog Produk -->
          <ProductsPanel
            store={store}
            adOrders={adOrders}
            bumpLedger={bumpLedger}
            notifications={notifications}
          />

          <!-- Tab 2: Buku Kas Usaha -->
          <CashbookPanel
            summary={cashbookSummary}
            entries={cashbookEntries}
            products={store.products}
          />

          <!-- Tab 3: Profil Usaha -->
          <ProfilePanel store={store} zones={zones} />

          <!-- Tab 4: Layanan Kemitraan & Kaderisasi -->
          <ServicesPanel
            user={user}
            zones={zones}
            assignedZone={zones.find((z) => z.id === user.assigned_zone_id)}
          />
        </main>
      </div>

      <!-- Modal Dialogs -->
      <ProductModals />
      <AdPromotionModal store={store} />
    </div>
  )}

  <style is:global>
    .nav-tab-btn {
      color: #475569;
      border: 1px solid transparent;
      transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    .nav-tab-btn:hover {
      background-color: #f8fafc;
      color: #0f172a;
    }
    .nav-tab-btn.active {
      background-color: #ecfdf5;
      color: #064e3b;
      border-color: #a7f3d0;
      font-weight: 600;
    }
    .nav-tab-btn.active .nav-badge,
    .nav-tab-btn.active span[class*="text-xs"] {
      background-color: #d1fae5;
      color: #065f46;
      border-color: transparent;
    }
  </style>

  {isLoggedOut && (
    <script is:inline>
      try { localStorage.removeItem('mamasar_favorites'); } catch {}
    </script>
  )}
  <script src="../../scripts/dashboard.client.ts"></script>
</AppLayout>
