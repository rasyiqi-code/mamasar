---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import AppIcon from '../components/common/AppIcon.astro';
import EmptyState from '../components/common/EmptyState.astro';
import {
  getAllZones,
  getProducts,
  getProductsCount,
  getMostFavoritedProducts,
  getAllUMKM,
  getArticles,
  getUserFromSession,
  getUserFavoriteIds,
} from '../../lib/db';
import {
  PRODUCT_CATEGORIES,
  CATEGORY_ICONS,
  CATEGORY_BADGES,
  POPULAR_TAGS,
  DEFAULT_PRODUCT_IMAGE,
} from '../../lib/constants';
import { getOptimizedImageUrl } from '../../lib/utils';

const url = new URL(Astro.request.url);
const currentZone = url.searchParams.get('zona') || 'semua';
const currentCategory = url.searchParams.get('kategori') || 'semua';
const currentStock = url.searchParams.get('stok') || 'semua';
const currentVerified = url.searchParams.get('terverifikasi') || '0';
const searchQuery = url.searchParams.get('q') || '';
const currentSort = url.searchParams.get('sort') || 'newest';
const PAGE_SIZE = 15;
const requestedPage = Number.parseInt(url.searchParams.get('page') || '1', 10);
const currentPage = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;

const zones = await getAllZones();
const sellers = await getAllUMKM();
const articles = await getArticles();

const filterOptions = {
  zoneSlug: currentZone,
  category: currentCategory,
  search: searchQuery,
  stockStatus: currentStock,
  sort: currentSort,
  verifiedOnly: currentVerified === '1',
};

const totalProducts = await getProductsCount(filterOptions);
const totalPages = Math.max(1, Math.ceil(totalProducts / PAGE_SIZE));
const safePage = Math.min(currentPage, totalPages);
const offset = (safePage - 1) * PAGE_SIZE;

const products = await getProducts({
  ...filterOptions,
  limit: PAGE_SIZE,
  offset,
});

const verifiedSellers = [...sellers].sort(
  (a, b) =>
    Number(Boolean(b.is_verified)) - Number(Boolean(a.is_verified)) ||
    b.product_count - a.product_count
);

const isFiltered =
  currentZone !== 'semua' ||
  currentCategory !== 'semua' ||
  searchQuery !== '' ||
  currentStock !== 'semua' ||
  currentVerified === '1';

const showDiscoverySections = !isFiltered && safePage === 1;

const spotlightProducts = showDiscoverySections
  ? (await getProducts({ limit: 4, sort: 'newest' })).slice(0, 4)
  : [];

const popularProducts = showDiscoverySections ? await getMostFavoritedProducts(4) : [];

const sessionCookie = Astro.cookies.get('mamasar_session')?.value;
const sessionUser = sessionCookie && showDiscoverySections ? await getUserFromSession(sessionCookie) : null;
const ssrFavCount = sessionUser ? (await getUserFavoriteIds(sessionUser.id)).length : null;

function buildFilterUrl(updates: Record<string, string | null>) {
  const params = new URLSearchParams(url.searchParams);
  if (!('page' in updates)) {
    params.delete('page');
  }
  for (const [key, val] of Object.entries(updates)) {
    if (val === null || val === 'semua' || val === '' || val === '0' || (key === 'page' && val === '1')) {
      params.delete(key);
    } else {
      params.set(key, val);
    }
  }
  const str = params.toString();
  return str ? `/?${str}#katalog-terbaru` : `/#katalog-terbaru`;
}
---

<Layout
  title="Mamasar | Direktori Iklan UMKM Sumenep"
  noindex={isFiltered || safePage > 1}
  canonicalUrl={`${Astro.url.origin}/`}
>
  <div class="space-y-6 sm:space-y-12 py-2 sm:py-6">

    <!-- HERO SEARCH & CATEGORY STRIP -->
    <section class="text-center space-y-3.5 sm:space-y-5 pt-1 sm:pt-4 px-3 sm:px-0">
      <div class="space-y-1.5 sm:space-y-2">
        <h1 class="text-xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-snug">
          Mau beli apa dari <span class="text-emerald-700 underline decoration-emerald-300">warga NU?</span>
        </h1>
        <p class="hidden sm:block text-xs sm:text-sm text-slate-600 max-w-xl mx-auto">
          Temukan produk asli warga nahdliyin se-Kabupaten Sumenep. Transaksi langsung via WhatsApp tanpa komisi perantara.
        </p>
      </div>

      <form
        method="GET"
        action="/"
        class="max-w-3xl mx-auto bg-white border border-slate-300 rounded-2xl p-1.5 sm:p-2 shadow-sm flex flex-wrap sm:flex-nowrap items-center gap-1.5 sm:gap-2"
      >
        <div class="order-2 basis-full sm:basis-auto sm:order-1 sm:w-56 relative border-t sm:border-t-0 sm:border-r border-slate-200 pt-1 sm:pt-0 shrink-0">
          <select
            name="zona"
            aria-label="Pilih Wilayah MWC"
            class="w-full min-h-[40px] sm:min-h-[44px] appearance-none bg-transparent pl-8 pr-7 py-1.5 sm:py-2.5 text-xs sm:text-sm font-bold text-slate-800 cursor-pointer"
          >
            <option value="semua" class="bg-white text-slate-900">Semua Wilayah MWC</option>
            {zones.map((z) => (
              <option value={z.slug} selected={currentZone === z.slug} class="bg-white text-slate-900">
                {z.name}
              </option>
            ))}
          </select>
          <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-emerald-700 pointer-events-none flex items-center">
            <AppIcon name="map-pin" size="xs" />
          </span>
          <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none flex items-center">
            <AppIcon name="chevron-down" size="xs" />
          </span>
        </div>

        <div class="order-1 sm:order-2 relative flex-1 min-w-0">
          <input
            type="text"
            id="hero-q"
            name="q"
            value={searchQuery}
            aria-label="Kata kunci produk"
            placeholder="Cari rengginang, batik, petis..."
            class="w-full min-h-[44px] py-2 sm:py-2.5 px-2.5 sm:px-3 text-xs sm:text-sm text-slate-900 placeholder-slate-500 bg-transparent focus:outline-none"
          />
          {searchQuery && (
            <a
              href={buildFilterUrl({ q: null })}
              aria-label="Hapus kata kunci"
              class="absolute right-1 top-1/2 -translate-y-1/2 min-w-[40px] min-h-[40px] text-slate-500 hover:text-slate-900 font-bold text-xs flex items-center justify-center"
            >
              <AppIcon name="close" size="xs" />
            </a>
          )}
        </div>

        <button
          type="submit"
          class="order-1 sm:order-3 w-auto min-h-[44px] bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold text-xs sm:text-sm px-4 sm:px-7 py-2.5 rounded-xl transition flex items-center justify-center gap-1.5 sm:gap-2 shrink-0 cursor-pointer shadow-xs active:scale-98"
        >
          <AppIcon name="search" size="xs" />
          <span>Cari</span>
        </button>
      </form>

      <div
        id="hero-popular-tags"
        class={`${searchQuery ? 'flex' : 'hidden sm:flex'} flex-wrap items-center justify-center gap-1.5 sm:gap-2 text-xs text-slate-600 max-w-2xl mx-auto`}
      >
        <span class="font-bold text-slate-500">Populer:</span>
        {POPULAR_TAGS.map((tag) => (
          <a
            href={`/?q=${encodeURIComponent(tag)}`}
            class="bg-white hover:bg-emerald-50 border border-slate-200 text-slate-700 hover:text-emerald-800 px-3 py-1 rounded-full transition shadow-2xs"
          >
            {tag}
          </a>
        ))}
      </div>

      <div class="pt-1 sm:pt-2 max-w-5xl mx-auto">
        <div class="text-left text-xs font-bold uppercase tracking-wider text-slate-600 mb-2 sm:mb-3 px-1 sm:px-0">
          Kategori Iklan
        </div>
        <div class="flex items-start sm:items-center justify-start sm:justify-center gap-2.5 sm:gap-6 overflow-x-auto pb-1.5 sm:pb-2 no-scrollbar px-1 sm:px-0">
          <a
            href={`/?kategori=semua${currentZone !== 'semua' ? `&zona=${currentZone}` : ''}`}
            class="group flex flex-col items-center gap-1.5 sm:gap-2 shrink-0 text-center"
          >
            <div
              class={`relative w-12 h-12 sm:w-16 sm:h-16 rounded-full flex items-center justify-center transition border-2 ${
                currentCategory === 'semua'
                  ? 'bg-emerald-50 border-emerald-700 text-emerald-800 shadow-sm'
                  : 'bg-white border-slate-200 text-slate-700 group-hover:border-emerald-400 group-hover:scale-105 shadow-2xs'
              }`}
            >
              <AppIcon name="shopping-bag" size="md" class={`sm:scale-125 ${currentCategory === 'semua' ? 'text-emerald-700' : 'text-slate-600'}`} />
            </div>
            <span class={`text-[11px] sm:text-xs font-bold ${currentCategory === 'semua' ? 'text-emerald-800' : 'text-slate-700 group-hover:text-slate-900'}`}>
              Semua
            </span>
          </a>

          {PRODUCT_CATEGORIES.map((cat) => {
            const isActive = currentCategory === cat;
            const icon = CATEGORY_ICONS[cat] || 'package';
            const badge = CATEGORY_BADGES[cat];
            return (
              <a
                href={`/?kategori=${encodeURIComponent(cat)}${currentZone !== 'semua' ? `&zona=${currentZone}` : ''}`}
                class="group flex flex-col items-center gap-1.5 sm:gap-2 shrink-0 text-center"
              >
                <div
                  class={`relative w-12 h-12 sm:w-16 sm:h-16 rounded-full flex items-center justify-center transition border-2 ${
                    isActive
                      ? 'bg-emerald-50 border-emerald-700 text-emerald-800 shadow-sm'
                      : 'bg-white border-slate-200 text-slate-700 group-hover:border-emerald-400 group-hover:scale-105 shadow-2xs'
                  }`}
                >
                  <AppIcon name={icon} size="md" class={`sm:scale-125 ${isActive ? 'text-emerald-700' : 'text-slate-600'}`} />
                  {badge && (
                    <span
                      class={`hidden sm:inline-block absolute -top-1 -right-1 text-xs font-black uppercase px-1.5 py-0.5 rounded-full ${badge.color}`}
                    >
                      {badge.label}
                    </span>
                  )}
                </div>
                <span class={`text-[11px] sm:text-xs font-bold max-w-[74px] sm:max-w-[92px] leading-tight line-clamp-2 sm:truncate ${isActive ? 'text-emerald-800' : 'text-slate-700 group-hover:text-slate-900'}`}>
                  {cat}
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    {/* 1. TODAY'S FEATURED SELECTION (Mobile Swipe Carousel + Desktop 4-Col Grid) */}
    {showDiscoverySections && spotlightProducts.length > 0 && (
      <section class="w-screen relative left-1/2 -translate-x-1/2 bg-gradient-to-r from-emerald-50 via-teal-50/80 to-emerald-100/75 border-y border-emerald-200/70 py-5 sm:py-9">
        <div class="max-w-site mx-auto px-3 sm:px-6 lg:px-8 space-y-3 sm:space-y-4">
          <h2 class="text-base sm:text-xl font-black text-slate-900 tracking-tight">
            Pilihan Unggulan Hari Ini
          </h2>

          <div class="flex overflow-x-auto snap-x snap-mandatory gap-3 pb-1 -mx-3 px-3 sm:mx-0 sm:px-0 sm:grid sm:grid-cols-2 lg:grid-cols-4 sm:gap-4 sm:overflow-visible no-scrollbar">
            {spotlightProducts.map((p, idx) => (
              <div class="w-[74vw] max-w-[270px] shrink-0 snap-start sm:w-auto sm:max-w-none">
                <ProductCard product={p} variant="spotlight" highlight={idx === 0} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* 2. KABAR & PANDUAN UMKM + SLIM PROMO BANNER (Banner hidden on mobile: Bottom Nav already carries + CTA) */}
    {showDiscoverySections && (
      <section class="space-y-5 sm:space-y-6 px-3 sm:px-0">
        {articles.length > 0 && (
          <div class="space-y-3.5 sm:space-y-4">
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-base sm:text-xl font-black text-slate-900 tracking-tight">
                Kabar &amp; Panduan Usaha
              </h2>
              <a
                href="/edukasi"
                class="min-h-[40px] inline-flex items-center gap-1.5 px-3 sm:px-3.5 py-1.5 rounded-xl border border-emerald-600 text-emerald-800 hover:bg-emerald-50 text-xs font-bold transition shrink-0"
              >
                <AppIcon name="book" size="xs" />
                <span>Edukasi</span>
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
              {articles.slice(0, 3).map((art, artIdx) => (
                <a
                  href={`/edukasi/${art.slug}`}
                  class={`${artIdx >= 2 ? 'hidden md:flex' : 'flex'} items-start gap-3 rounded-2xl p-2 -m-2 hover:bg-white transition group cursor-pointer`}
                >
                  <img
                    src={getOptimizedImageUrl(art.image_url, 240)}
                    alt={art.title}
                    width="120"
                    height="90"
                    loading="lazy"
                    decoding="async"
                    class="w-24 sm:w-32 aspect-4/3 rounded-xl object-cover shrink-0 bg-slate-100 border border-slate-200 group-hover:scale-102 transition"
                  />
                  <div class="min-w-0 space-y-1">
                    <h3 class="font-extrabold text-sm text-slate-900 group-hover:text-emerald-700 line-clamp-2 leading-snug">
                      {art.title}
                    </h3>
                    <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                      {art.summary}
                    </p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Centered Slim Promo Banner (Hidden on mobile: redundant with center + Bottom Nav) -->
        <div class="hidden sm:block max-w-3xl mx-auto">
          <div class="bg-gradient-to-r from-emerald-800 via-emerald-700 to-teal-700 border border-emerald-600 rounded-2xl px-5 py-4 sm:px-7 sm:py-5 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm text-white">
            <div class="flex items-center gap-3.5 text-center sm:text-left">
              <div class="w-10 h-10 rounded-xl bg-white/15 border border-white/25 flex items-center justify-center shrink-0">
                <AppIcon name="store" size="md" class="text-white" />
              </div>
              <div>
                <p class="font-black text-base sm:text-lg leading-tight">
                  0% Komisi Transaksi
                </p>
                <p class="text-xs text-emerald-50 mt-0.5">
                  Pasang etalase UMKM Sumenep gratis &amp; terhubung langsung ke WhatsApp pembeli.
                </p>
              </div>
            </div>
            <a
              href="/pasang-iklan"
              class="shrink-0 min-h-[42px] inline-flex items-center justify-center bg-white hover:bg-slate-100 text-emerald-900 font-extrabold text-xs tracking-wide uppercase px-5 py-2 rounded-full shadow-xs transition"
            >
              Pasang Gratis
            </a>
          </div>
        </div>
      </section>
    )}

    {/* 3. MOST FAVORITED / POPULAR LISTINGS (Mobile Horizontal Carousel + Desktop 4-Col Row) */}
    {showDiscoverySections && popularProducts.length > 0 && (
      <section class="space-y-3 sm:space-y-4 px-3 sm:px-0">
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-base sm:text-xl font-black text-slate-900 tracking-tight">
            Produk Paling Diminati
          </h2>
          <a
            id="home-favorites-count-link"
            href="/favorit"
            data-ssr-fav-count={ssrFavCount !== null ? String(ssrFavCount) : ''}
            class="hidden sm:inline-flex min-h-[40px] items-center gap-1.5 px-3.5 py-1.5 rounded-xl border border-emerald-600 text-emerald-800 hover:bg-emerald-50 text-xs font-bold transition shrink-0"
          >
            <AppIcon name="star" size="xs" />
            <span>Kelola Favorit (<span id="home-fav-count-num">{ssrFavCount ?? 0}</span>)</span>
          </a>
        </div>

        <div class="flex overflow-x-auto snap-x snap-mandatory gap-3 pb-1 -mx-3 px-3 sm:mx-0 sm:px-0 sm:grid sm:grid-cols-2 lg:grid-cols-4 sm:gap-4 sm:overflow-visible no-scrollbar">
          {popularProducts.map((p) => (
            <div class="w-[68vw] max-w-[250px] shrink-0 snap-start sm:w-auto sm:max-w-none">
              <ProductCard product={p} variant="compact" hidePhotoCount={true} />
            </div>
          ))}
        </div>
      </section>
    )}

    {/* 4. BEST SELLERS / TOP UMKM PORTRAIT SHOWCASE (Full-Bleed Band) */}
    {showDiscoverySections && verifiedSellers.length > 0 && (
      <section id="toko-warga" class="w-screen relative left-1/2 -translate-x-1/2 bg-slate-100/90 border-y border-slate-200/80 py-5 sm:py-9">
        <div class="max-w-site mx-auto px-3 sm:px-6 lg:px-8 space-y-3 sm:space-y-4">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-base sm:text-xl font-black text-slate-900 tracking-tight">
              Toko &amp; Pengrajin Unggulan
            </h2>
            <a
              href="/toko"
              class="min-h-[40px] sm:min-h-0 text-xs font-bold text-emerald-700 hover:text-emerald-900 transition inline-flex items-center gap-1 shrink-0"
            >
              <span>Semua ({sellers.length})</span>
              <AppIcon name="arrow-right" size="xs" />
            </a>
          </div>

          <div class="-mx-3 sm:mx-0 grid grid-cols-2 lg:grid-cols-4 gap-0.5 sm:gap-4 [&>a]:rounded-none sm:[&>a]:rounded-lg [&>a]:border-0 sm:[&>a]:border">
            {verifiedSellers.slice(0, 4).map((seller) => {
              const coverImg = seller.sample_images[0] ? getOptimizedImageUrl(seller.sample_images[0], 500) : null;
              return (
                <a
                  href={`/toko/${seller.slug || seller.id}`}
                  class="relative aspect-square sm:aspect-3/4 rounded-lg overflow-hidden border border-slate-200 hover:border-emerald-500 shadow-xs hover:shadow-md transition group bg-emerald-950 block"
                >
                  {coverImg ? (
                    <img
                      src={coverImg}
                      alt={seller.name}
                      width="320"
                      height="420"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                    />
                  ) : (
                    <div class="w-full h-full bg-gradient-to-br from-emerald-800 to-teal-950 flex items-center justify-center text-white/90 font-black text-3xl sm:text-4xl">
                      {seller.name.slice(0, 2).toUpperCase()}
                    </div>
                  )}

                  {Boolean(seller.is_verified) && (
                    <span class="absolute top-2 left-2 sm:top-2.5 sm:left-2.5 bg-emerald-700 text-white text-[11px] sm:text-xs font-bold px-2 py-0.5 rounded-md shadow-xs inline-flex items-center gap-1">
                      <AppIcon name="check" size="xs" />
                      <span>Terverifikasi</span>
                    </span>
                  )}

                  <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent p-3 sm:p-4 text-left">
                    <h3 class="font-black text-sm sm:text-base text-white line-clamp-1 leading-tight">
                      {seller.name}
                    </h3>
                    <p class="text-xs text-slate-200 mt-0.5 truncate">
                      {seller.product_count} produk • {seller.zone_name}
                    </p>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- 5. MAIN CATALOG GRID (5-Column Desktop Dense Marketplace Grid + Pagination) -->
    <section id="katalog-terbaru" class="space-y-3.5 sm:space-y-4 px-3 sm:px-0 pt-1">
      <div class="-mx-3 px-3 sm:mx-0 sm:px-0 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 sm:gap-3 pb-2.5 sm:pb-3 border-b border-slate-200">
        <div>
          <h2 class="text-base sm:text-xl font-black text-slate-900 tracking-tight flex items-center gap-2">
            <AppIcon name="clipboard" size="sm" class="text-emerald-700" />
            <span>{isFiltered ? 'Hasil Pencarian Produk' : 'Katalog Produk Warga NU'}</span>
          </h2>
          <p class={`${isFiltered ? 'block' : 'hidden sm:block'} text-xs text-slate-600 mt-0.5`}>
            Menampilkan <strong>{products.length}</strong> dari <strong>{totalProducts}</strong> produk aktif (Halaman {safePage} / {totalPages})
          </p>
        </div>

        <div class="flex items-center gap-2.5 overflow-x-auto no-scrollbar">
          <form method="GET" action="/" class="flex items-center gap-1.5 shrink-0 text-xs">
            <input type="hidden" name="zona" value={currentZone} />
            <input type="hidden" name="kategori" value={currentCategory} />
            <input type="hidden" name="stok" value={currentStock} />
            <input type="hidden" name="terverifikasi" value={currentVerified} />
            <input type="hidden" name="q" value={searchQuery} />
            <label for="sort-select" class="text-slate-600 font-bold">Urut:</label>
            <select
              id="sort-select"
              name="sort"
              onchange="this.form.submit()"
              class="min-h-[40px] bg-white border border-slate-300 text-slate-800 rounded-lg py-1.5 px-2.5 text-xs font-semibold cursor-pointer"
            >
              <option value="newest" selected={currentSort === 'newest'}>Terbaru</option>
              <option value="price_asc" selected={currentSort === 'price_asc'}>Harga Termurah</option>
              <option value="price_desc" selected={currentSort === 'price_desc'}>Harga Termahal</option>
            </select>
          </form>

          {isFiltered && (
            <a
              href="/"
              class="shrink-0 min-h-[40px] inline-flex items-center px-2.5 text-xs font-bold text-rose-700 hover:text-rose-800 underline"
            >
              Reset Filter
            </a>
          )}
        </div>
      </div>

      <!-- Quick Filter Pills -->
      <div class="-mx-3 px-3 sm:mx-0 sm:px-0 flex items-center gap-2 overflow-x-auto no-scrollbar py-0.5 text-xs">
        <span class="text-slate-600 text-xs font-bold uppercase tracking-wider shrink-0 mr-1">
          Filter:
        </span>
        <a
          href={buildFilterUrl({ stok: 'semua' })}
          class={`min-h-[38px] inline-flex items-center px-3.5 py-1.5 rounded-full font-semibold transition shrink-0 border text-xs ${
            currentStock === 'semua'
              ? 'bg-slate-900 text-white border-slate-900 shadow-2xs'
              : 'bg-white text-slate-700 border-slate-200 hover:border-slate-400'
          }`}
        >
          Semua Stok
        </a>
        <a
          href={buildFilterUrl({ stok: 'ready' })}
          class={`min-h-[38px] inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full font-semibold transition shrink-0 border text-xs ${
            currentStock === 'ready'
              ? 'bg-emerald-700 text-white border-emerald-700 shadow-2xs'
              : 'bg-white text-emerald-800 border-emerald-200 hover:bg-emerald-50'
          }`}
        >
          <span class={`w-1.5 h-1.5 rounded-full ${currentStock === 'ready' ? 'bg-white' : 'bg-emerald-600'}`}></span>
          <span>Ready Stock</span>
        </a>
        <a
          href={buildFilterUrl({ stok: 'po' })}
          class={`min-h-[38px] inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full font-semibold transition shrink-0 border text-xs ${
            currentStock === 'po'
              ? 'bg-amber-400 text-slate-950 border-amber-400 shadow-2xs font-bold'
              : 'bg-white text-amber-900 border-amber-300 hover:bg-amber-50'
          }`}
        >
          <span class={`w-1.5 h-1.5 rounded-full ${currentStock === 'po' ? 'bg-slate-900' : 'bg-amber-600'}`}></span>
          <span>Pre-Order (PO)</span>
        </a>
        <a
          href={buildFilterUrl({ terverifikasi: currentVerified === '1' ? '0' : '1' })}
          class={`min-h-[38px] inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full font-semibold transition shrink-0 border text-xs ${
            currentVerified === '1'
              ? 'bg-emerald-700 text-white border-emerald-700 shadow-2xs'
              : 'bg-white text-emerald-800 border-emerald-300 hover:bg-emerald-50'
          }`}
        >
          <AppIcon name="verified" size="xs" />
          <span>Hanya Toko Terverifikasi</span>
        </a>
      </div>

      {isFiltered && (
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="text-slate-600 font-bold">Filter Aktif:</span>
          {currentZone !== 'semua' && (
            <span class="bg-white border border-slate-300 text-slate-700 px-2.5 py-1 rounded-full font-medium shadow-2xs">
              Wilayah: {zones.find((z) => z.slug === currentZone)?.name || currentZone}
            </span>
          )}
          {currentCategory !== 'semua' && (
            <span class="bg-white border border-slate-300 text-slate-700 px-2.5 py-1 rounded-full font-medium shadow-2xs">
              Kategori: {currentCategory}
            </span>
          )}
          {searchQuery && (
            <span class="bg-white border border-slate-300 text-slate-700 px-2.5 py-1 rounded-full font-medium shadow-2xs">
              Kata Kunci: "{searchQuery}"
            </span>
          )}
          {currentStock !== 'semua' && (
            <span class="bg-white border border-slate-300 text-slate-700 px-2.5 py-1 rounded-full font-medium shadow-2xs">
              Stok: <strong class="text-slate-900">{currentStock === 'ready' ? 'Ready Stock' : currentStock === 'po' ? 'Pre-Order' : 'Habis'}</strong>
            </span>
          )}
        </div>
      )}

      {products.length > 0 ? (
        <div class="space-y-6">
          <div class="-mx-3 sm:mx-0 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-px sm:gap-4 bg-slate-200 sm:bg-transparent border-y sm:border-0 border-slate-200 [&>article]:rounded-none sm:[&>article]:rounded-lg [&>article]:border-0 sm:[&>article]:border [&>article]:shadow-none sm:[&>article]:shadow-xs">
            {products.map((p) => (
              <ProductCard product={p} variant="compact" showSellerAvatar={false} />
            ))}
          </div>

          {totalPages > 1 && (
            <nav aria-label="Navigasi Halaman Katalog" class="flex items-center justify-center gap-2 pt-2">
              {safePage > 1 ? (
                <a
                  href={buildFilterUrl({ page: String(safePage - 1) })}
                  rel="prev"
                  class="min-h-[44px] inline-flex items-center px-4 py-2 bg-white hover:bg-slate-50 border border-slate-300 rounded-xl text-xs font-bold text-slate-700 transition"
                >
                  ← Sebelumnya
                </a>
              ) : (
                <span class="min-h-[44px] inline-flex items-center px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-400">
                  ← Sebelumnya
                </span>
              )}

              <span class="text-xs font-bold text-slate-700 px-3 tabular-nums">
                Halaman {safePage} dari {totalPages}
              </span>

              {safePage < totalPages ? (
                <a
                  href={buildFilterUrl({ page: String(safePage + 1) })}
                  rel="next"
                  class="min-h-[44px] inline-flex items-center px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-xs font-bold transition shadow-xs"
                >
                  Berikutnya →
                </a>
              ) : (
                <span class="min-h-[44px] inline-flex items-center px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-400">
                  Berikutnya →
                </span>
              )}
            </nav>
          )}
        </div>
      ) : (
        <EmptyState
          icon="search"
          title="Tidak Ada Produk yang Cocok"
          description="Coba pilih wilayah MWC lainnya atau ubah kata kunci pencarian Anda."
          actionHref="/"
          actionLabel="Lihat Semua Produk"
        />
      )}
    </section>

    {/* 6. RECENTLY VIEWED LISTINGS (Populated from localStorage history) */}
    {showDiscoverySections && (
      <section
        id="recent-viewed-section"
        data-default-image={DEFAULT_PRODUCT_IMAGE}
        class="hidden space-y-4 px-3 sm:px-0 pt-2"
      >
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight">
            Baru Saja Anda Lihat
          </h2>
          <button
            type="button"
            id="btn-clear-recent"
            class="text-xs font-semibold text-slate-500 hover:text-rose-700 transition cursor-pointer"
          >
            Bersihkan Riwayat
          </button>
        </div>
        <div id="recent-viewed-grid" class="-mx-3 sm:mx-0 grid grid-cols-2 lg:grid-cols-4 gap-px sm:gap-4 bg-slate-200 sm:bg-transparent border-y sm:border-0 border-slate-200"></div>
      </section>
    )}

  </div>

  <!-- Floating Back-to-Top Button -->
  <button
    type="button"
    id="btn-back-to-top"
    aria-label="Kembali ke atas"
    class="fixed bottom-20 right-4 lg:bottom-6 lg:right-6 z-30 w-11 h-11 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white shadow-lg flex items-center justify-center opacity-0 pointer-events-none transition cursor-pointer"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
    </svg>
  </button>

  <script>
    // Reveal popular tags when mobile user focuses the search field
    const heroQInput = document.getElementById('hero-q') as HTMLInputElement | null;
    const heroPopularTags = document.getElementById('hero-popular-tags');
    heroQInput?.addEventListener('focus', () => {
      if (heroPopularTags) {
        heroPopularTags.classList.remove('hidden');
        heroPopularTags.classList.add('flex');
      }
    });

    // Sync favorite count badge on "Kelola Favorit (N)"
    const favLink = document.getElementById('home-favorites-count-link');
    const favNumEl = document.getElementById('home-fav-count-num');
    if (favLink && favNumEl) {
      const ssrCount = favLink.getAttribute('data-ssr-fav-count');
      if (!ssrCount) {
        try {
          const stored = JSON.parse(localStorage.getItem('mamasar_favorites') || '[]');
          if (Array.isArray(stored)) {
            favNumEl.textContent = String(stored.length);
          }
        } catch (_) {}
      }
    }

    // Floating Back-to-Top button
    const backTopBtn = document.getElementById('btn-back-to-top');
    if (backTopBtn) {
      window.addEventListener(
        'scroll',
        () => {
          if (window.scrollY > 400) {
            backTopBtn.classList.remove('opacity-0', 'pointer-events-none');
          } else {
            backTopBtn.classList.add('opacity-0', 'pointer-events-none');
          }
        },
        { passive: true }
      );
      backTopBtn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Recently Viewed Listings (rendered safely via DOM nodes, never innerHTML)
    const recentSection = document.getElementById('recent-viewed-section');
    const recentGrid = document.getElementById('recent-viewed-grid');
    const btnClearRecent = document.getElementById('btn-clear-recent');
    const fallbackImg = recentSection?.getAttribute('data-default-image') || '/icon.svg';

    function safeImageSrc(url: unknown): string {
      if (!url || typeof url !== 'string') return fallbackImg;
      if (url.startsWith('/uploads/') || url.startsWith('/')) return url;
      if (/^https:\/\//i.test(url)) return url;
      return fallbackImg;
    }

    function formatRupiahClient(val: unknown): string {
      return new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        maximumFractionDigits: 0,
      }).format(Number(val) || 0);
    }

    interface RecentProduct {
      id: number;
      slug: string;
      name: string;
      price: number;
      image_url: string;
      zone_name?: string;
      umkm_name?: string;
      umkm_logo_url?: string;
      is_verified?: boolean;
      is_featured?: boolean;
      photo_count?: number;
    }

    function getInitialsClient(name: unknown): string {
      const str = typeof name === 'string' ? name.trim() : '';
      if (!str) return 'UM';
      return (
        str
          .split(/\s+/)
          .slice(0, 2)
          .map((w) => w[0]?.toUpperCase() || '')
          .join('')
          .slice(0, 2) || 'UM'
      );
    }

    async function renderRecentViewed() {
      if (!recentSection || !recentGrid) return;
      try {
        const raw = localStorage.getItem('mamasar_recent_viewed');
        const ids = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(ids) || ids.length === 0) return;

        const cleanIds = ids.filter((id): id is number => typeof id === 'number' && id > 0).slice(0, 4);
        if (cleanIds.length === 0) return;

        const res = await fetch(`/api/favorites/list?ids=${cleanIds.join(',')}`);
        const data = await res.json();
        if (!res.ok || !data?.success || !Array.isArray(data.products) || data.products.length === 0) return;

        const productsList = data.products as RecentProduct[];
        const byId = new Map<number, RecentProduct>(productsList.map((p) => [p.id, p]));
        const ordered = cleanIds.map((id) => byId.get(id)).filter((p): p is RecentProduct => Boolean(p));
        if (ordered.length === 0) return;

        recentGrid.replaceChildren();
        ordered.forEach((p) => {
          const card = document.createElement('a');
          card.href = `/produk/${p.slug}`;
          card.className =
            'bg-white border-0 sm:border border-slate-200 hover:border-emerald-400 rounded-none sm:rounded-lg overflow-hidden shadow-none sm:shadow-xs hover:shadow-md transition group block';

          const media = document.createElement('div');
          media.className = 'relative aspect-4/3 bg-slate-100 overflow-hidden';

          const img = document.createElement('img');
          img.src = safeImageSrc(p.image_url);
          img.alt = p.name || 'Produk';
          img.loading = 'lazy';
          img.decoding = 'async';
          img.className = 'w-full h-full object-cover group-hover:scale-105 transition duration-300';
          media.appendChild(img);

          const avatarWrap = document.createElement('span');
          avatarWrap.className = 'absolute top-2.5 left-2.5 z-10 inline-flex items-center justify-center';
          if (p.umkm_logo_url && safeImageSrc(p.umkm_logo_url)) {
            const avatarImg = document.createElement('img');
            avatarImg.src = safeImageSrc(p.umkm_logo_url);
            avatarImg.alt = p.umkm_name || 'Toko';
            avatarImg.loading = 'lazy';
            avatarImg.decoding = 'async';
            avatarImg.className =
              'w-9 h-9 rounded-full object-cover bg-white border-2 border-white ring-2 ring-emerald-600 shadow-sm';
            avatarWrap.appendChild(avatarImg);
          } else {
            const avatarCircle = document.createElement('span');
            avatarCircle.className =
              'w-9 h-9 rounded-full bg-emerald-900 text-white border-2 border-white ring-2 ring-emerald-600 shadow-sm flex items-center justify-center text-xs font-black tracking-tight';
            avatarCircle.textContent = getInitialsClient(p.umkm_name);
            avatarWrap.appendChild(avatarCircle);
          }
          if (p.is_verified || p.is_featured) {
            const verifTag = document.createElement('span');
            verifTag.className =
              'absolute -bottom-1 -right-1.5 bg-emerald-700 text-white text-xs font-black uppercase px-1 py-0.5 rounded leading-none ring-1 ring-white';
            verifTag.textContent = p.is_verified ? 'VERIF' : 'PRO';
            avatarWrap.appendChild(verifTag);
          }
          media.appendChild(avatarWrap);

          const scrim = document.createElement('div');
          scrim.className =
            'absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent pt-7 pb-2.5 px-3 flex items-end justify-between gap-2';

          const leftCol = document.createElement('div');
          leftCol.className = 'space-y-1';

          if (p.is_featured) {
            const pill = document.createElement('span');
            pill.className = 'inline-block text-xs font-extrabold bg-amber-400 text-slate-950 px-2 py-0.5 rounded-md';
            pill.textContent = 'Unggulan';
            leftCol.appendChild(pill);
          }

          const priceEl = document.createElement('div');
          priceEl.className = 'text-sm sm:text-base font-extrabold tabular-nums text-white drop-shadow-sm';
          priceEl.textContent = formatRupiahClient(p.price);
          leftCol.appendChild(priceEl);
          scrim.appendChild(leftCol);

          if (p.photo_count && p.photo_count > 1) {
            const countBadge = document.createElement('span');
            countBadge.className = 'text-xs font-bold text-white/95 tabular-nums drop-shadow-sm';
            countBadge.textContent = `${p.photo_count}x`;
            scrim.appendChild(countBadge);
          }

          media.appendChild(scrim);
          card.appendChild(media);

          const body = document.createElement('div');
          body.className = 'p-3 space-y-1';

          const loc = document.createElement('div');
          loc.className = 'text-xs text-slate-500 truncate';
          loc.textContent = `${p.zone_name || 'Sumenep'}, Sumenep`;
          body.appendChild(loc);

          const title = document.createElement('div');
          title.className = 'font-bold text-sm text-slate-900 line-clamp-1 group-hover:text-emerald-700';
          title.textContent = p.name || '';
          body.appendChild(title);

          card.appendChild(body);
          recentGrid.appendChild(card);
        });

        recentSection.classList.remove('hidden');
      } catch (_) {}
    }

    renderRecentViewed();

    btnClearRecent?.addEventListener('click', () => {
      try {
        localStorage.removeItem('mamasar_recent_viewed');
      } catch (_) {}
      recentGrid?.replaceChildren();
      recentSection?.classList.add('hidden');
    });
  </script>
</Layout>
