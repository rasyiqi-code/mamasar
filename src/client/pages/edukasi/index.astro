---
import Layout from '../../layouts/Layout.astro';
import { getArticles, getActiveCaseStudies } from '../../../lib/db';
import { resolveUser } from '../../../lib/neon-auth';
import { can, isPCNU } from '../../../lib/modules/auth';
import AppIcon from '../../components/common/AppIcon.astro';

const allArticles = await getArticles();
const caseStudies = await getActiveCaseStudies();
const user = await resolveUser(Astro.request);
const isManager = Boolean(user && (can(user, 'articles:manage') || isPCNU(user)));

const url = new URL(Astro.request.url);
const currentCategory = url.searchParams.get('kategori') || 'semua';
const searchQuery = (url.searchParams.get('q') || '').trim();

const categories = [
  'Semua',
  'Ekonomi Pekarangan',
  'Panduan Usaha',
  'Legalitas & Halal',
  'Tips Transaksi',
  'Gerakan Warga',
];

// Dynamic filter by category from database
const categoryMatched =
  currentCategory === 'semua'
    ? allArticles
    : allArticles.filter((art) => art.category.toLowerCase() === currentCategory.toLowerCase());

const searchLower = searchQuery.toLowerCase();
const filteredArticles = searchQuery
  ? categoryMatched.filter(
      (art) =>
        art.title.toLowerCase().includes(searchLower) ||
        art.summary.toLowerCase().includes(searchLower) ||
        (art.content && art.content.toLowerCase().includes(searchLower))
    )
  : categoryMatched;

const featuredArticle = searchQuery ? null : (currentCategory === 'semua' ? allArticles[0] : null);
const otherArticles = featuredArticle
  ? filteredArticles.filter((art) => art.id !== featuredArticle.id)
  : filteredArticles;

function calculateReadTime(content?: string | null): number {
  const words = (content || '').trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 180));
}
---

<Layout
  title="Pusat Edukasi & Panduan Usaha Nahdliyin | Mamasar Sumenep"
  description="Kumpulan panduan praktis ekonomi pekarangan, kiat merintis usaha UMKM warga NU, pengurusan sertifikasi halal gratis, dan panduan transaksi aman warga NU Sumenep."
>
  <div class="pb-12 space-y-8">
    {/* Full-bleed Header & Category Filter Strip */}
    <header class="-mx-0 sm:-mx-6 lg:-mx-8 px-3 sm:px-6 lg:px-8 py-3.5 sm:py-8 space-y-3 sm:space-y-4 bg-white border-b border-slate-200">
      <div class="hidden md:flex items-center justify-between text-xs text-slate-600 pb-3 border-b border-slate-100">
        <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 flex-wrap">
          <a href="/" class="hover:text-emerald-700 font-medium">Beranda</a>
          <AppIcon name="chevron-right" size="xs" class="text-slate-400" />
          <a href="/edukasi" class="hover:text-emerald-700 font-medium">Pusat Edukasi</a>
          {currentCategory !== 'semua' && (
            <>
              <AppIcon name="chevron-right" size="xs" class="text-slate-400" />
              <span class="text-emerald-700 font-bold">{currentCategory}</span>
            </>
          )}
        </nav>

        <a
          href="/dashboard"
          class="hidden sm:inline-flex text-xs font-bold text-emerald-700 hover:text-emerald-800 transition items-center gap-1"
        >
          <AppIcon name="plus" size="xs" />
          <span>Daftarkan Usaha</span>
        </a>
      </div>

      <div class="space-y-1.5 sm:space-y-2">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold">
          <AppIcon name="book" size="xs" class="text-emerald-700" />
          <span>Literasi &amp; Pemberdayaan Ekonomi Nahdliyin</span>
        </div>
        <h1 class="text-xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Pusat Edukasi &amp; Panduan Usaha
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 max-w-2xl leading-relaxed">
          Panduan taktis usaha, rubrik ekonomi pekarangan, legalitas halal SEHATI, dan strategi transaksi warga NU Sumenep.
        </p>
      </div>

      {/* Search Bar & Manager CTA */}
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 pt-1">
        <form method="GET" action="/edukasi" class="relative flex-1 max-w-lg">
          {currentCategory !== 'semua' && (
            <input type="hidden" name="kategori" value={currentCategory} />
          )}
          <div class="relative flex items-center">
            <span class="absolute left-3.5 text-slate-400 pointer-events-none">
              <AppIcon name="search" size="xs" />
            </span>
            <input
              type="text"
              name="q"
              value={searchQuery}
              placeholder="Cari panduan pekarangan, halal, izin, modal..."
              aria-label="Cari panduan edukasi"
              class="w-full min-h-[44px] pl-10 pr-10 text-xs sm:text-sm bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 focus:border-emerald-700 rounded-lg transition placeholder:text-slate-400 focus:outline-none focus:ring-1 focus:ring-emerald-700"
            />
            {searchQuery && (
              <a
                href={currentCategory === 'semua' ? '/edukasi' : `/edukasi?kategori=${encodeURIComponent(currentCategory)}`}
                class="absolute right-2.5 text-slate-400 hover:text-slate-600 p-1 rounded-md"
                aria-label="Hapus kata kunci pencarian"
              >
                <AppIcon name="x" size="xs" />
              </a>
            )}
          </div>
        </form>

        {isManager && (
          <div class="flex items-center gap-2 shrink-0">
            <a
              href="/admin/articles"
              class="min-h-[44px] inline-flex items-center justify-center gap-1.5 px-4 py-2 bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] text-white text-xs font-bold rounded-lg transition shadow-2xs whitespace-nowrap"
            >
              <AppIcon name="plus" size="xs" />
              <span>Kelola Panduan</span>
            </a>
          </div>
        )}
      </div>

      {/* Category Filter Badges */}
      <div class="flex items-center gap-2 overflow-x-auto pt-1 no-scrollbar pb-1 snap-x snap-mandatory [mask-image:linear-gradient(to_right,black_88%,transparent_100%)] sm:[mask-image:none]">
        {categories.map((cat) => {
          const isActive = currentCategory.toLowerCase() === cat.toLowerCase();
          const catCount =
            cat === 'Semua'
              ? allArticles.length
              : allArticles.filter((art) => art.category.toLowerCase() === cat.toLowerCase()).length;
          const targetUrl = new URL('/edukasi', 'https://mamasar.local');
          if (cat !== 'Semua') targetUrl.searchParams.set('kategori', cat);
          if (searchQuery) targetUrl.searchParams.set('q', searchQuery);
          const href = `${targetUrl.pathname}${targetUrl.search}`;

          return (
            <a
              href={href}
              class={`px-3 py-2 min-h-[40px] inline-flex items-center gap-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition shrink-0 snap-start active:scale-[0.97] ${
                isActive
                  ? 'bg-emerald-700 text-white shadow-2xs'
                  : 'bg-white text-slate-700 hover:bg-slate-50 hover:text-slate-900 border border-slate-200'
              }`}
            >
              <span>{cat}</span>
              <span class={`text-[10px] font-mono tabular-nums px-1.5 py-0.5 rounded-full ${
                isActive ? 'bg-emerald-800 text-emerald-100' : 'bg-slate-100 text-slate-500'
              }`}>
                {catCount}
              </span>
            </a>
          );
        })}
      </div>
    </header>

    <div class="px-3 sm:px-0 space-y-10">
      {/* Featured Top Article (Hanya saat tab "Semua" tanpa kata kunci pencarian) */}
      {currentCategory === 'semua' && featuredArticle && (
        <section class="bg-white border border-slate-200 rounded-lg overflow-hidden hover:border-slate-300 transition group shadow-2xs">
          <a href={`/edukasi/${featuredArticle.slug}`} class="grid grid-cols-1 md:grid-cols-12 gap-0 items-stretch">
            <div class="md:col-span-6 lg:col-span-7 aspect-16/9 md:aspect-auto md:min-h-[280px] overflow-hidden bg-slate-100">
              <img
                src={featuredArticle.image_url}
                alt={featuredArticle.title}
                class="w-full h-full object-cover group-hover:scale-103 transition duration-300"
              />
            </div>
            <div class="md:col-span-6 lg:col-span-5 p-5 sm:p-8 flex flex-col justify-center space-y-3 border-t md:border-t-0 md:border-l border-slate-200">
              <div>
                <span class="inline-block text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 px-2.5 py-0.5 rounded-md">
                  {featuredArticle.category}
                </span>
              </div>
              <h2 class="text-lg sm:text-2xl font-black text-slate-900 group-hover:text-emerald-700 transition leading-snug">
                {featuredArticle.title}
              </h2>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-3">
                {featuredArticle.summary}
              </p>
              <div class="pt-2 flex items-center gap-1.5 text-xs font-bold text-emerald-700">
                <span>Baca Panduan</span>
                <AppIcon name="arrow-right" size="xs" />
              </div>
            </div>
          </a>
        </section>
      )}

      {/* Articles Grid (Dinamis dari Database) */}
      <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-slate-200 pb-3">
          <h2 class="text-sm sm:text-base font-black text-slate-900 tracking-tight flex items-center gap-2">
            <AppIcon name="book" size="sm" class="text-emerald-700" />
            <span>
              {searchQuery
                ? `Hasil Pencarian "${searchQuery}"`
                : currentCategory === 'semua'
                  ? 'Daftar Panduan'
                  : `Panduan ${currentCategory}`}
              (<span class="font-mono tabular-nums">{filteredArticles.length}</span>)
            </span>
          </h2>

          {(searchQuery || currentCategory !== 'semua') && (
            <a
              href="/edukasi"
              class="text-xs font-semibold text-emerald-700 hover:text-emerald-800 flex items-center gap-1 transition"
            >
              <span>Semua Kategori</span>
              <AppIcon name="x" size="xs" />
            </a>
          )}
        </div>

        {filteredArticles.length === 0 ? (
          <div class="bg-white border border-slate-200 rounded-lg p-6 sm:p-10 text-center space-y-3 max-w-sm mx-auto my-6 shadow-2xs">
            <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
              <AppIcon name="book" size="md" />
            </div>
            <div class="space-y-1">
              <h3 class="text-sm font-bold text-slate-900">Panduan Tidak Ditemukan</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                {searchQuery
                  ? `Tidak ada panduan dengan kata kunci "${searchQuery}".`
                  : 'Belum ada panduan untuk kategori ini.'}
              </p>
            </div>
            <a
              href="/edukasi"
              class="inline-flex items-center justify-center min-h-[40px] px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold text-xs rounded-lg transition active:scale-[0.98]"
            >
              Reset
            </a>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-5">
            {(currentCategory === 'semua' && !searchQuery ? otherArticles : filteredArticles).map((article) => (
              <article class="bg-white border border-slate-200 rounded-lg overflow-hidden hover:border-slate-300 transition flex flex-col justify-between group shadow-2xs">
                <div>
                  <a href={`/edukasi/${article.slug}`} class="block aspect-16/10 overflow-hidden bg-slate-100 relative">
                    <img
                      src={article.image_url}
                      alt={article.title}
                      loading="lazy"
                      class="w-full h-full object-cover group-hover:scale-103 transition duration-300"
                    />
                    <span class="absolute top-2.5 left-2.5 bg-white/95 text-emerald-800 border border-emerald-200 text-xs font-bold px-2 py-0.5 rounded-md">
                      {article.category}
                    </span>
                  </a>

                  <div class="p-4 space-y-2">
                    <a
                      href={`/edukasi/${article.slug}`}
                      class="font-black text-sm sm:text-base text-slate-900 group-hover:text-emerald-700 line-clamp-2 leading-snug transition block"
                    >
                      {article.title}
                    </a>
                    <p class="hidden sm:block text-xs text-slate-600 line-clamp-2 leading-relaxed">
                      {article.summary}
                    </p>
                  </div>
                </div>

                <div class="px-4 py-2 sm:py-3 border-t border-slate-100 flex items-center justify-between text-xs">
                  <div class="flex items-center gap-1.5 text-slate-500 font-medium">
                    <span>
                      {new Date(article.created_at).toLocaleDateString('id-ID', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                      })}
                    </span>
                    <span>&bull;</span>
                    <span>{calculateReadTime(article.content)} mnt baca</span>
                  </div>
                  <a
                    href={`/edukasi/${article.slug}`}
                    class="font-bold text-emerald-700 group-hover:underline flex items-center gap-1 min-h-[44px] sm:min-h-[32px]"
                  >
                    <span>Baca</span>
                    <AppIcon name="arrow-right" size="xs" />
                  </a>
                </div>
              </article>
            ))}
          </div>
        )}
      </section>

      {/* Studi Kasus & Dokumentasi Video */}
      <section class="space-y-4 pt-4 border-t border-slate-200">
        <div class="space-y-1.5">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-amber-50 text-amber-900 border border-amber-200 text-xs font-bold">
            <AppIcon name="eye" size="xs" class="text-amber-700" />
            <span>Studi Kasus LPNU &bull; Dokumentasi</span>
          </div>
          <h2 class="text-lg sm:text-2xl font-black text-slate-900">
            Inspirasi Nyata Ekonomi Pekarangan &amp; UMKM Warga
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 max-w-2xl leading-relaxed">
            Dokumentasi praktik lapangan mandiri pangan dan budidaya pekarangan sebagai percontohan unit usaha warga di lingkungan MWC NU Sumenep.
          </p>
        </div>

        {caseStudies.length > 0 && (
          <div class="bg-white border border-slate-200 rounded-lg grid grid-cols-1 md:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-slate-200 overflow-hidden shadow-2xs">
            {caseStudies.map((cs, index) => (
              <div class="p-4 sm:p-5 flex flex-col justify-between space-y-4">
                <div class="space-y-3">
                  <a href={`/edukasi/video/${cs.id}`} class="relative aspect-16/9 rounded-lg overflow-hidden bg-slate-900 group block">
                    <img
                      src={cs.thumbnail_url}
                      alt={cs.title}
                      loading="lazy"
                      class="w-full h-full object-cover opacity-85 group-hover:scale-103 transition duration-300"
                    />
                    <span class="absolute bottom-1.5 right-1.5 bg-black/85 text-white text-[11px] font-medium leading-none px-1.5 py-1 rounded-[3px] tabular-nums">
                      {cs.duration.match(/^\d+/) ? `${cs.duration.match(/^\d+/)![0]}:00` : cs.duration}
                    </span>
                    <span class="absolute inset-0 bg-slate-950/20 group-hover:bg-transparent transition"></span>
                  </a>

                  <div class="space-y-1">
                    <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider block">
                      Video {String(index + 1).padStart(2, '0')} &bull; {cs.tag}
                    </span>
                    <a href={`/edukasi/video/${cs.id}`} class="font-black text-sm text-slate-900 hover:text-emerald-700 leading-snug block transition">
                      {cs.title}
                    </a>
                    <p class="text-xs text-slate-600 font-medium">{cs.channel_name}</p>
                  </div>

                  {(cs.practice_summary || cs.opportunity_summary) && (
                    <div class="space-y-1.5 text-xs text-slate-600 pt-2 border-t border-slate-100">
                      {cs.practice_summary && (
                        <p class="leading-relaxed line-clamp-2">
                          <strong class="text-slate-900">Praktik:</strong> {cs.practice_summary}
                        </p>
                      )}
                      {cs.opportunity_summary && (
                        <p class="leading-relaxed line-clamp-2">
                          <strong class="text-slate-900">Peluang:</strong> {cs.opportunity_summary}
                        </p>
                      )}
                    </div>
                  )}
                </div>

                <a
                  href={`/edukasi/video/${cs.id}`}
                  class="w-full min-h-[44px] py-2.5 px-3 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs rounded-lg flex items-center justify-center gap-2 transition active:scale-[0.98]"
                >
                  <AppIcon name="eye" size="xs" />
                  <span>Tonton Video</span>
                </a>
              </div>
            ))}
          </div>
        )}
      </section>

      {/* Bottom Call to Action */}
      <div class="bg-emerald-800 border border-emerald-900 rounded-lg p-5 sm:p-8 text-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-sm">
        <div class="space-y-1">
          <h2 class="text-base sm:text-xl font-black">Punya Usaha atau Produk Rumah Tangga di Sumenep?</h2>
          <p class="text-xs sm:text-sm text-emerald-100 max-w-xl leading-relaxed">
            Terapkan panduan di atas dan pasang iklan produk Anda secara gratis. Terhubung langsung ke WhatsApp pembeli tanpa potongan biaya.
          </p>
        </div>
        <a
          href="/pasang-iklan"
          class="shrink-0 min-h-[44px] bg-white hover:bg-slate-100 text-emerald-900 font-bold text-xs sm:text-sm px-5 py-2.5 rounded-lg inline-flex items-center gap-2 transition active:scale-[0.98]"
        >
          <AppIcon name="plus" size="xs" />
          <span>Pasang Iklan</span>
        </a>
      </div>
    </div>
  </div>
</Layout>