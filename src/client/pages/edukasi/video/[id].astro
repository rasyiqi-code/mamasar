---
import Layout from '../../../layouts/Layout.astro';
import { getCaseStudyById, getActiveCaseStudies } from '../../../../lib/db';
import AppIcon from '../../../components/common/AppIcon.astro';

const { id } = Astro.params;
const videoId = Number(id);

if (!videoId || isNaN(videoId)) {
  return Astro.redirect('/edukasi');
}

const video = await getCaseStudyById(videoId);

if (!video) {
  return Astro.redirect('/edukasi');
}

const allVideos = await getActiveCaseStudies();
const relatedVideos = allVideos.filter((v) => v.id !== video.id);

function getYouTubeEmbedUrl(url: string): string | null {
  if (!url) return null;
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=|shorts\/)([^#\&\?]*).*/;
  const match = url.match(regExp);
  if (match && match[2].length === 11) {
    return `https://www.youtube-nocookie.com/embed/${match[2]}?rel=0&modestbranding=1&iv_load_policy=3&playsinline=1&color=white`;
  }
  return null;
}

const embedUrl = getYouTubeEmbedUrl(video.video_url);

function formatDurationBadge(dur: string | null | undefined): string {
  if (!dur) return '';
  const clean = dur.trim();
  if (/^\d+:\d+/.test(clean)) return clean;
  const match = clean.match(/^(\d+)\s*(menit|mins?|m)?$/i);
  if (match) return `${match[1]}:00`;
  return clean;
}

// Schema.org VideoObject for Google Lighthouse & SEO perfection
const videoSchema = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: video.title,
  description: `${video.title} oleh ${video.channel_name}. Studi kasus inspirasi ekonomi pekarangan dan usaha nahdliyin Sumenep. ${video.practice_summary || ''}`,
  thumbnailUrl: [video.thumbnail_url],
  uploadDate: video.created_at,
  contentUrl: video.video_url,
  embedUrl: embedUrl || video.video_url,
};
---

<Layout
  title={`${video.title} | Studi Kasus Edukasi Mamasar`}
  description={`${video.title} oleh ${video.channel_name}. Pelajari praktik lapangan dan peluang usaha ekonomi pekarangan warga NU Sumenep.`}
  image={video.thumbnail_url}
  schema={videoSchema}
>
  <div class="pb-16 bg-white min-h-screen">
    {/* Breadcrumbs Nav (Desktop only, minimal on mobile) */}
    <div class="hidden md:block border-b border-slate-100 bg-slate-50/50">
      <div class="max-w-[1080px] mx-auto px-3 sm:px-6 lg:px-8 py-2.5">
        <nav aria-label="Breadcrumb" class="flex items-center gap-1.5 text-xs text-slate-500 flex-wrap">
          <a href="/" class="hover:text-emerald-700 font-medium">Beranda</a>
          <AppIcon name="chevron-right" size="xs" class="text-slate-400" />
          <a href="/edukasi" class="hover:text-emerald-700 font-medium">Pusat Edukasi</a>
          <AppIcon name="chevron-right" size="xs" class="text-slate-400" />
          <span class="text-slate-800 font-bold truncate max-w-xs sm:max-w-md">{video.title}</span>
        </nav>
      </div>
    </div>

    {/* Main Cinema Video Workspace - max-w-[1080px] standard */}
    <main class="max-w-[1080px] mx-auto px-3 sm:px-6 lg:px-8 pt-4 sm:pt-6 overflow-x-clip">
      <div class="grid grid-cols-[minmax(0,1fr)] lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        {/* Kolom Kiri: Video Cinema Player & Key Insights (8 Cols) */}
        <section class="min-w-0 lg:col-span-8 space-y-6">
          {/* Cinema Player Container (Full-bleed on mobile, rounded on desktop) */}
          <div class="-mx-3 sm:mx-0 aspect-16/9 bg-slate-950 rounded-none sm:rounded-2xl overflow-hidden shadow-xs border-y sm:border border-slate-800/80 relative group">
            {embedUrl ? (
              <iframe
                src={embedUrl}
                title={video.title}
                class="w-full h-full border-none"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                allowfullscreen
              ></iframe>
            ) : (
              <a
                href={video.video_url}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full h-full relative block select-none"
                title="Buka Video di YouTube"
              >
                <img
                  src={video.thumbnail_url}
                  alt={video.title}
                  class="w-full h-full object-cover opacity-80 group-hover:opacity-90 group-hover:scale-102 transition duration-300"
                />
                <div class="absolute inset-0 bg-slate-950/40 flex flex-col items-center justify-center gap-3">
                  <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-rose-600 hover:bg-rose-700 text-white flex items-center justify-center shadow-xl transition transform group-hover:scale-110 active:scale-95">
                    <svg class="w-8 h-8 sm:w-10 sm:h-10 fill-current translate-x-0.5" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                  <span class="text-white text-xs sm:text-sm font-bold bg-slate-900/80 px-3.5 py-1 rounded-full backdrop-blur-xs">
                    Tonton di YouTube ({video.duration})
                  </span>
                </div>
              </a>
            )}
          </div>

          {/* Video Headline & Author Bar */}
          <div class="space-y-3.5">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="px-2.5 py-0.5 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold">
                {video.tag}
              </span>
              <span class="text-xs text-slate-500">{video.duration}</span>
            </div>

            <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight leading-snug">
              {video.title}
            </h1>
          </div>

          {/* Rincian Praktik & Peluang: dua kolom setara, dipisah garis tipis */}
          {(video.practice_summary || video.opportunity_summary) && (
            <section class="grid grid-cols-1 md:grid-cols-2 md:divide-x divide-y md:divide-y-0 divide-slate-200 border-y border-slate-200">
              {video.practice_summary && (
                <div class="py-5 md:pr-6 space-y-1.5">
                  <h2 class="flex items-center gap-1.5 text-xs font-bold text-emerald-800">
                    <AppIcon name="check" size="xs" class="text-emerald-600" />
                    <span>Praktik Lapangan</span>
                  </h2>
                  <p class="text-sm text-slate-700 leading-relaxed">{video.practice_summary}</p>
                </div>
              )}
              {video.opportunity_summary && (
                <div class="py-5 md:pl-6 space-y-1.5">
                  <h2 class="flex items-center gap-1.5 text-xs font-bold text-amber-800">
                    <AppIcon name="trending-up" size="xs" class="text-amber-600" />
                    <span>Peluang Usaha</span>
                  </h2>
                  <p class="text-sm text-slate-700 leading-relaxed">{video.opportunity_summary}</p>
                </div>
              )}
            </section>
          )}

          {/* Banner Ekosistem Pasar Warga (Anti-Slop Clean CTA) */}
          <div class="bg-emerald-800 text-white rounded-xl p-5 sm:p-6 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-2xs">
            <div class="space-y-1 max-w-lg">
              <h3 class="text-sm sm:text-base font-black leading-snug">
                Siap Memulai Budidaya Pekarangan Mandiri?
              </h3>
              <p class="text-xs text-emerald-100 leading-relaxed">
                Temukan bibit sayuran, pupuk kompos organik, dan peralatan berkebun langsung dari pengrajin & petani warga NU Sumenep.
              </p>
            </div>
            <a
              href="/daftar-toko"
              class="shrink-0 h-9 px-4 bg-white hover:bg-slate-100 text-emerald-900 font-bold text-xs rounded-lg transition inline-flex items-center gap-2 shadow-2xs active:scale-[0.98]"
            >
              <span>Pasar Warga</span>
              <AppIcon name="arrow-right" size="xs" />
            </a>
          </div>
        </section>

        {/* Kolom Kanan: Video Rekomendasi Studi Kasus Lainnya (4 Cols, Sticky) */}
        <aside class="min-w-0 lg:col-span-4 lg:sticky lg:top-20 self-start space-y-5">
          <div class="space-y-3">
            <div class="flex items-center justify-between pb-2 border-b border-slate-100">
              <h2 class="text-xs sm:text-sm font-bold text-slate-900">
                Studi Kasus Lainnya
              </h2>
              <a href="/edukasi" class="text-xs text-emerald-700 hover:underline font-semibold">
                Lihat Semua
              </a>
            </div>

            <div class="space-y-3">
              {relatedVideos.length === 0 ? (
                <div class="p-4 text-center text-xs text-slate-500 bg-slate-50 rounded-lg border border-slate-200">
                  Belum ada video lain.
                </div>
              ) : (
                relatedVideos.map((item) => (
                  <a
                    href={`/edukasi/video/${item.id}`}
                    class="group flex items-start gap-3 p-1.5 -mx-1.5 rounded-lg hover:bg-slate-100/70 transition"
                  >
                    <div class="w-36 aspect-16/9 rounded-md overflow-hidden bg-slate-900 relative shrink-0">
                      <img
                        src={item.thumbnail_url}
                        alt={item.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition duration-200"
                        loading="lazy"
                      />
                      <span class="absolute bottom-1 right-1 bg-black/85 text-white font-sans font-medium text-[10px] leading-none px-1.5 py-0.5 rounded-[3px] select-none tracking-tight">
                        {formatDurationBadge(item.duration)}
                      </span>
                    </div>

                    <div class="min-w-0 flex-1 space-y-1">
                      <h3 class="text-xs font-semibold text-slate-900 leading-snug line-clamp-2 group-hover:text-emerald-700 transition">
                        {item.title}
                      </h3>
                      <div class="text-[11px] text-slate-500 leading-tight space-y-0.5">
                        <p class="truncate font-normal">{item.channel_name}</p>
                        <span class="inline-block text-[10px] font-semibold text-emerald-700 uppercase tracking-wide">
                          {item.tag}
                        </span>
                      </div>
                    </div>
                  </a>
                ))
              )}
            </div>
          </div>

          {/* Panduan Tertulis (Clean Section, Anti-Slop Hairline Divider) */}
          <div class="pt-4 border-t border-slate-200 space-y-2">
            <div class="font-bold text-slate-800 text-xs flex items-center gap-1.5">
              <AppIcon name="book" size="xs" class="text-emerald-700" />
              <span>Panduan Tertulis Terkait</span>
            </div>
            <p class="text-slate-500 leading-relaxed text-xs">
              Pelajari panduan langkah-demi-langkah terkait sertifikasi halal, kiat usaha modal kecil, dan legalitas izin NIB warga.
            </p>
            <a
              href="/edukasi"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 hover:text-emerald-800 hover:underline pt-0.5 group"
            >
              <span>Buka Katalog Panduan</span>
              <AppIcon name="arrow-right" size="xs" />
            </a>
          </div>
        </aside>
      </div>
    </main>
  </div>
</Layout>
