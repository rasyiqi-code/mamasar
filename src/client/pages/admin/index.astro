---
import AppLayout from '../../layouts/AppLayout.astro';
import { resolveUser } from '../../../lib/neon-auth';
import {
  isSuperadmin,
  isPetugas,
  getPendingPetugas,
  getAllUsersForAdmin,
  getUMKMForVerification,
  getAllZones,
  getEvents,
  getEventOrders,
  getAllPendingAdOrders,
  getArticles,
} from '../../../lib/db';

import AdminSidebar from '../../components/admin/AdminSidebar.astro';
import AgentsPanel from '../../components/admin/AgentsPanel.astro';
import StoresPanel from '../../components/admin/StoresPanel.astro';
import EntryPanel from '../../components/admin/EntryPanel.astro';
import EventsPanel from '../../components/admin/EventsPanel.astro';
import ZonesPanel from '../../components/admin/ZonesPanel.astro';
import PromotionsPanel from '../../components/admin/PromotionsPanel.astro';
import AppIcon from '../../components/common/AppIcon.astro';

const user = await resolveUser(Astro.request);
const isSuper = !!user && isSuperadmin(user);
const isCadre = !!user && isPetugas(user);

// Proteksi akses: Khusus semua role selain warga (superadmin, pengurus, atau petugas aktif)
if (!user) {
  return Astro.redirect('/login?error=unauthorized_admin&redirect=/admin');
}

if (!isSuper && !isCadre) {
  return Astro.redirect('/daftar-kader?notice=unauthorized_admin');
}

const [zones, pendingPetugas, allUsers, allStores, allEventOrders, articles] = await Promise.all([
  getAllZones(),
  isSuper ? getPendingPetugas() : Promise.resolve([]),
  getAllUsersForAdmin(),
  getUMKMForVerification(),
  getEventOrders(),
  isSuper ? getArticles() : Promise.resolve([]),
]);

const assignedZone = zones.find((z) => z.id === user.assigned_zone_id);

// Jika petugas/pengurus MWC, batasi daftar toko ke MWC penugasannya
const stores = isSuper
  ? allStores
  : (user.assigned_zone_id ? allStores.filter((s) => s.zone_id === user.assigned_zone_id) : []);

const eventOrders = isSuper
  ? allEventOrders
  : (user.assigned_zone_id ? allEventOrders.filter((o) => o.zone_id === user.assigned_zone_id) : []);

const pendingStores = stores.filter((s) => !s.is_verified);
const verifiedStores = stores.filter((s) => s.is_verified);
const canReviewPromos = isSuper || (user.role === 'mwcnu' && Boolean(user.assigned_zone_id));

const [events, pendingPromotions] = await Promise.all([
  isSuper ? getEvents() : getEvents({ zoneSlug: assignedZone?.slug }),
  isSuper
    ? getAllPendingAdOrders()
    : (canReviewPromos && user.assigned_zone_id ? getAllPendingAdOrders(user.assigned_zone_id) : Promise.resolve([])),
]);

const portalHeading = isSuper
  ? 'Pusat Kendali Admin PCNU Sumenep'
  : user.role === 'mwcnu'
    ? `Portal Pengurus MWC ${assignedZone?.name || 'Sumenep'}`
    : `Portal Kader MWC ${assignedZone?.name || 'Sumenep'}`;

const defaultTabLabel = isSuper ? 'Pengguna & Peran' : 'Entri Jemput Bola';
const scopeBadgeText = isSuper ? 'PCNU Sumenep' : `MWC ${assignedZone?.name || 'Sumenep'}`;
---

<AppLayout
  title={`${portalHeading} | Mamasar`}
  description="Panel kendali operasional terpadu PCNU untuk manajemen akun & peran, persetujuan kader MWC, moderasi toko, dan pendataan UMKM jemput bola."
>
  <div class="min-h-screen w-full max-w-full overflow-x-clip bg-white flex flex-col md:flex-row">
    <!-- Sidebar Navigasi Admin / Pengurus / Petugas -->
    <AdminSidebar
      user={user}
      isSuper={isSuper}
      userRole={user.role}
      assignedZoneName={assignedZone?.name}
      pendingPetugasCount={pendingPetugas.length}
      pendingStoresCount={pendingStores.length}
      zonesCount={zones.length}
      pendingPromotionsCount={pendingPromotions.length}
      articlesCount={articles.length}
    />

    <!-- Kolom Kanan: Sticky Desktop App Header + Workspace Utama -->
    <div class="flex-1 min-w-0 w-full max-w-full flex flex-col">
      <header class="hidden md:flex sticky top-0 z-30 h-14 bg-white/95 backdrop-blur-xs border-b border-slate-200 px-6 lg:px-8 items-center justify-between gap-4 shrink-0">
        <div class="flex items-center gap-2.5 min-w-0">
          <h1 id="admin-desktop-title" class="text-sm sm:text-base font-bold tracking-tight text-slate-900 truncate">
            {defaultTabLabel}
          </h1>
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 text-xs font-medium shrink-0">
            <AppIcon name="map-pin" size="xs" class="text-emerald-700" />
            <span>{scopeBadgeText}</span>
          </span>
        </div>

        <div class="shrink-0">
          {/* Header Actions: Tab Pengguna & Peran */}
          <div data-admin-header-group="agents" class={isSuper ? '' : 'hidden'}>
            <div class="flex items-center gap-1.5">
              <a
                href="/dashboard"
                class="h-8 px-2.5 rounded-md border border-slate-200 bg-white hover:bg-slate-50 text-slate-800 text-xs font-semibold transition inline-flex items-center gap-1 whitespace-nowrap"
              >
                <AppIcon name="store" size="xs" />
                <span>Toko</span>
              </a>
              <button
                type="button"
                data-open-add-user
                class="h-8 px-2.5 rounded-md bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold transition inline-flex items-center gap-1 cursor-pointer whitespace-nowrap"
              >
                <AppIcon name="plus" size="xs" />
                <span>Daftarkan</span>
              </button>
            </div>
          </div>

          {/* Header Actions: Tab Agenda Kegiatan */}
          <div data-admin-header-group="events" class="hidden">
            <div class="flex items-center gap-1.5">
              <a
                href="/kegiatan"
                target="_blank"
                class="h-8 px-2.5 rounded-md border border-slate-300 bg-white hover:bg-slate-50 text-slate-700 text-xs font-semibold transition inline-flex items-center gap-1 whitespace-nowrap"
              >
                <span>Direktori</span>
                <AppIcon name="external-link" size="xs" />
              </a>
              <button
                type="button"
                data-open-add-event
                class="h-8 px-2.5 rounded-md bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold transition inline-flex items-center gap-1 cursor-pointer whitespace-nowrap"
              >
                <AppIcon name="plus" size="xs" />
                <span>Tambah</span>
              </button>
            </div>
          </div>

          {/* Header Actions: Tab Entri Jemput Bola */}
          <div data-admin-header-group="entry" class={isSuper ? 'hidden' : ''}>
            <div class="flex items-center gap-1.5">
              <a
                href="/"
                class="h-8 px-2.5 rounded-md text-slate-700 hover:text-slate-900 hover:bg-slate-100 text-xs font-medium transition inline-flex items-center gap-1 whitespace-nowrap"
              >
                <AppIcon name="globe" size="xs" />
                <span>Katalog</span>
              </a>
              <a
                href="/dashboard"
                class="h-8 px-2.5 rounded-md border border-slate-200 bg-white hover:bg-slate-50 text-slate-800 text-xs font-semibold transition inline-flex items-center gap-1 whitespace-nowrap"
              >
                <AppIcon name="store" size="xs" />
                <span>Toko</span>
              </a>
            </div>
          </div>

          {/* Header Actions: Default (Toko, Promosi, Wilayah) */}
          <div data-admin-header-group="default" class="hidden">
            <div class="flex items-center gap-1.5">
              <a
                href="/"
                class="h-8 px-2.5 rounded-md text-slate-700 hover:text-slate-900 hover:bg-slate-100 text-xs font-medium transition inline-flex items-center gap-1 whitespace-nowrap"
              >
                <AppIcon name="globe" size="xs" />
                <span>Katalog</span>
              </a>
              <a
                href="/dashboard"
                class="h-8 px-2.5 rounded-md border border-slate-200 bg-white hover:bg-slate-50 text-slate-800 text-xs font-semibold transition inline-flex items-center gap-1 whitespace-nowrap"
              >
                <AppIcon name="store" size="xs" />
                <span>Toko</span>
              </a>
              <button
                type="button"
                id="admin-quick-entry-btn"
                data-jump-admin-tab="entry"
                class={`h-8 px-2.5 rounded-md bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold transition items-center gap-1 cursor-pointer whitespace-nowrap ${isSuper ? 'inline-flex' : 'hidden'}`}
              >
                <AppIcon name="plus" size="xs" />
                <span>Entri</span>
              </button>
            </div>
          </div>
        </div>
      </header>

      <main id="main" tabindex="-1" class="flex-1 min-w-0 w-full max-w-full overflow-x-clip pb-24 md:pb-10">
        <span class="sr-only">{portalHeading}</span>

        <!-- Status Box Fallback -->
        <div id="admin-status-box" role="status" aria-live="polite" class="hidden mx-4 sm:mx-6 lg:mx-8 my-4 p-3 rounded-lg text-xs font-semibold"></div>

        <!-- Tab: Manajemen Akun, Peran & Persetujuan Kader/MWC (Khusus Superadmin) -->
        {isSuper && <AgentsPanel pendingPetugas={pendingPetugas} allUsers={allUsers} zones={zones} />}

        <!-- Tab: Kurasi & Moderasi Toko Warga -->
        <StoresPanel pendingStores={pendingStores} verifiedStores={verifiedStores} users={allUsers} />

        <!-- Tab: Pendataan Jemput Bola (Formulir Kamera & Entri Lapangan 2-Step) -->
        <EntryPanel user={user} assignedZone={assignedZone} zones={zones} stores={stores} isDefaultActive={!isSuper} />

        <!-- Tab: Agenda Kegiatan NU & Pasar Konsumsi -->
        <EventsPanel events={events} zones={zones} eventOrders={eventOrders} />

        <!-- Tab: Moderasi Iklan & Promosi Berbayar (PCNU & MWCNU) -->
        {canReviewPromos && <PromotionsPanel pendingPromotions={pendingPromotions} />}

        <!-- Tab: Sebaran Wilayah 24 MWC NU Sumenep (Peta Sebaran Maps) -->
        <ZonesPanel zones={zones} allStores={allStores} />
      </main>
    </div>
  </div>

  <style is:global>
    .admin-nav-tab {
      color: #475569;
      border: 1px solid transparent;
      transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    .admin-nav-tab:hover {
      background-color: #f8fafc;
      color: #0f172a;
    }
    .admin-nav-tab.active {
      background-color: #ecfdf5;
      color: #064e3b;
      border-color: #a7f3d0;
      font-weight: 600;
    }
    .admin-nav-tab.active .admin-nav-badge {
      background-color: #d1fae5;
      color: #065f46;
      border-color: transparent;
    }
  </style>

  <script src="../../scripts/admin.client.ts"></script>
</AppLayout>
