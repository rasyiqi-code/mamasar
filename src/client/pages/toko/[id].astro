---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import AppIcon from '../../components/common/AppIcon.astro';
import NotFoundView from '../../components/common/NotFoundView.astro';
import { getUMKMById } from '../../../lib/db';
import { formatPhoneForWhatsApp, getOptimizedImageUrl } from '../../../lib/utils';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/toko', 301);
}

const store = await getUMKMById(id);

if (store && store.slug && /^\d+$/.test(id.trim())) {
  return Astro.redirect(`/toko/${store.slug}`, 301);
}

if (!store) {
  Astro.response.status = 404;
}

const cleanPhone = store ? formatPhoneForWhatsApp(store.phone) : '';
const maskedPhone = cleanPhone.length > 6 ? `+${cleanPhone.slice(0, 2)} ${cleanPhone.slice(2, 6)}••••` : '+62 ••••';
const storeSlugOrId = store ? store.slug || store.id : id;
const currentUrl = new URL(`/toko/${storeSlugOrId}`, Astro.url.origin).href;
const waLink = store
  ? `https://wa.me/${cleanPhone}?text=${encodeURIComponent(
      `Assalamu'alaikum ${store.name}, saya melihat etalase toko Anda di Mamasar Sumenep. Saya ingin bertanya mengenai ketersediaan produk Anda.`
    )}`
  : '#';

const initials = store
  ? store.name
      .trim()
      .split(/\s+/)
      .slice(0, 2)
      .map((w) => w[0]?.toUpperCase() || '')
      .join('')
      .slice(0, 2) || 'NU'
  : 'NU';

const legalityItems = store
  ? [
      store.nib ? { label: 'Nomor Induk Berusaha (NIB)', value: store.nib } : null,
      store.halal_cert ? { label: 'Sertifikasi Halal (BPJPH)', value: store.halal_cert } : null,
      store.pirt ? { label: 'Izin P-IRT (Dinkes)', value: store.pirt } : null,
      store.bpom ? { label: 'Izin Edar BPOM', value: store.bpom } : null,
      store.other_legalities ? { label: 'Legalitas Lainnya', value: store.other_legalities } : null,
    ].filter((item): item is { label: string; value: string } => Boolean(item))
  : [];

// Structured Schema.org Organization/LocalBusiness for SEO
const storeSchema = store
  ? {
      '@context': 'https://schema.org',
      '@type': 'LocalBusiness',
      '@id': currentUrl,
      name: store.name,
      telephone: `+${cleanPhone}`,
      address: {
        '@type': 'PostalAddress',
        streetAddress: store.address || 'Kabupaten Sumenep',
        addressLocality: store.zone_name,
        addressRegion: 'Jawa Timur',
        addressCountry: 'ID',
      },
      url: currentUrl,
    }
  : undefined;
---

<Layout
  title={store ? `${store.name} - Toko UMKM Warga NU ${store.zone_name} Sumenep` : 'Toko Tidak Ditemukan (404) | Mamasar'}
  description={
    store
      ? `Profil dan etalase produk resmi ${store.name} di ${store.zone_name}, Sumenep. Belanja langsung dari pengrajin warga Nahdliyin.`
      : 'Toko UMKM yang Anda cari tidak ditemukan atau telah dihapus.'
  }
  canonicalUrl={currentUrl}
  noindex={!store}
  hideMobileNav={Boolean(store)}
  schema={storeSchema}
>
  {!store ? (
    <NotFoundView
      heading="Toko Tidak Ditemukan"
      message="Maaf, etalase toko UMKM yang Anda cari tidak terdaftar atau sudah tidak aktif lagi di direktori Mamasar."
      primaryHref="/toko"
      primaryLabel="Lihat Semua Toko Warga"
    />
  ) : (
    <div class="pb-24 md:pb-10">
      <!-- Full-Bleed Top Identity Header (Box-Free Hairline Layout) -->
      <header class="-mx-0 sm:-mx-6 lg:-mx-8 px-3 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-4 sm:space-y-5 bg-white border-b border-slate-200">
        <!-- Breadcrumb (Desktop Only) -->
          <div class="hidden md:flex items-center justify-between text-xs text-slate-600">
            <nav aria-label="Breadcrumb" class="flex items-center gap-2 truncate">
              <a href="/" class="hover:text-emerald-700 transition">Beranda</a>
              <span aria-hidden="true">›</span>
              <a href="/toko" class="hover:text-emerald-700 transition">Toko</a>
              <span aria-hidden="true">›</span>
              <a href={`/toko?zona=${store.zone_slug}`} class="hover:text-emerald-700 truncate transition">
                {store.zone_name}
              </a>
              <span aria-hidden="true">›</span>
              <span class="text-slate-900 font-bold truncate">{store.name}</span>
            </nav>

            <a
              href="/toko"
              class="hidden sm:inline-flex items-center gap-1 text-xs font-semibold text-slate-600 hover:text-emerald-700 transition shrink-0"
            >
              <span>← Semua Toko</span>
            </a>
          </div>

          <!-- Store Identity Row -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div class="flex items-start sm:items-center gap-3.5 sm:gap-4 min-w-0">
              <div class="relative shrink-0">
                {store.logo_url ? (
                  <img
                    src={getOptimizedImageUrl(store.logo_url, 200)}
                    alt={`Logo ${store.name}`}
                    width="80"
                    height="80"
                    class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl object-cover border border-slate-200 bg-white"
                  />
                ) : (
                  <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl bg-emerald-800 text-white flex items-center justify-center font-black text-xl sm:text-2xl tracking-tight">
                    {initials}
                  </div>
                )}
                {Boolean(store.is_verified) && (
                  <span
                    class="absolute -bottom-1 -right-1 bg-emerald-700 text-white w-6 h-6 rounded-full border-2 border-white flex items-center justify-center shadow-xs"
                    title="Terverifikasi MWC NU"
                  >
                    <AppIcon name="check" size="xs" />
                  </span>
                )}
              </div>

              <div class="space-y-1.5 min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <h1 class="text-xl sm:text-2xl lg:text-3xl font-black text-slate-900 tracking-tight leading-tight">
                    {store.name}
                  </h1>
                  {Boolean(store.is_verified) ? (
                    <span class="inline-flex items-center gap-1 text-xs font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-md">
                      <AppIcon name="check" size="xs" />
                      <span>Terverifikasi MWC</span>
                    </span>
                  ) : (
                    <span class="inline-flex items-center text-xs font-semibold text-slate-700 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded-md">
                      Belum Verifikasi
                    </span>
                  )}
                </div>

                <p class="text-xs sm:text-sm text-slate-600 flex items-center gap-1.5 min-w-0 flex-wrap">
                  <AppIcon name="map-pin" size="xs" class="text-emerald-700 shrink-0" />
                  <span class="truncate">
                    {store.ranting ? `Ranting ${store.ranting}, ` : ''}
                    {store.zone_name}
                    {store.address ? ` • ${store.address}` : ''}
                  </span>
                  {store.maps_url && (
                    <a
                      href={store.maps_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs font-bold text-emerald-700 hover:text-emerald-900 underline inline-flex items-center gap-0.5 ml-1 shrink-0"
                    >
                      <span>Buka Google Maps</span>
                      <AppIcon name="arrow-right" size="xs" />
                    </a>
                  )}
                </p>

                {legalityItems.length > 0 && (
                  <div class="flex flex-wrap items-center gap-1.5 pt-0.5">
                    {store.halal_cert && (
                      <span class="text-xs font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded">Halal</span>
                    )}
                    {store.nib && (
                      <span class="text-xs font-bold text-slate-800 bg-slate-100 px-2 py-0.5 rounded">NIB</span>
                    )}
                    {store.pirt && (
                      <span class="text-xs font-bold text-amber-900 bg-amber-50 px-2 py-0.5 rounded">P-IRT</span>
                    )}
                    {store.bpom && (
                      <span class="text-xs font-bold text-sky-900 bg-sky-50 px-2 py-0.5 rounded">BPOM</span>
                    )}
                  </div>
                )}
              </div>
            </div>

            <!-- Primary Actions -->
            <div class="flex items-center gap-2 shrink-0 flex-wrap">
              <a
                href={waLink}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-1 sm:flex-initial min-h-[44px] py-2.5 px-5 bg-emerald-700 hover:bg-emerald-800 active:scale-98 text-white font-bold text-xs sm:text-sm rounded-lg transition inline-flex items-center justify-center gap-2"
              >
                <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
                </svg>
                <span>Chat WhatsApp</span>
              </a>

              {store.maps_url && (
                <a
                  href={store.maps_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Petunjuk Arah Google Maps"
                  title="Buka Lokasi Toko di Google Maps"
                  class="min-w-[44px] min-h-[44px] px-3.5 rounded-lg bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 text-emerald-900 text-xs font-bold inline-flex items-center gap-1.5 transition"
                >
                  <AppIcon name="map-pin" size="xs" class="text-emerald-700" />
                  <span class="hidden sm:inline">Peta Lokasi</span>
                </a>
              )}

              {store.qris_image_url && (
                <button
                  type="button"
                  id="btn-show-store-qris"
                  aria-label="Tampilkan QRIS Toko"
                  title="Bayar Non-Tunai lewat QRIS"
                  class="min-w-[44px] min-h-[44px] px-3.5 rounded-lg bg-slate-100 hover:bg-slate-200 border border-slate-300 text-slate-900 text-xs font-bold inline-flex items-center gap-1.5 transition cursor-pointer"
                >
                  <AppIcon name="qrcode" size="xs" class="text-emerald-700" />
                  <span>QRIS Toko</span>
                </button>
              )}

              <a
                href={`https://wa.me/?text=${encodeURIComponent(`Kunjungi Toko ${store.name} di Mamasar Sumenep: ${currentUrl}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Bagikan Toko"
                title="Bagikan Profil Toko"
                class="min-w-[44px] min-h-[44px] rounded-lg bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 inline-flex items-center justify-center transition"
              >
                <AppIcon name="share" size="sm" />
              </a>
            </div>
          </div>

          <!-- Hairline Store Summary Strip (No Box Tiles) -->
          <dl class="pt-4 border-t border-slate-200 grid grid-cols-2 sm:grid-cols-4 gap-y-3 gap-x-0 sm:divide-x sm:divide-slate-200">
            <div class="pr-3 sm:pr-5 border-r border-slate-200 sm:border-r-0">
              <dt class="text-xs text-slate-500">Produk Tayang</dt>
              <dd class="text-sm font-extrabold text-slate-900 tabular-nums mt-0.5">
                {store.products.length} Produk
              </dd>
            </div>
            <div class="pl-3 sm:px-5">
              <dt class="text-xs text-slate-500">Wilayah MWC</dt>
              <dd class="text-sm font-extrabold text-slate-900 mt-0.5 truncate">{store.zone_name}</dd>
            </div>
            <div class="pr-3 sm:px-5 border-r border-slate-200 sm:border-r-0">
              <dt class="text-xs text-slate-500">Verifikasi</dt>
              <dd class={`text-sm font-extrabold mt-0.5 ${Boolean(store.is_verified) ? 'text-emerald-700' : 'text-slate-700'}`}>
                {Boolean(store.is_verified) ? 'Terverifikasi' : 'Menunggu'}
              </dd>
            </div>
            <div class="pl-3 sm:pl-5">
              <dt class="text-xs text-slate-500">Transaksi</dt>
              <dd class="text-sm font-extrabold text-slate-900 mt-0.5">COD / Kirim Paket</dd>
            </div>
          </dl>
      </header>

      <!-- Open Canvas 2-Column Content (No Box Containers) -->
      <div class="px-3 sm:px-0 pt-6 sm:pt-8">
        <div class="md:grid md:grid-cols-12 md:gap-8 lg:gap-10 items-start space-y-8 md:space-y-0">
          <!-- LEFT COLUMN: Open Product Grid & Store Editorial Info -->
          <div class="md:col-span-8 space-y-8">
            <!-- Etalase Produk (Directly on Page Canvas) -->
            <section class="space-y-4">
              <div class="flex items-baseline justify-between gap-3 pb-3 border-b border-slate-200">
                <h2 class="text-lg sm:text-xl font-black text-slate-900 tracking-tight">
                  Etalase Produk
                </h2>
                <span class="text-xs font-bold text-slate-600 tabular-nums">
                  {store.products.length} iklan tayang
                </span>
              </div>

              {store.products.length > 0 ? (
                <div class="-mx-3 sm:mx-0 grid grid-cols-2 sm:grid-cols-3 gap-px sm:gap-4 bg-slate-200 sm:bg-transparent border-y sm:border-0 border-slate-200 [&>article]:rounded-none sm:[&>article]:rounded-lg [&>article]:border-0 sm:[&>article]:border [&>article]:shadow-none sm:[&>article]:shadow-xs">
                  {store.products.map((p) => (
                    <ProductCard product={p} showSellerAvatar={false} />
                  ))}
                </div>
              ) : (
                <div class="py-12 border-b border-slate-200 text-center space-y-2">
                  <AppIcon name="box" size="xl" class="mx-auto text-slate-400" />
                  <p class="text-sm text-slate-600 font-medium">
                    Belum ada produk aktif yang terdaftar untuk toko ini.
                  </p>
                </div>
              )}
            </section>

            <!-- Tentang Usaha -->
            <section class="pt-6 border-t border-slate-200 space-y-3">
              <h2 class="text-base font-black text-slate-900 tracking-tight">
                Tentang Usaha
              </h2>
              <p class="text-sm text-slate-700 leading-relaxed">
                <strong>{store.name}</strong> adalah usaha warga Nahdliyin di{' '}
                <strong>{store.address || store.zone_name}</strong>, Kabupaten Sumenep. Seluruh pesanan diproses dan
                dikirim langsung oleh pemilik usaha tanpa potongan komisi perantara.
              </p>

              <div class="pt-2 flex flex-wrap gap-x-6 gap-y-2 text-xs text-slate-700">
                <span class="inline-flex items-center gap-1.5">
                  <AppIcon name="check" size="xs" class="text-emerald-700" />
                  <span>Produk Lokal Sumenep</span>
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <AppIcon
                    name={Boolean(store.is_verified) ? 'check' : 'clock'}
                    size="xs"
                    class={Boolean(store.is_verified) ? 'text-emerald-700' : 'text-slate-600'}
                  />
                  <span>{Boolean(store.is_verified) ? 'Terverifikasi MWC NU' : 'Menunggu Verifikasi MWC'}</span>
                </span>
                <span class="inline-flex items-center gap-1.5">
                  <AppIcon name="check" size="xs" class="text-emerald-700" />
                  <span>Mendukung COD</span>
                </span>
              </div>
            </section>

            <!-- Legalitas Usaha (Hairline Definition List) -->
            {legalityItems.length > 0 && (
              <section class="pt-6 border-t border-slate-200 space-y-3">
                <h2 class="text-base font-black text-slate-900 tracking-tight">
                  Legalitas Usaha
                </h2>
                <dl class="-mx-3 px-3 sm:mx-0 sm:px-0 divide-y divide-slate-200 border-y border-slate-200">
                  {legalityItems.map((item) => (
                    <div class="py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-1 text-xs sm:text-sm">
                      <dt class="text-slate-600 font-medium">{item.label}</dt>
                      <dd class="font-mono font-bold text-slate-900">{item.value}</dd>
                    </div>
                  ))}
                </dl>
              </section>
            )}
          </div>

          <!-- RIGHT COLUMN: Docked Hairline Sidebar (No Box Container) -->
          <aside class="md:col-span-4 md:sticky md:top-20 self-start md:border-l md:border-slate-200 md:pl-8 pt-6 md:pt-0 border-t md:border-t-0 border-slate-200 space-y-6">
            <div class="space-y-2.5">
              <a
                href={waLink}
                target="_blank"
                rel="noopener noreferrer"
                class="hidden md:flex w-full min-h-[44px] py-3 px-4 bg-emerald-700 hover:bg-emerald-800 active:scale-98 text-white rounded-lg font-bold text-sm items-center justify-center gap-2 transition"
              >
                <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
                </svg>
                <span>Hubungi Pemilik Toko</span>
              </a>

              <a
                href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${store.name} ${store.zone_name} Sumenep`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full min-h-[44px] py-2.5 px-3 bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 text-xs font-bold rounded-lg flex items-center justify-center gap-1.5 transition"
              >
                <AppIcon name="map" size="xs" class="text-emerald-700" />
                <span>Buka Google Maps</span>
              </a>
            </div>

            <!-- Contact & Location Details -->
            <div class="pt-5 border-t border-slate-200 space-y-3">
              <h3 class="text-xs font-black uppercase tracking-wider text-slate-800">
                Kontak &amp; Lokasi
              </h3>
              <dl class="space-y-3 text-xs">
                <div>
                  <dt class="text-slate-500">Alamat Usaha</dt>
                  <dd class="text-slate-900 font-medium mt-0.5 leading-relaxed">
                    {store.address || 'Kabupaten Sumenep, Madura'}
                  </dd>
                </div>
                <div>
                  <dt class="text-slate-500">Wilayah MWC NU</dt>
                  <dd class="text-slate-900 font-medium mt-0.5">{store.zone_name}</dd>
                </div>
                <div>
                  <dt class="text-slate-500">WhatsApp</dt>
                  <dd class="font-mono font-bold text-slate-900 mt-0.5">{maskedPhone} (Aktif)</dd>
                </div>
              </dl>
            </div>

            <!-- Safety Tips Strip -->
            <div class="pt-5 border-t border-slate-200">
              <div class="border-l-2 border-amber-500 pl-3.5 space-y-2">
                <h4 class="text-xs font-black text-slate-900 uppercase tracking-wider">
                  Belanja Aman
                </h4>
                <ul class="text-xs text-slate-600 space-y-1.5 leading-relaxed">
                  <li>Sepakati COD atau transfer saat barang siap kirim.</li>
                  <li>Pesanan grosir dapat langsung mengunjungi alamat UMKM di atas.</li>
                </ul>
              </div>
            </div>
          </aside>
        </div>
      </div>

      <!-- Mobile Sticky Bottom WhatsApp Bar -->
      <div class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom,0px))] shadow-lg">
        <div class="flex items-center gap-3">
          <div class="min-w-0 shrink-0 pl-1">
            <span class="text-xs text-slate-500 block leading-tight">Toko Warga NU</span>
            <span class="text-xs font-black text-slate-900 block truncate max-w-[140px]">
              {store.name}
            </span>
          </div>
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 min-h-[44px] py-2.5 px-4 bg-emerald-700 active:bg-emerald-800 text-white rounded-lg font-bold text-xs flex items-center justify-center gap-2 transition"
          >
            <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
            </svg>
            <span>Chat WhatsApp</span>
          </a>
        </div>
      </div>

      <!-- QRIS Toko Modal -->
      {store.qris_image_url && (
        <dialog
          id="modal-store-qris"
          class="p-0 rounded-2xl bg-white shadow-2xl backdrop:bg-slate-950/60 max-w-sm w-[90vw] mx-auto my-auto border border-slate-200"
        >
          <div class="p-6 text-center space-y-4">
            <div class="flex items-center justify-between pb-2 border-b border-slate-100">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-extrabold text-xs">QRIS RESMI</span>
                <h3 class="text-sm font-bold text-slate-900 truncate max-w-[180px]">{store.name}</h3>
              </div>
              <button
                type="button"
                id="btn-close-store-qris"
                aria-label="Tutup Modal QRIS"
                class="w-8 h-8 rounded-full hover:bg-slate-100 inline-flex items-center justify-center text-slate-500 hover:text-slate-700 cursor-pointer"
              >
                <AppIcon name="x" size="sm" />
              </button>
            </div>
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 flex justify-center">
              <img
                src={store.qris_image_url}
                alt={`QRIS Toko ${store.name}`}
                class="max-w-full max-h-80 object-contain rounded-lg"
                loading="eager"
              />
            </div>
            <p class="text-xs text-slate-500 leading-relaxed">
              Pindai dengan aplikasi m-Banking (BCA, BRI, BNI, Mandiri, BSI, dll) atau e-Wallet (GoPay, OVO, Dana, LinkAja) untuk pembayaran langsung ke rekening pemilik toko.
            </p>
          </div>
        </dialog>
      )}

      <script>
        const btnShowQris = document.getElementById('btn-show-store-qris');
        const modalQris = document.getElementById('modal-store-qris') as HTMLDialogElement | null;
        const btnCloseQris = document.getElementById('btn-close-store-qris');
        if (btnShowQris && modalQris) {
          btnShowQris.addEventListener('click', () => modalQris.showModal());
          btnCloseQris?.addEventListener('click', () => modalQris.close());
          modalQris.addEventListener('click', (e) => {
            if (e.target === modalQris) modalQris.close();
          });
        }
      </script>
    </div>
  )}
</Layout>
