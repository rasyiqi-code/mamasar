---
import '../styles/global.css';
import { SITE_CONFIG } from '../../lib/constants';
import ConfirmDialog from '../components/common/ConfirmDialog.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Pusat Manajemen Mamasar Kabupaten Sumenep',
} = Astro.props;

const siteName = SITE_CONFIG.name;
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="id" class="h-full bg-white text-slate-900 overflow-x-clip overscroll-x-contain">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- SEO & Security -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />

    <!-- PWA & Mobile Meta Tags -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="theme-color" content="#047857" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Mamasar" />
  </head>
  <body class="min-h-full bg-white text-slate-900 font-sans antialiased flex flex-col overflow-x-clip overscroll-x-contain selection:bg-emerald-500 selection:text-white">
    <!-- Global Navigation Progress Bar for Instant Touch/Click Feedback in PWA & Mobile -->
    <div
      id="global-page-progress"
      class="fixed top-0 left-0 right-0 h-1 bg-emerald-600 z-[9999] opacity-0 pointer-events-none transition-all duration-300"
      style="width: 0%;"
      role="progressbar"
      aria-hidden="true"
    ></div>

    <a href="#main" class="skip-link">Langsung ke konten</a>

    <!-- Main App Slot (Zero Front Web Header or Footer) -->
    <div class="flex-1 min-w-0 w-full max-w-full flex flex-col min-h-screen overflow-x-clip">
      <slot />
    </div>

    <ConfirmDialog />

    <!-- App Global Toast Container -->
    <div
      id="app-toast"
      class="fixed bottom-20 md:bottom-6 left-1/2 -translate-x-1/2 z-50 max-w-[calc(100vw-2rem)] bg-slate-900 text-white text-xs font-bold px-4 py-2.5 rounded-lg shadow-md transition-all duration-300 opacity-0 pointer-events-none translate-y-2 flex items-center gap-2 border border-slate-800"
      role="status"
      aria-live="polite"
    >
      <span id="app-toast-icon" class="flex items-center shrink-0"></span>
      <span id="app-toast-msg">Notifikasi</span>
    </div>

    <script>
      let toastTimeout: any;
      (window as any).showAppToast = function (msg: string, isError = false) {
        const toast = document.getElementById('app-toast');
        const toastMsg = document.getElementById('app-toast-msg');
        const toastIcon = document.getElementById('app-toast-icon');
        if (!toast || !toastMsg || !toastIcon) return;

        toastMsg.textContent = msg;
        toastIcon.innerHTML = isError
          ? '<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>'
          : '<svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5L20 7"/></svg>';

        if (isError) {
          toast.classList.remove('bg-slate-900/95', 'border-slate-800');
          toast.classList.add('bg-rose-900/95', 'border-rose-700');
        } else {
          toast.classList.remove('bg-rose-900/95', 'border-rose-700');
          toast.classList.add('bg-slate-900/95', 'border-slate-800');
        }

        toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
        toast.classList.add('opacity-100', 'translate-y-0');

        clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => {
          toast.classList.remove('opacity-100', 'translate-y-0');
          toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
        }, 2500);
      };

      // PWA Service Worker Registration
      if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js', { scope: '/' }).catch(() => {});
        });
      }

      // Instant Navigation Progress Bar (Eliminates perceived lag on page switch in PWA/Mobile)
      const progressBar = document.getElementById('global-page-progress');
      let progressTimer: any = null;

      function startPageProgress() {
        if (!progressBar) return;
        clearTimeout(progressTimer);
        progressBar.style.transition = 'width 150ms ease-out, opacity 100ms ease';
        progressBar.style.opacity = '1';
        progressBar.style.width = '35%';
        progressTimer = setTimeout(() => {
          progressBar.style.transition = 'width 800ms cubic-bezier(0.1, 0.5, 0.1, 1)';
          progressBar.style.width = '82%';
        }, 150);
      }

      function finishPageProgress() {
        if (!progressBar) return;
        clearTimeout(progressTimer);
        progressBar.style.transition = 'width 120ms ease-in, opacity 200ms ease 100ms';
        progressBar.style.width = '100%';
        progressBar.style.opacity = '0';
        setTimeout(() => {
          progressBar.style.width = '0%';
        }, 350);
      }

      document.addEventListener('click', (e) => {
        const anchor = (e.target as HTMLElement)?.closest('a');
        if (!anchor) return;
        const href = anchor.getAttribute('href');
        if (!href || href.startsWith('#') || href.startsWith('javascript:') || href.startsWith('tel:') || href.startsWith('mailto:')) return;
        if (anchor.target === '_blank' || anchor.hasAttribute('download')) return;

        try {
          const targetUrl = new URL(anchor.href, window.location.href);
          if (targetUrl.origin === window.location.origin && (targetUrl.pathname !== window.location.pathname || targetUrl.search !== window.location.search)) {
            startPageProgress();
          }
        } catch {}
      }, { passive: true });

      window.addEventListener('pageshow', () => {
        finishPageProgress();
      });
      window.addEventListener('beforeunload', () => {
        startPageProgress();
        if (progressBar) progressBar.style.width = '100%';
      });
    </script>
  </body>
</html>
