---
import '../styles/global.css';
import { SITE_CONFIG } from '../../lib/constants';
import { getAllZones, isPCNU, isRanting } from '../../lib/db';
import { resolveUser } from '../../lib/neon-auth';
import { safeJsonLd } from '../../lib/security';
import AppIcon from '../components/common/AppIcon.astro';
import ConfirmDialog from '../components/common/ConfirmDialog.astro';
import MamasarLogo from '../components/common/MamasarLogo.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  noindex?: boolean;
  schema?: Record<string, any>;
  hideMobileNav?: boolean;
}

const {
  title,
  description = SITE_CONFIG.description,
  image = SITE_CONFIG.defaultOgImage,
  canonicalUrl,
  noindex = false,
  schema,
  hideMobileNav = false,
} = Astro.props;

const defaultCanonical = new URL(Astro.url.pathname, Astro.url.origin).href;
const resolvedCanonical = canonicalUrl
  ? new URL(canonicalUrl, Astro.url.origin).href.split('#')[0]
  : defaultCanonical;
const robotsContent = noindex ? 'noindex, nofollow' : 'index, follow';

const siteName = SITE_CONFIG.name;
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const absoluteOgImage = image.startsWith('http') ? image : new URL(image, Astro.url).href;
const zones = await getAllZones();
const currentYear = new Date().getFullYear();

const user = await resolveUser(Astro.request);
const isSuperadmin = isPCNU(user);
const isPetugas = isRanting(user);
const currentPath = Astro.url.pathname;
const navLinkClass = (active: boolean) =>
  active
    ? 'text-emerald-800 bg-emerald-50 border border-emerald-200 px-2.5 py-1.5 rounded-lg font-bold flex items-center gap-1.5 transition whitespace-nowrap'
    : 'hover:text-emerald-700 px-2 py-1.5 rounded-lg transition flex items-center gap-1.5 whitespace-nowrap';
---

<!doctype html>
<html lang="id" class="h-full bg-[#f8fafc] text-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={resolvedCanonical} />

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />

    <!-- PWA & Mobile Meta Tags -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icon-192.png" />
    <meta name="theme-color" content="#059669" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Mamasar" />

    <!-- Open Graph / WhatsApp / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    {schema && (
      <script type="application/ld+json" set:html={safeJsonLd(schema)} />
    )}
  </head>
  <body class={`min-h-full flex flex-col font-sans antialiased overflow-x-clip bg-[#f8fafc] text-slate-900 ${hideMobileNav ? '' : 'pb-16 md:pb-0'}`}>
    <a href="#main" class="skip-link">Langsung ke konten</a>

    <!-- Top Classifieds Header (OsClass Light Aesthetic) -->
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200/90 shadow-xs">
      <div class="max-w-site mx-auto px-3 sm:px-6 lg:px-8 py-2 sm:py-3 flex items-center justify-between gap-3">
        
        <!-- Mobile Hamburger Button & Brand Logo -->
        <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
          <button
            id="open-mobile-drawer"
            type="button"
            aria-label="Buka Menu"
            class="lg:hidden min-w-[44px] min-h-[44px] flex items-center justify-center text-slate-700 hover:text-slate-900 hover:bg-slate-100 rounded-lg cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>

          <a href="/" class="flex items-center gap-2 sm:gap-2.5 group min-h-[44px]">
            <MamasarLogo size="lg" class="shadow-sm group-hover:bg-emerald-800 transition" />
            <div>
              <div class="font-black text-sm sm:text-base tracking-tight leading-none text-slate-900">
                <span>Mamasar</span>
              </div>
              <p class="hidden sm:block text-xs text-slate-600 mt-0.5">Direktori UMKM Nahdliyin</p>
            </div>
          </a>
        </div>

        <!-- Desktop Navigation Links -->
        <nav aria-label="Navigasi Utama" class="hidden lg:flex items-center gap-1.5 text-xs font-semibold text-slate-700">
          <a href="/" aria-current={currentPath === '/' ? 'page' : undefined} class={navLinkClass(currentPath === '/')}>
            <AppIcon name="clipboard" size="xs" class={currentPath === '/' ? 'text-emerald-700' : 'text-slate-400'} />
            <span>Katalog</span>
          </a>
          <a href="/pekarangan" aria-current={currentPath.startsWith('/pekarangan') ? 'page' : undefined} class={navLinkClass(currentPath.startsWith('/pekarangan'))}>
            <AppIcon name="sprout" size="xs" class={currentPath.startsWith('/pekarangan') ? 'text-emerald-700' : 'text-slate-400'} />
            <span>Pekarangan</span>
          </a>
          <a href="/kegiatan" aria-current={currentPath.startsWith('/kegiatan') ? 'page' : undefined} class={navLinkClass(currentPath.startsWith('/kegiatan'))}>
            <AppIcon name="tent" size="xs" class={currentPath.startsWith('/kegiatan') ? 'text-emerald-700' : 'text-slate-400'} />
            <span>Kegiatan</span>
          </a>
          <a href="/edukasi" aria-current={currentPath.startsWith('/edukasi') ? 'page' : undefined} class={navLinkClass(currentPath.startsWith('/edukasi'))}>
            <AppIcon name="book" size="xs" class={currentPath.startsWith('/edukasi') ? 'text-emerald-700' : 'text-slate-400'} />
            <span>Edukasi</span>
          </a>
          <a href="/favorit" aria-current={currentPath.startsWith('/favorit') ? 'page' : undefined} class={navLinkClass(currentPath.startsWith('/favorit'))}>
            <AppIcon name="star" size="xs" class={currentPath.startsWith('/favorit') ? 'text-emerald-700' : 'text-slate-400'} />
            <span>Favorit</span>
          </a>
        </nav>

        <!-- Right Side: Post Ad Button & Admin/Dashboard Links -->
        <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
          {isSuperadmin && (
            <a
              href="/admin"
              title="Konsol Admin"
              aria-label="Konsol Admin"
              class="hidden sm:inline-flex items-center justify-center w-8 h-8 rounded-lg text-rose-700 bg-rose-50 hover:bg-rose-100 border border-rose-300 transition shadow-2xs hover:shadow-xs active:scale-95 cursor-pointer"
            >
              <AppIcon name="shield" size="xs" class="text-rose-600" />
            </a>
          )}
          {isPetugas && !isSuperadmin && (
            <a
              href="/admin#entry"
              title={user?.role === 'mwcnu' ? 'Pengurus MWC' : 'Petugas MWC'}
              aria-label={user?.role === 'mwcnu' ? 'Pengurus MWC' : 'Petugas MWC'}
              class="hidden sm:inline-flex items-center justify-center w-8 h-8 rounded-lg text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-300 transition shadow-2xs hover:shadow-xs active:scale-95 cursor-pointer"
            >
              <AppIcon name="clipboard" size="xs" class="text-emerald-600" />
            </a>
          )}

          <a
            href={user ? "/dashboard" : "/login"}
            title={user ? (user.umkm ? 'Toko Saya' : 'Dashboard Toko') : 'Masuk / Daftar'}
            aria-label={user ? (user.umkm ? 'Toko Saya' : 'Dashboard Toko') : 'Masuk / Daftar'}
            class="hidden sm:inline-flex items-center justify-center w-8 h-8 rounded-lg text-slate-700 hover:text-emerald-700 border border-slate-200 bg-slate-50 hover:bg-slate-100 transition shadow-2xs hover:shadow-xs active:scale-95 cursor-pointer"
          >
            <AppIcon name="store" size="xs" class="text-slate-600" />
          </a>
          <a
            href="/#hero-q"
            aria-label="Cari produk UMKM"
            class="sm:hidden min-w-[36px] min-h-[36px] inline-flex items-center justify-center text-slate-700 hover:text-emerald-700 hover:bg-slate-100 rounded-lg transition"
          >
            <AppIcon name="search" size="sm" />
          </a>
          <a
            href="/pasang-iklan"
            class="hidden sm:inline-flex h-8 items-center gap-1.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs px-3 rounded-lg transition shadow-2xs hover:shadow-xs active:scale-95"
          >
            <AppIcon name="plus" size="xs" />
            <span>Pasang Iklan</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Mobile Slide-out Drawer (Light Theme) -->
    <div id="mobile-drawer-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden transition-opacity"></div>
    <aside
      id="mobile-drawer"
      class="fixed top-0 left-0 bottom-0 w-72 max-w-[85vw] bg-white border-r border-slate-200 z-50 transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col justify-between hidden shadow-2xl"
    >
      <!-- Brand Drawer Header -->
      <div class="p-4 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5">
          <MamasarLogo size="md" class="shadow-sm" />
          <div>
            <div class="font-black text-sm text-slate-900 tracking-tight leading-none">
              <span>Mamasar</span>
            </div>
            <p class="text-[11px] text-slate-500 mt-0.5">Pasar UMKM Nahdliyin</p>
          </div>
        </a>
        <button id="close-mobile-drawer" aria-label="Tutup Menu" class="min-w-[44px] min-h-[44px] text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg cursor-pointer flex items-center justify-center">
          <AppIcon name="close" size="sm" />
        </button>
      </div>

      <!-- Drawer Nav Links -->
      <div class="p-3.5 space-y-1.5 flex-1 overflow-y-auto text-xs font-semibold text-slate-700">
        {user && (
          <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between gap-2.5 mb-2">
            <div class="flex items-center gap-2.5 min-w-0">
              <div class="w-8 h-8 rounded-full bg-emerald-700 text-white font-bold text-xs flex items-center justify-center shrink-0">
                {(user.name || user.email || 'U').slice(0, 2).toUpperCase()}
              </div>
              <div class="min-w-0">
                <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block leading-tight">Akun Masuk</span>
                <p class="text-xs font-bold text-slate-900 truncate">{user.name || user.email}</p>
              </div>
            </div>
            <span class="text-[10px] font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full shrink-0">
              {isSuperadmin ? 'Admin' : isPetugas ? 'Petugas' : 'Warga'}
            </span>
          </div>
        )}
        {isSuperadmin && (
          <a href="/admin" class="flex items-center gap-2.5 p-2.5 rounded-xl bg-rose-50 text-rose-900 border border-rose-300 font-bold hover:bg-rose-100 transition shadow-2xs">
            <AppIcon name="shield" size="sm" class="text-rose-600" />
            <span>Konsol Superadmin</span>
          </a>
        )}
        <a href={user ? "/dashboard" : "/login"} class="flex items-center gap-2.5 p-2.5 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold hover:bg-emerald-100 transition shadow-2xs">
          <AppIcon name="store" size="sm" class="text-emerald-700" />
          <span>{user ? 'Dashboard Toko Saya' : 'Masuk / Daftar Akun'}</span>
        </a>
        <a href={isPetugas ? '/admin#entry' : '/daftar-kader'} class="flex items-center gap-2.5 p-2.5 rounded-xl bg-emerald-700 hover:bg-emerald-800 text-white font-bold shadow-sm transition">
          <AppIcon name="plus" size="sm" />
          <span>{isPetugas ? 'Portal Pengurus / Petugas' : 'Daftar Pengurus / Petugas'}</span>
        </a>

        <!-- Tombol Install PWA (Otomatis tampil saat didukung peramban) -->
        <button
          id="pwa-install-drawer-btn"
          type="button"
          class="hidden w-full items-center justify-between p-2.5 rounded-xl bg-emerald-50 text-emerald-900 border border-emerald-200 font-bold hover:bg-emerald-100 transition cursor-pointer text-xs"
        >
          <div class="flex items-center gap-2.5">
            <AppIcon name="download" size="sm" class="text-emerald-700" />
            <span>Install Aplikasi Mamasar</span>
          </div>
          <span class="text-[10px] uppercase font-bold px-1.5 py-0.5 rounded bg-emerald-700 text-white">App</span>
        </button>
        <a href="/" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition">
          <AppIcon name="clipboard" size="sm" class="text-slate-400" />
          <span>Katalog Iklan</span>
        </a>
        <a href="/pekarangan" class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition">
          <div class="flex items-center gap-2.5">
            <AppIcon name="sprout" size="sm" class="text-emerald-700" />
            <span>Aplikasi Pekarangan</span>
          </div>
          <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800">Mandiri Pangan</span>
        </a>
        <a href="/toko" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition">
          <AppIcon name="store" size="sm" class="text-slate-400" />
          <span>Toko & Pengrajin Warga NU</span>
        </a>
        <a href="/kegiatan" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition">
          <AppIcon name="tent" size="sm" class="text-slate-400" />
          <span>Pasar Kegiatan & Konsumsi NU</span>
        </a>
        <a href="/favorit" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition">
          <AppIcon name="star" size="sm" class="text-slate-400" />
          <span>Iklan Favorit Tersimpan</span>
        </a>
        <a href="/edukasi" class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition">
          <div class="flex items-center gap-2.5">
            <AppIcon name="book" size="sm" class="text-slate-400" />
            <span>Edukasi</span>
          </div>
          <span class="text-[10px] font-bold px-1.5 py-0.5 rounded bg-emerald-100 text-emerald-800">Pekarangan</span>
        </a>

        <div class="pt-3 pb-1 text-xs uppercase font-bold text-slate-600 tracking-wider">
          Wilayah MWC NU Sumenep ({zones.length} Zona)
        </div>
        {zones.map((z) => (
          <a href={`/?zona=${z.slug}`} class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-slate-100 text-slate-700">
            <AppIcon name="map-pin" size="xs" class="text-slate-400" />
            <span>{z.name}</span>
          </a>
        ))}
      </div>

      <!-- Drawer Footer -->
      <div class="p-3.5 border-t border-slate-200 bg-slate-50 text-xs">
        <a href={isPetugas ? '/admin#entry' : '/daftar-kader'} class="flex items-center justify-between text-emerald-700 font-bold hover:text-emerald-800">
          <span>{isPetugas ? 'Masuk Portal Pengurus / Petugas' : 'Daftar Pengurus / Petugas MWC'}</span>
          <AppIcon name="arrow-right" size="xs" />
        </a>
      </div>
    </aside>

    <!-- Main Content Area: Zero margin on mobile (full-edge), Centered Container on Desktop -->
    <main id="main" tabindex="-1" class="flex-1 w-full mx-auto px-0 sm:px-6 lg:px-8 max-w-site">
      <slot />
    </main>

    <!-- Pre-Footer Strip (Desktop & Tablet: mobile already anchors + Iklan in Bottom Nav) -->
    <section class="hidden sm:block bg-emerald-800 text-white py-6 sm:py-7 border-t border-emerald-700 mt-12 shadow-sm">
      <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <div class="space-y-0.5">
          <h2 class="text-base sm:text-lg font-extrabold tracking-tight text-white">Punya Usaha atau Produk Warga NU di Sumenep?</h2>
          <p class="text-xs sm:text-sm text-emerald-100">
            Daftarkan produk Anda secara gratis tanpa komisi agar terhubung ke WhatsApp pembeli lokal.
          </p>
        </div>
        <a
          href="/pasang-iklan"
          class="shrink-0 min-h-[44px] inline-flex items-center justify-center bg-white hover:bg-emerald-50 text-emerald-900 font-extrabold text-xs sm:text-sm px-5 py-2.5 rounded-full shadow-md transition active:scale-95"
        >
          + Pasang Iklan Sekarang
        </a>
      </div>
    </section>

    <!-- Footer Global Mamasar -->
    <footer class="bg-white border-t border-slate-200 mt-8 sm:mt-0 text-xs text-slate-600">
      {/* 1. Tampilan Mobile Sederhana & Bersih (Sesuai Referensi: Link Tengah, Ikon Sosial Bundar, Copyright) */}
      <div class="md:hidden py-6 pb-20 px-4 text-center space-y-4">
        <nav aria-label="Tautan Bawah" class="flex flex-wrap items-center justify-center gap-x-2.5 gap-y-2 text-xs text-slate-700 font-medium max-w-sm mx-auto leading-relaxed">
          <a href="/privasi" class="hover:text-emerald-700 transition">Tentang Kami</a>
          <span class="text-slate-300" aria-hidden="true">|</span>
          <a href="/privasi" class="hover:text-emerald-700 transition">Syarat &amp; Ketentuan</a>
          <span class="text-slate-300" aria-hidden="true">|</span>
          <a href="/privasi" class="hover:text-emerald-700 transition">Kebijakan Privasi</a>
          <span class="text-slate-300" aria-hidden="true">|</span>
          <a href="/daftar-kader" class="hover:text-emerald-700 transition">Panduan Petugas</a>
          <span class="text-slate-300" aria-hidden="true">|</span>
          <a href={`https://wa.me/${SITE_CONFIG.whatsappHelp}?text=Halo%20Admin%20Mamasar,%20saya%20butuh%20bantuan`} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-700 transition">Bantuan</a>
          <span class="text-slate-300" aria-hidden="true">|</span>
          <a href={`https://wa.me/${SITE_CONFIG.whatsappHelp}`} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-700 transition">Kontak</a>
        </nav>

        {/* Baris Ikon Sosial Media Melingkar */}
        <div class="flex items-center justify-center gap-2 pt-1">
          <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-emerald-50 text-slate-600 hover:text-emerald-700 flex items-center justify-center transition">
            <AppIcon name="facebook" size="xs" />
          </a>
          <a href="https://x.com" target="_blank" rel="noopener noreferrer" aria-label="X" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-emerald-50 text-slate-600 hover:text-emerald-700 flex items-center justify-center transition">
            <AppIcon name="x" size="xs" />
          </a>
          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-emerald-50 text-slate-600 hover:text-emerald-700 flex items-center justify-center transition">
            <AppIcon name="instagram" size="xs" />
          </a>
          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-emerald-50 text-slate-600 hover:text-emerald-700 flex items-center justify-center transition">
            <AppIcon name="youtube" size="xs" />
          </a>
          <a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-emerald-50 text-slate-600 hover:text-emerald-700 flex items-center justify-center transition">
            <AppIcon name="tiktok" size="xs" />
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-emerald-50 text-slate-600 hover:text-emerald-700 flex items-center justify-center transition">
            <AppIcon name="linkedin" size="xs" />
          </a>
          <a href="https://t.me" target="_blank" rel="noopener noreferrer" aria-label="Telegram" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-emerald-50 text-slate-600 hover:text-emerald-700 flex items-center justify-center transition">
            <AppIcon name="telegram" size="xs" />
          </a>
        </div>

        {/* Garis Pembatas Tipis */}
        <div class="w-3/4 max-w-xs border-t border-slate-200 mx-auto pt-1"></div>

        {/* Copyright */}
        <p class="text-[11px] text-slate-500">
          Copyright &copy; {currentYear} Mamasar. All Rights Reserved.
        </p>
      </div>

      {/* 2. Tampilan Desktop 4 Kolom */}
      <div class="hidden md:block py-10">
        <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-4 gap-8">
          <!-- Col 1: About -->
          <div class="space-y-3">
            <div class="flex items-center gap-2">
              <MamasarLogo size="xs" />
              <span class="font-extrabold text-sm text-slate-900">Mamasar</span>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Portal direktori iklan baris digital untuk memajukan produk UMKM nahdliyin Kabupaten Sumenep. Transaksi langsung ke penjual tanpa perantara.
            </p>
            <div class="text-xs text-slate-600 space-y-1.5 pt-1">
              <p class="flex items-center gap-1.5"><AppIcon name="map-pin" size="xs" class="text-slate-500" /> <span>{SITE_CONFIG.address}</span></p>
              <a
                href={`https://wa.me/${SITE_CONFIG.whatsappHelp}`}
                target="_blank"
                rel="noopener noreferrer"
                class="min-h-[36px] hover:text-emerald-700 transition inline-flex items-center gap-1.5"
              >
                <AppIcon name="phone" size="xs" class="text-emerald-600" />
                <span>WhatsApp: {SITE_CONFIG.whatsappHelp.replace(/^62/, '+62 ')}</span>
              </a>
            </div>
          </div>

          <!-- Col 2: Kategori Iklan -->
          <div class="space-y-2">
            <h3 class="font-bold text-xs uppercase tracking-wider text-slate-900">Kategori Iklan</h3>
            <ul class="space-y-1.5 text-xs text-slate-600">
              <li><a href="/?kategori=Makanan%20%26%20Minuman" class="hover:text-emerald-700 transition">Makanan & Minuman Khas</a></li>
              <li><a href="/?kategori=Batik%20%26%20Kerajinan" class="hover:text-emerald-700 transition">Batik & Kerajinan Madura</a></li>
              <li><a href="/?kategori=Hasil%20Laut%20%26%20Olahan" class="hover:text-emerald-700 transition">Hasil Laut, Ikan & Petis</a></li>
              <li><a href="/?kategori=Pertanian%20%26%20Perkebunan" class="hover:text-emerald-700 transition">Pertanian & Siwalan Nira</a></li>
              <li><a href="/?kategori=Fashion%20Muslim" class="hover:text-emerald-700 transition">Fashion & Busana Muslim</a></li>
              <li><a href="/?kategori=Herbal%20%26%20Jamu" class="hover:text-emerald-700 transition">Herbal & Ramuan Jamu</a></li>
            </ul>
          </div>

          <!-- Col 3: Wilayah MWC NU -->
          <div class="space-y-2">
            <h3 class="font-bold text-xs uppercase tracking-wider text-slate-900">Wilayah MWC NU</h3>
            <ul class="space-y-1.5 text-xs text-slate-600">
              {zones.slice(0, 8).map((z) => (
                <li>
                  <a href={`/?zona=${z.slug}`} class="hover:text-emerald-700 transition">
                    {z.name}
                  </a>
                </li>
              ))}
              {zones.length > 8 && (
                <li>
                  <a href="/?zona=semua" class="text-emerald-700 font-bold hover:underline inline-flex items-center gap-1">
                    <span>Lihat Semua {zones.length} MWC</span>
                    <AppIcon name="arrow-right" size="xs" />
                  </a>
                </li>
              )}
            </ul>
          </div>

          <!-- Col 4: Informasi & Bantuan -->
          <div class="space-y-2.5">
            <h3 class="font-bold text-xs uppercase tracking-wider text-slate-900">Informasi & Bantuan</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Pendataan toko UMKM dilakukan secara langsung oleh petugas lapangan untuk menjamin keaslian pelaku usaha nahdliyin.
            </p>
            <div class="pt-2 space-y-2">
              <a
                href="/edukasi?kategori=Ekonomi+Pekarangan"
                class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-800 hover:text-emerald-900 bg-emerald-50 border border-emerald-200 px-2.5 py-1.5 rounded-lg transition"
              >
                <AppIcon name="sprout" size="xs" class="text-emerald-700" />
                <span>Rubrik Unggulan Pekarangan</span>
              </a>
              <div>
                <a
                  href={isPetugas ? '/admin#entry' : '/daftar-kader'}
                  class="inline-flex items-center gap-1 text-xs font-bold text-emerald-700 hover:text-emerald-800 underline"
                >
                  <span>{isPetugas ? 'Masuk Portal Pengurus / Petugas MWC' : 'Daftar Pengurus / Petugas MWC'}</span>
                  <AppIcon name="arrow-right" size="xs" />
                </a>
              </div>
            </div>
            <div class="pt-2">
              <span class="inline-block bg-slate-100 text-slate-700 px-2.5 py-1 rounded-md text-xs border border-slate-200">
                Kabupaten Sumenep, Madura
              </span>
            </div>
          </div>
        </div>

        <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 pt-8 mt-8 border-t border-slate-200 flex items-center justify-between gap-3 text-slate-600 text-xs">
          <p>© {currentYear} Mamasar. Seluruh hak cipta dilindungi.</p>
          <div class="flex items-center gap-4">
            <a href="/privasi" class="hover:text-slate-900 font-medium">Kebijakan Privasi</a>
            <span aria-hidden="true">•</span>
            <a href="/sitemap.xml" target="_blank" class="hover:text-slate-800">Sitemap XML</a>
            <span aria-hidden="true">•</span>
            <a href="/robots.txt" target="_blank" class="hover:text-slate-800">Robots.txt</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Bottom Navigation Bar (5-Button Clean UX) -->
    {!hideMobileNav && (
      <nav aria-label="Navigasi Bawah" class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white border-t border-slate-200 shadow-sm px-2 py-1 pb-[calc(0.5rem+env(safe-area-inset-bottom,0px))] flex items-center justify-around">
        <a href="/" aria-current={currentPath === '/' ? 'page' : undefined} class={`min-h-[44px] px-2 flex flex-col items-center justify-center gap-0.5 font-bold text-xs ${currentPath === '/' ? 'text-emerald-700' : 'text-slate-600 hover:text-emerald-700'}`}>
          <AppIcon name="store" size="sm" />
          <span>Beranda</span>
        </a>
        <a href="/favorit" aria-current={currentPath.startsWith('/favorit') ? 'page' : undefined} class={`min-h-[44px] px-2 flex flex-col items-center justify-center gap-0.5 font-bold text-xs ${currentPath.startsWith('/favorit') ? 'text-emerald-700' : 'text-slate-600 hover:text-emerald-700'}`}>
          <AppIcon name="star" size="sm" />
          <span>Favorit</span>
        </a>
        
        <!-- Elevated Center Plus Button -->
        <a
          href="/pasang-iklan"
          aria-label="Pasang Iklan Produk"
          class="w-12 h-12 -mt-5 rounded-full bg-emerald-700 hover:bg-emerald-800 text-white flex items-center justify-center text-2xl font-black shadow-lg border-4 border-white active:scale-95 transition"
        >
          +
        </a>

        <a href="/toko" aria-current={currentPath.startsWith('/toko') ? 'page' : undefined} class={`min-h-[44px] px-2 flex flex-col items-center justify-center gap-0.5 font-bold text-xs ${currentPath.startsWith('/toko') ? 'text-emerald-700' : 'text-slate-600 hover:text-emerald-700'}`}>
          <AppIcon name="package" size="sm" />
          <span>Toko</span>
        </a>
        <a href={isSuperadmin ? '/admin' : '/dashboard'} class="min-h-[44px] px-2 flex flex-col items-center justify-center gap-0.5 text-slate-600 hover:text-emerald-700 font-bold text-xs">
          {isSuperadmin ? <AppIcon name="shield" size="sm" class="text-rose-600" /> : <AppIcon name="user" size="sm" />}
          <span>{isSuperadmin ? 'Admin' : 'Toko Saya'}</span>
        </a>
      </nav>
    )}

    <ConfirmDialog />

    <!-- Global Toast Feedback Container -->
    <div
      id="mamasar-toast"
      class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 bg-slate-900 text-white text-xs font-bold px-4 py-2.5 rounded-lg shadow-md transition-all duration-300 opacity-0 pointer-events-none translate-y-2 flex items-center gap-2 border border-slate-800"
      role="status"
      aria-live="polite"
    >
      <span id="mamasar-toast-msg">Notifikasi</span>
    </div>

    <!-- PWA Install Modal (Centered Dialog) -->
    <div
      id="pwa-install-banner"
      role="dialog"
      aria-modal="true"
      aria-labelledby="pwa-banner-title"
      aria-describedby="pwa-banner-desc"
      class="hidden fixed inset-0 z-50 items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs transition-opacity duration-300 opacity-0"
    >
      <div class="relative w-full max-w-sm sm:max-w-md bg-white border border-slate-200 rounded-2xl shadow-2xl p-5 sm:p-6 transition-transform duration-300 transform scale-95">
        <div class="flex items-start gap-3.5">
          <div class="w-12 h-12 rounded-2xl bg-emerald-700 text-white flex items-center justify-center shrink-0 shadow-xs">
            <AppIcon name="download" size="lg" />
          </div>
          <div class="min-w-0 flex-1 space-y-1.5">
            <div class="flex items-center justify-between gap-2">
              <h3 id="pwa-banner-title" class="text-sm sm:text-base font-black text-slate-900 leading-tight">
                Pasang Aplikasi Mamasar
              </h3>
              <button
                id="pwa-banner-close-btn"
                type="button"
                aria-label="Tutup pemberitahuan pasang aplikasi"
                class="min-w-[36px] min-h-[36px] flex items-center justify-center text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition cursor-pointer -mr-1 -mt-1"
              >
                <AppIcon name="close" size="xs" />
              </button>
            </div>
            <p id="pwa-banner-desc" class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Akses cepat direktori UMKM Nahdliyin langsung dari layar utama perangkat Anda. Ringan, hemat kuota, dan tetap bisa dibuka saat offline.
            </p>

            <!-- Petunjuk Safari iOS (Khusus perangkat Apple) -->
            <div id="pwa-ios-instructions" class="hidden pt-2 text-xs text-slate-600 border-t border-slate-100 space-y-1">
              <p class="font-semibold text-slate-800">Cara pasang di iPhone / iPad:</p>
              <p>Ketuk ikon <strong>Bagikan (Share)</strong> di menu bawah Safari, lalu pilih <strong>Tambahkan ke Layar Utama</strong>.</p>
            </div>

            <div class="pt-3 flex items-center gap-2.5">
              <button
                id="pwa-banner-install-btn"
                type="button"
                class="flex-1 min-h-[42px] px-4 py-2 bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] text-white text-xs sm:text-sm font-bold rounded-xl transition inline-flex items-center justify-center gap-2 cursor-pointer shadow-xs"
              >
                <AppIcon name="download" size="xs" />
                <span>Install Sekarang</span>
              </button>
              <button
                id="pwa-banner-later-btn"
                type="button"
                class="min-h-[42px] px-4 py-2 bg-slate-100 hover:bg-slate-200 active:scale-[0.98] text-slate-700 text-xs sm:text-sm font-semibold rounded-xl transition cursor-pointer"
              >
                Nanti Saja
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Favorite Syncer & Drawer Script -->
    <script>
      // Drawer Logic
      const openDrawerBtn = document.getElementById('open-mobile-drawer');
      const closeDrawerBtn = document.getElementById('close-mobile-drawer');
      const drawer = document.getElementById('mobile-drawer');
      const backdrop = document.getElementById('mobile-drawer-backdrop');

      function openDrawer() {
        if (!drawer || !backdrop) return;
        drawer.classList.remove('hidden');
        backdrop.classList.remove('hidden');
        requestAnimationFrame(() => {
          drawer.classList.remove('-translate-x-full');
        });
      }

      function closeDrawer() {
        if (!drawer || !backdrop) return;
        drawer.classList.add('-translate-x-full');
        setTimeout(() => {
          drawer.classList.add('hidden');
          backdrop.classList.add('hidden');
        }, 300);
      }

      openDrawerBtn?.addEventListener('click', openDrawer);
      closeDrawerBtn?.addEventListener('click', closeDrawer);
      backdrop?.addEventListener('click', closeDrawer);

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          if (drawer && !drawer.classList.contains('hidden')) closeDrawer();
          if (pwaBanner && !pwaBanner.classList.contains('hidden')) dismissPwaBanner();
        }
      });

      // Global Favorite Sync & Toast System
      function initMamasarFavorites() {
        const toast = document.getElementById('mamasar-toast');
        const toastMsg = document.getElementById('mamasar-toast-msg');
        let toastTimeout: any;

        function showToast(msg: string) {
          if (!toast || !toastMsg) return;
          toastMsg.textContent = msg;
          toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
          toast.classList.add('opacity-100', 'translate-y-0');
          clearTimeout(toastTimeout);
          toastTimeout = setTimeout(() => {
            toast.classList.remove('opacity-100', 'translate-y-0');
            toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
          }, 2000);
        }

        function getFavorites(): number[] {
          try {
            return JSON.parse(localStorage.getItem('mamasar_favorites') || '[]');
          } catch {
            return [];
          }
        }

        function saveFavorites(favs: number[]) {
          localStorage.setItem('mamasar_favorites', JSON.stringify(favs));
        }

        function syncButtonStyles() {
          const favs = getFavorites();
          document.querySelectorAll<HTMLElement>('[data-fav-btn]').forEach((btn) => {
            const id = Number(btn.getAttribute('data-id'));
            if (!id) return;
            const isFav = favs.includes(id);
            if (isFav) {
              btn.classList.add('text-amber-500', 'bg-amber-50', 'border-amber-300');
              btn.classList.remove('text-slate-400');
            } else {
              btn.classList.remove('text-amber-500', 'bg-amber-50', 'border-amber-300');
              btn.classList.add('text-slate-400');
            }
          });
        }

        // Handle button clicks delegation
        document.addEventListener('click', (e) => {
          const target = (e.target as HTMLElement)?.closest('[data-fav-btn]') as HTMLElement | null;
          if (!target) return;

          e.preventDefault();
          e.stopPropagation();

          const id = Number(target.getAttribute('data-id'));
          if (!id) return;

          const favs = getFavorites();
          const idx = favs.indexOf(id);
          let isNowFav = false;

          if (idx > -1) {
            favs.splice(idx, 1);
            isNowFav = false;
          } else {
            favs.push(id);
            isNowFav = true;
          }

          saveFavorites(favs);
          syncButtonStyles();
          showToast(isNowFav ? 'Disimpan ke Favorit' : 'Dihapus dari Favorit');

          // Background sync to database if user is logged in
          fetch('/api/favorites/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productId: id }),
          }).catch(() => {});
        });

        syncButtonStyles();

        const params = new URLSearchParams(window.location.search);
        if (params.get('account_deleted') === '1') {
          showToast('Akun dan seluruh data Anda telah dihapus permanen.');
          params.delete('account_deleted');
          const nextSearch = params.toString();
          history.replaceState(null, '', window.location.pathname + (nextSearch ? `?${nextSearch}` : ''));
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMamasarFavorites);
      } else {
        initMamasarFavorites();
      }

      document.querySelectorAll<HTMLButtonElement>('[data-footer-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-footer-toggle');
          const list = targetId ? document.getElementById(targetId) : null;
          if (!list) return;
          const isClosed = list.classList.contains('hidden');
          list.classList.toggle('hidden', !isClosed);
          btn.setAttribute('aria-expanded', isClosed ? 'true' : 'false');
          const icon = btn.querySelector('svg');
          if (icon) icon.classList.toggle('rotate-180', isClosed);
        });
      });

      // PWA Service Worker & Install Prompt System
      if ('serviceWorker' in navigator && window.location.protocol.startsWith('http')) {
        window.addEventListener('load', () => {
          navigator.serviceWorker
            .register('/sw.js', { scope: '/' })
            .then((reg) => {
              reg.addEventListener('updatefound', () => {
                const installingWorker = reg.installing;
                if (installingWorker) {
                  installingWorker.addEventListener('statechange', () => {
                    if (installingWorker.state === 'installed' && navigator.serviceWorker.controller) {
                      console.info('PWA: Versi baru telah tersedia');
                    }
                  });
                }
              });
            })
            .catch((err) => {
              console.warn('PWA: Registrasi Service Worker gagal:', err);
            });
        });
      }

      let deferredPwaPrompt: any = null;
      const pwaInstallDrawerBtn = document.getElementById('pwa-install-drawer-btn');
      const pwaBanner = document.getElementById('pwa-install-banner');
      const pwaBannerInstallBtn = document.getElementById('pwa-banner-install-btn');
      const pwaBannerCloseBtn = document.getElementById('pwa-banner-close-btn');
      const pwaBannerLaterBtn = document.getElementById('pwa-banner-later-btn');
      const pwaIosInstructions = document.getElementById('pwa-ios-instructions');

      const isStandalone =
        window.matchMedia('(display-mode: standalone)').matches ||
        (window.navigator as any).standalone === true;

      const isIos =
        /iPad|iPhone|iPod/.test(navigator.userAgent) && !(window as any).MSStream;

      function isPwaDismissedRecently(): boolean {
        try {
          const raw = localStorage.getItem('mamasar_pwa_dismissed');
          if (!raw) return false;
          const dismissedAt = Number(raw);
          const sevenDays = 7 * 24 * 60 * 60 * 1000;
          return Date.now() - dismissedAt < sevenDays;
        } catch {
          return false;
        }
      }

      function dismissPwaBanner() {
        if (!pwaBanner) return;
        pwaBanner.classList.remove('opacity-100');
        pwaBanner.classList.add('opacity-0');
        const modalBox = pwaBanner.querySelector(':scope > div');
        if (modalBox) {
          modalBox.classList.remove('scale-100');
          modalBox.classList.add('scale-95');
        }
        setTimeout(() => {
          pwaBanner.classList.add('hidden');
          pwaBanner.classList.remove('flex');
        }, 300);
        try {
          localStorage.setItem('mamasar_pwa_dismissed', Date.now().toString());
        } catch {}
      }

      function showPwaBanner() {
        if (!pwaBanner || isStandalone || isPwaDismissedRecently()) return;
        pwaBanner.classList.remove('hidden');
        pwaBanner.classList.add('flex');
        requestAnimationFrame(() => {
          pwaBanner.classList.remove('opacity-0');
          pwaBanner.classList.add('opacity-100');
          const modalBox = pwaBanner.querySelector(':scope > div');
          if (modalBox) {
            modalBox.classList.remove('scale-95');
            modalBox.classList.add('scale-100');
          }
        });
      }

      // Capture beforeinstallprompt (Chrome / Edge / Android)
      window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPwaPrompt = e;

        if (pwaInstallDrawerBtn) {
          pwaInstallDrawerBtn.classList.remove('hidden');
          pwaInstallDrawerBtn.classList.add('flex');
        }

        setTimeout(showPwaBanner, 2000);
      });

      async function triggerPwaInstall() {
        if (deferredPwaPrompt) {
          deferredPwaPrompt.prompt();
          const { outcome } = await deferredPwaPrompt.userChoice;
          if (outcome === 'accepted') {
            dismissPwaBanner();
            if (pwaInstallDrawerBtn) pwaInstallDrawerBtn.classList.add('hidden');
          }
          deferredPwaPrompt = null;
        } else if (isIos && pwaIosInstructions) {
          pwaIosInstructions.classList.toggle('hidden');
        }
      }

      pwaBannerInstallBtn?.addEventListener('click', triggerPwaInstall);
      pwaInstallDrawerBtn?.addEventListener('click', triggerPwaInstall);
      pwaBannerCloseBtn?.addEventListener('click', dismissPwaBanner);
      pwaBannerLaterBtn?.addEventListener('click', dismissPwaBanner);
      pwaBanner?.addEventListener('click', (e) => {
        if (e.target === pwaBanner) dismissPwaBanner();
      });

      // Handle iOS Safari banner if not installed
      if (isIos && !isStandalone && !isPwaDismissedRecently()) {
        setTimeout(() => {
          if (pwaIosInstructions) pwaIosInstructions.classList.remove('hidden');
          if (pwaBannerInstallBtn) pwaBannerInstallBtn.classList.add('hidden');
          showPwaBanner();
        }, 3000);
      }

      window.addEventListener('appinstalled', () => {
        dismissPwaBanner();
        if (pwaInstallDrawerBtn) pwaInstallDrawerBtn.classList.add('hidden');
        console.info('PWA: Aplikasi Mamasar berhasil di-install.');
      });
    </script>
  </body>
</html>
