---
interface Props {
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  variant?: 'badge' | 'mark';
  class?: string;
}

const { size = 'md', variant = 'badge', class: className = '' } = Astro.props;

const sizeClasses: Record<NonNullable<Props['size']>, string> = {
  xs: 'w-7 h-7 rounded-lg',
  sm: 'w-8 h-8 rounded-lg',
  md: 'w-9 h-9 rounded-xl',
  lg: 'w-9 h-9 sm:w-10 sm:h-10 rounded-xl',
  xl: 'w-12 h-12 rounded-2xl',
};

const isBadge = variant === 'badge';
const mainFill = isBadge ? '#ffffff' : '#047857';
const accentFill = isBadge ? '#fbbf24' : '#d97706';
---

<span
  class={`inline-flex items-center justify-center shrink-0 select-none ${
    isBadge ? 'bg-emerald-700' : 'bg-transparent'
  } ${sizeClasses[size]} ${className}`}
  aria-hidden="true"
>
  <svg viewBox="0 0 32 32" fill="none" class="w-full h-full">
    <path d="M8.6 6.8H12.6L11.7 10Q11.4 11.4 9.9 11.4H7.4Q5.6 11.4 6.1 9.7L7.6 7.4Q8 6.8 8.6 6.8Z" fill={mainFill} />
    <path d="M14.1 6.8H17.9L18.9 9.8Q19.2 11.4 17.4 11.4H14.6Q12.8 11.4 13.1 9.8L14.1 6.8Z" fill={accentFill} />
    <path d="M23.4 6.8H19.4L20.3 10Q20.6 11.4 22.1 11.4H24.6Q26.4 11.4 25.9 9.7L24.4 7.4Q24 6.8 23.4 6.8Z" fill={mainFill} />
    <path
      d="M8.2 23.6V15.6L16 22.4L23.8 15.6V23.6"
      stroke={mainFill}
      stroke-width="3.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</span>
