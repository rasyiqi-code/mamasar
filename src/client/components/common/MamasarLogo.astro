---
interface Props {
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  variant?: 'badge' | 'mark';
  class?: string;
}

const { size = 'md', variant = 'badge', class: className = '' } = Astro.props;

const sizeClasses: Record<NonNullable<Props['size']>, string> = {
  xs: 'w-7 h-7 rounded-lg',
  sm: 'w-8 h-8 rounded-lg',
  md: 'w-9 h-9 rounded-xl',
  lg: 'w-9 h-9 sm:w-10 sm:h-10 rounded-xl',
  xl: 'w-12 h-12 rounded-2xl',
};

const isBadge = variant === 'badge';
const wingFill = isBadge ? '#ffffff' : '#047857';
const accentFill = isBadge ? '#fbbf24' : '#d97706';
---

<span
  class={`inline-flex items-center justify-center shrink-0 select-none ${
    isBadge ? 'bg-emerald-700' : 'bg-transparent'
  } ${sizeClasses[size]} ${className}`}
  aria-hidden="true"
>
  <svg viewBox="0 0 32 32" fill="none" class="w-full h-full">
    <path d="M6.4 23.2V11L9.4 8L11.1 9.7L14.7 16.2V20.6L10.2 14.6V23.2H6.4Z" fill={wingFill} />
    <path d="M25.6 23.2V11L22.6 8L20.9 9.7L17.3 16.2V20.6L21.8 14.6V23.2H25.6Z" fill={wingFill} />
    <path d="M16 7.8L18.9 11L16 15.2L13.1 11L16 7.8Z" fill={accentFill} />
  </svg>
</span>
