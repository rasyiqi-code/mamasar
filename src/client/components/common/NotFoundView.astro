---
import AppIcon from './AppIcon.astro';

interface Props {
  code?: string;
  heading?: string;
  message?: string;
  primaryHref?: string;
  primaryLabel?: string;
}

const {
  code = '404',
  heading = 'Halaman Tidak Ditemukan',
  message = 'Mohon maaf, tautan atau produk yang Anda cari mungkin telah laku terjual, dihapus pemiliknya, atau alamat URL telah dipindahkan.',
  primaryHref = '/',
  primaryLabel = 'Kembali ke Katalog',
} = Astro.props;
---

<div class="min-h-[65vh] flex items-center justify-center py-10 sm:px-6 lg:px-8">
  <div class="max-w-lg w-full text-center space-y-5 bg-white border-y sm:border border-slate-200 sm:rounded-lg p-6 sm:p-8">
    <div class="inline-flex items-center justify-center px-4 py-2 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 text-2xl font-black font-mono tracking-wider">
      {code}
    </div>

    <div class="space-y-1.5">
      <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
        {heading}
      </h1>
      <p class="text-sm text-slate-600 leading-relaxed">
        {message}
      </p>
    </div>

    <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-2.5 text-xs font-bold">
      <a
        href={primaryHref}
        class="w-full sm:w-auto min-h-[44px] px-4 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg transition inline-flex items-center justify-center gap-1.5"
      >
        <AppIcon name="clipboard" size="xs" />
        <span>{primaryLabel}</span>
      </a>
      <a
        href="/toko"
        class="w-full sm:w-auto min-h-[44px] px-4 py-2.5 bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 rounded-lg transition inline-flex items-center justify-center gap-1.5"
      >
        <AppIcon name="store" size="xs" class="text-slate-600" />
        <span>Daftar Toko</span>
      </a>
      <a
        href="/kegiatan"
        class="w-full sm:w-auto min-h-[44px] px-4 py-2.5 bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 rounded-lg transition inline-flex items-center justify-center gap-1.5"
      >
        <AppIcon name="tent" size="xs" class="text-slate-600" />
        <span>Kegiatan NU</span>
      </a>
    </div>

    <div class="pt-4 border-t border-slate-200 text-xs text-slate-600">
      Butuh bantuan? Hubungi pengurus MWC NU setempat melalui WhatsApp.
    </div>
  </div>
</div>
