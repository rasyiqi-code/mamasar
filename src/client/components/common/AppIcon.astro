---
interface Props {
  name: string;
  class?: string;
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl' | '2xl' | '3xl' | 'category';
  strokeWidth?: number | string;
  duotone?: boolean;
  viewBox?: string;
}

const {
  name,
  class: className = '',
  size = 'md',
  strokeWidth = 1.75,
  duotone = true,
  viewBox = '0 0 24 24',
} = Astro.props;

const sizeClasses: Record<string, string> = {
  xs: 'w-3.5 h-3.5',
  sm: 'w-4 h-4',
  md: 'w-4.5 h-4.5',
  lg: 'w-5 h-5',
  xl: 'w-6 h-6',
  '2xl': 'w-8 h-8',
  '3xl': 'w-10 h-10',
  category: 'w-10 h-10 sm:w-12 sm:h-12',
};

const hasExplicitWidth = /\bw-\S+/.test(className);
const resolvedSizeClass = !hasExplicitWidth && size && sizeClasses[size] ? sizeClasses[size] : size === 'category' ? sizeClasses.category : '';
const combinedClasses = `inline-block shrink-0 transition-colors ${resolvedSizeClass} ${className}`.trim();
---

