---
interface Props {
  hasStore?: boolean;
}

const { hasStore = false } = Astro.props;
---

<section
  aria-labelledby="privacy-account-heading"
  class="pt-6 mt-6 border-t border-slate-200 space-y-4"
>
  <div class="space-y-1">
    <h3 id="privacy-account-heading" class="text-xs font-bold uppercase tracking-wider text-slate-800">
      Privasi &amp; Data Akun
    </h3>
    <p class="text-xs text-slate-600 leading-relaxed">
      Unduh salinan data Anda dalam format JSON atau hapus akun beserta seluruh data terkait secara permanen. Pelajari selengkapnya di{' '}
      <a href="/privasi" class="text-emerald-700 hover:text-emerald-800 font-semibold underline">
        Kebijakan Privasi
      </a>.
    </p>
  </div>

  <div class="flex flex-col sm:flex-row sm:items-center gap-3">
    <a
      href="/api/user/export"
      download
      class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-800 transition"
    >
      Unduh Salinan Data Akun (JSON)
    </a>

    <button
      type="button"
      id="btn-toggle-delete-account"
      aria-expanded="false"
      aria-controls="delete-account-box"
      class="inline-flex items-center justify-center min-h-[44px] px-4 py-2 rounded-lg border border-rose-200 bg-rose-50 hover:bg-rose-100 text-xs font-semibold text-rose-800 transition cursor-pointer"
    >
      Hapus Akun Secara Permanen
    </button>
  </div>

  <div id="delete-account-box" class="hidden p-4 rounded-lg bg-rose-50/70 border border-rose-200 space-y-3">
    <p class="text-xs text-rose-950 leading-relaxed font-medium">
      Tindakan ini tidak dapat dibatalkan. Akun Anda{hasStore ? ', profil toko, seluruh produk,' : ','} daftar favorit, dan buku kas akan dihapus permanen.
    </p>
    <div id="delete-account-status" role="status" aria-live="polite" class="hidden p-2.5 rounded-lg text-xs font-semibold"></div>
    <form id="delete-account-form" class="flex flex-col sm:flex-row sm:items-end gap-2.5">
      <div class="flex-1 space-y-1">
        <label for="deleteConfirmInput" class="block text-xs font-medium text-rose-950">
          Ketik <strong class="font-mono">HAPUS</strong> untuk konfirmasi:
        </label>
        <input
          type="text"
          id="deleteConfirmInput"
          name="confirmText"
          placeholder="HAPUS"
          autocomplete="off"
          required
          class="w-full min-h-[44px] bg-white border border-rose-300 rounded-lg px-3 py-2 text-xs font-mono text-slate-900 focus:border-rose-600 focus:ring-1 focus:ring-rose-600"
        />
      </div>
      <button
        type="submit"
        id="btn-confirm-delete-account"
        class="min-h-[44px] px-4 py-2 rounded-lg bg-rose-700 hover:bg-rose-800 text-white text-xs font-bold transition cursor-pointer shrink-0"
      >
        Ya, Hapus Akun Permanen
      </button>
    </form>
  </div>
</section>
