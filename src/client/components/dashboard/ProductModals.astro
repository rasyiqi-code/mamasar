---
import { PRODUCT_CATEGORIES } from '../../../lib/constants';
import AppIcon from '../common/AppIcon.astro';
---

<!-- MODAL: EDIT PRODUK (Native <dialog>) -->
<dialog
  id="modal-edit-product"
  aria-labelledby="modal-edit-product-title"
  class="w-full sm:w-[calc(100%-1.5rem)] max-w-lg rounded-t-2xl sm:rounded-lg bg-white border border-slate-200 shadow-lg p-0 text-slate-900 overflow-hidden"
>
  <div class="sm:hidden flex justify-center pt-2.5 pb-1 shrink-0">
    <span class="w-10 h-1 rounded-full bg-slate-300" aria-hidden="true"></span>
  </div>
  <div class="flex flex-col max-h-[88dvh]">
    <div class="p-4 sm:p-5 border-b border-slate-200 flex items-center justify-between shrink-0">
      <h3 id="modal-edit-product-title" class="font-bold text-sm sm:text-base text-slate-900">Edit Iklan Produk</h3>
      <button type="button" data-close-modal="edit-product" autofocus aria-label="Tutup modal edit produk" class="min-w-[40px] min-h-[40px] rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 cursor-pointer flex items-center justify-center">
        <AppIcon name="close" size="xs" />
      </button>
    </div>

    <form id="edit-product-form" class="p-4 sm:p-6 space-y-4 overflow-y-auto flex-1">
      <input type="hidden" id="editProductId" name="productId" />
      <input type="hidden" id="editImageBase64" name="imageBase64" />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label for="editProdName" class="block text-xs font-medium text-slate-700">Nama Barang / Produk <span class="text-rose-500">*</span></label>
          <input
            type="text"
            id="editProdName"
            name="name"
            required
            class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
          />
        </div>

        <div class="space-y-1.5">
          <label for="editProdCategory" class="block text-xs font-medium text-slate-700">Kategori <span class="text-rose-500">*</span></label>
          <select
            id="editProdCategory"
            name="category"
            required
            class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-xs font-medium text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 cursor-pointer"
          >
            {PRODUCT_CATEGORIES.map((cat) => (
              <option value={cat}>
                {cat}
              </option>
            ))}
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label for="editProdPrice" class="block text-xs font-medium text-slate-700">Harga Jual Promo (IDR) <span class="text-rose-500">*</span></label>
          <input
            type="number"
            id="editProdPrice"
            name="price"
            required
            min="500"
            class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 font-mono focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
          />
        </div>

        <div class="space-y-1.5">
          <label for="editProdOriginalPrice" class="block text-xs font-medium text-slate-700">Harga Normal / Coret (Opsional)</label>
          <input
            type="number"
            id="editProdOriginalPrice"
            name="originalPrice"
            min="500"
            placeholder="Contoh: 20000"
            class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 font-mono focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label for="editProdStockStatus" class="block text-xs font-medium text-slate-700">Ketersediaan Stok <span class="text-rose-500">*</span></label>
          <select
            id="editProdStockStatus"
            name="stockStatus"
            required
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs font-medium text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 cursor-pointer"
          >
            <option value="ready">Ready Stock (Siap Kirim)</option>
            <option value="po">Pre-Order / Dibuat Berdasarkan Pesanan</option>
            <option value="sold_out">Habis / Kuota Penuh</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label for="editProdLeadTime" class="block text-xs font-medium text-slate-700">Waktu Persiapan / Pengerjaan</label>
          <select
            id="editProdLeadTime"
            name="orderLeadTimeDays"
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs font-medium text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 cursor-pointer"
          >
            <option value="0">Langsung Siap / Same-day</option>
            <option value="1">PO H-1 (Siap 1 Hari)</option>
            <option value="2">PO H-2 (Siap 2 Hari)</option>
            <option value="3">PO H-3 (Siap 3 Hari)</option>
            <option value="7">PO H-7 (Siap 1 Minggu)</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label for="editProdMinOrder" class="block text-xs font-medium text-slate-700">Minimal Pesanan</label>
          <input
            type="number"
            id="editProdMinOrder"
            name="minOrder"
            min="1"
            value="1"
            placeholder="1"
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
          />
        </div>

        <div class="space-y-1.5">
          <label for="editProdMaxOrder" class="block text-xs font-medium text-slate-700">Maksimal Pesanan (Opsional)</label>
          <input
            type="number"
            id="editProdMaxOrder"
            name="maxOrder"
            min="1"
            placeholder="Contoh: 300"
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label for="editProdCapacity" class="block text-xs font-medium text-slate-700">Kapasitas Produksi (Opsional)</label>
          <input
            type="text"
            id="editProdCapacity"
            name="productionCapacity"
            placeholder="Contoh: 50 bungkus/hari"
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
          />
        </div>

        <div class="space-y-1.5">
          <label for="editProdShelfLife" class="block text-xs font-medium text-slate-700">Ketahanan Produk (Khusus Makanan/Basah)</label>
          <input
            type="text"
            id="editProdShelfLife"
            name="shelfLifeNotes"
            placeholder="Contoh: 2 hari suhu ruang"
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
          />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label for="editProdDeliveryCoverage" class="block text-xs font-medium text-slate-700">Jangkauan Pengiriman</label>
          <select
            id="editProdDeliveryCoverage"
            name="deliveryCoverage"
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs font-medium text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 cursor-pointer"
          >
            <option value="all_sumenep">Seluruh Sumenep (COD / Ekspedisi)</option>
            <option value="pickup_only">Ambil di Tempat Saja (Pickup)</option>
            <option value="local_village">Sekitar Desa / Kelurahan Terdekat</option>
            <option value="mwc_wide">Satu Wilayah MWC NU (Kecamatan)</option>
            <option value="island_delivery">Aman Kirim ke Kepulauan (Tahan Kapal)</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label for="editProdShopee" class="block text-xs font-medium text-slate-700">Link Toko Online / Marketplace (Opsional)</label>
          <input
            type="url"
            id="editProdShopee"
            name="shopeeUrl"
            placeholder="Shopee, Tokopedia, TikTok Shop, Web, dll..."
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
          />
        </div>
      </div>

      <div class="space-y-1.5">
        <label for="editProdDesc" class="block text-xs font-medium text-slate-700">Deskripsi Produk</label>
        <textarea
          id="editProdDesc"
          name="description"
          rows="2"
          class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
        ></textarea>
      </div>

      <div class="space-y-1.5">
        <label for="edit-camera-input" class="block text-xs font-medium text-slate-700">Ganti Foto Produk (Opsional)</label>
        <input
          type="file"
          id="edit-camera-input"
          accept="image/*"
          class="w-full text-xs text-slate-600 file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 cursor-pointer"
        />
        <p id="edit-compress-info" class="text-xs text-slate-600 font-medium"></p>
      </div>

      <div class="pt-2 flex flex-col-reverse sm:flex-row gap-2">
        <button
          type="button"
          data-close-modal="edit-product"
          class="min-h-[44px] sm:w-32 py-2.5 bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 font-semibold text-xs sm:text-sm rounded-lg transition cursor-pointer"
        >
          Batal
        </button>
        <button
          type="submit"
          id="btn-submit-edit-product"
          class="flex-1 min-h-[44px] py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs sm:text-sm rounded-lg transition cursor-pointer inline-flex items-center justify-center gap-1.5"
        >
          <span>Simpan</span>
          <AppIcon name="arrow-right" size="xs" />
        </button>
      </div>
    </form>
  </div>
</dialog>
