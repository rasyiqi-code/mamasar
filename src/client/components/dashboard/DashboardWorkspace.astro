---
import AppLayout from '../../layouts/AppLayout.astro';
import {
  getUMKMByUserId,
  getAllZones,
  getCashbookSummary,
  getCashbookEntries,
  getAdOrdersByUmkm,
  getBumpLedgerByUmkm,
  getNotificationsForUser,
  isSuperadmin,
  isPetugas,
} from '../../../lib/db';
import { resolveUser } from '../../../lib/neon-auth';
import { resolveAvatarUrl } from '../../../lib/storage';

import StoreSetupCard from './StoreSetupCard.astro';
import DashboardSidebar from './DashboardSidebar.astro';
import OverviewPanel from './OverviewPanel.astro';
import ProductsPanel from './ProductsPanel.astro';
import CashbookPanel from './CashbookPanel.astro';
import ProfilePanel from './ProfilePanel.astro';
import ServicesPanel from './ServicesPanel.astro';
import ProductModals from './ProductModals.astro';
import AdPromotionModal from './AdPromotionModal.astro';
import AppIcon from '../common/AppIcon.astro';

export type DashboardSection = 'overview' | 'products' | 'cashbook' | 'profile' | 'services';

interface Props {
  activeSection?: DashboardSection;
  user?: NonNullable<Awaited<ReturnType<typeof resolveUser>>>;
  store?: any;
}

const { activeSection = 'overview', user: propUser, store: propStore } = Astro.props;

const user = propUser || (await resolveUser(Astro.request));

if (!user) {
  const currentPath = Astro.url.pathname + Astro.url.search;
  const redirectQuery = currentPath && currentPath !== '/dashboard' ? `?redirect=${encodeURIComponent(currentPath)}` : '';
  return Astro.redirect(`/login${redirectQuery}`);
}

const store = propStore || user.umkm || (await getUMKMByUserId(user.id));

const [zones, avatarUrl, cashbookSummary, cashbookEntries, adOrders, bumpLedger, notifications] = await Promise.all([
  getAllZones(),
  resolveAvatarUrl(user.avatar_url),
  getCashbookSummary(user.id, store?.id),
  getCashbookEntries(user.id, 50, store?.id),
  store && activeSection === 'products' ? getAdOrdersByUmkm(store.id) : Promise.resolve([]),
  store && activeSection === 'products' ? getBumpLedgerByUmkm(store.id, 10) : Promise.resolve([]),
  activeSection === 'overview' || activeSection === 'products'
    ? getNotificationsForUser(user.id, 5)
    : Promise.resolve([]),
]);

const authError = Astro.url.searchParams.get('error');
const intent = Astro.url.searchParams.get('intent');
if (intent === 'daftar-kader') {
  return Astro.redirect('/daftar-kader');
}

const isSuper = isSuperadmin(user);
const isCadre = isPetugas(user);
const assignedZone = zones.find((z) => z.id === user.assigned_zone_id);

const sectionTitleMap: Record<DashboardSection, string> = {
  overview: 'Ringkasan Toko',
  products: 'Katalog Produk',
  cashbook: 'Buku Kas Usaha',
  profile: 'Profil & Data Toko',
  services: 'Layanan Kemitraan & Kaderisasi',
};

const activeLabel = sectionTitleMap[activeSection];
const pageTitle = store
  ? `${activeLabel}: ${store.name} | Mamasar`
  : `Buka Toko UMKM: ${user.name} | Mamasar`;
---

<AppLayout
  title={pageTitle}
  description="Portal swalayan pemilik UMKM Nahdliyin, Kader Ranting, Pengurus MWC, dan Admin PCNU Sumenep."
>
  <!-- Banner Akses Terbatas /admin -->
  {authError === 'unauthorized_admin' && (
    <div role="alert" class="bg-amber-50 border-b border-amber-300 px-4 py-3 text-xs text-amber-950">
      <div class="max-w-5xl mx-auto flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <p class="font-semibold">
          Halaman Portal Admin &amp; Kader (<code>/admin</code>) khusus untuk Kader Ranting, Pengurus MWC, atau Admin PCNU yang sudah disetujui.
        </p>
        <a href="/daftar-kader" class="shrink-0 font-bold text-emerald-800 underline hover:text-emerald-900 inline-flex items-center gap-1">
          <span>Ajukan Peran Kader MWC</span>
          <AppIcon name="arrow-right" size="xs" />
        </a>
      </div>
    </div>
  )}

  <!-- KONDISI 1: Sudah Login, Belum Punya Profil Toko -->
  {!store && (
    <StoreSetupCard
      user={user}
      zones={zones}
      assignedZone={assignedZone}
      isSuper={isSuper}
      isCadre={isCadre}
    />
  )}

  <!-- KONDISI 2: Workspace Toko Siap (Full-Viewport App Shell with Sticky App Header) -->
  {store && (
    <div class="min-h-screen w-full max-w-full overflow-x-clip bg-white flex flex-col md:flex-row">
      <!-- Sidebar Navigasi -->
      <DashboardSidebar
        user={user}
        store={store}
        avatarUrl={avatarUrl}
        isSuper={isSuper}
        isCadre={isCadre}
        activeSection={activeSection}
        productCount={store.products?.length || 0}
        cashbookCount={cashbookEntries.length}
      />

      <!-- Kolom Kanan: App Header + Workspace Utama (Full Viewport Width) -->
      <div class="flex-1 min-w-0 w-full max-w-full flex flex-col">
        <header class="hidden md:flex sticky top-0 z-30 h-14 bg-white/95 backdrop-blur-xs border-b border-slate-200 px-6 lg:px-8 items-center justify-between gap-4">
          <div class="flex items-center gap-2.5 min-w-0">
            <h1 class="text-sm sm:text-base font-bold tracking-tight text-slate-900 truncate">{activeLabel}</h1>
            <span class="hidden lg:inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 text-xs font-medium shrink-0">
              <AppIcon name="map-pin" size="xs" class="text-emerald-700" />
              <span>{store.zone_name}</span>
            </span>
            {activeSection === 'profile' && (
              <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 text-xs font-mono font-medium shrink-0">
                ID #{store.id}
              </span>
            )}
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <a
              href="/"
              class="min-h-[36px] px-2.5 py-1.5 rounded-lg text-slate-700 hover:text-slate-900 hover:bg-slate-100 text-xs font-medium transition inline-flex items-center gap-1.5"
            >
              <AppIcon name="globe" size="xs" />
              <span>Katalog Publik</span>
            </a>
            <a
              href={`/toko/${store.slug || store.id}`}
              target="_blank"
              class="min-h-[36px] px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-800 text-xs font-semibold transition inline-flex items-center gap-1.5 active:scale-[0.98]"
            >
              <span>Etalase</span>
              <AppIcon name="external-link" size="xs" />
            </a>

            {activeSection === 'overview' && (
              <>
                <span class="h-4 w-px bg-slate-200 mx-0.5" aria-hidden="true"></span>
                <a
                  href="/dashboard/produk"
                  class="min-h-[36px] px-3 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-800 text-xs font-semibold transition inline-flex items-center gap-1.5 active:scale-[0.98]"
                >
                  <AppIcon name="package" size="xs" />
                  <span>Produk</span>
                </a>
                <a
                  href="/pasang-iklan"
                  class="min-h-[36px] px-3.5 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold transition inline-flex items-center gap-1.5 active:scale-[0.98]"
                >
                  <AppIcon name="plus" size="xs" />
                  <span>Iklan</span>
                </a>
              </>
            )}

            {activeSection === 'products' && (
              <>
                <span class="h-4 w-px bg-slate-200 mx-0.5" aria-hidden="true"></span>
                <button
                  type="button"
                  data-trigger="open-promo"
                  class="min-h-[36px] px-3 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-800 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer shadow-2xs hover:shadow-xs transition-all duration-150 ease-out hover:scale-[1.02] active:scale-[0.98]"
                >
                  <AppIcon name="zap" size="xs" class="text-amber-600" />
                  <span>Promosi</span>
                </button>
                <a
                  href="/pasang-iklan"
                  class="min-h-[36px] px-3.5 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold inline-flex items-center gap-1.5 shadow-2xs hover:shadow-xs transition-all duration-150 ease-out hover:scale-[1.02] active:scale-[0.98]"
                >
                  <AppIcon name="plus" size="xs" />
                  <span>Tambah</span>
                </a>
              </>
            )}

            {activeSection === 'cashbook' && (
              <>
                <span class="h-4 w-px bg-slate-200 mx-0.5" aria-hidden="true"></span>
                <button
                  type="button"
                  data-trigger="export-csv"
                  title="Unduh CSV"
                  class="min-h-[36px] px-3 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-slate-800 text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer shadow-2xs hover:shadow-xs transition-all duration-150 ease-out hover:scale-[1.02] active:scale-[0.98]"
                >
                  <AppIcon name="download" size="xs" />
                  <span>Ekspor</span>
                </button>
                <button
                  type="button"
                  data-trigger="toggle-cashbook"
                  class="min-h-[36px] px-3.5 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer shadow-2xs hover:shadow-xs transition-all duration-150 ease-out hover:scale-[1.02] active:scale-[0.98]"
                >
                  <AppIcon name="plus" size="xs" />
                  <span>Catat</span>
                </button>
              </>
            )}
          </div>
        </header>

        <main id="main" tabindex="-1" class="flex-1 min-w-0 w-full pb-24 md:pb-10">
          <!-- Status Notification Box -->
          <div id="action-status" role="status" aria-live="polite" class="hidden mx-4 sm:mx-6 lg:mx-8 my-4 p-3 rounded-lg text-xs font-semibold"></div>

          {activeSection === 'overview' && (
            <OverviewPanel
              store={store}
              cashbookSummary={cashbookSummary}
              cashbookEntries={cashbookEntries}
              notifications={notifications}
            />
          )}

          {activeSection === 'products' && (
            <ProductsPanel
              store={store}
              adOrders={adOrders}
              bumpLedger={bumpLedger}
              notifications={notifications}
            />
          )}

          {activeSection === 'cashbook' && (
            <CashbookPanel
              summary={cashbookSummary}
              entries={cashbookEntries}
              products={store.products}
            />
          )}

          {activeSection === 'profile' && (
            <ProfilePanel store={store} zones={zones} />
          )}

          {activeSection === 'services' && (
            <ServicesPanel
              user={user}
              zones={zones}
              assignedZone={zones.find((z) => z.id === user.assigned_zone_id)}
            />
          )}
        </main>
      </div>

      {activeSection === 'products' && (
        <>
          <ProductModals />
          <AdPromotionModal store={store} />
        </>
      )}
    </div>
  )}

  <style is:global>
    .nav-tab-btn {
      color: #475569;
      border: 1px solid transparent;
      transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }
    .nav-tab-btn:hover {
      background-color: #f8fafc;
      color: #0f172a;
    }
    .nav-tab-btn.active {
      background-color: #ecfdf5;
      color: #064e3b;
      border-color: #a7f3d0;
      font-weight: 600;
    }
    .nav-tab-btn.active .nav-badge {
      background-color: #d1fae5;
      color: #065f46;
      border-color: transparent;
    }
  </style>
</AppLayout>

<script src="../../scripts/dashboard.client.ts"></script>
