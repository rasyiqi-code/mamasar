---
import { formatRupiah } from '../../../lib/utils';
import AppIcon from '../common/AppIcon.astro';

interface Props {
  summary: {
    totalIncome: number;
    totalExpense: number;
    balance: number;
  };
  entries: Array<{
    id: number;
    transaction_date: string;
    title: string;
    type: string;
    amount: number;
  }>;
  products?: Array<{
    id: number;
    name: string;
    price: number;
  }>;
}

const { summary, entries, products = [] } = Astro.props;
---

<section id="panel-cashbook" class="tab-panel">
  {/* Summary Metric Strip: Saldo Bersih Full Row on Mobile + 2-Col Income/Expense Underneath */}
  <div class="grid grid-cols-2 sm:grid-cols-3 border-b border-slate-200 text-xs">
    <div class="px-4 sm:px-6 lg:px-8 py-4 border-r border-slate-200">
      <span class="text-xs font-medium text-slate-600 block">Pemasukan</span>
      <span class="text-base sm:text-lg font-bold text-slate-900 block font-mono tabular-nums mt-0.5 truncate" id="cash-income-display">
        {formatRupiah(summary.totalIncome)}
      </span>
    </div>
    <div class="px-4 sm:px-6 lg:px-8 py-4 sm:border-r border-slate-200">
      <span class="text-xs font-medium text-slate-600 block">Pengeluaran</span>
      <span class="text-base sm:text-lg font-bold text-slate-900 block font-mono tabular-nums mt-0.5 truncate" id="cash-expense-display">
        {formatRupiah(summary.totalExpense)}
      </span>
    </div>
    <div class="col-span-2 sm:col-span-1 order-first sm:order-last border-b sm:border-b-0 border-slate-200 px-4 sm:px-6 lg:px-8 py-4 bg-emerald-50/40 sm:bg-transparent">
      <span class="text-xs font-medium text-slate-600 block">Saldo Bersih</span>
      <span class="text-xl sm:text-lg font-bold text-emerald-700 block font-mono tabular-nums mt-0.5" id="cash-balance-display">
        {formatRupiah(summary.balance)}
      </span>
    </div>
  </div>

  {/* Fast Entry Cashbook Section */}
  <div id="cashbook-form-container" class="hidden px-4 sm:px-6 lg:px-8 py-4 border-b border-slate-200 bg-slate-50/40 space-y-3">
    <div class="flex items-center justify-between">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">Catat Transaksi Kas</h3>
      <button type="button" id="btn-cancel-cashbook" class="min-h-[36px] px-2 text-xs text-slate-600 hover:text-slate-900 cursor-pointer inline-flex items-center gap-1">
        <span>Tutup</span>
        <AppIcon name="x" size="xs" />
      </button>
    </div>

    <form id="cashbook-entry-form" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
      {products.length > 0 && (
        <div class="sm:col-span-4 bg-slate-50 p-2.5 rounded-lg border border-slate-200 flex flex-col sm:flex-row sm:items-center gap-2">
          <span class="text-xs font-semibold text-slate-700 shrink-0">Isi Cepat Produk:</span>
          <select id="cashProdSelect" class="flex-1 min-h-[42px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs font-medium text-slate-800">
            <option value="">-- Isi otomatis nama &amp; harga dari produk --</option>
            {products.map((p) => (
              <option value={p.id} data-name={p.name} data-price={p.price}>
                {p.name} ({formatRupiah(p.price)})
              </option>
            ))}
          </select>
        </div>
      )}

      <div class="sm:col-span-2 space-y-1">
        <label for="cashTitle" class="block text-xs font-medium text-slate-700">Keterangan <span class="text-rose-500">*</span></label>
        <input
          type="text"
          id="cashTitle"
          name="title"
          placeholder="Contoh: Penjualan 3 Keripik"
          required
          class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/15"
        />
      </div>

      <div class="space-y-1">
        <label for="cashAmount" class="block text-xs font-medium text-slate-700">Nominal (Rp) <span class="text-rose-500">*</span></label>
        <input
          type="number"
          id="cashAmount"
          name="amount"
          placeholder="45000"
          required
          min="100"
          class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs font-mono focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/15"
        />
      </div>

      <div class="space-y-1">
        <label for="cashType" class="block text-xs font-medium text-slate-700">Jenis</label>
        <select
          id="cashType"
          name="type"
          class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs font-medium focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/15"
        >
          <option value="income">Pemasukan</option>
          <option value="expense">Pengeluaran</option>
        </select>
      </div>

      <div class="sm:col-span-2 space-y-1">
        <label for="cashDate" class="block text-xs font-medium text-slate-700">Tanggal</label>
        <input
          type="date"
          id="cashDate"
          name="transactionDate"
          class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs font-mono focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/15"
        />
      </div>

      <div class="sm:col-span-2 flex items-end justify-end">
        <button
          type="submit"
          class="min-h-[44px] py-2 px-5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-lg cursor-pointer inline-flex items-center gap-1.5"
        >
          <span>Simpan Catatan</span>
          <AppIcon name="arrow-right" size="xs" />
        </button>
      </div>
    </form>
  </div>

  {/* Mobile Table Horizontal-Scroll Hint */}
  <div class="sm:hidden px-4 py-1.5 bg-slate-50 border-b border-slate-200 text-[11px] text-slate-600 flex items-center justify-between">
    <span>Riwayat Transaksi Kas</span>
    <span class="font-medium text-slate-500">Geser ke samping →</span>
  </div>

  {/* Cashbook Table: Preserved Table with Clean Horizontal Scroll on Mobile */}
  <div class="w-full overflow-x-auto">
    <table class="w-full min-w-[600px] text-left text-xs border-b border-slate-200">
      <thead class="bg-slate-50/70">
        <tr class="border-b border-slate-200 text-slate-600 font-semibold uppercase tracking-wider text-xs">
          <th class="py-3 pl-4 sm:pl-6 lg:pl-8 pr-3 whitespace-nowrap">Tanggal</th>
          <th class="py-3 px-3">Keterangan</th>
          <th class="py-3 px-3 whitespace-nowrap">Jenis</th>
          <th class="py-3 px-3 text-right whitespace-nowrap">Nominal</th>
          <th class="py-3 pl-3 pr-4 sm:pr-6 lg:pr-8 text-center whitespace-nowrap">Aksi</th>
        </tr>
      </thead>
      <tbody id="cashbook-rows" class="divide-y divide-slate-100">
        {entries.length > 0 ? (
          entries.map((c) => (
            <tr class="hover:bg-slate-50/60 transition" id={`cash-row-${c.id}`}>
              <td class="py-2.5 pl-4 sm:pl-6 lg:pl-8 pr-3 text-slate-600 font-mono tabular-nums text-xs whitespace-nowrap">{c.transaction_date}</td>
              <td class="py-2.5 px-3 text-slate-900 font-medium">{c.title}</td>
              <td class="py-2.5 px-3 whitespace-nowrap">
                <span class={`inline-block px-2 py-0.5 rounded-md text-xs font-semibold ${
                  c.type === 'income' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200'
                }`}>
                  {c.type === 'income' ? 'Masuk' : 'Keluar'}
                </span>
              </td>
              <td class={`py-2.5 px-3 text-right font-bold font-mono tabular-nums whitespace-nowrap ${c.type === 'income' ? 'text-emerald-700' : 'text-rose-700'}`}>
                {c.type === 'income' ? '+' : '-'} {formatRupiah(c.amount)}
              </td>
              <td class="py-1.5 pl-3 pr-4 sm:pr-6 lg:pr-8 text-center">
                <button
                  type="button"
                  class="btn-delete-cash min-w-[44px] min-h-[44px] inline-flex items-center justify-center text-slate-500 hover:text-rose-600 hover:bg-rose-50 rounded-lg cursor-pointer transition"
                  data-id={c.id}
                  title="Hapus"
                  aria-label={`Hapus catatan ${c.title}`}
                >
                  <AppIcon name="x" size="xs" />
                </button>
              </td>
            </tr>
          ))
        ) : (
          <tr>
            <td colspan="5" class="py-10 px-4 sm:px-6 lg:px-8 text-center text-slate-500 text-xs">
              Belum ada catatan buku kas.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</section>
