---
import AppIcon from '../common/AppIcon.astro';

interface Props {
  authError?: string | null;
  isLoggedOut?: boolean;
  intent?: string | null;
}

const { authError, isLoggedOut = false, intent = null } = Astro.props;
const isKaderIntent = intent === 'daftar-kader';
---

<header class="border-b border-slate-200 bg-white">
  <div class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 h-14 flex items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 group">
      <span class="w-7 h-7 rounded-lg bg-emerald-700 text-white font-extrabold text-xs flex items-center justify-center group-hover:bg-emerald-800 transition">
        NU
      </span>
      <span class="font-bold text-sm text-slate-900">Mamasar</span>
    </a>
    <a
      href="/"
      class="min-h-[38px] px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700 transition inline-flex items-center gap-1.5"
    >
      <AppIcon name="bag" size="xs" />
      <span>Katalog UMKM</span>
    </a>
  </div>
</header>

<main id="main" tabindex="-1" class="flex-1 w-full max-w-site mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-14">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
    {/* Kiri: Penjelasan ringkas Portal Akun & Toko */}
    <div class="lg:col-span-6 space-y-6 pt-1">
      <div class="space-y-2.5">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-800">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
          <span>{isKaderIntent ? 'Pendaftaran Peran' : 'Portal UMKM & Kader'}</span>
        </span>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900 leading-tight">
          {isKaderIntent ? 'Masuk untuk Daftar Kader atau Pengurus' : 'Kelola Toko, Pembukuan & Peran NU'}
        </h1>
        <p class="text-sm text-slate-600 leading-relaxed max-w-lg">
          {isKaderIntent
            ? 'Masuk dengan Google atau email, lalu ajukan peran Kader Ranting atau Pengurus MWC NU.'
            : 'Satu akun terintegrasi untuk menayangkan produk UMKM, mencatat kas usaha, hingga mendata unit binaan.'}
        </p>
      </div>

      <ul class="divide-y divide-slate-200 border-y border-slate-200">
        <li class="py-3.5 flex items-start gap-3">
          <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5">
            <AppIcon name="store" size="sm" />
          </span>
          <div>
            <p class="text-xs font-bold text-slate-900">Etalase Toko &amp; Sundul Katalog</p>
            <p class="text-xs text-slate-600 mt-0.5">Terhubung langsung ke WhatsApp penjual tanpa komisi perantara.</p>
          </div>
        </li>
        <li class="py-3.5 flex items-start gap-3">
          <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5">
            <AppIcon name="book" size="sm" />
          </span>
          <div>
            <p class="text-xs font-bold text-slate-900">Buku Kas Usaha &amp; Ekspor CSV</p>
            <p class="text-xs text-slate-600 mt-0.5">Catat pemasukan dan pengeluaran harian usaha secara rapi.</p>
          </div>
        </li>
        <li class="py-3.5 flex items-start gap-3">
          <span class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-700 flex items-center justify-center shrink-0 mt-0.5">
            <AppIcon name="users" size="sm" />
          </span>
          <div>
            <p class="text-xs font-bold text-slate-900">Akses Kader Ranting &amp; MWC</p>
            <p class="text-xs text-slate-600 mt-0.5">Pendataan jemput bola UMKM dan kurasi produk wilayah.</p>
          </div>
        </li>
      </ul>
    </div>

    {/* Kanan: Panel Login / Registrasi */}
    <div class="lg:col-span-6 w-full lg:max-w-md lg:ml-auto">
      <div class="border border-slate-200 rounded-xl bg-white p-5 sm:p-7 space-y-5">
        <div class="space-y-1">
          <h2 class="text-base font-bold text-slate-900">Masuk ke Akun Anda</h2>
          <p class="text-xs text-slate-600">Pilih Google untuk akses cepat atau gunakan email.</p>
        </div>

        {isLoggedOut && (
          <div class="p-3 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-lg text-xs font-medium flex items-center gap-2">
            <AppIcon name="check" size="xs" class="shrink-0" />
            <span>Anda telah berhasil keluar dari akun.</span>
          </div>
        )}

        {authError && (
          <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-lg text-xs font-medium">
            Kendala autentikasi: {authError}. Silakan coba kembali beberapa saat lagi.
          </div>
        )}

        <div class="space-y-4">
          <a
            href="/api/auth/login"
            data-astro-prefetch="false"
            data-astro-reload
            class="w-full min-h-[44px] py-2.5 px-4 bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 font-semibold text-xs sm:text-sm rounded-lg flex items-center justify-center gap-3 transition cursor-pointer"
          >
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
            </svg>
            <span>Masuk dengan Akun Google</span>
          </a>

          <div class="relative flex items-center justify-center my-3">
            <div class="border-t border-slate-200 w-full"></div>
            <span class="bg-white px-3 text-xs font-medium text-slate-600 uppercase tracking-wider relative">atau dengan email</span>
          </div>

          <form id="neon-auth-form" class="space-y-3.5 text-left" aria-label="Formulir masuk atau daftar dengan email">
            <input type="hidden" id="neonAuthAction" name="action" value="signin" />

            <div id="name-field-group" class="space-y-1 hidden">
              <label for="neonName" class="block text-xs font-medium text-slate-800">Nama Lengkap</label>
              <input
                type="text"
                id="neonName"
                name="name"
                autocomplete="name"
                placeholder="Contoh: H. Ahmad Zaini"
                class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/15"
              />
            </div>

            <div class="space-y-1">
              <label for="neonEmail" class="block text-xs font-medium text-slate-800">Alamat Email</label>
              <input
                type="email"
                id="neonEmail"
                name="email"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="none"
                spellcheck="false"
                required
                placeholder="nama@email.com"
                class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/15"
              />
            </div>

            <div class="space-y-1">
              <div class="flex items-center justify-between">
                <label for="neonPassword" class="block text-xs font-medium text-slate-800">Kata Sandi</label>
                <button
                  type="button"
                  id="toggle-neon-password"
                  aria-pressed="false"
                  class="text-xs font-semibold text-slate-600 hover:text-emerald-800 underline underline-offset-2 cursor-pointer"
                >
                  Tampilkan
                </button>
              </div>
              <input
                type="password"
                id="neonPassword"
                name="password"
                autocomplete="current-password"
                required
                minlength="6"
                placeholder="Minimal 6 karakter"
                class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/15"
              />
            </div>

            <button
              type="submit"
              id="neon-submit-btn"
              class="w-full min-h-[44px] py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs sm:text-sm rounded-lg transition cursor-pointer"
            >
              Masuk dengan Email
            </button>
          </form>

          <div id="neon-auth-msg" role="status" aria-live="polite" class="hidden p-2.5 rounded-lg text-xs font-medium"></div>

          <div class="pt-1 border-t border-slate-100 text-center">
            <button
              type="button"
              id="toggle-auth-mode"
              class="min-h-[40px] px-2 text-xs text-slate-600 hover:text-emerald-800 font-medium underline inline-flex items-center gap-1 mx-auto cursor-pointer"
            >
              <span>Belum punya akun? Buat akun baru di sini</span>
              <AppIcon name="arrow-right" size="xs" />
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
