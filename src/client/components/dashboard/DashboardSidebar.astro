---
import AppIcon from '../common/AppIcon.astro';

interface Props {
  user: {
    id: number;
    name: string;
    email: string;
    avatar_url?: string | null;
  };
  store: {
    id: number;
    slug?: string;
    name: string;
    logo_url?: string | null;
    zone_name: string;
    is_verified?: boolean | number | null;
    products?: any[];
  };
  avatarUrl?: string | null;
  isSuper?: boolean;
  isCadre?: boolean;
  activeSection?: 'overview' | 'products' | 'cashbook' | 'profile' | 'services';
  productCount?: number;
  cashbookCount?: number;
}

const {
  user,
  store,
  avatarUrl,
  isSuper = false,
  isCadre = false,
  activeSection = 'overview',
  productCount = 0,
  cashbookCount = 0,
} = Astro.props;

const activeMobileTitleMap: Record<NonNullable<Props['activeSection']>, string> = {
  overview: 'Ringkasan Toko',
  products: 'Katalog Produk',
  cashbook: 'Buku Kas Usaha',
  profile: 'Profil & Data Toko',
  services: 'Layanan Kemitraan',
};
const activeMobileTitle = activeMobileTitleMap[activeSection];
---

<!-- MOBILE TOP HEADER (Unified App Bar: Menu + Page Title + Action) -->
<div class="md:hidden sticky top-0 z-40 bg-white/95 backdrop-blur-xs border-b border-slate-200 px-3 py-2 flex items-center justify-between gap-2">
  <div class="flex items-center gap-2.5 min-w-0">
    <button
      type="button"
      id="btn-toggle-sidebar"
      class="min-w-[44px] min-h-[44px] flex items-center justify-center text-slate-700 hover:text-slate-900 hover:bg-slate-50 rounded-lg border border-slate-200 focus:outline-none cursor-pointer shrink-0"
      aria-label="Buka Menu Sidebar"
    >
      <AppIcon name="menu" size="lg" />
    </button>

    <h2 class="text-sm font-bold text-slate-900 truncate">{activeMobileTitle}</h2>
  </div>

  <div class="flex items-center gap-1.5 shrink-0">
    {activeSection === 'products' && (
      <>
        <button
          type="button"
          data-trigger="open-promo"
          aria-label="Promosi dan Sundul"
          class="min-w-[44px] min-h-[44px] px-2.5 bg-white hover:bg-slate-50 text-slate-800 font-semibold text-xs rounded-lg border border-slate-300 transition inline-flex items-center justify-center gap-1 cursor-pointer"
        >
          <AppIcon name="zap" size="xs" class="text-amber-600" />
          <span class="hidden min-[390px]:inline">Promosi</span>
        </button>
        <a
          href="/pasang-iklan"
          class="min-h-[44px] py-2 px-3 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-lg shrink-0 transition inline-flex items-center gap-1"
        >
          <AppIcon name="plus" size="xs" />
          <span>Produk</span>
        </a>
      </>
    )}

    {activeSection === 'cashbook' && (
      <>
        <button
          type="button"
          data-trigger="export-csv"
          aria-label="Unduh CSV Buku Kas"
          title="Unduh CSV"
          class="min-w-[44px] min-h-[44px] px-2.5 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs rounded-lg border border-slate-300 transition cursor-pointer inline-flex items-center justify-center gap-1"
        >
          <AppIcon name="download" size="xs" />
          <span class="hidden min-[390px]:inline">CSV</span>
        </button>
        <button
          type="button"
          data-trigger="toggle-cashbook"
          class="min-h-[44px] py-2 px-3 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-lg transition cursor-pointer inline-flex items-center gap-1"
        >
          <AppIcon name="plus" size="xs" />
          <span>Catat</span>
        </button>
      </>
    )}

    {activeSection === 'overview' && (
      <a
        href="/pasang-iklan"
        class="min-h-[44px] py-2 px-3 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-lg shrink-0 transition inline-flex items-center gap-1"
      >
        <AppIcon name="plus" size="xs" />
        <span>Iklan</span>
      </a>
    )}

    {(activeSection === 'profile' || activeSection === 'services') && (
      <a
        href={`/toko/${store.slug || store.id}`}
        target="_blank"
        class="min-h-[44px] py-2 px-2.5 bg-white hover:bg-slate-50 text-slate-800 font-semibold text-xs rounded-lg border border-slate-300 shrink-0 transition inline-flex items-center gap-1"
      >
        <span>Etalase</span>
        <AppIcon name="external-link" size="xs" />
      </a>
    )}
  </div>
</div>

<!-- SIDEBAR BACKDROP ON MOBILE -->
<div id="sidebar-backdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 hidden md:hidden transition-opacity"></div>

<!-- DESKTOP & MOBILE SIDEBAR -->
<aside
  id="dashboard-sidebar"
  class="fixed md:sticky top-0 bottom-0 left-0 z-50 w-64 bg-[#fbfcfd] border-r border-slate-200 flex flex-col justify-between transform -translate-x-full md:translate-x-0 transition-transform duration-200 ease-in-out h-dvh shrink-0"
>
  <div class="flex flex-col h-full overflow-y-auto">
    <!-- Sidebar Brand / Store Profile (Matches sticky h-14 header hairline) -->
    <div class="px-4 h-14 border-b border-slate-200 flex items-center justify-between gap-2 shrink-0">
      <div class="flex items-center gap-3 min-w-0">
        <a
          href="/dashboard/profil#store-logo-section"
          id="sidebar-store-logo-link"
          title="Ubah Logo Toko"
          aria-label="Ubah Logo Toko"
          class="shrink-0 block rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-700/30 hover:ring-2 hover:ring-emerald-600/30 transition"
        >
          <img
            id="sidebar-store-logo-img"
            src={store.logo_url || ''}
            alt={`Logo ${store.name}`}
            class={`w-9 h-9 rounded-lg object-cover border border-slate-200 bg-white ${store.logo_url ? '' : 'hidden'}`}
          />
          <div
            id="sidebar-store-logo-fallback"
            class={`w-9 h-9 rounded-lg bg-emerald-700 text-white flex items-center justify-center font-bold text-sm ${store.logo_url ? 'hidden' : ''}`}
          >
            {store.name.slice(0, 2).toUpperCase()}
          </div>
        </a>
        <div class="min-w-0">
          <div class="text-xs font-bold text-slate-900 truncate" title={store.name}>{store.name}</div>
          <div class="flex items-center gap-1.5 pt-0.5">
            {store.is_verified ? (
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-700">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span> Terverifikasi
              </span>
            ) : (
              <span class="inline-flex items-center gap-1 text-xs text-slate-600">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Proses Kurasi
              </span>
            )}
          </div>
        </div>
      </div>

      <button
        type="button"
        id="btn-close-sidebar"
        class="md:hidden min-w-[44px] min-h-[44px] flex items-center justify-center text-slate-600 hover:text-slate-900 rounded-lg hover:bg-slate-100 cursor-pointer"
        aria-label="Tutup Menu Sidebar"
      >
        <AppIcon name="x" size="sm" />
      </button>
    </div>

    <!-- Role Quick Links (If Superadmin or Petugas) -->
    {(isSuper || isCadre) && (
      <div class="p-3 border-b border-slate-200 space-y-1.5">
        {isSuper && (
          <a
            href="/admin"
            class="min-h-[40px] flex items-center justify-between px-3 py-2 rounded-lg bg-rose-50 text-rose-900 border border-rose-200 text-xs font-semibold hover:bg-rose-100/70 transition"
          >
            <span class="flex items-center gap-1.5">
              <AppIcon name="shield" size="xs" />
              <span>Konsol Superadmin</span>
            </span>
            <AppIcon name="arrow-right" size="xs" />
          </a>
        )}
        {isCadre && !isSuper && (
          <a
            href="/admin#entry"
            class="min-h-[40px] flex items-center justify-between px-3 py-2 rounded-lg bg-emerald-50 text-emerald-900 border border-emerald-200 text-xs font-semibold hover:bg-emerald-100/70 transition"
          >
            <span class="flex items-center gap-1.5">
              <AppIcon name="clipboard" size="xs" />
              <span>Portal Petugas MWC</span>
            </span>
            <AppIcon name="arrow-right" size="xs" />
          </a>
        )}
      </div>
    )}

    <!-- Navigation Items (Dedicated URL Routes) -->
    <nav aria-label="Menu Dashboard Toko" class="p-3 space-y-1 flex-1 text-xs">
      <div class="space-y-1">
        <a
          href="/dashboard"
          aria-current={activeSection === 'overview' ? 'page' : undefined}
          class={`nav-tab-btn w-full min-h-[42px] flex items-center gap-2.5 px-3 py-2 rounded-lg text-left ${
            activeSection === 'overview' ? 'active' : ''
          }`}
        >
          <AppIcon name="sliders" size="sm" />
          <span>Ringkasan</span>
        </a>

        <a
          href="/dashboard/produk"
          aria-current={activeSection === 'products' ? 'page' : undefined}
          class={`nav-tab-btn w-full min-h-[42px] flex items-center justify-between px-3 py-2 rounded-lg text-left ${
            activeSection === 'products' ? 'active' : ''
          }`}
        >
          <div class="flex items-center gap-2.5">
            <AppIcon name="package" size="sm" />
            <span>Katalog Produk</span>
          </div>
          <span class="nav-badge text-xs font-mono font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 tabular-nums">
            {productCount}
          </span>
        </a>

        <a
          href="/dashboard/kas"
          aria-current={activeSection === 'cashbook' ? 'page' : undefined}
          class={`nav-tab-btn w-full min-h-[42px] flex items-center justify-between px-3 py-2 rounded-lg text-left ${
            activeSection === 'cashbook' ? 'active' : ''
          }`}
        >
          <div class="flex items-center gap-2.5">
            <AppIcon name="book" size="sm" />
            <span>Buku Kas Usaha</span>
          </div>
          <span class="nav-badge text-xs font-mono font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 tabular-nums">
            {cashbookCount}
          </span>
        </a>

        <a
          href="/dashboard/kemitraan"
          aria-current={activeSection === 'services' ? 'page' : undefined}
          class={`nav-tab-btn w-full min-h-[42px] flex items-center gap-2.5 px-3 py-2 rounded-lg text-left ${
            activeSection === 'services' ? 'active' : ''
          }`}
        >
          <AppIcon name="award" size="sm" />
          <span>Layanan Kemitraan</span>
        </a>
      </div>

      <div class="md:hidden pt-3 mt-3 border-t border-slate-200 space-y-1">
        <a
          href="/"
          class="min-h-[40px] flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 transition font-medium"
        >
          <AppIcon name="globe" size="sm" />
          <span>Katalog Publik</span>
        </a>
      </div>
    </nav>

    <!-- Sidebar Footer: Mobile Storefront Link & User Account Row -->
    <div class="p-3 border-t border-slate-200 space-y-2.5 md:space-y-0">
      <a
        href={`/toko/${store.slug || store.id}`}
        target="_blank"
        class="md:hidden w-full min-h-[40px] flex items-center justify-center gap-1.5 py-2 px-3 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs rounded-lg border border-slate-200 transition"
      >
        <span>Lihat Toko Publik</span>
        <AppIcon name="external-link" size="xs" />
      </a>

      <div class="pt-2 md:pt-0 border-t md:border-t-0 border-slate-200/70 flex items-center justify-between gap-1.5 text-xs">
        <a
          href="/dashboard/profil"
          aria-current={activeSection === 'profile' ? 'page' : undefined}
          title="Buka Profil Toko & Akun"
          class={`flex-1 min-w-0 flex items-center gap-2.5 p-1.5 rounded-lg transition group ${
            activeSection === 'profile'
              ? 'bg-emerald-50 ring-1 ring-emerald-200'
              : 'hover:bg-slate-100'
          }`}
        >
          {avatarUrl ? (
            <img
              src={avatarUrl}
              alt={user.name}
              class="w-8 h-8 rounded-full border border-slate-200 shrink-0 object-cover"
            />
          ) : (
            <span
              aria-hidden="true"
              class="w-8 h-8 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 font-bold text-xs flex items-center justify-center shrink-0"
            >
              {user.name.slice(0, 2).toUpperCase()}
            </span>
          )}
          <div class="min-w-0 flex-1">
            <span class="font-semibold text-slate-900 group-hover:text-emerald-800 block truncate text-xs">{user.name}</span>
            <span class="text-xs text-slate-600 block truncate">{user.email}</span>
          </div>
          <AppIcon
            name="chevron-right"
            size="xs"
            class={`shrink-0 transition ${activeSection === 'profile' ? 'text-emerald-700' : 'text-slate-400 group-hover:text-slate-700'}`}
          />
        </a>
        <form
          method="POST"
          action="/api/auth/logout"
          onsubmit="try{localStorage.removeItem('mamasar_favorites')}catch{}"
        >
          <button
            type="submit"
            class="min-w-[36px] min-h-[36px] flex items-center justify-center text-slate-600 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition cursor-pointer"
            title="Keluar"
            aria-label="Keluar dari akun"
          >
            <AppIcon name="log-out" size="sm" />
          </button>
        </form>
      </div>
    </div>
  </div>
</aside>

<!-- MOBILE DASHBOARD BOTTOM TAB BAR (1-Tap Thumb Navigation Across Core Store Views) -->
<nav
  aria-label="Navigasi Bawah Dashboard"
  class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-xs border-t border-slate-200 px-1 py-1 pb-[calc(0.35rem+env(safe-area-inset-bottom,0px))] grid grid-cols-5 items-center text-[11px]"
>
  <a
    href="/dashboard"
    aria-current={activeSection === 'overview' ? 'page' : undefined}
    class={`min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold transition ${
      activeSection === 'overview' ? 'text-emerald-700 bg-emerald-50/70' : 'text-slate-600 hover:text-emerald-700'
    }`}
  >
    <AppIcon name="sliders" size="sm" />
    <span class="truncate max-w-full">Ringkasan</span>
  </a>

  <a
    href="/dashboard/produk"
    aria-current={activeSection === 'products' ? 'page' : undefined}
    class={`relative min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold transition ${
      activeSection === 'products' ? 'text-emerald-700 bg-emerald-50/70' : 'text-slate-600 hover:text-emerald-700'
    }`}
  >
    <AppIcon name="package" size="sm" />
    <span class="truncate max-w-full">Produk</span>
    {productCount > 0 && (
      <span class="absolute top-1 right-2.5 min-w-[16px] h-4 px-1 rounded-full bg-slate-200 text-slate-800 text-[10px] font-mono font-bold flex items-center justify-center leading-none">
        {productCount > 99 ? '99+' : productCount}
      </span>
    )}
  </a>

  <a
    href="/dashboard/kas"
    aria-current={activeSection === 'cashbook' ? 'page' : undefined}
    class={`min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold transition ${
      activeSection === 'cashbook' ? 'text-emerald-700 bg-emerald-50/70' : 'text-slate-600 hover:text-emerald-700'
    }`}
  >
    <AppIcon name="book" size="sm" />
    <span class="truncate max-w-full">Buku Kas</span>
  </a>

  <a
    href="/dashboard/profil"
    aria-current={activeSection === 'profile' ? 'page' : undefined}
    class={`min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold transition ${
      activeSection === 'profile' ? 'text-emerald-700 bg-emerald-50/70' : 'text-slate-600 hover:text-emerald-700'
    }`}
  >
    <AppIcon name="store" size="sm" />
    <span class="truncate max-w-full">Profil</span>
  </a>

  <a
    href="/dashboard/kemitraan"
    aria-current={activeSection === 'services' ? 'page' : undefined}
    class={`min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold transition ${
      activeSection === 'services' ? 'text-emerald-700 bg-emerald-50/70' : 'text-slate-600 hover:text-emerald-700'
    }`}
  >
    <AppIcon name="award" size="sm" />
    <span class="truncate max-w-full">Mitra</span>
  </a>
</nav>
