---
import { SITE_CONFIG } from '../../../lib/constants';
import AppIcon from '../common/AppIcon.astro';

interface Zone {
  id: number;
  name: string;
}

interface Props {
  user: {
    id: number;
    name: string;
    role: string;
    agent_status?: string | null;
    agent_ranting?: string | null;
    agent_org?: string | null;
    agent_phone?: string | null;
    assigned_zone_id?: number | null;
  } | null;
  zones: Zone[];
  assignedZone?: Zone;
}

const { user, zones, assignedZone } = Astro.props;
const isSuper = user?.role === 'pcnu';
const isMwcAdmin = user?.role === 'mwcnu';
const isCadre =
  isSuper ||
  isMwcAdmin ||
  user?.role === 'ranting' ||
  user?.agent_status === 'active';
const isPending = user?.agent_status === 'pending' || user?.agent_status === 'pending_mwcnu';
const isPendingMwc = user?.agent_status === 'pending_mwcnu';
const isRejected = user?.agent_status === 'rejected';

const banomPills = ['LPNU', 'GP Ansor', 'Fatayat', 'Muslimat', 'IPNU/IPPNU', 'ISNU'];
---

{isCadre ? (
  /* STATUS 1: AKUN SUDAH AKTIF */
  <div class="space-y-4">
    <div class="pb-2 border-b border-slate-200 flex items-center justify-between">
      <h2 class="text-xs font-black uppercase tracking-wider text-slate-800 flex items-center gap-2">
        <AppIcon name="check" size="xs" class="text-emerald-700" />
        <span>Status Penugasan Aktif</span>
      </h2>
      <span class="text-xs font-bold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
        {isSuper ? 'Superadmin PCNU' : isMwcAdmin ? 'Pengurus MWC' : 'Kader Ranting'}
      </span>
    </div>

    <div class="space-y-1 text-xs text-slate-700">
      <p class="text-sm font-bold text-slate-900">
        Wilayah: MWC {assignedZone?.name || 'Sumenep'}{user?.agent_ranting ? ` · Ranting ${user.agent_ranting}` : ''}
      </p>
      <p class="text-slate-600">
        {isSuper
          ? 'Anda memiliki akses penuh moderasi toko, verifikasi kader, dan konfigurasi zona di konsol admin.'
          : isMwcAdmin
            ? 'Anda memiliki hak akses verifikasi toko binaan dan kurasi komoditas wilayah kecamatan Anda.'
            : 'Anda memiliki hak entri cepat jemput bola UMKM warga langsung ke katalog direktori.'}
      </p>
    </div>

    <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
      <a
        href="/"
        class="w-full sm:w-auto min-h-[44px] inline-flex items-center justify-center px-5 py-2.5 text-xs font-bold text-slate-700 hover:text-slate-900 border border-slate-300 rounded-lg text-center hover:bg-slate-50 transition"
      >
        Lihat Katalog
      </a>

      <a
        href={isSuper ? '/admin' : '/admin#entry'}
        class="w-full sm:w-auto min-h-[44px] px-6 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs sm:text-sm rounded-lg transition inline-flex items-center justify-center gap-1.5"
      >
        <span>{isSuper ? 'Konsol Admin' : 'Portal Kerja Petugas'}</span>
        <AppIcon name="arrow-right" size="xs" />
      </a>
    </div>
  </div>
) : isPending ? (
  /* STATUS 2: PERMOHONAN SEDANG DIPROSES */
  <div class="space-y-4">
    <div class="pb-2 border-b border-slate-200 flex items-center justify-between">
      <h2 class="text-xs font-black uppercase tracking-wider text-slate-800 flex items-center gap-2">
        <AppIcon name="clock" size="xs" class="text-amber-700" />
        <span>Status Permohonan Peran</span>
      </h2>
      <span class="text-xs font-bold text-amber-900 bg-amber-100 px-2 py-0.5 rounded border border-amber-300">
        Menunggu Verifikasi
      </span>
    </div>

    <div class="space-y-1 text-xs text-slate-700">
      <p class="text-sm font-bold text-slate-900">
        Peran: {isPendingMwc ? 'Pengurus MWC NU' : 'Kader Ranting'} · MWC {assignedZone?.name || 'Sumenep'}
      </p>
      <p class="text-slate-600">
        Berkas pengajuan Anda sedang ditinjau oleh Admin PCNU Sumenep. Konfirmasi pendaftaran dapat dilakukan langsung via WhatsApp resmi.
      </p>
    </div>

    <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
      <a
        href="/"
        class="w-full sm:w-auto min-h-[44px] inline-flex items-center justify-center px-5 py-2.5 text-xs font-bold text-slate-700 hover:text-slate-900 border border-slate-300 rounded-lg text-center hover:bg-slate-50 transition"
      >
        Kembali ke Beranda
      </a>

      <a
        href={`https://wa.me/${SITE_CONFIG.whatsappHelp}?text=${encodeURIComponent(`Assalamu'alaikum Admin PCNU, saya ${user?.name || ''} sudah mengajukan peran ${isPendingMwc ? 'Pengurus MWC' : 'Kader Ranting'} Mamasar wilayah MWC ${assignedZone?.name || 'Sumenep'}. Mohon bantuannya untuk verifikasi.`)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto min-h-[44px] px-6 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs sm:text-sm rounded-lg transition inline-flex items-center justify-center gap-1.5"
      >
        <AppIcon name="phone" size="xs" />
        <span>Konfirmasi via WhatsApp</span>
      </a>
    </div>
  </div>
) : !user ? (
  /* STATUS 3: BELUM LOGIN */
  <div class="space-y-4">
    <div class="pb-2 border-b border-slate-200 flex items-center justify-between">
      <h2 class="text-xs font-black uppercase tracking-wider text-slate-800 flex items-center gap-2">
        <AppIcon name="shield" size="xs" class="text-slate-600" />
        <span>Autentikasi Diperlukan</span>
      </h2>
      <span class="text-xs font-bold text-slate-700 bg-slate-100 px-2 py-0.5 rounded border border-slate-200">
        Perlu Masuk Akun
      </span>
    </div>

    <div class="space-y-1 text-xs text-slate-700">
      <p class="text-sm font-bold text-slate-900">
        Silakan masuk ke akun Nahdliyin Anda
      </p>
      <p class="text-slate-600">
        Pendaftaran peran Kader Ranting dan Pengurus MWC memerlukan akun terdaftar agar hak akses verifikasi dan pendataan jemput bola dapat terhubung dengan identitas resmi Anda.
      </p>
    </div>

    <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
      <a
        href="/"
        class="w-full sm:w-auto min-h-[44px] inline-flex items-center justify-center px-5 py-2.5 text-xs font-bold text-slate-700 hover:text-slate-900 border border-slate-300 rounded-lg text-center hover:bg-slate-50 transition"
      >
        Lihat Katalog
      </a>

      <a
        href="/login?redirect=/daftar-kader"
        class="w-full sm:w-auto min-h-[44px] px-6 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs sm:text-sm rounded-lg transition inline-flex items-center justify-center gap-1.5"
      >
        <span>Masuk</span>
        <AppIcon name="arrow-right" size="xs" />
      </a>
    </div>
  </div>
) : (
  /* STATUS 4: FORM PENDAFTARAN (MIRRORING pasang-iklan.astro FORM LAYOUT) */
  <form id="petugas-register-form" class="space-y-6" aria-label="Formulir pengajuan peran kader">
    {isRejected && (
      <div class="-mx-3 sm:mx-0 px-3.5 py-3.5 sm:p-4 rounded-none sm:rounded-lg bg-amber-50 border-y sm:border border-amber-200 text-xs font-semibold text-amber-950">
        Pengajuan sebelumnya belum disetujui. Periksa kembali kecocokan data wilayah dan nomor WhatsApp Anda, lalu kirim ulang permohonan di bawah ini.
      </div>
    )}

    <div id="petugas-reg-status" role="status" aria-live="polite" class="hidden -mx-3 sm:mx-0 px-3.5 py-3.5 sm:p-4 rounded-none sm:rounded-lg text-xs font-semibold"></div>

    {/* Section 1: Pilihan Peran & Wilayah (Persis Section Detail Produk di pasang-iklan) */}
    <div class="space-y-4">
      <div class="pb-2 border-b border-slate-200 flex items-center justify-between">
        <h2 class="text-xs font-black uppercase tracking-wider text-slate-800 flex items-center gap-2">
          <AppIcon name="users" size="xs" class="text-emerald-700" />
          <span>Pilihan Peran &amp; Wilayah</span>
        </h2>
        <span class="text-xs text-slate-600">* Wajib</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <label
          for="roleOptionRanting"
          class="flex items-start gap-3 p-3.5 rounded-lg border border-slate-300 hover:border-emerald-600 bg-white cursor-pointer transition min-h-[48px] has-checked:border-emerald-700 has-checked:bg-emerald-50/40 has-checked:ring-1 has-checked:ring-emerald-700"
        >
          <input
            type="radio"
            id="roleOptionRanting"
            name="requestedRole"
            value="ranting"
            checked
            class="mt-0.5 w-4 h-4 accent-emerald-700 shrink-0"
          />
          <div class="text-xs leading-snug">
            <strong class="text-slate-900 font-bold block">Kader Ranting</strong>
            <span class="text-slate-600">Pendataan jemput bola UMKM warga di tingkat Desa/Kelurahan</span>
          </div>
        </label>

        <label
          for="roleOptionMwc"
          class="flex items-start gap-3 p-3.5 rounded-lg border border-slate-300 hover:border-emerald-600 bg-white cursor-pointer transition min-h-[48px] has-checked:border-emerald-700 has-checked:bg-emerald-50/40 has-checked:ring-1 has-checked:ring-emerald-700"
        >
          <input
            type="radio"
            id="roleOptionMwc"
            name="requestedRole"
            value="mwcnu"
            class="mt-0.5 w-4 h-4 accent-emerald-700 shrink-0"
          />
          <div class="text-xs leading-snug">
            <strong class="text-slate-900 font-bold block">Pengurus MWC NU</strong>
            <span class="text-slate-600">Verifikasi toko binaan &amp; kurasi tingkat Kecamatan</span>
          </div>
        </label>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label for="regZoneId" class="block text-xs font-bold text-slate-700">
            Wilayah MWC NU (Kecamatan) <span class="text-rose-600">*</span>
          </label>
          <select
            id="regZoneId"
            name="zoneId"
            required
            aria-invalid="false"
            class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs sm:text-sm font-semibold text-slate-900 focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 cursor-pointer transition"
          >
            <option value="" disabled selected={!user?.assigned_zone_id}>Pilih Wilayah MWC</option>
            {zones.map((z) => (
              <option value={z.id} selected={user?.assigned_zone_id === z.id}>{z.name}</option>
            ))}
          </select>
        </div>

        <div class="space-y-1.5">
          <label for="regRanting" id="regRantingLabel" class="block text-xs font-bold text-slate-700">
            Ranting NU (Desa / Kelurahan) <span id="regRantingRequiredMark" class="text-rose-600">*</span>
          </label>
          <input
            type="text"
            id="regRanting"
            name="ranting"
            value={user?.agent_ranting || ''}
            placeholder="Contoh: Gapura Barat / Pajagalan"
            required
            aria-invalid="false"
            class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs sm:text-sm text-slate-900 placeholder:text-slate-500 focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 transition"
          />
        </div>
      </div>
    </div>

    {/* Section 2: Kontak & Lembaga (Persis Section Foto/Kontak di pasang-iklan) */}
    <div class="space-y-4 pt-2">
      <div class="pb-2 border-b border-slate-200 flex items-center justify-between">
        <h2 class="text-xs font-black uppercase tracking-wider text-slate-800 flex items-center gap-2">
          <AppIcon name="phone" size="xs" class="text-emerald-700" />
          <span>Kontak &amp; Afiliasi</span>
        </h2>
        <span class="text-xs text-slate-600">* Wajib</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label for="regPhone" class="block text-xs font-bold text-slate-700">
            Nomor WhatsApp Aktif <span class="text-rose-600">*</span>
          </label>
          <input
            type="tel"
            id="regPhone"
            name="phone"
            value={user?.agent_phone || ''}
            autocomplete="tel"
            inputmode="tel"
            placeholder="Contoh: 081234567890"
            required
            aria-invalid="false"
            class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs sm:text-sm font-mono font-bold text-slate-900 placeholder:text-slate-500 focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 transition"
          />
        </div>

        <div class="space-y-1.5">
          <label for="regOrg" class="block text-xs font-bold text-slate-700">
            Afiliasi Banom / Lembaga NU <span class="text-rose-600">*</span>
          </label>
          <input
            type="text"
            id="regOrg"
            name="org"
            value={user?.agent_org || ''}
            placeholder="Contoh: LPNU / GP Ansor / Fatayat"
            required
            aria-invalid="false"
            class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg p-2.5 text-xs sm:text-sm text-slate-900 placeholder:text-slate-500 focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 transition"
          />
          <div class="flex flex-wrap items-center gap-1 pt-1">
            <span class="text-[10px] text-slate-500 mr-0.5">Pilihan:</span>
            {banomPills.map((b) => (
              <button
                type="button"
                class="text-[10px] font-semibold bg-slate-100 hover:bg-emerald-50 hover:text-emerald-800 text-slate-600 px-1.5 py-0.5 rounded border border-slate-200 transition cursor-pointer"
                onclick={`const el = document.getElementById('regOrg'); if(el) { el.value = '${b}'; el.focus(); }`}
              >
                {b}
              </button>
            ))}
          </div>
        </div>
      </div>
    </div>

    {/* Section 3: Persetujuan (Persis pasang-iklan line 265) */}
    <label for="petugasRegConsent" class="flex items-start gap-2.5 pt-2 cursor-pointer text-xs text-slate-700">
      <input
        type="checkbox"
        id="petugasRegConsent"
        required
        class="mt-0.5 w-4 h-4 accent-emerald-700 shrink-0 rounded border-slate-300"
      />
      <span>
        Saya menyetujui <a href="/privasi" target="_blank" class="text-emerald-700 font-semibold underline">Kebijakan Privasi Mamasar</a> dan memastikan data pendaftaran kader ini benar untuk diverifikasi pengurus PCNU.
      </span>
    </label>

    {/* Section 4: Action Buttons (Persis pasang-iklan line 278-293) */}
    <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
      <a
        href="/"
        class="w-full sm:w-auto min-h-[44px] inline-flex items-center justify-center px-5 py-2.5 text-xs font-bold text-slate-700 hover:text-slate-900 border border-slate-300 rounded-lg text-center hover:bg-slate-50 transition"
      >
        Batal
      </a>

      <button
        type="submit"
        id="btn-submit-petugas-reg"
        class="w-full sm:w-auto min-h-[44px] px-6 py-2.5 bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] disabled:opacity-50 text-white font-bold text-xs sm:text-sm rounded-lg transition flex items-center justify-center cursor-pointer"
      >
        Daftar
      </button>
    </div>
  </form>
)}
