---
import KaderRegisterForm from './KaderRegisterForm.astro';
import PrivacyAccountPanel from './PrivacyAccountPanel.astro';
import AppIcon from '../common/AppIcon.astro';

interface Zone {
  id: number;
  name: string;
}

interface Props {
  user: {
    id: number;
    name: string;
    email: string;
    role: string;
    agent_status?: string | null;
    agent_ranting?: string | null;
    agent_org?: string | null;
    agent_phone?: string | null;
    assigned_zone_id?: number | null;
  };
  zones: Zone[];
  assignedZone?: Zone;
  isSuper?: boolean;
  isCadre?: boolean;
  initialTab?: 'store' | 'kader';
}

const {
  user,
  zones,
  assignedZone,
  isSuper = false,
  isCadre = false,
  initialTab = 'store',
} = Astro.props;

const isPending = user.agent_status === 'pending' || user.agent_status === 'pending_mwcnu';
const roleLabel = isSuper
  ? 'Superadmin PCNU'
  : user.role === 'mwcnu'
    ? 'Pengurus MWC NU'
    : isCadre
      ? 'Kader Ranting Aktif'
      : isPending
        ? 'Menunggu Verifikasi Kader'
        : 'Warga';

const showKaderFirst = initialTab === 'kader';
---

<main id="main" tabindex="-1" class="min-h-screen w-full bg-white px-4 sm:px-8 lg:px-12 py-5 sm:py-12">
<div class="max-w-4xl mx-auto space-y-6">
  <!-- Account Status & Quick Actions (App Mode, No Front Header) -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-200">
    <div class="min-w-0 space-y-0.5">
      <div class="flex items-center gap-2 flex-wrap">
        <span class="text-sm font-bold text-slate-900 truncate">{user.name}</span>
        <span class={`text-xs font-semibold px-2 py-0.5 rounded-md border ${
          isSuper
            ? 'bg-rose-50 text-rose-800 border-rose-200'
            : isCadre
              ? 'bg-emerald-50 text-emerald-800 border-emerald-200'
              : isPending
                ? 'bg-amber-50 text-amber-900 border-amber-200'
                : 'bg-slate-100 text-slate-700 border-slate-200'
        }`}>
          {roleLabel}
        </span>
      </div>
      <p class="hidden sm:block text-xs text-slate-600 truncate font-mono">{user.email}</p>
    </div>

    <div class="flex items-center gap-2 shrink-0 w-full sm:w-auto">
      <a
        href="/"
        class="flex-1 sm:flex-initial inline-flex items-center justify-center min-h-[44px] px-3.5 py-1.5 rounded-lg border border-slate-300 bg-white hover:bg-slate-50 text-xs font-semibold text-slate-700 transition"
      >
        Lihat Pasar
      </a>
      <form
        method="POST"
        action="/api/auth/logout"
        onsubmit="try{localStorage.removeItem('mamasar_favorites')}catch{}"
        class="flex-1 sm:flex-initial"
      >
        <button
          type="submit"
          class="w-full inline-flex items-center justify-center min-h-[44px] px-3.5 py-1.5 rounded-lg border border-rose-200 bg-rose-50 hover:bg-rose-100 text-xs font-semibold text-rose-800 transition cursor-pointer"
        >
          Keluar Akun
        </button>
      </form>
    </div>
  </div>

  <!-- Quick Portal Banner for Superadmin / Active Pengurus / Active Kader -->
  {(isSuper || isCadre) && (
    <div class={`p-4 rounded-lg border flex flex-col sm:flex-row sm:items-center justify-between gap-3 ${
      isSuper ? 'bg-rose-50/70 border-rose-200' : 'bg-emerald-50/70 border-emerald-200'
    }`}>
      <div class="space-y-0.5">
        <p class="text-xs font-bold text-slate-900">
          {isSuper
            ? 'Anda masuk dengan akun Superadmin PCNU'
            : user.role === 'mwcnu'
              ? `Anda aktif sebagai Pengurus MWC ${assignedZone?.name || 'Sumenep'}`
              : `Anda aktif sebagai Kader Ranting ${user.agent_ranting || ''} (MWC ${assignedZone?.name || 'Sumenep'})`}
        </p>
        <p class="text-xs text-slate-700">
          {isSuper
            ? 'Atur peran seluruh akun, setujui pengajuan kader/MWC, dan moderasi toko dari Konsol Admin.'
            : 'Masuk ke portal tugas untuk mendata UMKM warga atau mengelola toko binaan di wilayah Anda.'}
        </p>
      </div>
      <a
        href={isSuper ? '/admin' : '/admin#entry'}
        class={`inline-flex items-center justify-center gap-1.5 min-h-[44px] px-4 py-2 rounded-lg text-xs font-bold text-white transition shrink-0 ${
          isSuper ? 'bg-rose-700 hover:bg-rose-800' : 'bg-emerald-700 hover:bg-emerald-800'
        }`}
      >
        <span>{isSuper ? 'Konsol Admin' : 'Portal Tugas'}</span>
        <AppIcon name="arrow-right" size="xs" />
      </a>
    </div>
  )}

  {/* Role Onboarding Header + Accessible Tab Switcher */}
  <div class="space-y-4">
    <div class="space-y-1">
      <h1 class="text-xl sm:text-2xl font-bold tracking-tight text-slate-900">
        Pilih Tujuan Akun Anda
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
        Ingin berjualan di pasar UMKM atau bertugas sebagai Kader Ranting / Pengurus MWC NU? Pilih tab di bawah ini sesuai kebutuhan Anda.
      </p>
    </div>

    <div
      role="tablist"
      aria-label="Pilihan pendaftaran peran akun"
      class="flex border-b border-slate-200 overflow-x-auto"
    >
      <button
        type="button"
        role="tab"
        id="onboard-tab-store"
        data-onboard-tab="store"
        aria-selected={showKaderFirst ? 'false' : 'true'}
        tabindex={showKaderFirst ? '-1' : '0'}
        class={`relative flex-1 min-h-[44px] px-4 py-2.5 text-xs sm:text-sm font-semibold whitespace-nowrap cursor-pointer transition border-b-2 inline-flex items-center justify-center gap-2 ${
          !showKaderFirst
            ? 'border-emerald-700 text-emerald-800 bg-emerald-50/50'
            : 'border-transparent text-slate-600 hover:text-slate-900 hover:bg-slate-50'
        }`}
      >
        <AppIcon name="store" size="xs" />
        <span>Buka / Klaim Toko</span>
      </button>
      <button
        type="button"
        role="tab"
        id="onboard-tab-kader"
        data-onboard-tab="kader"
        aria-selected={showKaderFirst ? 'true' : 'false'}
        tabindex={showKaderFirst ? '0' : '-1'}
        class={`relative flex-1 min-h-[44px] px-4 py-2.5 text-xs sm:text-sm font-semibold whitespace-nowrap cursor-pointer transition border-b-2 inline-flex items-center justify-center gap-2 ${
          showKaderFirst
            ? 'border-emerald-700 text-emerald-800 bg-emerald-50/50'
            : 'border-transparent text-slate-600 hover:text-slate-900 hover:bg-slate-50'
        }`}
      >
        <AppIcon name="users" size="xs" />
        <span>Daftar Kader / Pengurus</span>
      </button>
    </div>
  </div>

  <!-- Panel 1: Buka / Klaim Toko UMKM -->
  <div
    id="onboard-panel-store"
    role="tabpanel"
    aria-labelledby="onboard-tab-store"
    hidden={showKaderFirst}
    class="space-y-5"
  >
    <div id="setup-status" role="status" aria-live="polite" class="hidden p-3 rounded-lg text-xs font-semibold"></div>

    <form id="store-setup-form" class="space-y-4" aria-label="Formulir pembukaan profil toko UMKM">
      <input type="hidden" id="claimStoreIdInput" name="claimStoreId" value="" />
      <input type="hidden" id="skipClaimInput" name="skipClaim" value="" />

      <div class="space-y-1.5">
        <label for="storeName" class="block text-xs font-medium text-slate-700">Nama Toko / Usaha <span class="text-rose-500">*</span></label>
        <input
          type="text"
          id="storeName"
          name="name"
          placeholder="Contoh: Toko Barokah Gapura"
          required
          class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/15"
        />
      </div>

      <div class="space-y-1.5">
        <label for="storePhone" class="block text-xs font-medium text-slate-700">Nomor WhatsApp Aktif <span class="text-rose-500">*</span></label>
        <input
          type="tel"
          id="storePhone"
          name="phone"
          placeholder="Contoh: 081234567890"
          required
          class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 font-mono focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/15"
        />
        <p class="text-xs text-slate-600">Pastikan nomor ini aktif di WhatsApp untuk menerima pesanan dari jamaah.</p>
      </div>

      {/* Pending Claim Card (Shown if phone matches an orphan store) */}
      <div id="claim-offer" class="hidden p-4 rounded-lg bg-amber-50 border border-amber-300 space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-amber-900">Toko Terdeteksi</span>
        <p id="claim-offer-text" class="text-xs text-amber-950 leading-relaxed font-medium"></p>
        <div class="flex flex-wrap items-center gap-2 pt-1">
          <button
            type="button"
            id="btn-claim-store"
            class="min-h-[40px] py-1.5 px-3 bg-amber-700 hover:bg-amber-800 text-white font-semibold text-xs rounded-md transition cursor-pointer inline-flex items-center gap-1.5"
          >
            <AppIcon name="check" size="xs" />
            <span>Klaim Toko Ini</span>
          </button>
          <button
            type="button"
            id="btn-skip-claim"
            class="min-h-[40px] py-1.5 px-3 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 font-medium text-xs rounded-md transition cursor-pointer"
          >
            Buat Baru
          </button>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label for="storeZoneId" class="block text-xs font-medium text-slate-700">Wilayah MWC NU (Kecamatan) <span class="text-rose-500">*</span></label>
          <select
            id="storeZoneId"
            name="zoneId"
            required
            class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs font-medium text-slate-800 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/15 cursor-pointer"
          >
            <option value="" disabled selected>Pilih Wilayah MWC Kecamatan</option>
            {zones.map((z) => (
              <option value={z.id}>{z.name}</option>
            ))}
          </select>
        </div>

        <div class="space-y-1.5">
          <label for="storeRanting" class="block text-xs font-medium text-slate-700">Ranting NU (Desa / Kelurahan)</label>
          <input
            type="text"
            id="storeRanting"
            name="ranting"
            placeholder="Contoh: Gapura Barat / Paberasan"
            class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/15"
          />
        </div>
      </div>

      <div class="space-y-1.5">
        <label for="storeAddress" class="block text-xs font-medium text-slate-700">Alamat Lengkap / Dusun</label>
        <input
          type="text"
          id="storeAddress"
          name="address"
          placeholder="Contoh: Dusun Karang Anyar, RT 01 RW 02"
          class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/15"
        />
      </div>

      <label for="storeSetupConsent" class="flex items-start gap-2.5 pt-1 cursor-pointer text-xs text-slate-700">
        <input
          type="checkbox"
          id="storeSetupConsent"
          required
          class="mt-0.5 w-4 h-4 accent-emerald-700 shrink-0 rounded border-slate-300"
        />
        <span>
          Saya menyetujui <a href="/privasi" target="_blank" class="text-emerald-700 font-semibold underline">Kebijakan Privasi Mamasar</a> untuk menampilkan data kontak toko di direktori publik.
        </span>
      </label>

      <div class="pt-2">
        <button
          type="submit"
          id="btn-save-store"
          class="w-full min-h-[44px] py-2.5 px-6 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs sm:text-sm rounded-lg transition cursor-pointer inline-flex items-center justify-center gap-2"
        >
          <span>Buka Toko</span>
          <AppIcon name="arrow-right" size="xs" />
        </button>
      </div>
    </form>
  </div>

  <!-- Panel 2: Daftar Kader Ranting / Pengurus MWC NU -->
  <div
    id="onboard-panel-kader"
    role="tabpanel"
    aria-labelledby="onboard-tab-kader"
    hidden={!showKaderFirst}
    class="space-y-4"
  >
    <KaderRegisterForm user={user} zones={zones} assignedZone={assignedZone} />
  </div>

  <PrivacyAccountPanel hasStore={false} />
</div>
</main>
