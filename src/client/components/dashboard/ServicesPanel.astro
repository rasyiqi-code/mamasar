---
import { SITE_CONFIG } from '../../../lib/constants';
import AppIcon from '../common/AppIcon.astro';
import KaderRegisterForm from './KaderRegisterForm.astro';

interface Zone {
  id: number;
  name: string;
}

interface Props {
  user: {
    id: number;
    name: string;
    agent_status?: string | null;
    agent_ranting?: string | null;
    agent_org?: string | null;
    agent_phone?: string | null;
    assigned_zone_id?: number | null;
    role: string;
  };
  zones: Zone[];
  assignedZone?: Zone;
}

const { user, zones, assignedZone } = Astro.props;
---

<section id="panel-services" class="tab-panel hidden space-y-6">
  <!-- Top Bar: Compact Header -->
  <div class="pb-4 border-b border-slate-200 space-y-0.5">
    <h2 class="text-lg sm:text-xl font-bold tracking-tight text-slate-900">Layanan Kemitraan &amp; Kaderisasi</h2>
    <p class="text-xs text-slate-600">Akses pendaftaran petugas wilayah serta pendampingan modal syariah dan legalitas.</p>
  </div>

  <!-- BAGIAN 1: STATUS / PENDAFTARAN KADER RANTING & PENGURUS MWC -->
  <KaderRegisterForm user={user} zones={zones} assignedZone={assignedZone} />

  <!-- BAGIAN 2: KEMITRAAN USAHA (MODAL & LEGALITAS) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
    <!-- Permodalan Syariah -->
    <div class="space-y-2.5 pb-5 border-b md:border-b-0 md:border-r border-slate-200 md:pr-6">
      <div class="flex items-center gap-2">
        <AppIcon name="cash" size="sm" class="text-emerald-700" />
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">Permodalan Syariah (BMTNU &amp; Lazisnu)</h3>
      </div>
      <ul class="space-y-1.5 text-xs text-slate-600">
        <li class="flex items-start gap-2">
          <AppIcon name="check" size="xs" class="text-emerald-700 mt-0.5 shrink-0" />
          <span>Pembiayaan syariah murabahah &amp; mudharabah BMTNU</span>
        </li>
        <li class="flex items-start gap-2">
          <AppIcon name="check" size="xs" class="text-emerald-700 mt-0.5 shrink-0" />
          <span>Modal peralatan bergulir Lazisnu Produktif</span>
        </li>
      </ul>
      <div class="pt-1">
        <a
          href={`https://wa.me/${SITE_CONFIG.whatsappHelp}?text=${encodeURIComponent("Assalamu'alaikum LPNU PCNU Sumenep, saya pemilik UMKM warga NU ingin konsultasi akses permodalan BMTNU / Lazisnu")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 hover:text-emerald-800"
        >
          <span>Konsultasi Permodalan</span>
          <AppIcon name="arrow-right" size="xs" />
        </a>
      </div>
    </div>

    <!-- Legalitas & Halal -->
    <div class="space-y-2.5">
      <div class="flex items-center gap-2">
        <AppIcon name="shield" size="sm" class="text-emerald-700" />
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">NIB &amp; Sertifikasi Halal (SEHATI)</h3>
      </div>
      <ul class="space-y-1.5 text-xs text-slate-600">
        <li class="flex items-start gap-2">
          <AppIcon name="check" size="xs" class="text-emerald-700 mt-0.5 shrink-0" />
          <span>Fasilitasi izin edar dan NIB online gratis</span>
        </li>
        <li class="flex items-start gap-2">
          <AppIcon name="check" size="xs" class="text-emerald-700 mt-0.5 shrink-0" />
          <span>Pendampingan PPH program SEHATI BPJPH</span>
        </li>
      </ul>
      <div class="pt-1 flex items-center gap-3">
        <a
          href="/edukasi/sertifikasi-halal-gratis-sehati-umkm-sumenep"
          class="text-xs font-medium text-slate-600 hover:text-slate-900 underline"
        >
          Panduan Halal
        </a>
        <span class="text-slate-300" aria-hidden="true">·</span>
        <a
          href={`https://wa.me/${SITE_CONFIG.whatsappHelp}?text=${encodeURIComponent("Assalamu'alaikum LPNU Sumenep, saya butuh bantuan pendampingan NIB dan Sertifikasi Halal")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 hover:text-emerald-800"
        >
          <span>Dampingi Halal</span>
          <AppIcon name="arrow-right" size="xs" />
        </a>
      </div>
    </div>
  </div>
</section>
