---
import AppIcon from '../common/AppIcon.astro';
import { formatRupiah } from '../../../lib/utils';
import type { AdPromotion } from '../../../lib/modules/types';

interface Props {
  pendingPromotions: AdPromotion[];
}

const { pendingPromotions } = Astro.props;

function getPackageLabel(type: string) {
  switch (type) {
    case 'featured_7d':
      return { label: 'Slot Unggulan 7 Hari', badge: 'bg-amber-100 text-amber-950 border-amber-300', isFeatured: true };
    case 'featured_14d':
      return { label: 'Slot Unggulan 14 Hari', badge: 'bg-amber-100 text-amber-950 border-amber-300', isFeatured: true };
    case 'featured_30d':
      return { label: 'Slot Unggulan 30 Hari', badge: 'bg-amber-100 text-amber-950 border-amber-300', isFeatured: true };
    case 'bump_pack_5':
      return { label: 'Paket 5x Token Sundul', badge: 'bg-emerald-100 text-emerald-950 border-emerald-300', isFeatured: false };
    case 'bump_pack_12':
      return { label: 'Paket 12x Token Sundul', badge: 'bg-emerald-100 text-emerald-950 border-emerald-300', isFeatured: false };
    case 'bump_pack_30':
      return { label: 'Paket 30x Token Sundul', badge: 'bg-emerald-100 text-emerald-950 border-emerald-300', isFeatured: false };
    default:
      return { label: type, badge: 'bg-slate-100 text-slate-800 border-slate-300', isFeatured: false };
  }
}

const totalPendingAmount = pendingPromotions.reduce((sum, p) => sum + p.amount, 0);
const featuredPromoCount = pendingPromotions.filter((p) => p.type.startsWith('featured_')).length;
const bumpPromoCount = pendingPromotions.filter((p) => p.type.startsWith('bump_pack_')).length;
---

<section id="panel-promotions" class="admin-tab-panel w-full min-w-0 max-w-full overflow-x-clip hidden">
  {/* Hairline Operational Metric Strip: Horizontal Scroll on Mobile, 4-Col Grid on Desktop */}
  <div
    tabindex="0"
    role="region"
    aria-label="Ringkasan statistik promosi"
    class="flex lg:grid lg:grid-cols-4 w-full max-w-full overflow-x-auto no-scrollbar snap-x snap-mandatory divide-x divide-slate-200 border-b border-slate-200 bg-white"
  >
    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Antrean Verifikasi</span>
      <div class="mt-0.5 flex items-baseline gap-1.5 whitespace-nowrap">
        <span class={`text-xl font-bold font-mono tabular-nums ${pendingPromotions.length > 0 ? 'text-amber-700' : 'text-slate-900'}`}>
          {pendingPromotions.length}
        </span>
        <span class="text-xs text-slate-600">pesanan</span>
      </div>
    </div>

    <div class="shrink-0 min-w-[170px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Infaq Pending</span>
      <span class="mt-0.5 text-lg sm:text-xl font-bold text-emerald-700 font-mono tabular-nums block whitespace-nowrap">
        {formatRupiah(totalPendingAmount)}
      </span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Slot Unggulan</span>
      <span class="mt-0.5 text-xl font-bold text-slate-900 font-mono tabular-nums block">{featuredPromoCount}</span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Paket Sundul</span>
      <span class="mt-0.5 text-xl font-bold text-slate-900 font-mono tabular-nums block">{bumpPromoCount}</span>
    </div>
  </div>

  {/* Status Alert inside panel */}
  <div id="promo-review-alert" role="status" aria-live="polite" class="hidden mx-4 sm:mx-6 lg:mx-8 my-4 p-3 rounded-lg text-xs font-semibold"></div>

  {/* Pending Orders List */}
  {pendingPromotions.length > 0 ? (
    <div>
      <div class="px-4 sm:px-6 lg:px-8 py-3 border-b border-slate-200 bg-white">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 whitespace-nowrap">
          Antrean Verifikasi
        </h2>
      </div>

      <div class="divide-y divide-slate-200 border-b border-slate-200 bg-white">
        {pendingPromotions.map((promo) => {
          const pkgInfo = getPackageLabel(promo.type);
          const dateStr = new Date(promo.created_at).toLocaleDateString('id-ID', {
            day: 'numeric',
            month: 'short',
            year: 'numeric',
            hour: '2-digit',
            minute: '2-digit',
          });

          return (
            <div class="px-4 sm:px-6 lg:px-8 py-4 hover:bg-slate-50/70 transition flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
              {/* Left & Details */}
              <div class="flex items-start gap-3.5 sm:gap-4 min-w-0">
                <div class="shrink-0">
                  {promo.proof_image_url ? (
                    <a
                      href={promo.proof_image_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block relative group"
                      title="Buka bukti pembayaran ukuran penuh"
                    >
                      <img
                        src={promo.proof_image_url}
                        alt={`Bukti transfer ${promo.umkm_name || 'toko'}`}
                        width="80"
                        height="80"
                        class="w-16 h-16 sm:w-20 sm:h-20 rounded-lg object-cover border border-slate-200 group-hover:opacity-90 transition"
                      />
                      <span class="mt-1 inline-flex w-full items-center justify-center gap-1 text-[11px] font-semibold text-emerald-700 hover:underline">
                        <AppIcon name="external-link" size="xs" />
                        <span>Bukti</span>
                      </span>
                    </a>
                  ) : (
                    <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-lg bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-600 text-[11px] text-center p-1.5 font-semibold">
                      Tanpa Bukti
                    </div>
                  )}
                </div>

                <div class="min-w-0 space-y-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class={`text-xs font-semibold px-2 py-0.5 rounded border ${pkgInfo.badge}`}>
                      {pkgInfo.label}
                    </span>
                    <span class="text-sm font-bold text-slate-900 truncate">
                      {promo.umkm_name || 'Toko UMKM'}
                    </span>
                    {promo.user_email && (
                      <span class="hidden sm:inline text-xs text-slate-600 font-mono">{promo.user_email}</span>
                    )}
                  </div>

                  {pkgInfo.isFeatured && promo.product_name && (
                    <div class="text-xs text-slate-700 font-medium flex items-center gap-1.5 flex-wrap">
                      <span class="text-slate-600">Produk:</span>
                      {promo.product_slug ? (
                        <a
                          href={`/produk/${promo.product_slug}`}
                          target="_blank"
                          class="font-bold text-emerald-800 hover:underline inline-flex items-center gap-1"
                        >
                          <span>{promo.product_name}</span>
                          <AppIcon name="external-link" size="xs" />
                        </a>
                      ) : (
                        <span class="font-bold text-slate-900">{promo.product_name}</span>
                      )}
                    </div>
                  )}

                  <div class="flex items-center gap-2.5 text-xs pt-0.5 flex-wrap text-slate-600">
                    <span class="font-bold font-mono tabular-nums text-emerald-800">{formatRupiah(promo.amount)}</span>
                    <span aria-hidden="true">/</span>
                    <span class="uppercase font-medium">{promo.payment_method}</span>
                    <span aria-hidden="true">/</span>
                    <span class="font-mono tabular-nums">{dateStr}</span>
                  </div>

                  {promo.notes && (
                    <p class="text-xs text-slate-700 bg-slate-50 px-2.5 py-1.5 rounded-lg border border-slate-200 mt-1">
                      "{promo.notes}"
                    </p>
                  )}
                </div>
              </div>

              {/* Right: Review Action Buttons */}
              <div class="grid grid-cols-2 sm:flex items-center gap-2 shrink-0 w-full md:w-auto pt-2.5 md:pt-0 border-t md:border-t-0 border-slate-100 justify-end">
                <button
                  type="button"
                  data-action="review-promo"
                  data-order-id={promo.id}
                  data-decision="reject"
                  class="h-9 sm:h-8 px-3 rounded-md border border-rose-300 bg-white hover:bg-rose-50 text-rose-700 font-semibold text-xs transition cursor-pointer inline-flex items-center justify-center active:scale-[0.98]"
                >
                  Tolak
                </button>

                <button
                  type="button"
                  data-action="review-promo"
                  data-order-id={promo.id}
                  data-decision="approve"
                  class="h-9 sm:h-8 px-3 rounded-md bg-emerald-700 hover:bg-emerald-800 active:bg-emerald-900 text-white font-semibold text-xs transition cursor-pointer inline-flex items-center justify-center gap-1 active:scale-[0.98]"
                >
                  <AppIcon name="check" size="xs" />
                  <span>Setujui</span>
                </button>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  ) : (
    <div class="px-4 sm:px-6 lg:px-8 py-10 text-center border-b border-slate-200 bg-white space-y-1.5">
      <div class="w-9 h-9 mx-auto rounded-md bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center">
        <AppIcon name="check" size="sm" />
      </div>
      <h2 class="text-xs font-bold text-slate-900">Belum Ada Antrean</h2>
      <p class="text-xs text-slate-600">
        Semua pengajuan promosi telah diproses.
      </p>
    </div>
  )}
</section>
