---
import AppIcon from '../common/AppIcon.astro';
import type { EventOrderItem } from '../../../lib/db';

interface EventItem {
  id: number;
  title: string;
  slug: string;
  organizer: string;
  zone_id: number;
  zone_name: string;
  event_date: string;
  time_description: string;
  location_name: string;
  location_address?: string | null;
  estimated_attendance?: number | null;
  consumption_needed?: string | null;
  allow_stalls?: boolean | number | null;
  coordinator_name?: string | null;
  coordinator_phone: string;
}

interface Zone {
  id: number;
  name: string;
}

interface Props {
  events: EventItem[];
  zones: Zone[];
  eventOrders?: EventOrderItem[];
}

const { events, zones, eventOrders = [] } = Astro.props;

const bazarCount = events.filter((e) => Boolean(e.allow_stalls)).length;
const pendingOrdersCount = eventOrders.filter((o) => o.status === 'pending').length;

function formatDate(iso: string): string {
  try {
    return new Date(iso).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
  } catch {
    return iso;
  }
}

const orderStatusBadge: Record<string, { label: string; cls: string }> = {
  pending: { label: 'Menunggu', cls: 'bg-amber-50 text-amber-800 border-amber-200' },
  accepted: { label: 'Diterima', cls: 'bg-emerald-50 text-emerald-800 border-emerald-200' },
  rejected: { label: 'Ditolak', cls: 'bg-rose-50 text-rose-800 border-rose-200' },
};
---

<section id="panel-events" class="admin-tab-panel w-full min-w-0 max-w-full overflow-x-clip hidden">
  {/* Hairline Operational Metric Strip: Horizontal Scroll on Mobile, 4-Col Grid on Desktop */}
  <div
    tabindex="0"
    role="region"
    aria-label="Ringkasan statistik agenda"
    class="flex lg:grid lg:grid-cols-4 w-full max-w-full overflow-x-auto no-scrollbar snap-x snap-mandatory divide-x divide-slate-200 border-b border-slate-200 bg-white"
  >
    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Agenda Terdaftar</span>
      <span class="mt-0.5 text-xl font-bold text-slate-900 font-mono tabular-nums block">{events.length}</span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Buka Lapak Bazar</span>
      <span class="mt-0.5 text-xl font-bold text-emerald-700 font-mono tabular-nums block">{bazarCount}</span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Pengajuan Masuk</span>
      <span class="mt-0.5 text-xl font-bold text-slate-900 font-mono tabular-nums block">{eventOrders.length}</span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Menunggu Respon</span>
      <span class={`mt-0.5 text-xl font-bold font-mono tabular-nums block ${pendingOrdersCount > 0 ? 'text-amber-700' : 'text-slate-900'}`}>
        {pendingOrdersCount}
      </span>
    </div>
  </div>

  {/* Toolbar */}
  <div class="px-4 sm:px-6 lg:px-8 py-3 border-b border-slate-200 flex items-center justify-between gap-2 bg-white">
    <h2 id="events-table-heading" class="text-xs font-bold uppercase tracking-wider text-slate-800 whitespace-nowrap truncate">
      Agenda NU
    </h2>

    {/* Mobile-only actions (moved to sticky top header on md+) */}
    <div class="md:hidden shrink-0">
      <div class="flex items-center gap-1.5">
        <a
          href="/kegiatan"
          target="_blank"
          class="inline-flex items-center gap-1 h-8 px-2.5 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs rounded-md border border-slate-300 transition whitespace-nowrap"
        >
          <span>Direktori</span>
          <AppIcon name="external-link" size="xs" />
        </a>
        <button
          type="button"
          id="btn-open-add-event"
          data-open-add-event
          class="h-8 px-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-md transition cursor-pointer inline-flex items-center gap-1 whitespace-nowrap"
        >
          <AppIcon name="plus" size="xs" />
          <span>Tambah</span>
        </button>
      </div>
    </div>
  </div>

  {/* Events Management Table: Preserved Table with Horizontal Scroll & Accessible Region */}
  <div
    tabindex="0"
    role="region"
    aria-labelledby="events-table-heading"
    class="events-table-wrapper w-full max-w-full min-w-0 overflow-x-auto border-b border-slate-200 bg-white"
  >
    <table class="events-directory-table w-full min-w-[680px] text-left border-collapse text-xs">
      <thead class="bg-slate-50 border-b border-slate-200 text-slate-700">
        <tr>
          <th scope="col" class="py-2.5 pl-4 sm:pl-6 lg:pl-8 pr-3 font-bold">Tanggal</th>
          <th scope="col" class="py-2.5 px-3 font-bold">Nama Acara &amp; Wilayah</th>
          <th scope="col" class="py-2.5 px-3 font-bold">Penyelenggara</th>
          <th scope="col" class="py-2.5 px-3 font-bold">Bazar</th>
          <th scope="col" class="py-2.5 pl-3 pr-4 sm:pr-6 lg:pr-8 font-bold text-right">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {events.length > 0 ? (
          events.map((ev) => (
            <tr class="hover:bg-slate-50/70 transition" id={`event-row-${ev.id}`}>
              <td class="py-3 pl-4 sm:pl-6 lg:pl-8 pr-3 text-slate-600 font-mono tabular-nums text-xs whitespace-nowrap align-top">
                {formatDate(ev.event_date)}
              </td>
              <th scope="row" class="py-3 px-3 min-w-[220px] font-normal align-top">
                <a href={`/kegiatan/${ev.slug}`} target="_blank" class="font-bold text-slate-900 hover:text-emerald-700 transition block">
                  {ev.title}
                </a>
                <span class="inline-flex items-center gap-1 text-xs text-slate-600 mt-0.5">
                  <AppIcon name="map-pin" size="xs" />
                  <span>{ev.zone_name} · {ev.location_name}</span>
                </span>
              </th>
              <td class="py-3 px-3 text-slate-700 align-top">
                <span class="text-xs font-medium block">{ev.organizer}</span>
                <span class="text-xs text-slate-600 block font-mono tabular-nums mt-0.5">{ev.coordinator_phone}</span>
              </td>
              <td class="py-3 px-3 whitespace-nowrap align-top">
                {Boolean(ev.allow_stalls) ? (
                  <span class="inline-block px-2 py-0.5 rounded text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
                    Bazar
                  </span>
                ) : (
                  <span class="inline-block px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-600">
                    Tidak
                  </span>
                )}
              </td>
              <td class="py-3 pl-3 pr-4 sm:pr-6 lg:pr-8 text-right whitespace-nowrap align-top">
                <div class="inline-flex items-center justify-end gap-1.5">
                  <button
                    type="button"
                    data-action="edit-event"
                    data-id={ev.id}
                    class="min-h-[40px] sm:min-h-[34px] py-1 px-3 bg-white hover:bg-slate-100 text-slate-700 font-semibold text-xs rounded-lg border border-slate-300 transition cursor-pointer"
                  >
                    Edit
                  </button>
                  <button
                    type="button"
                    data-action="delete-event"
                    data-id={ev.id}
                    data-title={ev.title}
                    class="inline-flex items-center justify-center min-h-[40px] min-w-[40px] sm:min-h-[34px] sm:min-w-[34px] p-1.5 text-slate-600 hover:text-rose-700 hover:bg-rose-50 rounded-lg border border-transparent hover:border-rose-200 transition cursor-pointer"
                    title="Hapus"
                    aria-label={`Hapus agenda ${ev.title}`}
                  >
                    <AppIcon name="trash" size="xs" />
                  </button>
                </div>
              </td>
            </tr>
          ))
        ) : (
          <tr>
            <td colspan="5" class="py-10 px-4 text-center text-slate-600 text-xs">
              Belum ada agenda. Klik Tambah untuk membuat baru.
            </td>
          </tr>
        )}
      </tbody>
    </table>
  </div>

  {/* Raw Events JSON for prefilling edit modal */}
  <script type="application/json" id="admin-events-json" set:html={JSON.stringify(events).replace(/</g, '\\u003c')} />

  {/* Pengajuan Konsumsi & Lapak Bazar Masuk */}
  <div class="pt-4">
    <div class="px-4 sm:px-6 lg:px-8 py-3 border-b border-slate-200 bg-white flex items-center justify-between">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800 whitespace-nowrap">
        Pengajuan Bazar (<span class="font-mono tabular-nums">{eventOrders.length}</span>)
      </h3>
    </div>

    {eventOrders.length > 0 ? (
      <div class="divide-y divide-slate-200 border-b border-slate-200 bg-white">
        {eventOrders.map((order) => {
          const st = orderStatusBadge[order.status] || orderStatusBadge.pending;
          return (
            <div id={`event-order-row-${order.id}`} class="px-4 sm:px-6 lg:px-8 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:bg-slate-50/70 transition text-xs">
              <div class="space-y-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2">
                  <span class={`text-xs font-semibold px-2 py-0.5 rounded border ${order.type === 'stall' ? 'bg-teal-50 text-teal-800 border-teal-200' : 'bg-amber-50 text-amber-900 border-amber-200'}`}>
                    {order.type === 'stall' ? 'Lapak Bazar' : 'Konsumsi'}
                  </span>
                  <span class="font-bold text-sm text-slate-900">{order.sender_name}</span>
                  {order.umkm_name && (
                    <span class="text-xs text-emerald-700 font-semibold">Toko {order.umkm_name}</span>
                  )}
                  <span data-order-badge={order.id} class={`text-xs font-semibold px-2 py-0.5 rounded border ${st.cls}`}>
                    {st.label}
                  </span>
                </div>
                <p class="text-xs text-slate-800 font-medium">{order.event_title}</p>
                <p class="text-xs text-slate-600">{order.item_description}{order.quantity_or_slots ? ` (${order.quantity_or_slots})` : ''}</p>
                <a
                  href={`https://wa.me/${order.sender_phone}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-mono font-semibold text-emerald-700 hover:underline"
                >
                  <AppIcon name="phone" size="xs" />
                  <span>{order.sender_phone}</span>
                </a>
              </div>

              <div class="grid grid-cols-2 sm:flex items-center gap-2 shrink-0 w-full sm:w-auto">
                <button
                  type="button"
                  data-action="event-order-status"
                  data-id={order.id}
                  data-status="accepted"
                  disabled={order.status === 'accepted'}
                  class="h-8 px-2.5 bg-emerald-700 hover:bg-emerald-800 disabled:opacity-40 text-white font-semibold text-xs rounded-md transition cursor-pointer"
                >
                  Terima
                </button>
                <button
                  type="button"
                  data-action="event-order-status"
                  data-id={order.id}
                  data-status="rejected"
                  disabled={order.status === 'rejected'}
                  class="h-8 px-2.5 bg-white hover:bg-rose-50 disabled:opacity-40 text-rose-700 border border-rose-300 font-semibold text-xs rounded-md transition cursor-pointer"
                >
                  Tolak
                </button>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <p class="text-xs text-slate-600 py-8 px-4 sm:px-6 lg:px-8 text-center border-b border-slate-200 bg-white">
        Belum ada pengajuan masuk.
      </p>
    )}
  </div>

  {/* MODAL: TAMBAH / UBAH AGENDA (Native <dialog> with light dismiss) */}
  <dialog
    id="modal-event"
    closedby="any"
    aria-labelledby="modal-event-title"
    class="w-full sm:w-[calc(100%-1.5rem)] max-w-xl rounded-t-2xl sm:rounded-lg bg-white border border-slate-200 shadow-lg p-0 text-slate-900 overflow-hidden"
  >
    <div class="flex flex-col max-h-[88dvh]">
      <div class="sm:hidden flex justify-center pt-2.5 pb-1 shrink-0">
        <span class="w-10 h-1 rounded-full bg-slate-300"></span>
      </div>
      <div class="px-4 py-3.5 border-b border-slate-200 flex items-center justify-between shrink-0">
        <h3 id="modal-event-title" class="font-bold text-sm text-slate-900">Agenda Kegiatan NU</h3>
        <button type="button" id="btn-close-event-modal" aria-label="Tutup modal agenda" class="min-w-[44px] min-h-[44px] text-slate-600 hover:text-slate-900 flex items-center justify-center rounded-lg hover:bg-slate-100 cursor-pointer">
          <AppIcon name="close" size="xs" />
        </button>
      </div>

      <form id="admin-event-form" class="p-4 space-y-3.5 overflow-y-auto flex-1 text-xs">
        <input type="hidden" id="adminEventAction" name="action" value="create" />
        <input type="hidden" id="adminEventId" name="eventId" value="" />

        <div class="space-y-1">
          <label for="adminEvTitle" class="block font-semibold text-slate-800">Judul Acara <span class="text-rose-500">*</span></label>
          <input
            type="text"
            id="adminEvTitle"
            name="title"
            placeholder="Contoh: Lailatul Ijtima' MWC NU Gapura"
            required
            class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label for="adminEvDate" class="block font-semibold text-slate-800">Tanggal Acara <span class="text-rose-500">*</span></label>
            <input
              type="date"
              id="adminEvDate"
              name="eventDate"
              required
              class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20 font-mono"
            />
          </div>

          <div class="space-y-1">
            <label for="adminEvTime" class="block font-semibold text-slate-800">Waktu Pelaksanaan <span class="text-rose-500">*</span></label>
            <input
              type="text"
              id="adminEvTime"
              name="timeDesc"
              placeholder="Contoh: 19:30 WIB - Selesai"
              required
              class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label for="adminEvZone" class="block font-semibold text-slate-800">Wilayah MWC <span class="text-rose-500">*</span></label>
            <select
              id="adminEvZone"
              name="zoneId"
              required
              class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs font-medium text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20 cursor-pointer"
            >
              {zones.map((z) => (
                <option value={z.id}>{z.name}</option>
              ))}
            </select>
          </div>

          <div class="space-y-1">
            <label for="adminEvOrganizer" class="block font-semibold text-slate-800">Penyelenggara <span class="text-rose-500">*</span></label>
            <input
              type="text"
              id="adminEvOrganizer"
              name="organizer"
              placeholder="Contoh: MWC NU Gapura"
              required
              class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
            />
          </div>
        </div>

        <div class="space-y-1">
          <label for="adminEvLocation" class="block font-semibold text-slate-800">Tempat / Lokasi <span class="text-rose-500">*</span></label>
          <input
            type="text"
            id="adminEvLocation"
            name="locationName"
            placeholder="Contoh: Masjid Jamik Gapura"
            required
            class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>

        <div class="space-y-1">
          <label for="adminEvAddress" class="block font-semibold text-slate-800">Alamat Lengkap</label>
          <input
            type="text"
            id="adminEvAddress"
            name="locationAddress"
            placeholder="Jl. Raya / patokan alamat"
            class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label for="adminEvAttendance" class="block font-semibold text-slate-800">Estimasi Jamaah</label>
            <input
              type="number"
              id="adminEvAttendance"
              name="estimatedAttendance"
              placeholder="Contoh: 500"
              class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20 font-mono"
            />
          </div>

          <div class="space-y-1">
            <label for="adminEvStalls" class="block font-semibold text-slate-800">Izinkan Bazar UMKM?</label>
            <select
              id="adminEvStalls"
              name="allowStalls"
              class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs font-medium text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20 cursor-pointer"
            >
              <option value="1">Ya, Diizinkan</option>
              <option value="0">Tidak Diizinkan</option>
            </select>
          </div>
        </div>

        <div class="space-y-1">
          <label for="adminEvConsumption" class="block font-semibold text-slate-800">Kebutuhan Konsumsi</label>
          <input
            type="text"
            id="adminEvConsumption"
            name="consumptionNeeded"
            placeholder="Contoh: 500 nasi kotak, snack box"
            class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label for="adminEvCoordinator" class="block font-semibold text-slate-800">Nama Panitia</label>
            <input
              type="text"
              id="adminEvCoordinator"
              name="coordinatorName"
              placeholder="Nama koordinator acara"
              class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
            />
          </div>

          <div class="space-y-1">
            <label for="adminEvPhone" class="block font-semibold text-slate-800">Nomor WhatsApp <span class="text-rose-500">*</span></label>
            <input
              type="tel"
              id="adminEvPhone"
              name="coordinatorPhone"
              inputmode="tel"
              placeholder="08xxxxxxxxxx"
              required
              class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 font-mono focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
            />
          </div>
        </div>

        <div class="pt-3 border-t border-slate-200 flex items-center justify-end gap-2">
          <button
            type="button"
            id="btn-cancel-event-modal"
            autofocus
            class="min-h-[44px] py-2 px-4 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 font-semibold text-xs rounded-lg transition cursor-pointer"
          >
            Batal
          </button>
          <button
            type="submit"
            id="btn-submit-event"
            class="min-h-[44px] py-2 px-5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-lg transition cursor-pointer inline-flex items-center justify-center"
          >
            Simpan Agenda
          </button>
        </div>
      </form>
    </div>
  </dialog>
</section>

<style>
  .events-table-wrapper {
    max-inline-size: 100%;
    -webkit-overflow-scrolling: touch;
  }

  .events-directory-table thead {
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
  }
</style>
