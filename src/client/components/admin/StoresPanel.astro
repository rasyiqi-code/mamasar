---
import AppIcon from '../common/AppIcon.astro';

interface UMKMStore {
  id: number;
  name: string;
  slug?: string;
  logo_url?: string | null;
  phone: string;
  address?: string | null;
  ranting?: string | null;
  zone_name: string;
  is_verified?: boolean | number | null;
  product_count?: number;
  owner_name?: string | null;
  owner_email?: string | null;
  created_at: string;
}

interface Props {
  pendingStores: UMKMStore[];
  verifiedStores: UMKMStore[];
}

const { pendingStores, verifiedStores } = Astro.props;

const totalStoresCount = pendingStores.length + verifiedStores.length;
const totalProductsCount =
  pendingStores.reduce((sum, s) => sum + (s.product_count || 0), 0) +
  verifiedStores.reduce((sum, s) => sum + (s.product_count || 0), 0);
const coveredZonesCount = new Set(
  [...pendingStores, ...verifiedStores].map((s) => s.zone_name).filter(Boolean)
).size;

function formatDate(iso: string): string {
  try {
    return new Date(iso).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
  } catch {
    return iso;
  }
}

function storeInitials(name: string): string {
  const words = name.trim().split(/\s+/).filter(Boolean);
  if (words.length >= 2) return (words[0][0] + words[1][0]).toUpperCase();
  return name.trim().slice(0, 2).toUpperCase() || 'UM';
}
---

<section id="panel-stores" class="admin-tab-panel w-full min-w-0 max-w-full overflow-x-clip hidden">
  {/* Hairline Operational Metric Strip: Horizontal Scroll on Mobile, 4-Col Grid on Desktop */}
  <div
    tabindex="0"
    role="region"
    aria-label="Ringkasan statistik toko"
    class="flex lg:grid lg:grid-cols-4 w-full max-w-full overflow-x-auto no-scrollbar snap-x snap-mandatory divide-x divide-slate-200 border-b border-slate-200 bg-white"
  >
    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Antrean Verifikasi</span>
      <div class="mt-0.5 flex items-baseline gap-1.5 whitespace-nowrap">
        <span class={`text-xl font-bold font-mono tabular-nums ${pendingStores.length > 0 ? 'text-amber-700' : 'text-slate-900'}`}>
          {pendingStores.length}
        </span>
        <span class="text-xs text-slate-600">menunggu</span>
      </div>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Toko Terverifikasi</span>
      <span class="mt-0.5 text-xl font-bold text-emerald-700 font-mono tabular-nums block">{verifiedStores.length}</span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Total Produk Etalase</span>
      <span class="mt-0.5 text-xl font-bold text-slate-900 font-mono tabular-nums block">{totalProductsCount}</span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Cakupan Wilayah</span>
      <div class="mt-0.5 flex items-baseline gap-1.5 whitespace-nowrap">
        <span class="text-xl font-bold text-slate-900 font-mono tabular-nums">{coveredZonesCount}</span>
        <span class="text-xs text-slate-600">MWC</span>
      </div>
    </div>
  </div>

  {/* Search & Status Filter Toolbar */}
  <div class="px-4 sm:px-6 lg:px-8 py-4 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/40">
    <div class="relative flex-1 min-w-0 w-full max-w-md">
      <label for="store-directory-search" class="sr-only">Cari nama toko, desa, atau MWC</label>
      <input
        type="search"
        id="store-directory-search"
        autocorrect="off"
        autocapitalize="none"
        spellcheck="false"
        placeholder="Cari nama toko, desa/ranting, atau MWC..."
        class="w-full min-h-[44px] sm:min-h-[38px] bg-white border border-slate-300 rounded-lg px-3 py-1.5 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
      />
    </div>

    <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
      <button
        type="button"
        data-store-filter="all"
        aria-pressed="true"
        class="store-filter-btn h-8 px-2.5 rounded-md text-xs font-semibold bg-slate-900 text-white border border-slate-900 transition cursor-pointer shrink-0 font-mono tabular-nums"
      >
        Semua ({totalStoresCount})
      </button>
      <button
        type="button"
        data-store-filter="pending"
        aria-pressed="false"
        class="store-filter-btn h-8 px-2.5 rounded-md text-xs font-semibold bg-white text-slate-700 hover:text-slate-900 border border-slate-300 transition cursor-pointer shrink-0 font-mono tabular-nums"
      >
        Antrean ({pendingStores.length})
      </button>
      <button
        type="button"
        data-store-filter="verified"
        aria-pressed="false"
        class="store-filter-btn h-8 px-2.5 rounded-md text-xs font-semibold bg-white text-slate-700 hover:text-slate-900 border border-slate-300 transition cursor-pointer shrink-0 font-mono tabular-nums"
      >
        Terverifikasi ({verifiedStores.length})
      </button>
    </div>
  </div>

  {/* Section 1: Antrean Menunggu Verifikasi */}
  <div id="stores-section-pending" class="border-b border-slate-200">
    <div class="px-4 sm:px-6 lg:px-8 py-3 border-b border-slate-200 bg-white flex items-center justify-between">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 whitespace-nowrap">
        Menunggu (<span class="font-mono tabular-nums">{pendingStores.length}</span>)
      </h2>
    </div>

    {pendingStores.length > 0 ? (
      <div class="divide-y divide-slate-200 bg-white">
        {pendingStores.map((store) => {
          const searchKey = `${store.name} ${store.zone_name} ${store.ranting || ''} ${store.owner_email || ''}`.toLowerCase();
          return (
            <div
              data-store-row
              data-store-status="pending"
              data-search={searchKey}
              class="px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 sm:gap-3 hover:bg-slate-50/70 transition"
            >
              <div
                data-store-header
                class="w-full sm:w-auto flex-1 flex items-start justify-between gap-3 min-w-0 cursor-pointer sm:cursor-default select-none sm:select-text"
              >
                <div class="flex items-start gap-3 min-w-0">
                  {store.logo_url ? (
                    <img
                      src={store.logo_url}
                      alt={`Logo ${store.name}`}
                      width="40"
                      height="40"
                      class="w-10 h-10 rounded-lg object-cover border border-slate-200 bg-white shrink-0"
                    />
                  ) : (
                    <div class="w-10 h-10 rounded-lg bg-amber-50 text-amber-800 border border-amber-200 flex items-center justify-center font-bold text-xs shrink-0">
                      {storeInitials(store.name)}
                    </div>
                  )}

                  <div class="min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <h3 class="font-bold text-sm text-slate-900">{store.name}</h3>
                      <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-700 bg-slate-100 px-2 py-0.5 rounded">
                        <AppIcon name="map-pin" size="xs" />
                        <span>MWC {store.zone_name}</span>
                      </span>
                      {store.ranting && (
                        <span class="text-xs font-semibold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                          Desa {store.ranting}
                        </span>
                      )}
                      <span class="text-xs font-mono tabular-nums text-slate-600">
                        {store.product_count || 0} produk<span class="hidden sm:inline"> ({formatDate(store.created_at)})</span>
                      </span>
                    </div>
                    {(store.address || store.owner_email) && (
                      <p class="hidden sm:block text-xs text-slate-600 truncate mt-0.5">
                        {[store.owner_email || 'Kader Lapangan', store.address].filter(Boolean).join(' · ')}
                      </p>
                    )}
                  </div>
                </div>

                <button
                  type="button"
                  data-store-toggle
                  aria-expanded="false"
                  aria-controls={`store-actions-pending-${store.id}`}
                  aria-label={`Tampilkan aksi untuk ${store.name}`}
                  class="sm:hidden shrink-0 w-7 h-7 flex items-center justify-center rounded-md text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition cursor-pointer mt-0.5"
                >
                  <span data-store-chevron class="inline-flex transition-transform duration-150">
                    <AppIcon name="chevron-down" size="xs" />
                  </span>
                </button>
              </div>

              <div
                id={`store-actions-pending-${store.id}`}
                data-store-actions
                class="hidden sm:flex items-center gap-1.5 shrink-0 w-full sm:w-auto pt-1 sm:pt-0"
              >
                <a
                  href={`/toko/${store.slug || store.id}`}
                  target="_blank"
                  class="inline-flex items-center justify-center gap-1 h-8 px-2.5 bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 text-xs font-semibold rounded-md transition"
                >
                  <span>Lihat</span>
                  <AppIcon name="external-link" size="xs" />
                </a>
                <button
                  type="button"
                  data-action="verify-store"
                  data-id={store.id}
                  data-verified="1"
                  class="inline-flex items-center justify-center gap-1 h-8 px-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-md transition cursor-pointer"
                >
                  <AppIcon name="check" size="xs" />
                  <span>Verifikasi</span>
                </button>
                <button
                  type="button"
                  data-action="delete-store"
                  data-id={store.id}
                  data-name={store.name}
                  class="inline-flex items-center justify-center w-8 h-8 p-1 text-slate-600 hover:text-rose-700 hover:bg-rose-50 rounded-md border border-transparent hover:border-rose-200 transition cursor-pointer"
                  title="Hapus Toko"
                  aria-label={`Hapus toko ${store.name}`}
                >
                  <AppIcon name="trash" size="xs" />
                </button>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <p class="text-xs text-slate-600 py-5 px-4 sm:px-6 lg:px-8 bg-white">
        Belum ada antrean.
      </p>
    )}
  </div>

  {/* Section 2: Toko Terverifikasi */}
  <div id="stores-section-verified" class="border-b border-slate-200">
    <div class="px-4 sm:px-6 lg:px-8 py-3 border-b border-slate-200 bg-white flex items-center justify-between">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 whitespace-nowrap">
        Terverifikasi (<span class="font-mono tabular-nums">{verifiedStores.length}</span>)
      </h2>
    </div>

    {verifiedStores.length > 0 ? (
      <div class="divide-y divide-slate-200 bg-white">
        {verifiedStores.map((store) => {
          const searchKey = `${store.name} ${store.zone_name} ${store.ranting || ''} ${store.owner_email || ''}`.toLowerCase();
          return (
            <div
              data-store-row
              data-store-status="verified"
              data-search={searchKey}
              class="px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 sm:gap-3 hover:bg-slate-50/70 transition"
            >
              <div
                data-store-header
                class="w-full sm:w-auto flex-1 flex items-start justify-between gap-3 min-w-0 cursor-pointer sm:cursor-default select-none sm:select-text"
              >
                <div class="flex items-start gap-3 min-w-0">
                  {store.logo_url ? (
                    <img
                      src={store.logo_url}
                      alt={`Logo ${store.name}`}
                      width="40"
                      height="40"
                      class="w-10 h-10 rounded-lg object-cover border border-slate-200 bg-white shrink-0"
                    />
                  ) : (
                    <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 flex items-center justify-center font-bold text-xs shrink-0">
                      {storeInitials(store.name)}
                    </div>
                  )}

                  <div class="min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <h3 class="font-bold text-sm text-slate-900">{store.name}</h3>
                      <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                        <AppIcon name="check" size="xs" />
                        <span>Terverifikasi</span>
                      </span>
                      <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-700 bg-slate-100 px-2 py-0.5 rounded">
                        <AppIcon name="map-pin" size="xs" />
                        <span>MWC {store.zone_name}</span>
                      </span>
                      {store.ranting && (
                        <span class="text-xs font-semibold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                          Desa {store.ranting}
                        </span>
                      )}
                      <span class="text-xs font-mono tabular-nums text-slate-600">
                        {store.product_count || 0} produk
                      </span>
                    </div>
                    {(store.address || store.owner_email) && (
                      <p class="hidden sm:block text-xs text-slate-600 truncate mt-0.5">
                        {[store.owner_email || 'Binaan Warga', store.address].filter(Boolean).join(' · ')}
                      </p>
                    )}
                  </div>
                </div>

                <button
                  type="button"
                  data-store-toggle
                  aria-expanded="false"
                  aria-controls={`store-actions-verified-${store.id}`}
                  aria-label={`Tampilkan aksi untuk ${store.name}`}
                  class="sm:hidden shrink-0 w-7 h-7 flex items-center justify-center rounded-md text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition cursor-pointer mt-0.5"
                >
                  <span data-store-chevron class="inline-flex transition-transform duration-150">
                    <AppIcon name="chevron-down" size="xs" />
                  </span>
                </button>
              </div>

              <div
                id={`store-actions-verified-${store.id}`}
                data-store-actions
                class="hidden sm:flex items-center gap-1.5 shrink-0 w-full sm:w-auto pt-1 sm:pt-0"
              >
                <a
                  href={`/toko/${store.slug || store.id}`}
                  target="_blank"
                  class="inline-flex items-center justify-center gap-1 h-8 px-2.5 bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 text-xs font-semibold rounded-md transition"
                >
                  <span>Lihat</span>
                  <AppIcon name="external-link" size="xs" />
                </a>
                <button
                  type="button"
                  data-action="verify-store"
                  data-id={store.id}
                  data-verified="0"
                  class="h-8 px-2.5 bg-white hover:bg-amber-50 text-amber-800 border border-amber-300 font-semibold text-xs rounded-md transition cursor-pointer"
                  title="Cabut status verifikasi"
                >
                  Cabut
                </button>
                <button
                  type="button"
                  data-action="delete-store"
                  data-id={store.id}
                  data-name={store.name}
                  class="inline-flex items-center justify-center w-8 h-8 p-1 text-slate-600 hover:text-rose-700 hover:bg-rose-50 rounded-md border border-transparent hover:border-rose-200 transition cursor-pointer"
                  title="Hapus Toko"
                  aria-label={`Hapus toko ${store.name}`}
                >
                  <AppIcon name="trash" size="xs" />
                </button>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <p class="text-xs text-slate-600 py-5 px-4 sm:px-6 lg:px-8 bg-white">
        Belum ada toko terverifikasi.
      </p>
    )}
  </div>

  <div id="store-directory-empty" class="hidden px-4 sm:px-6 lg:px-8 py-10 text-center text-xs text-slate-600 bg-white border-b border-slate-200">
    Toko tidak ditemukan.
  </div>
</section>
