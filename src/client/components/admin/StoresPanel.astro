---
import AppIcon from '../common/AppIcon.astro';

interface UMKMStore {
  id: number;
  name: string;
  slug?: string;
  logo_url?: string | null;
  phone: string;
  address?: string | null;
  ranting?: string | null;
  zone_name: string;
  is_verified?: boolean | number | null;
  product_count?: number;
  user_id?: number | null;
  owner_name?: string | null;
  owner_email?: string | null;
  created_at: string;
}

export interface UserOption {
  id: number;
  name: string;
  email: string;
  role: string;
  umkm_id?: number | null;
  umkm_name?: string | null;
}

interface Props {
  pendingStores: UMKMStore[];
  verifiedStores: UMKMStore[];
  users?: UserOption[];
}

const { pendingStores, verifiedStores, users = [] } = Astro.props;

const totalStoresCount = pendingStores.length + verifiedStores.length;
const totalProductsCount =
  pendingStores.reduce((sum, s) => sum + (s.product_count || 0), 0) +
  verifiedStores.reduce((sum, s) => sum + (s.product_count || 0), 0);
const coveredZonesCount = new Set(
  [...pendingStores, ...verifiedStores].map((s) => s.zone_name).filter(Boolean)
).size;

function formatDate(iso: string): string {
  try {
    return new Date(iso).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
  } catch {
    return iso;
  }
}

function storeInitials(name: string): string {
  const words = name.trim().split(/\s+/).filter(Boolean);
  if (words.length >= 2) return (words[0][0] + words[1][0]).toUpperCase();
  return name.trim().slice(0, 2).toUpperCase() || 'UM';
}
---

<section id="panel-stores" class="admin-tab-panel w-full min-w-0 max-w-full overflow-x-clip hidden">
  {/* Hairline Operational Metric Strip: Horizontal Scroll on Mobile, 4-Col Grid on Desktop */}
  <div
    tabindex="0"
    role="region"
    aria-label="Ringkasan statistik toko"
    class="flex lg:grid lg:grid-cols-4 w-full max-w-full overflow-x-auto no-scrollbar snap-x snap-mandatory divide-x divide-slate-200 border-b border-slate-200 bg-white"
  >
    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Antrean Verifikasi</span>
      <div class="mt-0.5 flex items-baseline gap-1.5 whitespace-nowrap">
        <span class={`text-xl font-bold font-mono tabular-nums ${pendingStores.length > 0 ? 'text-amber-700' : 'text-slate-900'}`}>
          {pendingStores.length}
        </span>
        <span class="text-xs text-slate-600">menunggu</span>
      </div>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Toko Terverifikasi</span>
      <span class="mt-0.5 text-xl font-bold text-emerald-700 font-mono tabular-nums block">{verifiedStores.length}</span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Total Produk Etalase</span>
      <span class="mt-0.5 text-xl font-bold text-slate-900 font-mono tabular-nums block">{totalProductsCount}</span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Cakupan Wilayah</span>
      <div class="mt-0.5 flex items-baseline gap-1.5 whitespace-nowrap">
        <span class="text-xl font-bold text-slate-900 font-mono tabular-nums">{coveredZonesCount}</span>
        <span class="text-xs text-slate-600">MWC</span>
      </div>
    </div>
  </div>

  {/* Search & Status Filter Toolbar */}
  <div class="px-4 sm:px-6 lg:px-8 py-4 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/40">
    <div class="relative flex-1 min-w-0 w-full max-w-md">
      <label for="store-directory-search" class="sr-only">Cari nama toko, desa, atau MWC</label>
      <input
        type="search"
        id="store-directory-search"
        autocorrect="off"
        autocapitalize="none"
        spellcheck="false"
        placeholder="Cari nama toko, desa/ranting, atau MWC..."
        class="w-full min-h-[44px] sm:min-h-[38px] bg-white border border-slate-300 rounded-lg px-3 py-1.5 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
      />
    </div>

    <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar">
      <button
        type="button"
        data-store-filter="all"
        aria-pressed="true"
        class="store-filter-btn h-8 px-2.5 rounded-md text-xs font-semibold bg-slate-900 text-white border border-slate-900 transition cursor-pointer shrink-0 font-mono tabular-nums"
      >
        Semua ({totalStoresCount})
      </button>
      <button
        type="button"
        data-store-filter="pending"
        aria-pressed="false"
        class="store-filter-btn h-8 px-2.5 rounded-md text-xs font-semibold bg-white text-slate-700 hover:text-slate-900 border border-slate-300 transition cursor-pointer shrink-0 font-mono tabular-nums"
      >
        Antrean ({pendingStores.length})
      </button>
      <button
        type="button"
        data-store-filter="verified"
        aria-pressed="false"
        class="store-filter-btn h-8 px-2.5 rounded-md text-xs font-semibold bg-white text-slate-700 hover:text-slate-900 border border-slate-300 transition cursor-pointer shrink-0 font-mono tabular-nums"
      >
        Terverifikasi ({verifiedStores.length})
      </button>
    </div>
  </div>

  {/* Section 1: Antrean Menunggu Verifikasi */}
  <div id="stores-section-pending" class="border-b border-slate-200">
    <div class="px-4 sm:px-6 lg:px-8 py-3 border-b border-slate-200 bg-white flex items-center justify-between">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 whitespace-nowrap">
        Menunggu (<span class="font-mono tabular-nums">{pendingStores.length}</span>)
      </h2>
    </div>

    {pendingStores.length > 0 ? (
      <div class="divide-y divide-slate-200 bg-white">
        {pendingStores.map((store) => {
          const searchKey = `${store.name} ${store.zone_name} ${store.ranting || ''} ${store.owner_email || ''}`.toLowerCase();
          return (
            <div
              data-store-row
              data-store-status="pending"
              data-search={searchKey}
              class="relative px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 sm:gap-3 hover:bg-slate-50/70 transition"
            >
              <button
                type="button"
                data-store-overlay-trigger
                aria-expanded="false"
                aria-controls={`store-actions-pending-${store.id}`}
                aria-label={`Tampilkan aksi untuk ${store.name}`}
                class="sm:hidden absolute inset-0 z-[1] bg-transparent cursor-pointer focus-visible:outline-2 focus-visible:outline-emerald-700 focus-visible:-outline-offset-2"
              ></button>

              <div
                data-store-header
                class="w-full sm:w-auto flex-1 flex items-start justify-between gap-3 min-w-0"
              >
                <div class="flex items-start gap-3 min-w-0">
                  {store.logo_url ? (
                    <img
                      src={store.logo_url}
                      alt={`Logo ${store.name}`}
                      width="40"
                      height="40"
                      class="w-10 h-10 rounded-lg object-cover border border-slate-200 bg-white shrink-0"
                    />
                  ) : (
                    <div class="w-10 h-10 rounded-lg bg-amber-50 text-amber-800 border border-amber-200 flex items-center justify-center font-bold text-xs shrink-0">
                      {storeInitials(store.name)}
                    </div>
                  )}

                  <div class="min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <h3 class="font-bold text-sm text-slate-900">{store.name}</h3>
                      {!store.user_id && !store.owner_email && (
                        <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
                          Data Awal (Belum Diklaim)
                        </span>
                      )}
                      <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-700 bg-slate-100 px-2 py-0.5 rounded">
                        <AppIcon name="map-pin" size="xs" />
                        <span>MWC {store.zone_name}</span>
                      </span>
                      {store.ranting && (
                        <span class="text-xs font-semibold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                          Desa {store.ranting}
                        </span>
                      )}
                      <span class="text-xs font-mono tabular-nums text-slate-600">
                        {store.product_count || 0} produk<span class="hidden sm:inline"> ({formatDate(store.created_at)})</span>
                      </span>
                    </div>
                    <p class="hidden sm:block text-xs text-slate-600 truncate mt-0.5">
                      {store.owner_email ? (
                        <span>
                          Pemilik: <strong class="text-slate-800">{store.owner_name || store.owner_email}</strong> ({store.owner_email})
                          {store.address ? ` · ${store.address}` : ''}
                        </span>
                      ) : (
                        <span class="text-amber-800 font-medium">
                          Belum terhubung akun warga · WA: {store.phone}
                          {store.address ? ` · ${store.address}` : ''}
                        </span>
                      )}
                    </p>
                  </div>
                </div>
              </div>

              <div
                id={`store-actions-pending-${store.id}`}
                data-store-actions
                class="hidden sm:flex items-center gap-1.5 shrink-0 sm:static sm:z-auto sm:bg-transparent sm:backdrop-blur-none sm:p-0 sm:justify-start"
              >
                <a
                  href={`/toko/${store.slug || store.id}`}
                  target="_blank"
                  class="inline-flex items-center justify-center gap-1 h-9 sm:h-8 px-3 sm:px-2.5 bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 text-xs font-semibold rounded-md transition active:scale-[0.98]"
                >
                  <span>Lihat</span>
                  <AppIcon name="external-link" size="xs" />
                </a>
                <button
                  type="button"
                  data-action="open-transfer-store"
                  data-id={store.id}
                  data-name={store.name}
                  data-current-user-id={store.user_id || ''}
                  data-current-owner={store.owner_email ? `${store.owner_name || store.owner_email} (${store.owner_email})` : ''}
                  class="inline-flex items-center justify-center gap-1 h-9 sm:h-8 px-2.5 sm:px-2 bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 text-xs font-semibold rounded-md transition cursor-pointer active:scale-[0.98]"
                  title="Limpahkan toko ke akun warga"
                >
                  <AppIcon name="user" size="xs" />
                  <span>Limpahkan</span>
                </button>
                <button
                  type="button"
                  data-action="verify-store"
                  data-id={store.id}
                  data-verified="1"
                  class="inline-flex items-center justify-center gap-1 h-9 sm:h-8 px-3 sm:px-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-md transition cursor-pointer active:scale-[0.98]"
                >
                  <AppIcon name="check" size="xs" />
                  <span>Verifikasi</span>
                </button>
                <button
                  type="button"
                  data-action="delete-store"
                  data-id={store.id}
                  data-name={store.name}
                  class="inline-flex items-center justify-center w-9 h-9 sm:w-8 sm:h-8 p-1 bg-white sm:bg-transparent text-slate-600 hover:text-rose-700 hover:bg-rose-50 rounded-md border border-slate-300 sm:border-transparent hover:border-rose-200 transition cursor-pointer active:scale-[0.98]"
                  title="Hapus Toko"
                  aria-label={`Hapus toko ${store.name}`}
                >
                  <AppIcon name="trash" size="xs" />
                </button>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <p class="text-xs text-slate-600 py-5 px-4 sm:px-6 lg:px-8 bg-white">
        Belum ada antrean.
      </p>
    )}
  </div>

  {/* Section 2: Toko Terverifikasi */}
  <div id="stores-section-verified" class="border-b border-slate-200">
    <div class="px-4 sm:px-6 lg:px-8 py-3 border-b border-slate-200 bg-white flex items-center justify-between">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 whitespace-nowrap">
        Terverifikasi (<span class="font-mono tabular-nums">{verifiedStores.length}</span>)
      </h2>
    </div>

    {verifiedStores.length > 0 ? (
      <div class="divide-y divide-slate-200 bg-white">
        {verifiedStores.map((store) => {
          const searchKey = `${store.name} ${store.zone_name} ${store.ranting || ''} ${store.owner_email || ''}`.toLowerCase();
          return (
            <div
              data-store-row
              data-store-status="verified"
              data-search={searchKey}
              class="relative px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2.5 sm:gap-3 hover:bg-slate-50/70 transition"
            >
              <button
                type="button"
                data-store-overlay-trigger
                aria-expanded="false"
                aria-controls={`store-actions-verified-${store.id}`}
                aria-label={`Tampilkan aksi untuk ${store.name}`}
                class="sm:hidden absolute inset-0 z-[1] bg-transparent cursor-pointer focus-visible:outline-2 focus-visible:outline-emerald-700 focus-visible:-outline-offset-2"
              ></button>

              <div
                data-store-header
                class="w-full sm:w-auto flex-1 flex items-start justify-between gap-3 min-w-0"
              >
                <div class="flex items-start gap-3 min-w-0">
                  {store.logo_url ? (
                    <img
                      src={store.logo_url}
                      alt={`Logo ${store.name}`}
                      width="40"
                      height="40"
                      class="w-10 h-10 rounded-lg object-cover border border-slate-200 bg-white shrink-0"
                    />
                  ) : (
                    <div class="w-10 h-10 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 flex items-center justify-center font-bold text-xs shrink-0">
                      {storeInitials(store.name)}
                    </div>
                  )}

                  <div class="min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <h3 class="font-bold text-sm text-slate-900">{store.name}</h3>
                      <span class="inline-flex items-center gap-1 text-xs font-semibold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                        <AppIcon name="check" size="xs" />
                        <span>Terverifikasi</span>
                      </span>
                      {!store.user_id && !store.owner_email && (
                        <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-amber-800 bg-amber-50 px-2 py-0.5 rounded border border-amber-200">
                          Data Awal (Belum Diklaim)
                        </span>
                      )}
                      <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-700 bg-slate-100 px-2 py-0.5 rounded">
                        <AppIcon name="map-pin" size="xs" />
                        <span>MWC {store.zone_name}</span>
                      </span>
                      {store.ranting && (
                        <span class="text-xs font-semibold text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200">
                          Desa {store.ranting}
                        </span>
                      )}
                      <span class="text-xs font-mono tabular-nums text-slate-600">
                        {store.product_count || 0} produk
                      </span>
                    </div>
                    <p class="hidden sm:block text-xs text-slate-600 truncate mt-0.5">
                      {store.owner_email ? (
                        <span>
                          Pemilik: <strong class="text-slate-800">{store.owner_name || store.owner_email}</strong> ({store.owner_email})
                          {store.address ? ` · ${store.address}` : ''}
                        </span>
                      ) : (
                        <span class="text-amber-800 font-medium">
                          Belum terhubung akun warga · WA: {store.phone}
                          {store.address ? ` · ${store.address}` : ''}
                        </span>
                      )}
                    </p>
                  </div>
                </div>
              </div>

              <div
                id={`store-actions-verified-${store.id}`}
                data-store-actions
                class="hidden sm:flex items-center gap-1.5 shrink-0 sm:static sm:z-auto sm:bg-transparent sm:backdrop-blur-none sm:p-0 sm:justify-start"
              >
                <a
                  href={`/toko/${store.slug || store.id}`}
                  target="_blank"
                  class="inline-flex items-center justify-center gap-1 h-9 sm:h-8 px-3 sm:px-2.5 bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 text-xs font-semibold rounded-md transition active:scale-[0.98]"
                >
                  <span>Lihat</span>
                  <AppIcon name="external-link" size="xs" />
                </a>
                <button
                  type="button"
                  data-action="open-transfer-store"
                  data-id={store.id}
                  data-name={store.name}
                  data-current-user-id={store.user_id || ''}
                  data-current-owner={store.owner_email ? `${store.owner_name || store.owner_email} (${store.owner_email})` : ''}
                  class="inline-flex items-center justify-center gap-1 h-9 sm:h-8 px-2.5 sm:px-2 bg-white hover:bg-slate-100 border border-slate-300 text-slate-700 text-xs font-semibold rounded-md transition cursor-pointer active:scale-[0.98]"
                  title="Limpahkan toko ke akun warga"
                >
                  <AppIcon name="user" size="xs" />
                  <span>Limpahkan</span>
                </button>
                <button
                  type="button"
                  data-action="verify-store"
                  data-id={store.id}
                  data-verified="0"
                  class="h-9 sm:h-8 px-3 sm:px-2.5 bg-white hover:bg-amber-50 text-amber-800 border border-amber-300 font-semibold text-xs rounded-md transition cursor-pointer active:scale-[0.98]"
                  title="Cabut status verifikasi"
                >
                  Cabut
                </button>
                <button
                  type="button"
                  data-action="delete-store"
                  data-id={store.id}
                  data-name={store.name}
                  class="inline-flex items-center justify-center w-9 h-9 sm:w-8 sm:h-8 p-1 bg-white sm:bg-transparent text-slate-600 hover:text-rose-700 hover:bg-rose-50 rounded-md border border-slate-300 sm:border-transparent hover:border-rose-200 transition cursor-pointer active:scale-[0.98]"
                  title="Hapus Toko"
                  aria-label={`Hapus toko ${store.name}`}
                >
                  <AppIcon name="trash" size="xs" />
                </button>
              </div>
            </div>
          );
        })}
      </div>
    ) : (
      <p class="text-xs text-slate-600 py-5 px-4 sm:px-6 lg:px-8 bg-white">
        Belum ada toko terverifikasi.
      </p>
    )}
  </div>

  <div id="store-directory-empty" class="hidden px-4 sm:px-6 lg:px-8 py-10 text-center text-xs text-slate-600 bg-white border-b border-slate-200">
    Toko tidak ditemukan.
  </div>

  <!-- Modal Pelimpahan Toko Warga (Khusus Admin PCNU & Pengurus MWC) -->
  <div
    id="modal-transfer-store"
    class="fixed inset-0 z-50 hidden bg-slate-900/60 backdrop-blur-xs flex items-center justify-center p-3 sm:p-4"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-transfer-title"
  >
    <div class="w-full max-w-lg bg-white rounded-xl shadow-2xl border border-slate-200 overflow-hidden flex flex-col max-h-[90vh]">
      <div class="px-5 py-4 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 flex items-center justify-center shrink-0">
            <AppIcon name="user" size="sm" />
          </div>
          <div>
            <h3 id="modal-transfer-title" class="font-bold text-sm text-slate-900">Pelimpahan Kepemilikan Toko</h3>
            <p class="text-xs text-slate-500">Hubungkan toko hasil pendataan awal ke akun warga terdaftar</p>
          </div>
        </div>
        <button
          type="button"
          id="btn-close-transfer-modal"
          class="text-slate-400 hover:text-slate-600 p-1 rounded-lg hover:bg-slate-200/50 transition cursor-pointer"
          aria-label="Tutup Modal"
        >
          <AppIcon name="x" size="sm" />
        </button>
      </div>

      <form id="form-transfer-store" class="p-5 space-y-4 overflow-y-auto flex-1">
        <input type="hidden" id="transfer-store-id" name="umkmId" value="" />

        <div class="p-3 bg-slate-50 rounded-lg border border-slate-200 space-y-1">
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500">Toko yang Dilimpahkan</span>
          <div id="transfer-store-name" class="font-bold text-sm text-slate-900">-</div>
          <div class="text-xs text-slate-600 flex items-center gap-1.5 flex-wrap">
            <span>Status Pemilik Saat Ini:</span>
            <span id="transfer-current-owner" class="font-semibold text-slate-800">Data Awal (Belum Ada Akun)</span>
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="transfer-user-select" class="block text-xs font-bold text-slate-700">
            Pilih Akun Warga Penerima Hak Kelola <span class="text-rose-600">*</span>
          </label>
          <p class="text-[11px] text-slate-500">
            Satu akun warga hanya dapat memiliki satu toko di direktori Mamasar.
          </p>

          <input
            type="text"
            id="transfer-user-search"
            placeholder="Cari nama atau email warga..."
            class="w-full text-xs border border-slate-300 rounded-lg px-3 py-2 bg-white text-slate-900 focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 outline-none"
          />

          <select
            id="transfer-user-select"
            name="targetUserId"
            required
            size="6"
            class="w-full text-xs border border-slate-300 rounded-lg p-2 bg-white text-slate-900 focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 outline-none"
          >
            <option value="" disabled>-- Pilih Akun Warga --</option>
            <option value="unlink" class="text-rose-700 font-semibold bg-rose-50/50">
              -- Lepas Kaitan Akun (Jadikan Data Awal Kembali) --
            </option>
            {users.map((u) => {
              const hasStore = Boolean(u.umkm_id);
              return (
                <option
                  value={u.id}
                  data-search={`${u.name} ${u.email} ${u.role}`.toLowerCase()}
                  data-has-store={hasStore ? '1' : '0'}
                  data-store-id={u.umkm_id || ''}
                  class={hasStore ? 'text-slate-400 bg-slate-50' : 'text-slate-900 font-medium'}
                >
                  {u.name} ({u.email}) — [{u.role.toUpperCase()}]{hasStore ? ` (Sudah punya toko: ${u.umkm_name})` : ' (Tersedia)'}
                </option>
              );
            })}
          </select>
        </div>

        <div class="p-3 bg-emerald-50 rounded-lg border border-emerald-200 text-xs text-emerald-900 leading-relaxed">
          <strong>Catatan Pelimpahan:</strong> Akun warga penerima akan langsung melihat toko ini di menu Dashboard mereka, dapat mengelola produk, foto botol, dan menerima pesanan WhatsApp tanpa perlu menginput ulang data.
        </div>

        <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-200">
          <button
            type="button"
            id="btn-cancel-transfer"
            class="min-h-[38px] px-4 py-1.5 text-xs font-semibold text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition cursor-pointer"
          >
            Batal
          </button>
          <button
            type="submit"
            id="btn-submit-transfer"
            class="min-h-[38px] px-4 py-1.5 text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 rounded-lg transition cursor-pointer shadow-xs inline-flex items-center gap-1.5"
          >
            <AppIcon name="check" size="xs" />
            <span>Simpan Pelimpahan</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</section>
