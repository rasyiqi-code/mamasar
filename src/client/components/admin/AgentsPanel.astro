---
import AppIcon from '../common/AppIcon.astro';
import type { AdminUserRow, PendingPetugasRow, Zone } from '../../../lib/db';

interface Props {
  pendingPetugas: PendingPetugasRow[];
  allUsers: AdminUserRow[];
  zones: Zone[];
}

const { pendingPetugas, allUsers, zones } = Astro.props;

const ROLE_BADGES: Record<string, { label: string; cls: string }> = {
  pcnu: { label: 'Admin PCNU', cls: 'bg-rose-50 text-rose-800 border-rose-200' },
  mwcnu: { label: 'Pengurus MWC', cls: 'bg-teal-50 text-teal-800 border-teal-200' },
  ranting: { label: 'Kader Ranting', cls: 'bg-emerald-50 text-emerald-800 border-emerald-200' },
  warga: { label: 'Warga', cls: 'bg-slate-100 text-slate-700 border-slate-200' },
};

const mwcCount = allUsers.filter((u) => u.role === 'mwcnu').length;
const rantingCount = allUsers.filter((u) => u.role === 'ranting').length;
---

<section id="panel-agents" class="admin-tab-panel w-full min-w-0 max-w-full overflow-x-clip">
  {/* Hairline Operational Metric Strip: Horizontal Scroll on Mobile, 4-Col Grid on Desktop */}
  <div
    tabindex="0"
    role="region"
    aria-label="Ringkasan statistik akun"
    class="flex lg:grid lg:grid-cols-4 w-full max-w-full overflow-x-auto no-scrollbar snap-x snap-mandatory divide-x divide-slate-200 border-b border-slate-200 bg-white"
  >
    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Permohonan Masuk</span>
      <div class="mt-0.5 flex items-baseline gap-1.5 whitespace-nowrap">
        <span class={`text-xl font-bold font-mono tabular-nums ${pendingPetugas.length > 0 ? 'text-amber-700' : 'text-slate-900'}`}>
          {pendingPetugas.length}
        </span>
        <span class="text-xs text-slate-600">menunggu</span>
      </div>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Pengurus MWC</span>
      <span class="mt-0.5 text-xl font-bold text-slate-900 font-mono tabular-nums block">{mwcCount}</span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Kader Ranting</span>
      <span class="mt-0.5 text-xl font-bold text-emerald-700 font-mono tabular-nums block">{rantingCount}</span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Total Akun</span>
      <span class="mt-0.5 text-xl font-bold text-slate-900 font-mono tabular-nums block">{allUsers.length}</span>
    </div>
  </div>

  {/* Section 1: Antrean Permohonan */}
  <div class="border-b border-slate-200">
    <div class="px-4 sm:px-6 lg:px-8 py-3 flex items-center justify-between gap-2 border-b border-slate-200 bg-white">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800 whitespace-nowrap">
        Permohonan Masuk (<span class="font-mono tabular-nums">{pendingPetugas.length}</span>)
      </h2>
    </div>

    {pendingPetugas.length === 0 ? (
      <div class="px-4 sm:px-6 lg:px-8 py-4 text-xs text-slate-600 flex items-center gap-2.5 bg-white">
        <span class="w-6 h-6 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center justify-center shrink-0">
          <AppIcon name="check" size="xs" />
        </span>
        <span>Belum ada permohonan masuk.</span>
      </div>
    ) : (
      <div class="divide-y divide-slate-200 bg-white">
        {pendingPetugas.map((kader) => {
          const isMwcReq = kader.requested_role === 'mwcnu';
          return (
            <div class="px-4 sm:px-6 lg:px-8 py-4 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3.5 hover:bg-slate-50/70 transition">
              <div class="min-w-0 space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <strong class="font-bold text-sm text-slate-900">{kader.name}</strong>
                  <span class={`text-xs font-semibold px-2 py-0.5 rounded border ${
                    isMwcReq
                      ? 'bg-teal-50 text-teal-800 border-teal-200'
                      : 'bg-emerald-50 text-emerald-800 border-emerald-200'
                  }`}>
                    {isMwcReq ? 'Ajukan: Pengurus MWC' : 'Ajukan: Kader Ranting'}
                  </span>
                  <span class="inline-flex items-center gap-1 text-xs font-medium text-slate-700 bg-slate-100 px-2 py-0.5 rounded">
                    <AppIcon name="map-pin" size="xs" />
                    <span>MWC {kader.zone_name || 'Sumenep'}</span>
                  </span>
                  {kader.agent_ranting && (
                    <span class="text-xs font-medium text-slate-700 bg-white px-2 py-0.5 rounded border border-slate-200">
                      Ranting {kader.agent_ranting}
                    </span>
                  )}
                </div>
                <div class="flex items-center gap-2 flex-wrap text-xs text-slate-600">
                  <span>{kader.agent_org || 'Kader NU'}</span>
                  <span aria-hidden="true">/</span>
                  <span class="font-mono break-all">{kader.email}</span>
                </div>
              </div>

              <div class="flex items-center gap-2 flex-wrap shrink-0 w-full lg:w-auto">
                {kader.agent_phone && (
                  <a
                    href={`https://wa.me/${kader.agent_phone}?text=${encodeURIComponent(`Assalamu'alaikum Sahabat ${kader.name}, kami dari Admin PCNU Sumenep mengonfirmasi pengajuan peran di Mamasar untuk wilayah MWC ${kader.zone_name || 'Sumenep'}.`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center justify-center gap-1.5 min-h-[44px] sm:min-h-[38px] px-3 py-1.5 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded-lg text-xs font-semibold transition"
                    title="Hubungi via WhatsApp"
                  >
                    <AppIcon name="phone" size="xs" />
                    <span>WA</span>
                  </a>
                )}

                <select
                  aria-label={`Pilih peran persetujuan untuk ${kader.name}`}
                  data-role-select-for={kader.id}
                  class="flex-1 sm:flex-initial min-h-[44px] sm:min-h-[38px] bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm sm:text-xs font-medium text-slate-900 focus:border-emerald-700 focus:outline-none"
                >
                  <option value="ranting" selected={!isMwcReq}>Setujui: Kader Ranting</option>
                  <option value="mwcnu" selected={isMwcReq}>Setujui: Pengurus MWC</option>
                </select>

                <button
                  type="button"
                  data-action="review-agent"
                  data-id={kader.id}
                  data-decision="approve"
                  class="inline-flex items-center justify-center gap-1.5 min-h-[44px] sm:min-h-[38px] py-1.5 px-3.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-lg transition cursor-pointer"
                >
                  <AppIcon name="check" size="xs" />
                  <span>Setujui</span>
                </button>
                <button
                  type="button"
                  data-action="review-agent"
                  data-id={kader.id}
                  data-decision="reject"
                  class="inline-flex items-center justify-center gap-1.5 min-h-[44px] sm:min-h-[38px] py-1.5 px-3 bg-white hover:bg-rose-50 text-rose-700 border border-rose-300 font-semibold text-xs rounded-lg transition cursor-pointer"
                >
                  <AppIcon name="x" size="xs" />
                  <span>Tolak</span>
                </button>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>

  {/* Section 2: Direktori Semua Pengguna & Ubah Peran */}
  <div class="pt-4 space-y-3 w-full min-w-0 max-w-full">
    <div class="flex items-center justify-between gap-2 px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 min-w-0">
        <h2 id="users-directory-heading" class="text-xs font-bold uppercase tracking-wider text-slate-800 whitespace-nowrap truncate">
          Direktori Akun
        </h2>
        <span id="user-directory-count" class="text-xs font-mono tabular-nums font-medium text-slate-600 whitespace-nowrap">
          {allUsers.length} akun
        </span>
      </div>

      {/* Mobile-only action (moved to sticky top header on md+) */}
      <div class="md:hidden shrink-0">
        <button
          type="button"
          id="btn-open-add-user"
          data-open-add-user
          class="min-h-[44px] px-3.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-md transition inline-flex items-center justify-center gap-1 cursor-pointer whitespace-nowrap active:scale-[0.98]"
        >
          <AppIcon name="plus" size="xs" />
          <span>Daftarkan</span>
        </button>
      </div>
    </div>

    <search class="flex flex-col sm:flex-row gap-2.5 px-4 sm:px-6 lg:px-8 w-full max-w-full min-w-0">
      <div class="relative flex-1 min-w-0 w-full">
        <label for="user-directory-search" class="sr-only">Cari nama, email, atau toko pengguna</label>
        <input
          type="search"
          id="user-directory-search"
          autocorrect="off"
          autocapitalize="none"
          spellcheck="false"
          placeholder="Cari nama, email, wilayah, atau nama toko..."
          class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
        />
      </div>
      <div class="w-full sm:w-56 min-w-0">
        <label for="user-directory-role-filter" class="sr-only">Filter berdasarkan peran</label>
        <select
          id="user-directory-role-filter"
          class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs font-medium text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20 cursor-pointer"
        >
          <option value="">Semua Peran ({allUsers.length})</option>
          <option value="pcnu">Admin PCNU / Superadmin</option>
          <option value="mwcnu">Pengurus MWC NU</option>
          <option value="ranting">Kader Ranting</option>
          <option value="warga">Warga Biasa</option>
        </select>
      </div>
    </search>

    <div
      tabindex="0"
      role="region"
      aria-labelledby="users-directory-heading"
      class="users-table-wrapper relative w-full max-w-full overflow-x-auto border-y border-slate-200 bg-white"
    >
      <table class="users-directory-table w-full min-w-[820px] text-left border-collapse text-xs">
        <thead class="bg-slate-50 border-b border-slate-200 text-slate-700">
          <tr>
            <th scope="col" class="py-2.5 pl-4 sm:pl-6 lg:pl-8 pr-3 font-bold">Pengguna</th>
            <th scope="col" class="py-2.5 px-3 font-bold">Peran Saat Ini</th>
            <th scope="col" class="py-2.5 px-3 font-bold">Ubah Peran</th>
            <th scope="col" class="py-2.5 px-3 font-bold">Wilayah MWC &amp; Ranting</th>
            <th scope="col" class="py-2.5 pl-3 pr-4 sm:pr-6 lg:pr-8 font-bold text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {allUsers.map((u) => {
            const badge = ROLE_BADGES[u.role] || ROLE_BADGES.warga;
            const searchKey = `${u.name} ${u.email} ${u.umkm_name || ''} ${u.zone_name || ''} ${u.agent_ranting || ''}`.toLowerCase();
            return (
              <tr
                data-user-row
                data-role={u.role}
                data-search={searchKey}
                class="hover:bg-slate-50/70 transition"
              >
                <th scope="row" class="py-2 pl-4 sm:pl-6 lg:pl-8 pr-3 font-normal align-middle">
                  <div class="max-w-[270px] space-y-0.5">
                    <div class="font-bold text-slate-900 flex items-center gap-1.5 min-w-0">
                      <span class="truncate">{u.name}</span>
                      {u.is_env_superadmin && (
                        <span class="text-[11px] font-semibold px-1.5 py-0.5 rounded bg-rose-100 text-rose-900 border border-rose-200 shrink-0">
                          Superadmin (Env)
                        </span>
                      )}
                      {u.is_pending_login && (
                        <span class="text-[11px] font-semibold px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-300 shrink-0">
                          Belum Login
                        </span>
                      )}
                    </div>
                    <div
                      class="text-xs text-slate-600 truncate"
                      title={u.umkm_name ? `${u.email} · Toko ${u.umkm_name}` : u.email}
                    >
                      <span class="font-mono">{u.email}</span>
                      {u.umkm_name && (
                        <span class="text-emerald-800 font-medium"> · Toko {u.umkm_name}</span>
                      )}
                    </div>
                  </div>
                </th>

                <td class="py-2 px-3 align-middle whitespace-nowrap">
                  <span class={`inline-block text-xs font-semibold px-2 py-0.5 rounded border ${badge.cls}`}>
                    {badge.label}
                  </span>
                </td>

                <td class="py-2 px-3 align-middle">
                  <select
                    id={`user-role-${u.id}`}
                    aria-label={`Peran untuk ${u.name}`}
                    data-user-role-select
                    data-id={u.id}
                    disabled={u.is_env_superadmin}
                    class="w-full min-h-[40px] sm:min-h-[34px] bg-white border border-slate-300 rounded-lg px-2.5 py-1 text-xs font-medium text-slate-900 disabled:bg-slate-100 disabled:text-slate-600 focus:border-emerald-700 focus:outline-none"
                  >
                    <option value="warga" selected={u.role === 'warga'}>Warga Biasa</option>
                    <option value="ranting" selected={u.role === 'ranting'}>Kader Ranting</option>
                    <option value="mwcnu" selected={u.role === 'mwcnu'}>Pengurus MWC NU</option>
                    <option value="pcnu" selected={u.role === 'pcnu'}>Admin PCNU</option>
                  </select>
                </td>

                <td class="py-2 px-3 align-middle">
                  <div class="flex flex-col sm:flex-row gap-1.5">
                    <select
                      id={`user-zone-${u.id}`}
                      aria-label={`Wilayah MWC untuk ${u.name}`}
                      data-user-zone-select
                      data-id={u.id}
                      disabled={u.is_env_superadmin}
                      class="flex-1 min-h-[40px] sm:min-h-[34px] bg-white border border-slate-300 rounded-lg px-2.5 py-1 text-xs text-slate-900 disabled:bg-slate-100 disabled:text-slate-600 focus:border-emerald-700 focus:outline-none"
                    >
                      <option value="">-- Semua / Tanpa MWC --</option>
                      {zones.map((z) => (
                        <option value={z.id} selected={u.assigned_zone_id === z.id}>{z.name}</option>
                      ))}
                    </select>
                    <input
                      type="text"
                      id={`user-ranting-${u.id}`}
                      aria-label={`Ranting untuk ${u.name}`}
                      data-user-ranting-input
                      data-id={u.id}
                      value={u.agent_ranting || ''}
                      disabled={u.is_env_superadmin}
                      placeholder="Ranting/Desa"
                      class="sm:w-32 min-h-[40px] sm:min-h-[34px] bg-white border border-slate-300 rounded-lg px-2.5 py-1 text-xs text-slate-900 disabled:bg-slate-100 disabled:text-slate-600 focus:border-emerald-700 focus:outline-none"
                    />
                  </div>
                </td>

                <td class="py-2 pl-3 pr-4 sm:pr-6 lg:pr-8 align-middle text-right">
                  {u.is_env_superadmin ? (
                    <span class="inline-flex items-center h-8 text-xs font-medium text-slate-600">Terkunci</span>
                  ) : (
                    <button
                      type="button"
                      data-action="save-user-role"
                      data-id={u.id}
                      class="h-8 px-3 bg-slate-900 hover:bg-emerald-700 text-white font-semibold text-xs rounded-md transition cursor-pointer active:scale-[0.98]"
                    >
                      Simpan
                    </button>
                  )}
                </td>
              </tr>
            );
          })}
          <tr id="user-directory-empty" class="hidden">
            <td colspan="5" class="py-10 px-4 text-center text-xs text-slate-600">
              Akun tidak ditemukan.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  {/* MODAL: DAFTARKAN / TETAPKAN AKUN PERAN KHUSUS (Native <dialog> with light dismiss) */}
  <dialog
    id="modal-add-user"
    closedby="any"
    aria-labelledby="modal-add-user-title"
    class="w-full sm:w-[calc(100%-1.5rem)] max-w-xl rounded-t-2xl sm:rounded-lg bg-white border border-slate-200 shadow-lg p-0 text-slate-900 overflow-hidden"
  >
    <div class="flex flex-col max-h-[88dvh]">
      <div class="sm:hidden flex justify-center pt-2.5 pb-1 shrink-0">
        <span class="w-10 h-1 rounded-full bg-slate-300"></span>
      </div>

      <div class="px-4 py-3.5 border-b border-slate-200 flex items-center justify-between gap-3 shrink-0">
        <h3 id="modal-add-user-title" class="font-bold text-sm text-slate-900">
          Tetapkan Peran Akun
        </h3>
        <button
          type="button"
          id="btn-close-add-user-modal"
          aria-label="Tutup modal akun peran"
          class="min-w-[44px] min-h-[44px] text-slate-600 hover:text-slate-900 flex items-center justify-center rounded-lg hover:bg-slate-100 cursor-pointer shrink-0"
        >
          <AppIcon name="close" size="xs" />
        </button>
      </div>

      <form id="form-admin-add-user" class="p-4 space-y-3.5 overflow-y-auto flex-1 text-xs" aria-label="Formulir pendaftaran akun sesuai peran">
        <input type="hidden" name="mode" value="create" />

        <p class="text-xs text-slate-600 leading-relaxed">
          Tetapkan email Pengurus MWC, Kader Ranting, atau Admin PCNU baru. Jika email sudah memiliki akun, perannya langsung diperbarui; jika belum, peran aktif otomatis saat pemilik email masuk.
        </p>

        <div id="admin-add-user-status" role="status" aria-live="polite" class="hidden p-3 rounded-lg text-xs font-semibold"></div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label for="addUserName" class="block font-semibold text-slate-800">
              Nama Lengkap <span class="text-rose-600" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="addUserName"
              name="name"
              autocomplete="name"
              autofocus
              required
              placeholder="Contoh: Ust. Fathorrahman"
              class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
            />
          </div>

          <div class="space-y-1">
            <label for="addUserEmail" class="block font-semibold text-slate-800">
              Alamat Email Akun <span class="text-rose-600" aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="addUserEmail"
              name="email"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="none"
              spellcheck="false"
              required
              placeholder="email@example.com"
              class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label for="addUserRole" class="block font-semibold text-slate-800">
              Peran / Hak Akses <span class="text-rose-600" aria-hidden="true">*</span>
            </label>
            <select
              id="addUserRole"
              name="role"
              required
              class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs font-semibold text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20 cursor-pointer"
            >
              <option value="mwcnu">Pengurus MWC NU (Kecamatan)</option>
              <option value="ranting">Kader Ranting (Petugas Lapangan)</option>
              <option value="pcnu">Admin PCNU / Superadmin</option>
              <option value="warga">Warga Biasa</option>
            </select>
          </div>

          <div class="space-y-1">
            <label for="addUserZone" class="block font-semibold text-slate-800">
              Wilayah MWC NU <span id="addUserZoneRequiredMark" class="text-rose-600" aria-hidden="true">*</span>
            </label>
            <select
              id="addUserZone"
              name="zoneId"
              required
              class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs font-medium text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20 cursor-pointer"
            >
              <option value="" disabled selected>Pilih Wilayah MWC</option>
              {zones.map((z) => (
                <option value={z.id}>{z.name}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <div class="space-y-1">
            <label for="addUserRanting" class="block font-semibold text-slate-800">
              Ranting / Desa
            </label>
            <input
              type="text"
              id="addUserRanting"
              name="ranting"
              placeholder="Nama desa / kelurahan"
              class="w-full min-h-[44px] sm:min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-2 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
            />
          </div>

          <div class="space-y-1">
            <label for="addUserOrg" class="block font-semibold text-slate-800">
              Banom / Lembaga
            </label>
            <input
              type="text"
              id="addUserOrg"
              name="org"
              placeholder="Misal: LPNU / Ansor"
