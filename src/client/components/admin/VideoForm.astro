---
import AppIcon from '../common/AppIcon.astro';
import type { CaseStudy } from '../../../lib/modules/case-studies';

interface Props {
  video?: CaseStudy;
}

const { video } = Astro.props;
const isEdit = Boolean(video);
const field =
  'w-full h-9 px-3 text-sm bg-white border border-slate-300 rounded-md focus:border-emerald-700 focus:ring-1 focus:ring-emerald-700 focus:outline-none placeholder:text-slate-400';
const area = field.replace('h-9', 'py-2');
const label = 'block text-xs font-semibold text-slate-700 mb-1';
---

<form id="video-form" class="min-h-screen bg-white flex flex-col" data-video-id={video?.id ?? ''}>
  <header class="sticky top-0 z-30 h-14 bg-white/95 backdrop-blur-xs border-b border-slate-200 px-4 sm:px-6 lg:px-8 flex items-center justify-between gap-3">
    <div class="flex items-center gap-3 min-w-0">
      <a
        href="/admin/articles#videos"
        class="h-8 px-2.5 rounded-md border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold inline-flex items-center gap-1.5 transition shrink-0"
      >
        <AppIcon name="arrow-left" size="xs" />
        <span class="hidden sm:inline">Video</span>
      </a>
      <h1 class="text-sm sm:text-base font-bold tracking-tight text-slate-900 truncate">
        {isEdit ? 'Edit Video' : 'Video Baru'}
      </h1>
      <span id="video-form-status" class="text-xs text-slate-500 hidden sm:inline" role="status"></span>
    </div>
    <button
      type="submit"
      id="btn-submit-video"
      class="h-8 px-4 rounded-md bg-emerald-700 hover:bg-emerald-800 disabled:opacity-60 text-white text-xs font-semibold inline-flex items-center gap-1.5 transition active:scale-[0.98] cursor-pointer"
    >
      <AppIcon name="check" size="xs" />
      <span>Simpan</span>
    </button>
  </header>

  <div class="flex-1 max-w-[1080px] w-full mx-auto grid grid-cols-1 lg:grid-cols-[1fr_320px] lg:divide-x divide-slate-200">
    <div class="px-4 sm:px-6 lg:px-8 py-6 space-y-5">
      <div>
        <label for="vid-title" class={label}>Judul</label>
        <input type="text" id="vid-title" required value={video?.title ?? ''} placeholder="Yoso Farm: Kebun Sayur & Ternak Mandiri" class={field} />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label for="vid-channel" class={label}>Channel</label>
          <input type="text" id="vid-channel" required value={video?.channel_name ?? ''} placeholder="Channel OASIS" class={field} />
        </div>
        <div>
          <label for="vid-tag" class={label}>Topik</label>
          <input type="text" id="vid-tag" required value={video?.tag ?? ''} placeholder="Integrasi Pangan" class={field} />
        </div>
      </div>

      <div>
        <label for="vid-url" class={label}>Tautan YouTube</label>
        <input type="url" id="vid-url" required value={video?.video_url ?? ''} placeholder="https://www.youtube.com/watch?v=..." class={field} />
      </div>

      <div>
        <label for="vid-practice" class={label}>Praktik lapangan</label>
        <textarea id="vid-practice" rows="3" placeholder="Langkah budidaya atau solusi praktis" class={area}>{video?.practice_summary ?? ''}</textarea>
      </div>

      <div>
        <label for="vid-opportunity" class={label}>Peluang usaha</label>
        <textarea id="vid-opportunity" rows="3" placeholder="Nilai ekonomi dan potensi serapan pasar" class={area}>{video?.opportunity_summary ?? ''}</textarea>
      </div>
    </div>

    <aside class="px-4 sm:px-6 lg:px-6 py-6 space-y-5 border-t lg:border-t-0 border-slate-200">
      <div>
        <label for="vid-thumb" class={label}>Thumbnail</label>
        <input type="url" id="vid-thumb" required value={video?.thumbnail_url ?? ''} placeholder="https://images.unsplash.com/..." class={field} />
        <div class="mt-2 relative aspect-16/9 rounded-md overflow-hidden bg-slate-100 flex items-center justify-center text-xs text-slate-500">
          <span id="vid-thumb-empty" class={video?.thumbnail_url ? 'hidden' : ''}>Pratinjau thumbnail</span>
          <img
            id="vid-thumb-preview"
            src={video?.thumbnail_url ?? ''}
            alt="Pratinjau thumbnail"
            width="320"
            height="180"
            class={`absolute inset-0 w-full h-full object-cover ${video?.thumbnail_url ? '' : 'hidden'}`}
          />
          <span id="vid-duration-badge" class="absolute bottom-1 right-1 bg-black/85 text-white text-[10px] font-medium leading-none px-1.5 py-0.5 rounded-[3px]"></span>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="vid-duration" class={label}>Durasi</label>
          <input type="text" id="vid-duration" value={video?.duration ?? ''} placeholder="22 Menit" class={field} />
        </div>
        <div>
          <label for="vid-sort" class={label}>Urutan</label>
          <input type="number" id="vid-sort" value={video?.sort_order ?? 0} class={field} />
        </div>
      </div>

      <label for="vid-active" class="flex items-center gap-2 text-sm text-slate-800 cursor-pointer">
        <input type="checkbox" id="vid-active" checked={video ? video.is_active === 1 : true} class="w-4 h-4 rounded border-slate-300 text-emerald-700 focus:ring-emerald-700" />
        <span>Tampil di /edukasi</span>
      </label>

      {isEdit && (
        <a href={`/edukasi/video/${video!.id}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-700 hover:underline">
          <AppIcon name="external-link" size="xs" />
          <span>Lihat halaman publik</span>
        </a>
      )}
    </aside>
  </div>
</form>

<script>
  function initVideoForm() {
    const form = document.getElementById('video-form') as HTMLFormElement | null;
    if (!form) return;
    const val = (id: string) => (document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement).value.trim();
    const status = document.getElementById('video-form-status');
    const submit = document.getElementById('btn-submit-video') as HTMLButtonElement;
    const thumbInput = document.getElementById('vid-thumb') as HTMLInputElement;
    const thumbImg = document.getElementById('vid-thumb-preview') as HTMLImageElement;
    const thumbEmpty = document.getElementById('vid-thumb-empty');
    const durInput = document.getElementById('vid-duration') as HTMLInputElement;
    const durBadge = document.getElementById('vid-duration-badge');

    const syncThumb = () => {
      const url = thumbInput.value.trim();
      if (url) thumbImg.src = url;
      thumbImg.classList.toggle('hidden', !url);
      thumbEmpty?.classList.toggle('hidden', !!url);
    };
    const syncDuration = () => {
      if (!durBadge) return;
      const m = durInput.value.trim().match(/^(\d+)/);
      durBadge.textContent = m ? `${m[1]}:00` : '';
      durBadge.classList.toggle('hidden', !m);
    };
    thumbInput.addEventListener('input', syncThumb);
    durInput.addEventListener('input', syncDuration);
    syncDuration();

    const setStatus = (msg: string, error = false) => {
      if (!status) return;
      status.textContent = msg;
      status.className = `text-xs sm:inline ${error ? 'text-rose-700 font-semibold' : 'text-emerald-700 font-semibold'}`;
    };

    async function save() {
      submit.disabled = true;
      setStatus('Menyimpan...');
      const id = form!.dataset.videoId || '';
      const payload: Record<string, string> = {
        action: id ? 'update' : 'create',
        title: val('vid-title'),
        channelName: val('vid-channel'),
        tag: val('vid-tag'),
        duration: val('vid-duration'),
        sortOrder: val('vid-sort'),
        videoUrl: val('vid-url'),
        thumbnailUrl: val('vid-thumb'),
        practiceSummary: val('vid-practice'),
        opportunitySummary: val('vid-opportunity'),
        isActive: (document.getElementById('vid-active') as HTMLInputElement).checked ? '1' : '0',
      };
      if (id) payload.id = id;
      try {
        const res = await fetch('/api/admin/case-studies', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          setStatus('Tersimpan');
          window.location.href = '/admin/articles#videos';
        } else {
          setStatus(data.message || 'Gagal menyimpan.', true);
          submit.disabled = false;
        }
      } catch {
        setStatus('Koneksi bermasalah.', true);
        submit.disabled = false;
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      void save();
    });
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
        e.preventDefault();
        form.requestSubmit();
      }
    });
  }

  initVideoForm();
</script>
