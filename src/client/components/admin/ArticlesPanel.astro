---
import AppIcon from '../common/AppIcon.astro';
import type { Article } from '../../../lib/db';

interface Props {
  articles: Article[];
}

const { articles = [] } = Astro.props;

const categories = Array.from(new Set(articles.map((a) => a.category).filter(Boolean)));
const totalArticles = articles.length;

function formatDate(iso: string | Date): string {
  try {
    return new Date(iso).toLocaleDateString('id-ID', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  } catch {
    return String(iso);
  }
}
---

<section id="panel-articles" class="admin-tab-panel w-full min-w-0 max-w-full overflow-x-clip hidden">
  {/* Hairline Operational Metric Strip */}
  <div
    tabindex="0"
    role="region"
    aria-label="Ringkasan statistik artikel edukasi"
    class="flex lg:grid lg:grid-cols-3 w-full max-w-full overflow-x-auto no-scrollbar snap-x snap-mandatory divide-x divide-slate-200 border-b border-slate-200 bg-white"
  >
    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Total Panduan Terbit</span>
      <span class="mt-0.5 text-xl font-bold text-slate-900 font-mono tabular-nums block">{totalArticles}</span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Kategori Aktif</span>
      <span class="mt-0.5 text-xl font-bold text-emerald-700 font-mono tabular-nums block">{categories.length}</span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Status Publikasi</span>
      <span class="mt-0.5 text-xs font-bold text-slate-700 block truncate">
        {articles[0] ? `Terbaru: ${articles[0].title}` : 'Belum ada panduan'}
      </span>
    </div>
  </div>

  {/* Toolbar */}
  <div class="px-4 sm:px-6 lg:px-8 py-3 border-b border-slate-200 flex items-center justify-between gap-3 bg-white">
    <div class="relative flex-1 max-w-md">
      <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none">
        <AppIcon name="search" size="xs" />
      </span>
      <input
        type="search"
        id="articles-table-search"
        placeholder="Cari judul atau kategori..."
        aria-label="Cari panduan di tabel"
        class="w-full h-8 pl-8 pr-3 text-xs bg-slate-50 hover:bg-white focus:bg-white border border-slate-200 focus:border-emerald-700 rounded-md transition focus:outline-none"
      />
    </div>

    {/* Mobile Only: Quick Actions (Desktop actions live in sticky header) */}
    <div class="flex md:hidden items-center gap-1.5 shrink-0">
      <a
        href="/edukasi"
        target="_blank"
        class="h-8 px-2.5 rounded-md border border-slate-300 bg-white text-slate-700 font-semibold text-xs inline-flex items-center gap-1 transition active:scale-[0.98]"
      >
        <span>Publik</span>
        <AppIcon name="external-link" size="xs" />
      </a>
      <button
        type="button"
        data-open-add-article
        class="h-8 px-3 rounded-md bg-emerald-700 text-white font-semibold text-xs inline-flex items-center gap-1 transition shadow-2xs cursor-pointer active:scale-[0.98]"
      >
        <AppIcon name="plus" size="xs" />
        <span>Tulis</span>
      </button>
    </div>
  </div>

  {/* Table List of Articles */}
  <div class="w-full overflow-x-auto">
    <table class="w-full text-left text-xs border-collapse">
      <thead>
        <tr class="border-b border-slate-200 bg-slate-50/70 text-slate-600 font-bold uppercase tracking-wider">
          <th scope="col" class="py-3 px-4 sm:px-6 w-16 align-middle">Sampul</th>
          <th scope="col" class="py-3 px-4 sm:px-6 align-middle">Judul & Ringkasan</th>
          <th scope="col" class="py-3 px-4 sm:px-6 w-40 align-middle">Kategori</th>
          <th scope="col" class="py-3 px-4 sm:px-6 w-32 align-middle">Tanggal</th>
          <th scope="col" class="py-3 px-4 sm:px-6 text-right w-44 align-middle">Aksi</th>
        </tr>
      </thead>
      <tbody id="articles-table-body" class="divide-y divide-slate-100 bg-white">
        {articles.length === 0 ? (
          <tr>
            <td colspan="5" class="py-12 text-center text-slate-500">
              <div class="w-12 h-12 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-slate-400 mb-2">
                <AppIcon name="book" size="md" />
              </div>
              <p class="font-bold text-slate-700">Belum ada panduan.</p>
              <p class="text-xs text-slate-500 mt-0.5">Gunakan tombol "Tulis" untuk menerbitkan materi baru.</p>
            </td>
          </tr>
        ) : (
          articles.map((art) => (
            <tr
              class="hover:bg-slate-50/80 transition group"
              data-article-row
              data-article-search={`${art.title.toLowerCase()} ${art.category.toLowerCase()} ${art.summary.toLowerCase()}`}
            >
              <td class="py-2.5 px-4 sm:px-6 align-middle">
                <div class="w-10 h-10 rounded-md bg-slate-100 overflow-hidden border border-slate-200 shrink-0">
                  <img
                    src={art.image_url || 'https://images.unsplash.com/photo-1542744094-3a31f272c490?w=200&q=80'}
                    alt={art.title}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
              </td>
              <td class="py-2.5 px-4 sm:px-6 max-w-md align-middle">
                <a
                  href={`/edukasi/${art.slug}`}
                  target="_blank"
                  class="font-bold text-slate-900 hover:text-emerald-700 transition line-clamp-1 block leading-snug"
                >
                  {art.title}
                </a>
                <p class="text-slate-500 line-clamp-1 text-xs mt-0.5 leading-normal">{art.summary}</p>
              </td>
              <td class="py-2.5 px-4 sm:px-6 align-middle">
                <span class="inline-block px-2 py-0.5 rounded-md text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 whitespace-nowrap">
                  {art.category}
                </span>
              </td>
              <td class="py-2.5 px-4 sm:px-6 text-slate-600 font-mono text-xs whitespace-nowrap align-middle">
                {formatDate(art.created_at)}
              </td>
              <td class="py-2.5 px-4 sm:px-6 text-right whitespace-nowrap align-middle">
                <div class="inline-flex items-center gap-1.5 justify-end">
                  <a
                    href={`/edukasi/${art.slug}`}
                    target="_blank"
                    class="h-7 px-2 rounded-md border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs inline-flex items-center gap-1 transition active:scale-[0.96]"
                    title="Buka Pratinjau Artikel"
                  >
                    <AppIcon name="external-link" size="xs" />
                    <span>Lihat</span>
                  </a>

                  <button
                    type="button"
                    data-edit-article
                    data-id={art.id}
                    data-title={art.title}
                    data-category={art.category}
                    data-summary={art.summary}
                    data-image-url={art.image_url}
                    data-content={art.content || ''}
                    class="h-7 px-2 rounded-md border border-slate-200 bg-white hover:bg-emerald-50 text-slate-700 hover:text-emerald-700 font-semibold text-xs inline-flex items-center gap-1 transition cursor-pointer active:scale-[0.96]"
                    title="Sunting Artikel"
                  >
                    <AppIcon name="edit" size="xs" />
                    <span>Edit</span>
                  </button>

                  <button
                    type="button"
                    data-delete-article
                    data-id={art.id}
                    data-title={art.title}
                    class="h-7 px-2 rounded-md border border-slate-200 bg-white hover:bg-rose-50 text-slate-700 hover:text-rose-700 font-semibold text-xs inline-flex items-center gap-1 transition cursor-pointer active:scale-[0.96]"
                    title="Hapus Artikel"
                  >
                    <AppIcon name="trash" size="xs" />
                    <span>Hapus</span>
                  </button>
                </div>
              </td>
            </tr>
          ))
        )}
      </tbody>
    </table>
  </div>

  {/* Modal Dialog Form: Tulis / Edit Panduan Edukasi (Bottom-Sheet Drawer on Mobile) */}
  <dialog
    id="modal-article"
    aria-labelledby="modal-article-title"
    class="w-full sm:w-[calc(100%-2rem)] max-w-2xl fixed sm:static bottom-0 inset-x-0 sm:inset-auto m-0 sm:m-auto rounded-t-2xl sm:rounded-2xl rounded-b-none sm:rounded-b-2xl bg-white border border-slate-200 shadow-2xl p-0 text-slate-900 backdrop:bg-slate-950/60"
  >
    {/* Mobile Drag Handle */}
    <div class="sm:hidden w-10 h-1 rounded-full bg-slate-300 mx-auto mt-2.5 mb-1" aria-hidden="true"></div>

    <div class="px-5 sm:px-6 py-3.5 border-b border-slate-200 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-700">
          <AppIcon name="book" size="sm" />
        </div>
        <h2 id="modal-article-title" class="text-sm sm:text-base font-bold text-slate-900">
          Tulis Panduan
        </h2>
      </div>
      <button
        type="button"
        id="btn-close-article-modal"
        class="min-h-[44px] min-w-[44px] sm:min-h-8 sm:min-w-8 sm:w-8 sm:h-8 rounded-lg flex items-center justify-center text-slate-500 hover:bg-slate-100 transition cursor-pointer active:scale-[0.95]"
        aria-label="Tutup formulir"
      >
        <AppIcon name="x" size="xs" />
      </button>
    </div>

    <form id="form-admin-article" class="p-5 sm:p-6 space-y-4 max-h-[78vh] overflow-y-auto">
      <input type="hidden" name="action" id="articleAction" value="create" />
      <input type="hidden" name="id" id="articleId" value="" />

      {/* Judul Artikel */}
      <div class="space-y-1">
        <label for="articleTitle" class="block text-xs font-bold text-slate-800">
          Judul <span class="text-rose-600">*</span>
        </label>
        <input
          type="text"
          id="articleTitle"
          name="title"
          required
          minlength="5"
          placeholder="Contoh: Sertifikasi Halal Gratis (SEHATI)"
          class="w-full min-h-[42px] px-3 py-2 text-xs sm:text-sm bg-white border border-slate-300 focus:border-emerald-700 rounded-lg transition focus:outline-none focus:ring-1 focus:ring-emerald-700"
        />
      </div>

      {/* Kategori & Foto Sampul */}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
        <div class="space-y-1">
          <label for="articleCategory" class="block text-xs font-bold text-slate-800">
            Kategori <span class="text-rose-600">*</span>
          </label>
          <select
            id="articleCategory"
            name="category"
            required
            class="w-full min-h-[42px] px-3 py-2 text-xs sm:text-sm bg-white border border-slate-300 focus:border-emerald-700 rounded-lg transition focus:outline-none focus:ring-1 focus:ring-emerald-700 cursor-pointer"
          >
            <option value="Ekonomi Pekarangan">Ekonomi Pekarangan</option>
            <option value="Panduan Usaha">Panduan Usaha</option>
            <option value="Legalitas & Halal">Legalitas & Halal</option>
            <option value="Tips Transaksi">Tips Transaksi</option>
            <option value="Gerakan Warga">Gerakan Warga</option>
            <option value="Edukasi UMKM">Edukasi UMKM</option>
          </select>
        </div>

        <div class="space-y-1">
          <label for="articleImageUrl" class="block text-xs font-bold text-slate-800">
            Foto Sampul (URL)
          </label>
          <input
            type="url"
            id="articleImageUrl"
            name="imageUrl"
            placeholder="https://images.unsplash.com/..."
            class="w-full min-h-[42px] px-3 py-2 text-xs sm:text-sm bg-white border border-slate-300 focus:border-emerald-700 rounded-lg transition focus:outline-none focus:ring-1 focus:ring-emerald-700"
          />
        </div>
      </div>

      {/* Ringkasan */}
      <div class="space-y-1">
        <div class="flex items-center justify-between">
          <label for="articleSummary" class="block text-xs font-bold text-slate-800">
            Ringkasan <span class="text-rose-600">*</span>
          </label>
          <span class="text-2xs font-mono text-slate-400">Maks. 250 karakter</span>
        </div>
        <textarea
          id="articleSummary"
          name="summary"
          rows="2"
          required
          maxlength="300"
          placeholder="Ringkasan 1-2 kalimat untuk pratinjau kartu katalog..."
          class="w-full px-3 py-2 text-xs sm:text-sm bg-white border border-slate-300 focus:border-emerald-700 rounded-lg transition focus:outline-none focus:ring-1 focus:ring-emerald-700"
        ></textarea>
      </div>

      {/* Konten Lengkap Markdown */}
      <div class="space-y-1">
        <div class="flex items-center justify-between">
          <label for="articleContent" class="block text-xs font-bold text-slate-800">
            Konten (Markdown)
          </label>
          <span class="text-2xs font-mono text-slate-400">### Judul · - Poin</span>
        </div>
        <textarea
          id="articleContent"
          name="content"
          rows="9"
          placeholder="Tuliskan materi panduan:&#10;&#10;### 1. Langkah Pertama&#10;Uraian langkah...&#10;&#10;### 2. Syarat&#10;- Berkas A&#10;- Berkas B"
          class="w-full px-3 py-2 text-xs sm:text-sm bg-white border border-slate-300 focus:border-emerald-700 rounded-lg transition font-mono leading-relaxed focus:outline-none focus:ring-1 focus:ring-emerald-700"
        ></textarea>
      </div>

      {/* Feedback Status */}
      <div id="admin-article-status" class="hidden p-3 rounded-lg text-xs font-semibold"></div>

      {/* Footer Buttons */}
      <div class="pt-3 border-t border-slate-200 flex flex-col-reverse sm:flex-row sm:justify-end gap-2">
        <button
          type="button"
          id="btn-cancel-article-modal"
          class="min-h-[44px] sm:min-h-[38px] px-4 py-2 rounded-lg text-xs font-semibold text-slate-700 bg-white hover:bg-slate-100 border border-slate-300 transition cursor-pointer active:scale-[0.98]"
        >
          Batal
        </button>
        <button
          type="submit"
          id="btn-submit-article"
          class="min-h-[44px] sm:min-h-[38px] px-5 py-2 rounded-lg text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 transition shadow-xs cursor-pointer inline-flex items-center justify-center gap-1.5 active:scale-[0.98]"
        >
          <AppIcon name="check" size="xs" />
          <span id="btn-submit-article-label">Simpan</span>
        </button>
      </div>
    </form>
  </dialog>
</section>
