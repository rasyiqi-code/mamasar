---
import AppIcon from '../common/AppIcon.astro';

interface Props {
  user: {
    id: number;
    name: string;
    email: string;
    avatar_url?: string | null;
    agent_ranting?: string | null;
  };
  isSuper?: boolean;
  userRole?: string;
  assignedZoneName?: string;
  pendingPetugasCount: number;
  pendingStoresCount: number;
  zonesCount: number;
  pendingPromotionsCount?: number;
}

const {
  user,
  isSuper = true,
  userRole = 'pcnu',
  assignedZoneName = 'Sumenep',
  pendingPetugasCount,
  pendingStoresCount,
  zonesCount,
  pendingPromotionsCount = 0,
} = Astro.props;

const isMwcAdmin = !isSuper && userRole === 'mwcnu';
const roleTitle = isSuper
  ? 'Konsol Admin PCNU'
  : isMwcAdmin
    ? `Pengurus MWC ${assignedZoneName}`
    : user.agent_ranting
      ? `Kader Ranting ${user.agent_ranting}`
      : `Kader MWC ${assignedZoneName}`;
const roleSub = isSuper
  ? 'Sumenep'
  : isMwcAdmin
    ? 'Moderasi & Agenda MWC'
    : `MWC ${assignedZoneName}`;
---

<!-- MOBILE TOP HEADER (Compact App Bar for Mobile) -->
<div class="md:hidden sticky top-0 z-40 bg-white/95 backdrop-blur-xs border-b border-slate-200 px-3 py-2 flex items-center justify-between gap-2">
  <div class="flex items-center gap-2.5 min-w-0">
    <button
      type="button"
      id="btn-toggle-admin-sidebar"
      class="min-w-[44px] min-h-[44px] flex items-center justify-center text-slate-700 hover:text-slate-900 hover:bg-slate-50 rounded-lg border border-slate-200 focus:outline-none cursor-pointer shrink-0"
      aria-label="Buka Menu Admin"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
    <h2 class="text-sm font-bold text-slate-900 truncate">
      {roleTitle}
    </h2>
  </div>

  <div class="flex items-center gap-1.5 shrink-0">
    <a
      href="/dashboard"
      class="min-h-[44px] inline-flex items-center gap-1 text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 border border-slate-200 rounded-lg px-2.5 transition"
    >
      <span>Toko</span>
      <AppIcon name="arrow-right" size="xs" />
    </a>
  </div>
</div>

<!-- SIDEBAR BACKDROP ON MOBILE -->
<div id="admin-sidebar-backdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 hidden md:hidden transition-opacity"></div>

<!-- DESKTOP & MOBILE SIDEBAR -->
<aside
  id="admin-sidebar"
  class="fixed md:sticky top-0 bottom-0 left-0 z-50 w-64 bg-[#fbfcfd] border-r border-slate-200 flex flex-col justify-between transform -translate-x-full md:translate-x-0 transition-transform duration-200 ease-in-out h-dvh shrink-0"
>
  <div class="flex flex-col h-full overflow-y-auto">
    <!-- Sidebar Header: PCNU Logo & Portal Info -->
    <div class="p-4 border-b border-slate-200/70 flex items-center justify-between">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-9 h-9 rounded-lg bg-emerald-700 text-white flex items-center justify-center font-bold text-xs shrink-0">
          PCNU
        </div>
        <div class="min-w-0">
          <div class="text-xs font-bold text-slate-900 truncate">
            {roleTitle}
          </div>
          <p class="text-xs text-slate-600 truncate">
            {roleSub}
          </p>
        </div>
      </div>

      <button
        type="button"
        id="btn-close-admin-sidebar"
        class="md:hidden min-w-[44px] min-h-[44px] flex items-center justify-center text-slate-600 hover:text-slate-900 rounded-lg cursor-pointer"
        aria-label="Tutup Menu Admin"
      >
        <AppIcon name="x" size="sm" />
      </button>
    </div>

    <!-- Navigation Tabs -->
    <nav aria-label="Menu Portal Admin & Kader" class="p-3 space-y-1 flex-1 text-xs">
      <div role="tablist" aria-orientation="vertical" class="space-y-1">
      {isSuper && (
        <button
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="panel-agents"
          data-admin-tab="agents"
          class="admin-nav-tab active w-full min-h-[42px] flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer text-left"
        >
          <div class="flex items-center gap-2.5">
            <AppIcon name="shield" size="sm" class="text-slate-600" />
            <span>Pengguna & Peran</span>
          </div>
          {pendingPetugasCount > 0 ? (
            <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-amber-100 text-amber-900">
              {pendingPetugasCount}
            </span>
          ) : (
            <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-600">
              0
            </span>
          )}
        </button>
      )}

      {isSuper ? (
        <button
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="panel-stores"
          data-admin-tab="stores"
          class="admin-nav-tab w-full min-h-[42px] flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer text-left"
        >
          <div class="flex items-center gap-2.5">
            <AppIcon name="store" size="sm" class="text-slate-600" />
            <span>Moderasi Toko</span>
          </div>
          {pendingStoresCount > 0 ? (
            <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-emerald-100 text-emerald-900">
              {pendingStoresCount}
            </span>
          ) : (
            <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-600">
              0
            </span>
          )}
        </button>
      ) : (
        <button
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="panel-entry"
          data-admin-tab="entry"
          class="admin-nav-tab active w-full min-h-[42px] flex items-center gap-2.5 px-3 py-2 rounded-lg cursor-pointer text-left"
        >
          <AppIcon name="clipboard" size="sm" class="text-slate-600" />
          <span>Entri Jemput Bola</span>
        </button>
      )}

      {isSuper ? (
        <button
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="panel-entry"
          data-admin-tab="entry"
          class="admin-nav-tab w-full min-h-[42px] flex items-center gap-2.5 px-3 py-2 rounded-lg cursor-pointer text-left"
        >
          <AppIcon name="clipboard" size="sm" class="text-slate-600" />
          <span>Entri Jemput Bola</span>
        </button>
      ) : (
        <button
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="panel-stores"
          data-admin-tab="stores"
          class="admin-nav-tab w-full min-h-[42px] flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer text-left"
        >
          <div class="flex items-center gap-2.5">
            <AppIcon name="store" size="sm" class="text-slate-600" />
            <span>Toko Binaan MWC</span>
          </div>
          <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-600">
            {pendingStoresCount}
          </span>
        </button>
      )}

      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="panel-events"
        data-admin-tab="events"
        class="admin-nav-tab w-full min-h-[42px] flex items-center gap-2.5 px-3 py-2 rounded-lg cursor-pointer text-left"
      >
        <AppIcon name="tent" size="sm" class="text-slate-600" />
        <span>Agenda Kegiatan</span>
      </button>

      {(isSuper || isMwcAdmin) && (
        <button
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="panel-promotions"
          data-admin-tab="promotions"
          class="admin-nav-tab w-full min-h-[42px] flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer text-left"
        >
          <div class="flex items-center gap-2.5">
            <AppIcon name="star" size="sm" class="text-amber-600" />
            <span>Iklan & Promosi</span>
          </div>
          {pendingPromotionsCount > 0 ? (
            <span class="text-xs font-bold px-2 py-0.5 rounded-md bg-amber-200 text-amber-950">
              {pendingPromotionsCount}
            </span>
          ) : (
            <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-600">
              0
            </span>
          )}
        </button>
      )}

      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls="panel-zones"
        data-admin-tab="zones"
        class="admin-nav-tab w-full min-h-[42px] flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer text-left"
      >
        <div class="flex items-center gap-2.5">
          <AppIcon name="map-pin" size="sm" class="text-slate-600" />
          <span>Peta Sebaran Wilayah</span>
        </div>
        <span class="text-xs font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-600">
          {zonesCount}
        </span>
      </button>
      </div>

      <div class="pt-3 mt-2 border-t border-slate-200/60 space-y-1">
        <a
          href="/dashboard"
          class="min-h-[40px] flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 transition font-medium"
        >
          <AppIcon name="store" size="sm" />
          <span>Dashboard Toko Saya</span>
        </a>
        <a
          href="/"
          class="min-h-[40px] flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 transition font-medium"
        >
          <AppIcon name="globe" size="sm" />
          <span>Lihat Katalog Depan</span>
        </a>
      </div>
    </nav>

    <!-- Sidebar Footer -->
    <div class="p-3 border-t border-slate-200/70">
      <div class="flex items-center justify-between text-xs">
        <div class="min-w-0">
          <span class="font-semibold text-slate-900 block truncate text-xs">{user.name}</span>
          <span class="text-xs text-slate-600 block truncate">
            {isSuper ? 'Superadmin PCNU' : isMwcAdmin ? `Pengurus MWC ${assignedZoneName}` : user.agent_ranting ? `Kader Ranting ${user.agent_ranting} • MWC ${assignedZoneName}` : `Kader MWC ${assignedZoneName}`}
          </span>
        </div>
        <form
          method="POST"
          action="/api/auth/logout"
          onsubmit="try{localStorage.removeItem('mamasar_favorites')}catch{}"
        >
          <button
            type="submit"
            class="p-1.5 text-slate-600 hover:text-rose-700 rounded-md transition cursor-pointer"
            title="Keluar"
            aria-label="Keluar dari akun"
          >
            <AppIcon name="log-out" size="sm" />
          </button>
        </form>
      </div>
    </div>
  </div>
</aside>

<!-- MOBILE ADMIN BOTTOM TAB BAR (1-Tap Thumb Navigation for Field Cadres & Admins) -->
<nav
  aria-label="Navigasi Bawah Portal Admin"
  class={`md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-xs border-t border-slate-200 px-1 py-1 pb-[calc(0.35rem+env(safe-area-inset-bottom,0px))] grid items-center text-[11px] ${
    isSuper || isMwcAdmin ? 'grid-cols-5' : 'grid-cols-4'
  }`}
>
  {isSuper ? (
    <button
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls="panel-agents"
      data-admin-tab="agents"
      class="relative min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold text-slate-600 aria-selected:text-emerald-700 aria-selected:bg-emerald-50/70 transition cursor-pointer"
    >
      <AppIcon name="shield" size="sm" />
      <span class="truncate max-w-full">Akun</span>
      {pendingPetugasCount > 0 && (
        <span class="absolute top-1 right-2 min-w-[16px] h-4 px-1 rounded-full bg-amber-200 text-amber-950 text-[10px] font-mono font-bold flex items-center justify-center leading-none">
          {pendingPetugasCount > 99 ? '99+' : pendingPetugasCount}
        </span>
      )}
    </button>
  ) : (
    <button
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls="panel-entry"
      data-admin-tab="entry"
      class="min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold text-slate-600 aria-selected:text-emerald-700 aria-selected:bg-emerald-50/70 transition cursor-pointer"
    >
      <AppIcon name="clipboard" size="sm" />
      <span class="truncate max-w-full">Entri</span>
    </button>
  )}

  <button
    type="button"
    role="tab"
    aria-selected="false"
    aria-controls="panel-stores"
    data-admin-tab="stores"
    class="relative min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold text-slate-600 aria-selected:text-emerald-700 aria-selected:bg-emerald-50/70 transition cursor-pointer"
  >
    <AppIcon name="store" size="sm" />
    <span class="truncate max-w-full">Toko</span>
    {pendingStoresCount > 0 && (
      <span class="absolute top-1 right-2 min-w-[16px] h-4 px-1 rounded-full bg-emerald-200 text-emerald-950 text-[10px] font-mono font-bold flex items-center justify-center leading-none">
        {pendingStoresCount > 99 ? '99+' : pendingStoresCount}
      </span>
    )}
  </button>

  {isSuper && (
    <button
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="panel-entry"
      data-admin-tab="entry"
      class="min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold text-slate-600 aria-selected:text-emerald-700 aria-selected:bg-emerald-50/70 transition cursor-pointer"
    >
      <AppIcon name="clipboard" size="sm" />
      <span class="truncate max-w-full">Entri</span>
    </button>
  )}

  <button
    type="button"
    role="tab"
    aria-selected="false"
    aria-controls="panel-events"
    data-admin-tab="events"
    class="min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold text-slate-600 aria-selected:text-emerald-700 aria-selected:bg-emerald-50/70 transition cursor-pointer"
  >
    <AppIcon name="tent" size="sm" />
    <span class="truncate max-w-full">Agenda</span>
  </button>

  {(isSuper || isMwcAdmin) && (
    <button
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="panel-promotions"
      data-admin-tab="promotions"
      class="relative min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold text-slate-600 aria-selected:text-emerald-700 aria-selected:bg-emerald-50/70 transition cursor-pointer"
    >
      <AppIcon name="star" size="sm" />
      <span class="truncate max-w-full">Promosi</span>
      {pendingPromotionsCount > 0 && (
        <span class="absolute top-1 right-2 min-w-[16px] h-4 px-1 rounded-full bg-amber-200 text-amber-950 text-[10px] font-mono font-bold flex items-center justify-center leading-none">
          {pendingPromotionsCount > 99 ? '99+' : pendingPromotionsCount}
        </span>
      )}
    </button>
  )}

  {!isSuper && (
    <button
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="panel-zones"
      data-admin-tab="zones"
      class="min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold text-slate-600 aria-selected:text-emerald-700 aria-selected:bg-emerald-50/70 transition cursor-pointer"
    >
      <AppIcon name="map-pin" size="sm" />
      <span class="truncate max-w-full">Peta</span>
    </button>
  )}
</nav>
