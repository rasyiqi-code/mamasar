---
import AppIcon from '../common/AppIcon.astro';

interface Props {
  user: {
    id: number;
    name: string;
    email: string;
    avatar_url?: string | null;
    agent_ranting?: string | null;
  };
  isSuper?: boolean;
  userRole?: string;
  assignedZoneName?: string;
  pendingPetugasCount: number;
  pendingStoresCount: number;
  zonesCount: number;
  pendingPromotionsCount?: number;
}

const {
  user,
  isSuper = true,
  userRole = 'pcnu',
  assignedZoneName = 'Sumenep',
  pendingPetugasCount,
  pendingStoresCount,
  zonesCount,
  pendingPromotionsCount = 0,
} = Astro.props;

const isMwcAdmin = !isSuper && userRole === 'mwcnu';
const roleTitle = isSuper
  ? 'Admin PCNU'
  : isMwcAdmin
    ? `MWC ${assignedZoneName}`
    : user.agent_ranting
      ? `Ranting ${user.agent_ranting}`
      : `Kader ${assignedZoneName}`;
const roleSub = isSuper
  ? 'PCNU Sumenep'
  : isMwcAdmin
    ? 'Pengurus MWC'
    : `MWC ${assignedZoneName}`;
const initialTabLabel = isSuper ? 'Pengguna & Peran' : 'Entri Jemput Bola';
---

<!-- MOBILE TOP HEADER (Unified App Bar matching DashboardSidebar) -->
<div class="md:hidden sticky top-0 z-40 h-14 bg-white/95 backdrop-blur-xs border-b border-slate-200 px-3 flex items-center justify-between gap-2 shrink-0">
  <div class="flex items-center gap-2.5 min-w-0">
    <button
      type="button"
      id="btn-toggle-admin-sidebar"
      aria-controls="admin-sidebar"
      aria-expanded="false"
      class="min-w-[44px] min-h-[44px] flex items-center justify-center text-slate-700 hover:text-slate-900 hover:bg-slate-50 rounded-lg border border-slate-200 cursor-pointer shrink-0"
      aria-label="Buka Menu Admin"
    >
      <AppIcon name="menu" size="lg" />
    </button>
    <h2 id="admin-mobile-title" class="text-sm font-bold text-slate-900 truncate">
      {initialTabLabel}
    </h2>
  </div>

  <div class="flex items-center gap-1.5 shrink-0">
    <a
      href="/dashboard"
      class="min-h-[44px] inline-flex items-center gap-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900 hover:bg-slate-50 border border-slate-200 rounded-lg px-3 transition"
    >
      <AppIcon name="store" size="xs" />
      <span>Toko</span>
    </a>
  </div>
</div>

<!-- SIDEBAR BACKDROP ON MOBILE -->
<div id="admin-sidebar-backdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 hidden md:hidden transition-opacity"></div>

<!-- DESKTOP & MOBILE SIDEBAR -->
<aside
  id="admin-sidebar"
  aria-label="Navigasi Portal Admin & Kader"
  class="fixed md:sticky top-0 bottom-0 left-0 z-50 w-64 bg-[#fbfcfd] border-r border-slate-200 flex flex-col justify-between transform -translate-x-full md:translate-x-0 transition-transform duration-200 ease-in-out h-dvh shrink-0"
>
  <div class="flex flex-col h-full overflow-y-auto">
    <!-- Sidebar Header: Aligned h-14 Hairline with Desktop Header -->
    <div class="px-4 h-14 border-b border-slate-200 flex items-center justify-between gap-2 shrink-0">
      <div class="flex items-center gap-2.5 min-w-0">
        <div class="w-9 h-9 rounded-lg bg-emerald-700 text-white flex items-center justify-center font-bold text-xs shrink-0">
          {isSuper ? 'PCNU' : 'MWC'}
        </div>
        <div class="min-w-0">
          <div class="text-xs font-bold text-slate-900 truncate">
            {roleTitle}
          </div>
          <p class="text-[11px] text-slate-600 truncate">
            {roleSub}
          </p>
        </div>
      </div>

      <button
        type="button"
        id="btn-close-admin-sidebar"
        class="md:hidden min-w-[44px] min-h-[44px] flex items-center justify-center text-slate-600 hover:text-slate-900 rounded-lg cursor-pointer"
        aria-label="Tutup Menu Admin"
      >
        <AppIcon name="x" size="sm" />
      </button>
    </div>

    <!-- Navigation Tabs -->
    <nav aria-label="Menu Portal Admin & Kader" class="p-3 space-y-1 flex-1 text-xs">
      <div role="tablist" aria-orientation="vertical" class="space-y-1">
        {isSuper && (
          <button
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="panel-agents"
            data-admin-tab="agents"
            data-admin-label="Pengguna & Peran"
            tabindex="0"
            class="admin-nav-tab active w-full min-h-[42px] flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer text-left"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <AppIcon name="shield" size="sm" class="shrink-0" />
              <span class="truncate">Pengguna &amp; Peran</span>
            </div>
            <span class={`admin-nav-badge text-xs font-mono tabular-nums font-semibold px-2 py-0.5 rounded-md ${
              pendingPetugasCount > 0 ? 'bg-amber-100 text-amber-900' : 'bg-slate-100 text-slate-600'
            }`}>
              {pendingPetugasCount}
            </span>
          </button>
        )}

        {isSuper ? (
          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-stores"
            data-admin-tab="stores"
            data-admin-label="Moderasi Toko"
            tabindex="-1"
            class="admin-nav-tab w-full min-h-[42px] flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer text-left"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <AppIcon name="store" size="sm" class="shrink-0" />
              <span class="truncate">Moderasi Toko</span>
            </div>
            <span class={`admin-nav-badge text-xs font-mono tabular-nums font-semibold px-2 py-0.5 rounded-md ${
              pendingStoresCount > 0 ? 'bg-amber-100 text-amber-900' : 'bg-slate-100 text-slate-600'
            }`}>
              {pendingStoresCount}
            </span>
          </button>
        ) : (
          <button
            type="button"
            role="tab"
            aria-selected="true"
            aria-controls="panel-entry"
            data-admin-tab="entry"
            data-admin-label="Entri Jemput Bola"
            tabindex="0"
            class="admin-nav-tab active w-full min-h-[42px] flex items-center gap-2.5 px-3 py-2 rounded-lg cursor-pointer text-left"
          >
            <AppIcon name="clipboard" size="sm" class="shrink-0" />
            <span class="truncate">Entri Jemput Bola</span>
          </button>
        )}

        {isSuper ? (
          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-entry"
            data-admin-tab="entry"
            data-admin-label="Entri Jemput Bola"
            tabindex="-1"
            class="admin-nav-tab w-full min-h-[42px] flex items-center gap-2.5 px-3 py-2 rounded-lg cursor-pointer text-left"
          >
            <AppIcon name="clipboard" size="sm" class="shrink-0" />
            <span class="truncate">Entri Jemput Bola</span>
          </button>
        ) : (
          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-stores"
            data-admin-tab="stores"
            data-admin-label="Toko Binaan MWC"
            tabindex="-1"
            class="admin-nav-tab w-full min-h-[42px] flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer text-left"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <AppIcon name="store" size="sm" class="shrink-0" />
              <span class="truncate">Toko Binaan MWC</span>
            </div>
            <span class="admin-nav-badge text-xs font-mono tabular-nums font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-600">
              {pendingStoresCount}
            </span>
          </button>
        )}

        <button
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="panel-events"
          data-admin-tab="events"
          data-admin-label="Agenda Kegiatan"
          tabindex="-1"
          class="admin-nav-tab w-full min-h-[42px] flex items-center gap-2.5 px-3 py-2 rounded-lg cursor-pointer text-left"
        >
          <AppIcon name="tent" size="sm" class="shrink-0" />
          <span class="truncate">Agenda Kegiatan</span>
        </button>

        {(isSuper || isMwcAdmin) && (
          <button
            type="button"
            role="tab"
            aria-selected="false"
            aria-controls="panel-promotions"
            data-admin-tab="promotions"
            data-admin-label="Iklan & Promosi"
            tabindex="-1"
            class="admin-nav-tab w-full min-h-[42px] flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer text-left"
          >
            <div class="flex items-center gap-2.5 min-w-0">
              <AppIcon name="star" size="sm" class="shrink-0 text-amber-600" />
              <span class="truncate">Iklan &amp; Promosi</span>
            </div>
            <span class={`admin-nav-badge text-xs font-mono tabular-nums font-semibold px-2 py-0.5 rounded-md ${
              pendingPromotionsCount > 0 ? 'bg-amber-100 text-amber-900' : 'bg-slate-100 text-slate-600'
            }`}>
              {pendingPromotionsCount}
            </span>
          </button>
        )}

        <button
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="panel-zones"
          data-admin-tab="zones"
          data-admin-label="Peta Sebaran Wilayah"
          tabindex="-1"
          class="admin-nav-tab w-full min-h-[42px] flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer text-left"
        >
          <div class="flex items-center gap-2.5 min-w-0">
            <AppIcon name="map-pin" size="sm" class="shrink-0" />
            <span class="truncate">Sebaran Wilayah</span>
          </div>
          <span class="admin-nav-badge text-xs font-mono tabular-nums font-semibold px-2 py-0.5 rounded-md bg-slate-100 text-slate-600">
            {zonesCount}
          </span>
        </button>
      </div>

      <div class="pt-3 mt-2 border-t border-slate-200/70 space-y-1">
        <a
          href="/dashboard"
          class="min-h-[42px] flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 transition font-medium"
        >
          <AppIcon name="store" size="sm" />
          <span>Dashboard Toko Saya</span>
        </a>
        <a
          href="/"
          class="min-h-[42px] flex items-center gap-2.5 px-3 py-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100/70 transition font-medium"
        >
          <AppIcon name="globe" size="sm" />
          <span>Lihat Katalog Depan</span>
        </a>
      </div>
    </nav>

    <!-- Sidebar Footer -->
    <div class="p-3 border-t border-slate-200/70">
      <div class="flex items-center justify-between gap-2 text-xs">
        <div class="min-w-0">
          <span class="font-semibold text-slate-900 block truncate text-xs">{user.name}</span>
          <span class="text-xs text-slate-600 block truncate">
            {isSuper ? 'Superadmin PCNU' : isMwcAdmin ? `Pengurus MWC ${assignedZoneName}` : user.agent_ranting ? `Kader Ranting ${user.agent_ranting}` : `Kader MWC ${assignedZoneName}`}
          </span>
        </div>
        <form
          method="POST"
          action="/api/auth/logout"
          onsubmit="try{localStorage.removeItem('mamasar_favorites')}catch{}"
        >
          <button
            type="submit"
            class="min-w-[40px] min-h-[40px] flex items-center justify-center text-slate-600 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition cursor-pointer"
            title="Keluar"
            aria-label="Keluar dari akun"
          >
            <AppIcon name="log-out" size="sm" />
          </button>
        </form>
      </div>
    </div>
  </div>
</aside>

<!-- MOBILE ADMIN BOTTOM TAB BAR -->
<nav
  aria-label="Navigasi Bawah Portal Admin"
  class={`md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-xs border-t border-slate-200 px-1 py-1 pb-[calc(0.35rem+env(safe-area-inset-bottom,0px))] grid items-center text-[11px] ${
    isSuper || isMwcAdmin ? 'grid-cols-5' : 'grid-cols-4'
  }`}
>
  {isSuper ? (
    <button
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls="panel-agents"
      data-admin-tab="agents"
      data-admin-label="Pengguna & Peran"
      class="relative min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold text-slate-600 aria-selected:text-emerald-700 aria-selected:bg-emerald-50/70 transition cursor-pointer"
    >
      <AppIcon name="shield" size="sm" />
      <span class="truncate max-w-full">Akun</span>
      {pendingPetugasCount > 0 && (
        <span class="absolute top-0.5 right-2.5 min-w-[16px] h-4 px-1 rounded-full bg-amber-200 text-amber-950 text-[10px] font-mono font-bold flex items-center justify-center leading-none">
          {pendingPetugasCount > 99 ? '99+' : pendingPetugasCount}
        </span>
      )}
    </button>
  ) : (
    <button
      type="button"
      role="tab"
      aria-selected="true"
      aria-controls="panel-entry"
      data-admin-tab="entry"
      data-admin-label="Entri Jemput Bola"
      class="min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold text-slate-600 aria-selected:text-emerald-700 aria-selected:bg-emerald-50/70 transition cursor-pointer"
    >
      <AppIcon name="clipboard" size="sm" />
      <span class="truncate max-w-full">Entri</span>
    </button>
  )}

  <button
    type="button"
    role="tab"
    aria-selected="false"
    aria-controls="panel-stores"
    data-admin-tab="stores"
    data-admin-label={isSuper ? 'Moderasi Toko' : 'Toko Binaan MWC'}
    class="relative min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold text-slate-600 aria-selected:text-emerald-700 aria-selected:bg-emerald-50/70 transition cursor-pointer"
  >
    <AppIcon name="store" size="sm" />
    <span class="truncate max-w-full">Toko</span>
    {pendingStoresCount > 0 && (
      <span class="absolute top-0.5 right-2.5 min-w-[16px] h-4 px-1 rounded-full bg-emerald-200 text-emerald-950 text-[10px] font-mono font-bold flex items-center justify-center leading-none">
        {pendingStoresCount > 99 ? '99+' : pendingStoresCount}
      </span>
    )}
  </button>

  {isSuper && (
    <button
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="panel-entry"
      data-admin-tab="entry"
      data-admin-label="Entri Jemput Bola"
      class="min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold text-slate-600 aria-selected:text-emerald-700 aria-selected:bg-emerald-50/70 transition cursor-pointer"
    >
      <AppIcon name="clipboard" size="sm" />
      <span class="truncate max-w-full">Entri</span>
    </button>
  )}

  <button
    type="button"
    role="tab"
    aria-selected="false"
    aria-controls="panel-events"
    data-admin-tab="events"
    data-admin-label="Agenda Kegiatan"
    class="min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold text-slate-600 aria-selected:text-emerald-700 aria-selected:bg-emerald-50/70 transition cursor-pointer"
  >
    <AppIcon name="tent" size="sm" />
    <span class="truncate max-w-full">Agenda</span>
  </button>

  {(isSuper || isMwcAdmin) && (
    <button
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="panel-promotions"
      data-admin-tab="promotions"
      data-admin-label="Iklan & Promosi"
      class="relative min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold text-slate-600 aria-selected:text-emerald-700 aria-selected:bg-emerald-50/70 transition cursor-pointer"
    >
      <AppIcon name="star" size="sm" />
      <span class="truncate max-w-full">Promosi</span>
      {pendingPromotionsCount > 0 && (
        <span class="absolute top-0.5 right-2.5 min-w-[16px] h-4 px-1 rounded-full bg-amber-200 text-amber-950 text-[10px] font-mono font-bold flex items-center justify-center leading-none">
          {pendingPromotionsCount > 99 ? '99+' : pendingPromotionsCount}
        </span>
      )}
    </button>
  )}

  {!isSuper && (
    <button
      type="button"
      role="tab"
      aria-selected="false"
      aria-controls="panel-zones"
      data-admin-tab="zones"
      data-admin-label="Sebaran Wilayah"
      class="min-h-[44px] px-1 flex flex-col items-center justify-center gap-0.5 rounded-lg font-semibold text-slate-600 aria-selected:text-emerald-700 aria-selected:bg-emerald-50/70 transition cursor-pointer"
    >
      <AppIcon name="map-pin" size="sm" />
      <span class="truncate max-w-full">Peta</span>
    </button>
  )}
</nav>
