---
import AppIcon from '../common/AppIcon.astro';
import { safeJsonLd } from '../../../lib/security';

interface Zone {
  id: number;
  name: string;
  slug: string;
  type?: 'daratan' | 'kepulauan' | string;
  count?: number;
}

interface StoreVerificationRow {
  id: number;
  name: string;
  zone_id: number;
  product_count?: number;
}

interface Props {
  zones: Zone[];
  allStores?: StoreVerificationRow[];
}

const { zones, allStores = [] } = Astro.props;

const SUMENEP_ZONE_GEO: Record<
  string,
  { lat: number; lng: number; type: 'daratan' | 'kepulauan'; highlight: string }
> = {
  'mwc-kota-sumenep': { lat: -6.9950, lng: 113.8650, type: 'daratan', highlight: 'Pusat Kota, Keraton Sumenep, & Sentra Kuliner Madura' },
  'mwc-batuan': { lat: -7.0180, lng: 113.8420, type: 'daratan', highlight: 'Sentra Olahan Makanan, Keripik, & Pertanian' },
  'mwc-kalianget': { lat: -7.0420, lng: 113.9160, type: 'daratan', highlight: 'Pelabuhan Kalianget, Garam Rakyat, & Perikanan' },
  'mwc-manding': { lat: -6.9380, lng: 113.8450, type: 'daratan', highlight: 'Sentra Anyaman Tikar Pandan & Palawija' },
  'mwc-gapura': { lat: -6.9850, lng: 113.9520, type: 'daratan', highlight: 'Sentra Rengginang Lorjuk, Kerupuk Ikan, & Terasi' },
  'mwc-bluto': { lat: -7.0850, lng: 113.8050, type: 'daratan', highlight: 'Kampung Pembuat Keris Tradisional & Pandai Besi' },
  'mwc-saronggi': { lat: -7.0720, lng: 113.8450, type: 'daratan', highlight: 'Budidaya Rumput Laut & Perikanan Tambak' },
  'mwc-lenteng': { lat: -7.0350, lng: 113.7850, type: 'daratan', highlight: 'Industri Genteng Tradisional & Makanan Ringan' },
  'mwc-guluk-guluk': { lat: -7.0250, lng: 113.6350, type: 'daratan', highlight: 'Pesantren Bersejarah Annuqayah & Perkebunan Tembakau' },
  'mwc-ganding': { lat: -7.0280, lng: 113.7050, type: 'daratan', highlight: 'Sentra Seni Ukir Kayu, Mebel, & Hasil Bumi' },
  'mwc-pragaan': { lat: -7.1250, lng: 113.6750, type: 'daratan', highlight: 'Pesisir Selatan Madura, Garam, & Kerupuk Ikan' },
  'mwc-ambunten': { lat: -6.8920, lng: 113.7250, type: 'daratan', highlight: 'Sentra Teri Nasi (Crispy), Rengginang, & Hasil Nelayan' },
  'mwc-pasongsongan': { lat: -6.8950, lng: 113.6250, type: 'daratan', highlight: 'Pendaratan Perahu Nelayan Laut Jawa & Ikan Asin' },
  'mwc-rubaru': { lat: -6.9450, lng: 113.7750, type: 'daratan', highlight: 'Sentra Komoditas Unggulan Bawang Merah Rubaru' },
  'mwc-dasuk': { lat: -6.8980, lng: 113.8150, type: 'daratan', highlight: 'Sentra Gula Merah Aren, Kelapa, & Buah Siwalan' },
  'mwc-dungkek': { lat: -6.9550, lng: 114.0450, type: 'daratan', highlight: 'Ujung Timur Madura, Oksigen Gili Iyang, & Ikan Tangkap' },
  'mwc-batang-batang': { lat: -6.9250, lng: 113.9950, type: 'daratan', highlight: 'Kawasan Wisata Pantai Lombang & Anyaman Daun Lontar' },
  'mwc-batuputih': { lat: -6.8850, lng: 113.8950, type: 'daratan', highlight: 'Perkebunan Mete, Asam Jawa, & Peternakan Sapi' },
  'mwc-talango': { lat: -7.0650, lng: 113.9750, type: 'kepulauan', highlight: 'Pulau Poteran, Wisata Religi Asta Sayyid Yusuf' },
  'mwc-giligenting': { lat: -7.1950, lng: 113.9250, type: 'kepulauan', highlight: 'Pulau Giligenting & Gili Labak, Perikanan Bahari' },
  'mwc-nonggunong': { lat: -7.0850, lng: 114.3550, type: 'kepulauan', highlight: 'Pulau Sapudi Bagian Utara, Budidaya Rumput Laut' },
  'mwc-raas': { lat: -7.1450, lng: 114.5650, type: 'kepulauan', highlight: 'Pulau Raas, Pengrajin Perahu & Kucing Busok Raas' },
  'mwc-arjasa': { lat: -6.8550, lng: 115.3050, type: 'kepulauan', highlight: 'Pulau Kangean, Sentra Niaga & Komoditas Kepulauan' },
  'mwc-sapeken': { lat: -7.0050, lng: 115.7050, type: 'kepulauan', highlight: 'Gugusan Terumbu Karang, Budidaya Kerapu & Lobster' },
};

const storeCountByZone = new Map<number, number>();
const productCountByZone = new Map<number, number>();

allStores.forEach((s) => {
  storeCountByZone.set(s.zone_id, (storeCountByZone.get(s.zone_id) || 0) + 1);
  productCountByZone.set(s.zone_id, (productCountByZone.get(s.zone_id) || 0) + (s.product_count || 0));
});

const enrichedZones = zones.map((z) => {
  const geo = SUMENEP_ZONE_GEO[z.slug] || {
    lat: -7.0167,
    lng: 113.8667,
    type: 'daratan',
    highlight: 'Kawasan MWC NU Kabupaten Sumenep',
  };

  const storeCount = storeCountByZone.get(z.id) || 0;
  const productCount = productCountByZone.get(z.id) || (z.count || 0);

  return {
    ...z,
    lat: geo.lat,
    lng: geo.lng,
    type: geo.type,
    highlight: geo.highlight,
    storeCount,
    productCount,
  };
});

const daratan = enrichedZones.filter((z) => z.type === 'daratan');
const kepulauan = enrichedZones.filter((z) => z.type === 'kepulauan');

const totalStores = enrichedZones.reduce((acc, z) => acc + z.storeCount, 0);
const totalProducts = enrichedZones.reduce((acc, z) => acc + z.productCount, 0);
const zonesWithStores = enrichedZones.filter((z) => z.storeCount > 0).length;
---

<section id="panel-zones" class="admin-tab-panel w-full min-w-0 max-w-full overflow-x-clip hidden">
  {/* Hairline Operational Metric Strip: Horizontal Scroll on Mobile, 4-Col Grid on Desktop */}
  <div
    tabindex="0"
    role="region"
    aria-label="Ringkasan statistik wilayah"
    class="flex lg:grid lg:grid-cols-4 w-full max-w-full overflow-x-auto no-scrollbar snap-x snap-mandatory divide-x divide-slate-200 border-b border-slate-200 bg-white"
  >
    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Wilayah MWC</span>
      <div class="mt-0.5 flex items-baseline gap-1.5 whitespace-nowrap">
        <span class="text-xl font-bold text-slate-900 font-mono tabular-nums">{enrichedZones.length}</span>
        <span class="text-[11px] text-emerald-700 font-semibold font-mono tabular-nums">{daratan.length}D / {kepulauan.length}P</span>
      </div>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Toko Terdata</span>
      <span class="mt-0.5 text-xl font-bold text-emerald-700 font-mono tabular-nums block">{totalStores}</span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">Produk Aktif</span>
      <span class="mt-0.5 text-xl font-bold text-slate-900 font-mono tabular-nums block">{totalProducts}</span>
    </div>

    <div class="shrink-0 min-w-[160px] sm:min-w-[190px] lg:min-w-0 snap-start px-4 sm:px-6 lg:px-8 py-3.5 sm:py-4">
      <span class="text-xs font-medium text-slate-600 block whitespace-nowrap">MWC Terisi</span>
      <div class="mt-0.5 flex items-baseline gap-1 whitespace-nowrap">
        <span class="text-xl font-bold text-emerald-800 font-mono tabular-nums">{zonesWithStores}</span>
        <span class="text-xs text-slate-600 font-mono tabular-nums">/ {enrichedZones.length}</span>
      </div>
    </div>
  </div>

  {/* Map Filter & Action Toolbar */}
  <div class="px-4 sm:px-6 lg:px-8 py-3.5 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-50/40">
    <div class="w-full sm:w-auto flex items-center gap-1.5 p-1 bg-slate-100 border border-slate-200 rounded-lg text-xs font-semibold overflow-x-auto no-scrollbar">
      <button
        type="button"
        id="btn-filter-all"
        class="zone-filter-btn min-h-[40px] sm:min-h-[34px] py-1 px-3 rounded-md bg-white text-slate-900 border border-slate-200 transition cursor-pointer whitespace-nowrap shrink-0"
        data-filter="all"
      >
        Semua ({enrichedZones.length})
      </button>
      <button
        type="button"
        id="btn-filter-daratan"
        class="zone-filter-btn min-h-[40px] sm:min-h-[34px] py-1 px-3 rounded-md text-slate-600 hover:text-slate-900 transition cursor-pointer whitespace-nowrap shrink-0"
        data-filter="daratan"
      >
        Daratan ({daratan.length})
      </button>
      <button
        type="button"
        id="btn-filter-kepulauan"
        class="zone-filter-btn min-h-[40px] sm:min-h-[34px] py-1 px-3 rounded-md text-slate-600 hover:text-slate-900 transition cursor-pointer whitespace-nowrap shrink-0"
        data-filter="kepulauan"
      >
        Kepulauan ({kepulauan.length})
      </button>
    </div>

    <div class="grid grid-cols-2 sm:flex items-center gap-2 w-full sm:w-auto shrink-0">
      <button
        type="button"
        id="btn-recenter-map"
        class="min-h-[44px] sm:min-h-[38px] py-1.5 px-3 bg-white hover:bg-slate-50 border border-slate-300 text-slate-700 hover:text-slate-900 text-xs font-semibold rounded-lg transition inline-flex items-center justify-center gap-1.5 cursor-pointer"
      >
        <AppIcon name="map-pin" size="xs" />
        <span>Pusatkan</span>
      </button>

      <a
        href="https://www.google.com/maps/search/?api=1&query=Kabupaten+Sumenep+Madura"
        target="_blank"
        rel="noopener noreferrer"
        class="min-h-[44px] sm:min-h-[38px] py-1.5 px-3 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-semibold rounded-lg transition inline-flex items-center justify-center gap-1.5"
      >
        <AppIcon name="globe" size="xs" />
        <span>Google Maps</span>
        <AppIcon name="external-link" size="xs" />
      </a>
    </div>
  </div>

  {/* Leaflet Interactive Map Container */}
  <div class="relative w-full overflow-hidden border-b border-slate-200 bg-slate-100">
    <div id="zones-leaflet-map" class="w-full h-[300px] sm:h-[460px] z-0"></div>

    {/* Map Overlay Legend (Desktop) */}
    <div class="hidden sm:block absolute bottom-3 left-3 z-10 bg-white/95 backdrop-blur-md border border-slate-200 rounded-lg p-2.5 shadow-sm text-xs space-y-1.5 pointer-events-auto">
      <p class="font-bold text-slate-800 leading-tight">Legenda Peta MWC NU:</p>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-emerald-700 border border-emerald-900"></span>
        <span class="text-slate-700">MWC Daratan ({daratan.length})</span>
      </div>
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-teal-700 border border-teal-900"></span>
        <span class="text-slate-700">MWC Kepulauan ({kepulauan.length})</span>
      </div>
      <p id="map-tile-fallback" class="hidden text-xs text-amber-800 font-semibold pt-1 border-t border-slate-200">
        Ubin peta eksternal tidak termuat. Gunakan daftar wilayah MWC di bawah.
      </p>
    </div>
  </div>

  {/* Detailed Zone Directory (Daratan & Kepulauan) */}
  <div class="divide-y divide-slate-200">
    {/* Daratan */}
    <div id="container-daratan">
      <div class="px-4 sm:px-6 lg:px-8 py-3 border-b border-slate-200 bg-white flex items-center justify-between">
        <div class="flex items-center gap-2">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800">
            Wilayah Daratan (<span class="font-mono tabular-nums">{daratan.length}</span> MWC)
          </h2>
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200">
            Daratan Madura
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 divide-y sm:divide-y-0 sm:gap-px sm:bg-slate-200 border-b border-slate-200">
        {daratan.map((z) => (
          <div
            id={`card-zone-${z.slug}`}
            class="zone-card bg-white p-4 transition space-y-3 group"
          >
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <h3 class="font-bold text-sm text-slate-900 group-hover:text-emerald-700 transition truncate">
                  {z.name}
                </h3>
                <p class="text-xs text-slate-600 mt-0.5 line-clamp-1" title={z.highlight}>
                  {z.highlight}
                </p>
              </div>
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700 shrink-0">
                Daratan
              </span>
            </div>

            <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs gap-2">
              <div class="flex items-center gap-2 text-slate-600 font-medium font-mono tabular-nums">
                <span><strong class="text-slate-900">{z.storeCount}</strong> Toko</span>
                <span aria-hidden="true">/</span>
                <span><strong class="text-slate-900">{z.productCount}</strong> Produk</span>
              </div>

              <div class="flex items-center gap-1.5 shrink-0">
                <button
                  type="button"
                  class="btn-fly-zone inline-flex items-center gap-1 min-h-[44px] sm:min-h-[36px] text-emerald-800 hover:text-emerald-950 font-semibold px-2.5 py-1 rounded-lg bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition cursor-pointer"
                  data-lat={z.lat}
                  data-lng={z.lng}
                  data-slug={z.slug}
                  title="Lihat posisi pin di peta"
                >
                  <AppIcon name="map-pin" size="xs" />
                  <span>Peta</span>
                </button>

                <a
                  href={`/?zona=${z.slug}`}
                  target="_blank"
                  class="inline-flex items-center gap-1 min-h-[44px] sm:min-h-[36px] text-slate-700 hover:text-emerald-800 font-semibold px-2.5 py-1 rounded-lg bg-white hover:bg-slate-50 border border-slate-300 transition"
                  title="Buka katalog produk MWC ini"
                >
                  <span>Katalog</span>
                  <AppIcon name="external-link" size="xs" />
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* Kepulauan */}
    <div id="container-kepulauan">
      <div class="px-4 sm:px-6 lg:px-8 py-3 border-b border-slate-200 bg-white flex items-center justify-between">
        <div class="flex items-center gap-2">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-800">
            Wilayah Kepulauan (<span class="font-mono tabular-nums">{kepulauan.length}</span> MWC)
          </h2>
          <span class="text-xs font-semibold px-2 py-0.5 rounded bg-teal-50 text-teal-800 border border-teal-200">
            Gugusan Pulau
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 divide-y sm:divide-y-0 sm:gap-px sm:bg-slate-200 border-b border-slate-200">
        {kepulauan.map((z) => (
          <div
            id={`card-zone-${z.slug}`}
            class="zone-card bg-white p-4 transition space-y-3 group"
          >
            <div class="flex items-start justify-between gap-2">
              <div class="min-w-0">
                <h3 class="font-bold text-sm text-slate-900 group-hover:text-teal-700 transition truncate">
                  {z.name}
                </h3>
                <p class="text-xs text-slate-600 mt-0.5 line-clamp-1" title={z.highlight}>
                  {z.highlight}
                </p>
              </div>
              <span class="text-xs font-semibold px-2 py-0.5 rounded bg-teal-50 text-teal-800 border border-teal-200 shrink-0">
                Kepulauan
              </span>
            </div>

            <div class="pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs gap-2">
              <div class="flex items-center gap-2 text-slate-600 font-medium font-mono tabular-nums">
                <span><strong class="text-slate-900">{z.storeCount}</strong> Toko</span>
                <span aria-hidden="true">/</span>
                <span><strong class="text-slate-900">{z.productCount}</strong> Produk</span>
              </div>

              <div class="flex items-center gap-1.5 shrink-0">
                <button
                  type="button"
                  class="btn-fly-zone inline-flex items-center gap-1 min-h-[44px] sm:min-h-[36px] text-teal-800 hover:text-teal-950 font-semibold px-2.5 py-1 rounded-lg bg-teal-50 hover:bg-teal-100 border border-teal-200 transition cursor-pointer"
                  data-lat={z.lat}
                  data-lng={z.lng}
                  data-slug={z.slug}
                  title="Lihat posisi pin di peta"
                >
                  <AppIcon name="map-pin" size="xs" />
                  <span>Peta</span>
                </button>

                <a
                  href={`/?zona=${z.slug}`}
                  target="_blank"
                  class="inline-flex items-center gap-1 min-h-[44px] sm:min-h-[36px] text-slate-700 hover:text-emerald-800 font-semibold px-2.5 py-1 rounded-lg bg-white hover:bg-slate-50 border border-slate-300 transition"
                  title="Buka katalog produk MWC ini"
                >
                  <span>Katalog</span>
                  <AppIcon name="external-link" size="xs" />
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  {/* Raw Zones Geo Data for Client Script */}
  <script id="zones-geo-data-json" type="application/json" set:html={safeJsonLd(enrichedZones)} />
</section>

<style is:global>
  .mamasar-map-pin {
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .mamasar-pin-inner {
    width: 28px;
    height: 28px;
    border-radius: 9999px;
    background: #047857;
    color: #ffffff;
    font-size: 11px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #ffffff;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.25);
    transition: transform 0.15s ease;
  }
  .mamasar-pin-inner.kepulauan {
    background: #0f766e;
  }
  .mamasar-pin-inner:hover {
    transform: scale(1.2);
  }
  .leaflet-popup-content-wrapper {
    border-radius: 12px;
    padding: 0;
    overflow: hidden;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.15);
    border: 1px solid #e2e8f0;
  }
  .leaflet-popup-content {
    margin: 0;
    line-height: 1.4;
  }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';

  let mapInstance: L.Map | null = null;
  const markersMap = new Map<string, L.CircleMarker>();

  function escapePopupHtml(value: unknown): string {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function initZonesMap() {
    const mapContainer = document.getElementById('zones-leaflet-map');
    const jsonEl = document.getElementById('zones-geo-data-json');
    if (!mapContainer || !jsonEl) return;

    if (mapInstance) {
      mapInstance.invalidateSize();
      return;
    }

    let zonesData: Array<{
      name: string;
      slug: string;
      lat: number;
      lng: number;
      type: string;
      highlight?: string;
      storeCount: number;
      productCount: number;
    }> = [];
    try {
      zonesData = JSON.parse(jsonEl.textContent || '[]');
    } catch {
      zonesData = [];
    }

    const sumenepCenter: [number, number] = [-7.0167, 113.8667];
    mapInstance = L.map('zones-leaflet-map', {
      center: sumenepCenter,
      zoom: 10,
      zoomControl: true,
      scrollWheelZoom: true,
    });

    const tileLayer = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener noreferrer">OpenStreetMap</a> contributors',
    }).addTo(mapInstance);

    tileLayer.on('tileerror', () => {
      document.getElementById('map-tile-fallback')?.classList.remove('hidden');
    });

    zonesData.forEach((z) => {
      const isKepulauan = z.type === 'kepulauan';
      const marker = L.circleMarker([z.lat, z.lng], {
        radius: Math.min(14, 7 + Math.min(z.storeCount, 7)),
        fillColor: isKepulauan ? '#0f766e' : '#047857',
        color: '#ffffff',
        weight: 2,
        opacity: 1,
        fillOpacity: 0.9,
      });

      const popupHtml = `
        <div class="p-3.5 space-y-2 text-slate-900 min-w-[220px]">
          <div class="flex items-center justify-between gap-2 border-b border-slate-100 pb-1.5">
            <h4 class="font-bold text-xs text-slate-900">${escapePopupHtml(z.name)}</h4>
            <span class="text-xs font-semibold px-1.5 py-0.5 rounded ${
              isKepulauan ? 'bg-teal-50 text-teal-800 border border-teal-200' : 'bg-emerald-50 text-emerald-800 border border-emerald-200'
            }">${isKepulauan ? 'Kepulauan' : 'Daratan'}</span>
          </div>
          <p class="text-xs text-slate-600 leading-snug">${escapePopupHtml(z.highlight || 'Wilayah MWC NU Sumenep')}</p>
          <div class="pt-1.5 border-t border-slate-100 flex items-center justify-between text-xs text-slate-600 font-semibold font-mono tabular-nums">
            <span>${Number(z.storeCount) || 0} Toko</span>
            <span>${Number(z.productCount) || 0} Produk</span>
          </div>
          <div class="pt-1 flex items-center gap-1.5">
            <a href="/?zona=${encodeURIComponent(z.slug)}" target="_blank" rel="noopener noreferrer" class="flex-1 min-h-[34px] py-1 px-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-lg text-center font-semibold text-xs transition inline-flex items-center justify-center">
              <span>Katalog Wilayah</span>
            </a>
            <a href="https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(z.name + ' Sumenep')}" target="_blank" rel="noopener noreferrer" class="min-h-[34px] py-1 px-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-center font-semibold text-xs transition inline-flex items-center justify-center">
              <span>Rute</span>
            </a>
          </div>
        </div>
      `;

      marker.addTo(mapInstance!).bindPopup(popupHtml);
      markersMap.set(z.slug, marker);
    });

    const btnRecenter = document.getElementById('btn-recenter-map');
    btnRecenter?.addEventListener('click', () => {
      if (mapInstance) {
        mapInstance.flyTo(sumenepCenter, 10, { duration: 1 });
      }
    });

    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.zone-filter-btn');
    const containerDaratan = document.getElementById('container-daratan');
    const containerKepulauan = document.getElementById('container-kepulauan');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filterType = btn.getAttribute('data-filter');

        filterBtns.forEach((b) => {
          b.classList.remove('bg-white', 'text-slate-900', 'border', 'border-slate-200');
          b.classList.add('text-slate-600');
        });
        btn.classList.add('bg-white', 'text-slate-900', 'border', 'border-slate-200');
        btn.classList.remove('text-slate-600');

        if (filterType === 'all') {
          containerDaratan?.classList.remove('hidden');
          containerKepulauan?.classList.remove('hidden');
        } else if (filterType === 'daratan') {
          containerDaratan?.classList.remove('hidden');
          containerKepulauan?.classList.add('hidden');
        } else if (filterType === 'kepulauan') {
          containerDaratan?.classList.add('hidden');
          containerKepulauan?.classList.remove('hidden');
        }

        if (!mapInstance) return;
        if (filterType === 'daratan') {
          mapInstance.flyTo([-6.9950, 113.8650], 11, { duration: 1 });
        } else if (filterType === 'kepulauan') {
          mapInstance.flyTo([-6.9500, 115.0000], 9, { duration: 1 });
        } else {
          mapInstance.flyTo(sumenepCenter, 10, { duration: 1 });
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.btn-fly-zone').forEach((btn) => {
      btn.addEventListener('click', () => {
        const lat = Number(btn.getAttribute('data-lat'));
        const lng = Number(btn.getAttribute('data-lng'));
        const slug = btn.getAttribute('data-slug');

        if (mapInstance && !Number.isNaN(lat) && !Number.isNaN(lng)) {
          mapContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
          mapInstance.flyTo([lat, lng], 13, { duration: 1.2 });

          setTimeout(() => {
            const marker = markersMap.get(slug || '');
            if (marker) marker.openPopup();
          }, 1300);
        }
      });
    });
  }

  window.addEventListener('hashchange', () => {
    if (window.location.hash === '#zones') {
      setTimeout(() => {
        if (!mapInstance) {
          initZonesMap();
        } else {
          mapInstance.invalidateSize();
        }
      }, 100);
    }
  });

  document.querySelectorAll('[data-admin-tab="zones"]').forEach((btn) => {
    btn.addEventListener('click', () => {
      setTimeout(() => {
        if (!mapInstance) {
          initZonesMap();
        } else {
          mapInstance.invalidateSize();
        }
      }, 100);
    });
  });

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      setTimeout(initZonesMap, 250);
    });
  } else {
    setTimeout(initZonesMap, 250);
  }
</script>
