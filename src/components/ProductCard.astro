---
import type { Product } from '../lib/db';
import { formatRupiah, createProductWhatsAppUrl } from '../lib/utils';

interface Props {
  product: Product;
  badge?: string;
  badgeColor?: 'indigo' | 'amber' | 'emerald' | 'rose';
  isSoldOut?: boolean;
  sellerAvatar?: string;
  photoCount?: number;
  views?: number;
  compact?: boolean;
}

const {
  product,
  badge,
  badgeColor = 'indigo',
  isSoldOut = Boolean(product.is_sold_out),
  sellerAvatar,
  photoCount = 2,
  views = product.views || 85,
  compact = false,
} = Astro.props;

const waLink = createProductWhatsAppUrl({
  phone: product.umkm_phone,
  storeName: product.umkm_name,
  productName: product.name,
  price: product.price,
});

const badgeStyles: Record<string, string> = {
  indigo: 'bg-[#4f46e5] text-white',
  amber: 'bg-amber-400 text-slate-950 font-black',
  emerald: 'bg-emerald-600 text-white',
  rose: 'bg-rose-600 text-white',
};
---

<article
  class={`bg-white border border-slate-200 rounded-xl overflow-hidden shadow-xs hover:border-slate-300 hover:shadow-md transition duration-200 flex flex-col justify-between group relative ${
    isSoldOut ? 'opacity-90' : ''
  }`}
>
  <!-- Card Top Media & Details -->
  <div>
    <!-- Image with Aspect Ratio & Overlays (OsClass Classified Signature) -->
    <a
      href={`/p/${product.slug}`}
      class="block relative aspect-4/3 sm:aspect-16/10 bg-slate-100 overflow-hidden"
    >
      <img
        src={product.image_url}
        alt={product.name}
        loading="lazy"
        class={`w-full h-full object-cover group-hover:scale-105 transition duration-300 ${
          isSoldOut ? 'grayscale-40' : ''
        }`}
      />

      <!-- Diagonal "HABIS / SOLD" Ribbon (OsClass Style) -->
      {isSoldOut && (
        <div class="absolute -left-10 top-5 -rotate-45 bg-rose-600 text-white font-black text-[9px] sm:text-[10px] uppercase tracking-wider py-1 w-36 text-center shadow-md z-20 pointer-events-none">
          Habis
        </div>
      )}

      <!-- Seller Avatar Overlay (Top-Left, OsClass "Most favorited listings" Style) -->
      {sellerAvatar && !isSoldOut && (
        <div class="absolute top-2 left-2 z-10 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/95 border-2 border-indigo-500 text-indigo-700 flex items-center justify-center font-bold text-xs shadow-md">
          {sellerAvatar}
        </div>
      )}

      <!-- Top Badge (Pilihan, Premium, Offer of the Day) -->
      {badge && !sellerAvatar && !isSoldOut && (
        <div class="absolute top-2 left-2 z-10">
          <span
            class={`text-[9px] sm:text-[10px] font-bold px-2 py-0.5 rounded shadow-xs tracking-wide ${
              badgeStyles[badgeColor] || badgeStyles.indigo
            }`}
          >
            {badge}
          </span>
        </div>
      )}

      <!-- Warga NU Badge Top-Right -->
      <div class="absolute top-2 right-2 z-10">
        <span class="bg-white/95 backdrop-blur-xs text-emerald-800 border border-emerald-300 text-[9px] font-bold px-1.5 py-0.5 rounded shadow-xs">
          Warga NU
        </span>
      </div>

      <!-- Price Overlay Bar at Bottom of Image (OsClass Epsilon Signature) -->
      <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/90 via-black/50 to-transparent pt-6 pb-2 px-2.5 sm:px-3 flex items-end justify-between">
        <span class="text-sm sm:text-base font-black text-white drop-shadow-sm tracking-tight">
          {formatRupiah(product.price)}
        </span>
        <span class="text-[10px] text-white font-bold bg-black/50 px-1.5 py-0.5 rounded flex items-center gap-1 shadow-xs">
          📷 {photoCount}
        </span>
      </div>
    </a>

    <!-- Card Body: Classified Meta, Title, Seller -->
    <div class="p-2.5 sm:p-3 space-y-1">
      <!-- Location (OsClass Sub-Title Style) -->
      <div class="text-[10px] sm:text-[11px] text-slate-500 flex items-center gap-1 truncate font-medium">
        <span>📍</span>
        <span class="truncate">{product.zone_name}, Sumenep</span>
      </div>

      <!-- Listing Title -->
      <a
        href={`/p/${product.slug}`}
        class="font-bold text-xs sm:text-[13px] text-slate-900 line-clamp-2 group-hover:text-emerald-700 leading-snug block"
        title={product.name}
      >
        {product.name}
      </a>

      <!-- Classified Meta: Category & Views -->
      <div class="text-[10px] text-slate-500 flex items-center justify-between pt-0.5 truncate">
        <span class="truncate">{product.category}</span>
        <span class="shrink-0">{views} dilihat</span>
      </div>

      <!-- Seller Identity Strip -->
      <div class="pt-1.5 border-t border-slate-100 flex items-center justify-between text-[11px]">
        <span class="text-slate-600 font-medium truncate text-[11px]">{product.umkm_name}</span>
        <span class="text-emerald-600 text-xs shrink-0 font-bold" title="Terverifikasi Nahdliyin">✓</span>
      </div>
    </div>
  </div>

  <!-- Card Action Bottom: Classified WhatsApp CTA -->
  <div class="p-2.5 sm:p-3 pt-0">
    <a
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Hubungi WhatsApp ${product.umkm_name} untuk produk ${product.name}`}
      class="w-full py-1.5 sm:py-2 px-2.5 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white rounded-lg text-xs font-bold flex items-center justify-center gap-1.5 shadow-xs transition active:scale-98"
    >
      <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"></path>
      </svg>
      <span>Chat Penjual</span>
    </a>
  </div>
</article>
