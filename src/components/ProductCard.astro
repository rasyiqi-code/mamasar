---
import type { Product } from '../lib/db';
import { formatRupiah, createProductWhatsAppUrl } from '../lib/utils';
import BadgeVerified from './BadgeVerified.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;

const waLink = createProductWhatsAppUrl({
  phone: product.umkm_phone,
  storeName: product.umkm_name,
  productName: product.name,
  price: product.price,
});
---

<article
  class="bg-white border border-slate-200/90 rounded-xl sm:rounded-2xl overflow-hidden shadow-xs hover:shadow-md md:hover:-translate-y-1 transition duration-200 flex flex-col justify-between group"
>
  <!-- Card Media & Details -->
  <div>
    <!-- Image with 1:1 Aspect Ratio -->
    <a href={`/p/${product.slug}`} class="block relative aspect-square bg-slate-100 overflow-hidden">
      <img
        src={product.image_url}
        alt={product.name}
        loading="lazy"
        class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
      />
      <!-- Location Chip -->
      <span
        class="absolute top-1.5 left-1.5 sm:top-2 sm:left-2 bg-slate-900/80 backdrop-blur-xs text-white text-[9px] sm:text-[10px] font-bold px-1.5 sm:px-2 py-0.5 rounded-md shadow-xs"
      >
        {product.zone_name.replace('MWC ', '')}
      </span>
    </a>

    <!-- Card Body -->
    <div class="p-2.5 sm:p-3.5 space-y-1 sm:space-y-1.5">
      <div>
        <BadgeVerified label="Warga NU" size="sm" />
      </div>
      <a
        href={`/p/${product.slug}`}
        class="font-bold text-xs sm:text-sm text-slate-800 line-clamp-2 hover:text-emerald-700 leading-snug block"
      >
        {product.name}
      </a>
      <span class="text-[11px] sm:text-xs text-slate-500 truncate block">
        {product.umkm_name}
      </span>
    </div>
  </div>

  <!-- Card Action Bottom (Price + WA Button) -->
  <div class="p-2.5 sm:p-3.5 pt-0 space-y-2">
    <span class="text-xs sm:text-sm font-black text-emerald-700 block">
      {formatRupiah(product.price)}
    </span>

    <a
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Hubungi WhatsApp ${product.umkm_name} untuk produk ${product.name}`}
      class="w-full py-2 px-2 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white rounded-lg sm:rounded-xl text-[11px] sm:text-xs font-bold flex items-center justify-center gap-1.5 shadow-xs transition active:scale-98"
    >
      <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"></path>
      </svg>
      <span>Chat WA</span>
    </a>
  </div>
</article>
