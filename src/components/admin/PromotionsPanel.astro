---
import { formatRupiah } from '../../lib/utils';
import type { AdPromotion } from '../../lib/modules/types';

interface Props {
  pendingPromotions: AdPromotion[];
}

const { pendingPromotions } = Astro.props;

function getPackageLabel(type: string) {
  switch (type) {
    case 'featured_7d':
      return { label: 'Slot Unggulan 7 Hari', badge: 'bg-amber-100 text-amber-950 border-amber-300', isFeatured: true };
    case 'featured_14d':
      return { label: 'Slot Unggulan 14 Hari', badge: 'bg-amber-100 text-amber-950 border-amber-300', isFeatured: true };
    case 'featured_30d':
      return { label: 'Slot Unggulan 30 Hari', badge: 'bg-amber-100 text-amber-950 border-amber-300', isFeatured: true };
    case 'bump_pack_5':
      return { label: 'Paket 5x Token Sundul', badge: 'bg-emerald-100 text-emerald-950 border-emerald-300', isFeatured: false };
    case 'bump_pack_12':
      return { label: 'Paket 12x Token Sundul', badge: 'bg-emerald-100 text-emerald-950 border-emerald-300', isFeatured: false };
    case 'bump_pack_30':
      return { label: 'Paket 30x Token Sundul', badge: 'bg-emerald-100 text-emerald-950 border-emerald-300', isFeatured: false };
    default:
      return { label: type, badge: 'bg-slate-100 text-slate-800 border-slate-300', isFeatured: false };
  }
}

const totalPendingAmount = pendingPromotions.reduce((sum, p) => sum + p.amount, 0);
---

<section id="panel-promotions" class="admin-tab-panel hidden space-y-6">
  <!-- Header & KPI -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
    <div>
      <div class="flex items-center gap-2">
        <h2 class="text-lg font-bold text-slate-900">Moderasi Iklan & Promosi Berbayar</h2>
        <span class="text-xs font-bold px-2 py-0.5 rounded-full bg-amber-100 text-amber-900 border border-amber-300">
          {pendingPromotions.length} Antrean
        </span>
      </div>
      <p class="text-xs text-slate-500 mt-1">
        Verifikasi bukti transfer / QRIS infaq promosi untuk mengaktifkan Slot Unggulan dan kuota token sundul toko warga.
      </p>
    </div>

    <div class="flex items-center gap-3">
      <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-right">
        <span class="text-[10px] uppercase font-bold text-slate-400 block tracking-wider">Total Nilai Infaq Pending</span>
        <span class="text-sm font-black font-mono text-emerald-700">{formatRupiah(totalPendingAmount)}</span>
      </div>
    </div>
  </div>

  <!-- Status Alert inside panel -->
  <div id="promo-review-alert" class="hidden p-3 rounded-xl text-xs font-semibold"></div>

  <!-- Pending Orders List -->
  {pendingPromotions.length > 0 ? (
    <div class="space-y-3">
      {pendingPromotions.map((promo) => {
        const pkgInfo = getPackageLabel(promo.type);
        const dateStr = new Date(promo.created_at).toLocaleDateString('id-ID', {
          day: 'numeric',
          month: 'short',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
        });

        return (
          <div class="p-4 rounded-xl border border-slate-200 bg-white hover:border-slate-300 transition flex flex-col md:flex-row items-start md:items-center justify-between gap-4 shadow-2xs">
            <!-- Left & Details -->
            <div class="flex items-start gap-4 min-w-0">
              <!-- Bukti Transfer Thumbnail -->
              <div class="shrink-0">
                {promo.proof_image_url ? (
                  <a
                    href={promo.proof_image_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block group relative"
                    title="Klik untuk melihat bukti ukuran penuh"
                  >
                    <img
                      src={promo.proof_image_url}
                      alt="Bukti Transfer"
                      class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl object-cover border border-slate-200 group-hover:opacity-90 shadow-2xs"
                    />
                    <span class="absolute inset-0 bg-slate-900/40 rounded-xl opacity-0 group-hover:opacity-100 transition flex items-center justify-center text-white text-[10px] font-bold">
                      Lihat ➔
                    </span>
                  </a>
                ) : (
                  <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-xl bg-slate-100 border border-slate-200 flex flex-col items-center justify-center text-slate-400 text-[10px] text-center p-1 font-semibold">
                    <span>Tanpa Bukti</span>
                  </div>
                )}
              </div>

              <!-- Information Details -->
              <div class="min-w-0 space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <span class={`text-[10px] font-bold px-2 py-0.5 rounded border ${pkgInfo.badge}`}>
                    {pkgInfo.label}
                  </span>
                  <span class="text-xs font-bold text-slate-900 truncate">
                    {promo.umkm_name || 'Toko UMKM'}
                  </span>
                  {promo.user_email && (
                    <span class="text-[11px] text-slate-400 font-mono">({promo.user_email})</span>
                  )}
                </div>

                {pkgInfo.isFeatured && promo.product_name && (
                  <div class="text-xs text-slate-700 font-medium flex items-center gap-1.5">
                    <span class="text-slate-400">Produk yang diiklankan:</span>
                    {promo.product_slug ? (
                      <a
                        href={`/p/${promo.product_slug}`}
                        target="_blank"
                        class="font-bold text-emerald-800 hover:underline inline-flex items-center gap-0.5"
                      >
                        <span>{promo.product_name}</span>
                        <span class="text-[10px]">↗</span>
                      </a>
                    ) : (
                      <span class="font-bold text-slate-900">{promo.product_name}</span>
                    )}
                  </div>
                )}

                <div class="flex items-center gap-3 text-xs pt-0.5">
                  <span class="font-bold font-mono text-emerald-800">{formatRupiah(promo.amount)}</span>
                  <span class="text-slate-300">•</span>
                  <span class="text-[11px] text-slate-500 uppercase">{promo.payment_method}</span>
                  <span class="text-slate-300">•</span>
                  <span class="text-[11px] text-slate-400">{dateStr}</span>
                </div>

                {promo.notes && (
                  <p class="text-[11px] text-slate-500 italic bg-slate-50 p-1.5 rounded border border-slate-100 mt-1">
                    "{promo.notes}"
                  </p>
                )}
              </div>
            </div>

            <!-- Right: Review Action Buttons -->
            <div class="flex items-center gap-2 shrink-0 w-full md:w-auto pt-2 md:pt-0 border-t md:border-t-0 border-slate-100 justify-end">
              <button
                type="button"
                data-action="review-promo"
                data-order-id={promo.id}
                data-decision="reject"
                class="px-3 py-1.5 rounded-lg border border-rose-200 bg-rose-50 hover:bg-rose-100 text-rose-800 font-bold text-xs transition cursor-pointer"
              >
                Tolak
              </button>

              <button
                type="button"
                data-action="review-promo"
                data-order-id={promo.id}
                data-decision="approve"
                class="px-4 py-1.5 rounded-lg bg-emerald-700 hover:bg-emerald-800 active:bg-emerald-900 text-white font-bold text-xs transition shadow-xs cursor-pointer flex items-center gap-1.5"
              >
                <span>✓ Setujui & Aktifkan</span>
              </button>
            </div>
          </div>
        );
      })}
    </div>
  ) : (
    <div class="py-16 text-center rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50/50 space-y-2">
      <div class="w-12 h-12 mx-auto rounded-full bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-lg">
        ✓
      </div>
      <h3 class="text-sm font-bold text-slate-800">Tidak Ada Antrean Promosi Baru</h3>
      <p class="text-xs text-slate-500 max-w-sm mx-auto">
        Semua pesanan slot iklan unggulan dan paket token sundul telah diproses. Pengajuan baru dari toko akan muncul otomatis di sini.
      </p>
    </div>
  )}
</section>
