---
import type { AdminUserRow, PendingPetugasRow, Zone } from '../../lib/db';

interface Props {
  pendingPetugas: PendingPetugasRow[];
  allUsers: AdminUserRow[];
  zones: Zone[];
}

const { pendingPetugas, allUsers, zones } = Astro.props;

const ROLE_BADGES: Record<string, { label: string; cls: string }> = {
  pcnu: { label: 'Admin PCNU', cls: 'bg-rose-50 text-rose-800 border-rose-200' },
  mwcnu: { label: 'Pengurus MWC', cls: 'bg-indigo-50 text-indigo-800 border-indigo-200' },
  ranting: { label: 'Kader Ranting', cls: 'bg-emerald-50 text-emerald-800 border-emerald-200' },
  warga: { label: 'Warga', cls: 'bg-slate-100 text-slate-700 border-slate-200' },
};
---

<section id="panel-agents" class="admin-tab-panel space-y-8">
  <!-- Top Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-3 border-b border-slate-200">
    <div class="flex items-center gap-2.5 flex-wrap">
      <h2 class="text-base sm:text-lg font-bold text-slate-900">Manajemen Pengguna & Peran</h2>
      <span class="text-xs font-semibold px-2 py-0.5 rounded bg-amber-50 text-amber-900 border border-amber-200">
        {pendingPetugas.length} permohonan baru
      </span>
      <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-200">
        {allUsers.length} total akun
      </span>
    </div>
  </div>

  <!-- Section 1: Antrean Permohonan (Pending) -->
  <div class="space-y-3">
    <div class="flex items-center justify-between pb-2 border-b border-slate-200">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">
        1. Antrean Permohonan Kader / Pengurus ({pendingPetugas.length})
      </h3>
    </div>

    {pendingPetugas.length === 0 ? (
      <p class="text-xs text-slate-600 py-2">Tidak ada permohonan kader atau pengurus yang menunggu persetujuan saat ini.</p>
    ) : (
      <div class="divide-y divide-slate-200 border-b border-slate-200">
        {pendingPetugas.map((kader) => {
          const isMwcReq = kader.requested_role === 'mwcnu';
          return (
            <div class="py-3 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3 hover:bg-slate-50/60 px-1 transition">
              <div class="min-w-0 space-y-1">
                <div class="flex items-center gap-2 flex-wrap">
                  <strong class="font-bold text-sm text-slate-900">{kader.name}</strong>
                  <span class={`text-[11px] font-semibold px-2 py-0.5 rounded border ${
                    isMwcReq
                      ? 'bg-indigo-50 text-indigo-800 border-indigo-200'
                      : 'bg-emerald-50 text-emerald-800 border-emerald-200'
                  }`}>
                    {isMwcReq ? 'Ajukan: Pengurus MWC NU' : 'Ajukan: Kader Ranting'}
                  </span>
                  <span class="text-[11px] font-semibold text-slate-700 bg-slate-100 px-2 py-0.5 rounded">
                    📍 MWC {kader.zone_name || 'Sumenep'}
                  </span>
                  {kader.agent_ranting && (
                    <span class="text-[11px] font-semibold text-slate-700 bg-white px-2 py-0.5 rounded border border-slate-200">
                      Ranting {kader.agent_ranting}
                    </span>
                  )}
                </div>
                <div class="flex items-center gap-2 flex-wrap text-xs text-slate-600">
                  <span>{kader.agent_org || 'Kader NU'}</span>
                  <span>•</span>
                  <span class="font-mono">{kader.email}</span>
                </div>
              </div>

              <div class="flex items-center gap-2 flex-wrap shrink-0 w-full lg:w-auto">
                {kader.agent_phone && (
                  <a
                    href={`https://wa.me/${kader.agent_phone}?text=${encodeURIComponent(`Assalamu'alaikum Sahabat ${kader.name}, kami dari Admin PCNU Sumenep mengonfirmasi pengajuan peran di Mamasar untuk wilayah MWC ${kader.zone_name || 'Sumenep'}.`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center min-h-[36px] px-2.5 py-1 bg-white hover:bg-slate-50 text-slate-700 border border-slate-300 rounded text-xs font-medium transition"
                    title="Hubungi via WhatsApp"
                  >
                    💬 WA
                  </a>
                )}

                <select
                  aria-label={`Pilih peran persetujuan untuk ${kader.name}`}
                  data-role-select-for={kader.id}
                  class="min-h-[36px] bg-white border border-slate-300 rounded px-2 py-1 text-xs font-medium text-slate-900 focus:border-emerald-700 focus:outline-none"
                >
                  <option value="ranting" selected={!isMwcReq}>Setujui sbg Kader Ranting</option>
                  <option value="mwcnu" selected={isMwcReq}>Setujui sbg Pengurus MWC</option>
                </select>

                <button
                  type="button"
                  data-action="review-agent"
                  data-id={kader.id}
                  data-decision="approve"
                  class="min-h-[36px] py-1 px-3 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded transition cursor-pointer"
                >
                  ✓ Setujui
                </button>
                <button
                  type="button"
                  data-action="review-agent"
                  data-id={kader.id}
                  data-decision="reject"
                  class="min-h-[36px] py-1 px-3 bg-white hover:bg-rose-50 text-rose-700 border border-rose-300 font-semibold text-xs rounded transition cursor-pointer"
                >
                  ✕ Tolak
                </button>
              </div>
            </div>
          );
        })}
      </div>
    )}
  </div>

  <!-- Section 2: Daftarkan / Tetapkan Akun Peran Khusus (via Email) -->
  <div class="space-y-3 bg-slate-50/70 border border-slate-200 rounded-xl p-4 sm:p-5">
    <div class="space-y-1">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">
        2. Daftarkan atau Tetapkan Akun Peran Khusus (via Email)
      </h3>
      <p class="text-xs text-slate-600 leading-relaxed">
        Daftarkan email Pengurus MWC, Kader Ranting, atau Admin PCNU baru dari sini. Jika pemilik email sudah punya akun, perannya langsung berubah; jika belum, saat nanti dia masuk dengan Google atau daftar memakai email ini, perannya otomatis aktif.
      </p>
    </div>

    <div id="admin-add-user-status" role="status" aria-live="polite" class="hidden p-2.5 rounded-lg text-xs font-semibold"></div>

    <form id="form-admin-add-user" class="space-y-3" aria-label="Formulir pendaftaran akun sesuai peran">
      <input type="hidden" name="mode" value="create" />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <div class="space-y-1">
          <label for="addUserName" class="block text-xs font-medium text-slate-800">
            Nama Lengkap <span class="text-rose-600" aria-hidden="true">*</span>
          </label>
          <input
            type="text"
            id="addUserName"
            name="name"
            autocomplete="name"
            required
            placeholder="Contoh: Ust. Fathorrahman"
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>

        <div class="space-y-1">
          <label for="addUserEmail" class="block text-xs font-medium text-slate-800">
            Alamat Email Akun <span class="text-rose-600" aria-hidden="true">*</span>
          </label>
          <input
            type="email"
            id="addUserEmail"
            name="email"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="none"
            spellcheck="false"
            required
            placeholder="pengurus@gmail.com"
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>

        <div class="space-y-1">
          <label for="addUserRole" class="block text-xs font-medium text-slate-800">
            Peran / Hak Akses <span class="text-rose-600" aria-hidden="true">*</span>
          </label>
          <select
            id="addUserRole"
            name="role"
            required
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm sm:text-xs font-semibold text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20 cursor-pointer"
          >
            <option value="mwcnu">Pengurus MWC NU (Kecamatan)</option>
            <option value="ranting">Kader Ranting (Petugas Lapangan)</option>
            <option value="pcnu">Admin PCNU / Superadmin</option>
            <option value="warga">Warga Biasa</option>
          </select>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <div class="space-y-1">
          <label for="addUserZone" class="block text-xs font-medium text-slate-800">
            Wilayah MWC NU <span id="addUserZoneRequiredMark" class="text-rose-600" aria-hidden="true">*</span>
          </label>
          <select
            id="addUserZone"
            name="zoneId"
            required
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm sm:text-xs font-medium text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20 cursor-pointer"
          >
            <option value="" disabled selected>Pilih Wilayah MWC</option>
            {zones.map((z) => (
              <option value={z.id}>{z.name}</option>
            ))}
          </select>
        </div>

        <div class="space-y-1">
          <label for="addUserRanting" class="block text-xs font-medium text-slate-800">
            Ranting / Desa (Opsional)
          </label>
          <input
            type="text"
            id="addUserRanting"
            name="ranting"
            placeholder="Contoh: Gapura Barat"
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>

        <div class="space-y-1">
          <label for="addUserOrg" class="block text-xs font-medium text-slate-800">
            Banom / Lembaga (Opsional)
          </label>
          <input
            type="text"
            id="addUserOrg"
            name="org"
            placeholder="Contoh: LPNU / Ansor"
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>

        <div class="space-y-1">
          <label for="addUserPhone" class="block text-xs font-medium text-slate-800">
            No. WhatsApp (Opsional)
          </label>
          <input
            type="tel"
            id="addUserPhone"
            name="phone"
            autocomplete="tel"
            inputmode="tel"
            placeholder="081234567890"
            class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm sm:text-xs font-mono text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>
      </div>

      <div class="pt-1">
        <button
          type="submit"
          id="btn-admin-add-user"
          class="min-h-[40px] py-2 px-4 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-lg shadow-xs transition cursor-pointer"
        >
          Simpan & Tetapkan Akun ➔
        </button>
      </div>
    </form>
  </div>

  <!-- Section 3: Direktori Semua Pengguna & Ubah Peran -->
  <div class="space-y-3">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 pb-2 border-b border-slate-200">
      <h3 id="users-directory-heading" class="text-xs font-bold uppercase tracking-wider text-slate-800">
        3. Daftar Seluruh Akun & Pengaturan Peran
      </h3>
      <span id="user-directory-count" class="text-xs font-medium text-slate-600">
        Menampilkan {allUsers.length} dari {allUsers.length} akun
      </span>
    </div>

    <search class="flex flex-col sm:flex-row gap-2.5">
      <div class="flex-1">
        <label for="user-directory-search" class="sr-only">Cari nama atau email pengguna</label>
        <input
          type="search"
          id="user-directory-search"
          autocorrect="off"
          autocapitalize="none"
          spellcheck="false"
          placeholder="Cari nama, email, atau nama toko..."
          class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg px-3 py-1.5 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
        />
      </div>
      <div class="sm:w-56">
        <label for="user-directory-role-filter" class="sr-only">Filter berdasarkan peran</label>
        <select
          id="user-directory-role-filter"
          class="w-full min-h-[40px] bg-white border border-slate-300 rounded-lg px-2.5 py-1.5 text-sm sm:text-xs font-medium text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20 cursor-pointer"
        >
          <option value="">Semua Peran ({allUsers.length})</option>
          <option value="pcnu">Admin PCNU / Superadmin</option>
          <option value="mwcnu">Pengurus MWC NU</option>
          <option value="ranting">Kader Ranting</option>
          <option value="warga">Warga Biasa</option>
        </select>
      </div>
    </search>

    <div
      tabindex="0"
      role="region"
      aria-labelledby="users-directory-heading"
      class="users-table-wrapper border border-slate-200 rounded-xl bg-white"
    >
      <table class="users-directory-table w-full text-left border-collapse text-xs">
        <thead class="bg-slate-50 border-b border-slate-200 text-slate-700">
          <tr>
            <th scope="col" class="py-2.5 px-3 font-bold">Pengguna</th>
            <th scope="col" class="py-2.5 px-3 font-bold">Peran Saat Ini</th>
            <th scope="col" class="py-2.5 px-3 font-bold">Ubah Peran</th>
            <th scope="col" class="py-2.5 px-3 font-bold">Wilayah MWC & Ranting</th>
            <th scope="col" class="py-2.5 px-3 font-bold text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {allUsers.map((u) => {
            const badge = ROLE_BADGES[u.role] || ROLE_BADGES.warga;
            const searchKey = `${u.name} ${u.email} ${u.umkm_name || ''} ${u.zone_name || ''} ${u.agent_ranting || ''}`.toLowerCase();
            return (
              <tr
                data-user-row
                data-role={u.role}
                data-search={searchKey}
                class="hover:bg-slate-50/70 transition"
              >
                <th scope="row" class="py-3 px-3 font-normal align-top">
                  <div class="space-y-0.5">
                    <div class="font-bold text-slate-900 flex items-center gap-1.5 flex-wrap">
                      <span>{u.name}</span>
                      {u.is_env_superadmin && (
                        <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-rose-100 text-rose-900 border border-rose-200">
                          Superadmin Utama (Env)
                        </span>
                      )}
                      {u.is_pending_login && (
                        <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded bg-slate-100 text-slate-700 border border-slate-300">
                          Belum Login
                        </span>
                      )}
                    </div>
                    <div class="font-mono text-[11px] text-slate-600 break-all">{u.email}</div>
                    {u.umkm_name && (
                      <div class="text-[11px] text-emerald-800 font-medium">
                        🏪 Toko: {u.umkm_name}
                      </div>
                    )}
                  </div>
                </th>

                <td class="py-3 px-3 align-top">
                  <div class="space-y-1">
                    <span class={`inline-block text-[11px] font-semibold px-2 py-0.5 rounded border ${badge.cls}`}>
                      {badge.label}
                    </span>
                    {u.zone_name && (
                      <div class="text-[11px] text-slate-600">
                        MWC {u.zone_name}{u.agent_ranting ? ` • ${u.agent_ranting}` : ''}
                      </div>
                    )}
                  </div>
                </td>

                <td class="py-3 px-3 align-top">
                  <label for={`user-role-${u.id}`} class="sr-only">Peran untuk {u.name}</label>
                  <select
                    id={`user-role-${u.id}`}
                    data-user-role-select
                    data-id={u.id}
                    disabled={u.is_env_superadmin}
                    class="w-full min-h-[36px] bg-white border border-slate-300 rounded px-2 py-1 text-xs font-medium text-slate-900 disabled:bg-slate-100 disabled:text-slate-600 focus:border-emerald-700 focus:outline-none"
                  >
                    <option value="warga" selected={u.role === 'warga'}>Warga Biasa</option>
                    <option value="ranting" selected={u.role === 'ranting'}>Kader Ranting</option>
                    <option value="mwcnu" selected={u.role === 'mwcnu'}>Pengurus MWC NU</option>
                    <option value="pcnu" selected={u.role === 'pcnu'}>Admin PCNU</option>
                  </select>
                </td>

                <td class="py-3 px-3 align-top">
                  <div class="flex flex-col sm:flex-row gap-1.5">
                    <label for={`user-zone-${u.id}`} class="sr-only">Wilayah MWC untuk {u.name}</label>
                    <select
                      id={`user-zone-${u.id}`}
                      data-user-zone-select
                      data-id={u.id}
                      disabled={u.is_env_superadmin}
                      class="flex-1 min-h-[36px] bg-white border border-slate-300 rounded px-2 py-1 text-xs text-slate-900 disabled:bg-slate-100 disabled:text-slate-600 focus:border-emerald-700 focus:outline-none"
                    >
                      <option value="">-- Semua / Tidak Ada MWC --</option>
                      {zones.map((z) => (
                        <option value={z.id} selected={u.assigned_zone_id === z.id}>{z.name}</option>
                      ))}
                    </select>
                    <label for={`user-ranting-${u.id}`} class="sr-only">Ranting untuk {u.name}</label>
                    <input
                      type="text"
                      id={`user-ranting-${u.id}`}
                      data-user-ranting-input
                      data-id={u.id}
                      value={u.agent_ranting || ''}
                      disabled={u.is_env_superadmin}
                      placeholder="Ranting/Desa"
                      class="sm:w-32 min-h-[36px] bg-white border border-slate-300 rounded px-2 py-1 text-xs text-slate-900 disabled:bg-slate-100 disabled:text-slate-600 focus:border-emerald-700 focus:outline-none"
                    />
                  </div>
                </td>

                <td class="py-3 px-3 align-top text-right">
                  {u.is_env_superadmin ? (
                    <span class="text-[11px] font-medium text-slate-600">Terkunci</span>
                  ) : (
                    <button
                      type="button"
                      data-action="save-user-role"
                      data-id={u.id}
                      class="min-h-[36px] px-3 py-1 bg-slate-900 hover:bg-emerald-700 text-white font-semibold text-xs rounded transition cursor-pointer"
                    >
                      Simpan
                    </button>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .users-table-wrapper {
    overflow: auto;
    max-inline-size: 100%;
    container-type: inline-size;
  }

  .users-directory-table thead {
    position: sticky;
    inset-block-start: 0;
    z-index: 1;
  }

  @container (width < 760px) {
    .users-directory-table,
    .users-directory-table thead,
    .users-directory-table tbody,
    .users-directory-table tr,
    .users-directory-table th,
    .users-directory-table td {
      display: block;
    }

    .users-directory-table thead {
      display: none;
    }

    .users-directory-table tr {
      padding: 0.75rem;
      border-bottom: 1px solid #e2e8f0;
    }

    .users-directory-table tbody th,
    .users-directory-table tbody td {
      padding: 0.35rem 0;
      text-align: left;
    }

    .users-directory-table tbody td:nth-child(2)::before {
      content: "Peran Saat Ini: ";
      font-weight: 700;
      color: #475569;
      display: block;
      margin-bottom: 0.2rem;
    }

    .users-directory-table tbody td:nth-child(3)::before {
      content: "Ubah Peran: ";
      font-weight: 700;
      color: #475569;
      display: block;
      margin-bottom: 0.2rem;
    }

    .users-directory-table tbody td:nth-child(4)::before {
      content: "Wilayah MWC & Ranting: ";
      font-weight: 700;
      color: #475569;
      display: block;
      margin-bottom: 0.2rem;
    }
  }
</style>
