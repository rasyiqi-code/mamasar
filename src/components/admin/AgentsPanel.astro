---
interface Petugas {
  id: number;
  name: string;
  email: string;
  agent_status?: string | null;
  agent_phone?: string | null;
  agent_ranting?: string | null;
  agent_org?: string | null;
  zone_name?: string | null;
}

interface Props {
  pendingPetugas: Petugas[];
  allPetugas: Petugas[];
}

const { pendingPetugas, allPetugas } = Astro.props;
const activePetugas = allPetugas.filter((p) => p.agent_status === 'active');
---

<section id="panel-agents" class="admin-tab-panel space-y-6">
  <!-- Top Bar: Compact Header with Line Divider -->
  <div class="flex items-center justify-between pb-3 border-b border-slate-200">
    <div class="flex items-center gap-2.5">
      <h2 class="text-base sm:text-lg font-bold text-slate-900">Kader Lapangan Ranting & MWC</h2>
      <span class="text-xs font-semibold px-2 py-0.5 rounded bg-amber-50 text-amber-900 border border-amber-200">
        {pendingPetugas.length} menunggu persetujuan
      </span>
    </div>
  </div>

  <!-- Section 1: Antrean Permohonan (Pending) -->
  <div class="space-y-2">
    <div class="flex items-center justify-between pb-2 border-b border-slate-200">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">
        Antrean Permohonan ({pendingPetugas.length})
      </h2>
    </div>

    {pendingPetugas.length === 0 ? (
      <p class="text-xs text-slate-400 py-3">Tidak ada permohonan petugas yang menunggu saat ini.</p>
    ) : (
      <div class="divide-y divide-slate-100 border-b border-slate-200">
        {pendingPetugas.map((kader) => (
          <div class="py-2.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 hover:bg-slate-50/60 px-1 transition">
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="font-bold text-sm text-slate-900">{kader.name}</h3>
                <span class="text-[10px] font-semibold text-emerald-800 bg-emerald-50 px-1.5 py-0.5 rounded">
                  📍 MWC {kader.zone_name || 'Sumenep'}
                </span>
                {kader.agent_ranting && (
                  <span class="text-[10px] font-bold text-slate-700 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">
                    Desa {kader.agent_ranting}
                  </span>
                )}
                <span class="text-[11px] text-slate-500">{kader.agent_org || 'Kader NU'}</span>
                <span class="text-[11px] text-slate-400 font-mono">{kader.email}</span>
              </div>
            </div>

            <div class="flex items-center gap-1.5 shrink-0 w-full sm:w-auto">
              {kader.agent_phone && (
                <a
                  href={`https://wa.me/${kader.agent_phone}?text=${encodeURIComponent(`Assalamu'alaikum Sahabat ${kader.name}, kami dari Admin PCNU Sumenep mengonfirmasi permohonan petugas lapangan Mamasar untuk wilayah MWC ${kader.zone_name}.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="px-2 py-1 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 rounded text-xs font-medium transition"
                  title="Hubungi via WhatsApp"
                >
                  💬 WA
                </a>
              )}
              <button
                type="button"
                data-action="review-agent"
                data-id={kader.id}
                data-decision="approve"
                class="py-1 px-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded transition cursor-pointer"
              >
                ✓ Setujui
              </button>
              <button
                type="button"
                data-action="review-agent"
                data-id={kader.id}
                data-decision="reject"
                class="py-1 px-2.5 bg-white hover:bg-rose-50 text-rose-700 border border-rose-200 font-medium text-xs rounded transition cursor-pointer"
              >
                ✕ Tolak
              </button>
            </div>
          </div>
        ))}
      </div>
    )}
  </div>

  <!-- Section 2: Daftar Petugas Aktif -->
  <div class="space-y-2 pt-2">
    <div class="flex items-center justify-between pb-2 border-b border-slate-200">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">
        Kader Resmi Aktif ({activePetugas.length})
      </h2>
    </div>

    {activePetugas.length > 0 ? (
      <div class="divide-y divide-slate-100 border-b border-slate-200">
        {activePetugas.map((p) => (
          <div class="py-2 flex items-center justify-between gap-3 px-1 hover:bg-slate-50/60 transition">
            <div class="min-w-0 flex items-center gap-2 flex-wrap text-xs">
              <strong class="font-bold text-slate-900">{p.name}</strong>
              <span class="text-slate-500">MWC {p.zone_name}</span>
              {p.agent_ranting && (
                <span class="text-slate-700 font-semibold">• Ranting {p.agent_ranting}</span>
              )}
              <span class="text-slate-400">• {p.agent_org}</span>
              <span class="text-slate-400 font-mono text-[11px]">{p.email}</span>
            </div>
            <span class="shrink-0 text-[10px] font-semibold text-emerald-700 bg-emerald-50 px-1.5 py-0.2 rounded">
              Aktif
            </span>
          </div>
        ))}
      </div>
    ) : (
      <p class="text-xs text-slate-400 py-3">Belum ada petugas yang disetujui.</p>
    )}
  </div>
</section>
