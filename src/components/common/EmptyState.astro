---
import AppIcon from './AppIcon.astro';

interface Props {
  icon?: 'search' | 'store' | 'calendar' | 'star' | 'box' | 'info';
  title: string;
  description: string;
  actionHref?: string;
  actionLabel?: string;
  actionId?: string;
}

const {
  icon = 'search',
  title,
  description,
  actionHref,
  actionLabel,
  actionId,
} = Astro.props;
---

<div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 text-center space-y-3 shadow-xs">
  <div class="w-12 h-12 mx-auto rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-center justify-center">
    <AppIcon name={icon} size="lg" />
  </div>
  <div class="space-y-1 max-w-md mx-auto">
    <h3 class="text-sm sm:text-base font-bold text-slate-900">{title}</h3>
    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">{description}</p>
  </div>
  {actionLabel && (
    actionHref ? (
      <div class="pt-1">
        <a
          href={actionHref}
          id={actionId}
          class="inline-flex min-h-[44px] items-center justify-center px-5 py-2 bg-emerald-700 hover:bg-emerald-800 text-white text-xs sm:text-sm font-bold rounded-xl transition"
        >
          {actionLabel}
        </a>
      </div>
    ) : (
      <div class="pt-1">
        <button
          type="button"
          id={actionId}
          class="inline-flex min-h-[44px] items-center justify-center px-5 py-2 bg-emerald-700 hover:bg-emerald-800 text-white text-xs sm:text-sm font-bold rounded-xl transition cursor-pointer"
        >
          {actionLabel}
        </button>
      </div>
    )
  )}
</div>
