---
import { SITE_CONFIG } from '../../lib/constants';

interface Zone {
  id: number;
  name: string;
}

interface Props {
  user: {
    id: number;
    name: string;
    agent_status?: string | null;
    agent_ranting?: string | null;
    agent_org?: string | null;
    assigned_zone_id?: number | null;
    role: string;
  };
  zones: Zone[];
  assignedZone?: Zone;
}

const { user, zones, assignedZone } = Astro.props;
const isCadre = user.role === 'ranting' || user.role === 'mwcnu' || user.role === 'pcnu' || user.agent_status === 'active';
const isPending = user.agent_status === 'pending';
---

<section id="panel-services" class="tab-panel hidden space-y-5">
  <!-- Top Bar: Compact Header with Line Divider -->
  <div class="flex items-center justify-between pb-3 border-b border-slate-200">
    <div class="flex items-center gap-2.5">
      <h2 class="text-base sm:text-lg font-bold text-slate-900">Layanan Kemitraan & Kaderisasi MWC / Ranting</h2>
    </div>
  </div>

  <!-- BAGIAN 1: STATUS / PENDAFTARAN PETUGAS PENDATA MWC & RANTING -->
  {isCadre ? (
    <div class="py-3 border-b border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div class="space-y-0.5">
        <div class="flex items-center gap-2">
          <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-800 bg-emerald-50 px-1.5 py-0.2 rounded">
            Kader Aktif
          </span>
          <span class="text-xs text-slate-700 font-medium">
            MWC {assignedZone?.name || 'Sumenep'} • {user.agent_ranting ? `Ranting ${user.agent_ranting} • ` : ''}{user.agent_org || 'Kader NU'}
          </span>
        </div>
        <p class="text-xs text-slate-500">
          Anda memiliki hak akses entri jemput bola UMKM warga di konsol admin.
        </p>
      </div>

      <a
        href="/admin#entry"
        class="py-1.5 px-3 bg-emerald-700 hover:bg-emerald-800 text-white font-medium text-xs rounded shadow-xs transition shrink-0"
      >
        Buka Entri Jemput Bola ➔
      </a>
    </div>
  ) : isPending ? (
    <div class="py-3 border-b border-slate-200 space-y-2">
      <div class="flex items-center gap-2">
        <span class="text-[10px] font-semibold uppercase tracking-wider text-amber-800 bg-amber-50 px-1.5 py-0.2 rounded">
          Menunggu Konfirmasi
        </span>
        <span class="text-xs text-slate-700 font-medium">
          Permohonan wilayah {assignedZone?.name || 'Sumenep'} {user.agent_ranting ? `(Ranting ${user.agent_ranting})` : ''} sedang diverifikasi admin PCNU.
        </span>
      </div>
      <div>
        <a
          href={`https://wa.me/${SITE_CONFIG.whatsappHelp}?text=${encodeURIComponent("Assalamu'alaikum Admin PCNU, saya sudah mengajukan diri sebagai petugas pendata Mamasar. Mohon bantuannya.")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-xs text-emerald-700 hover:text-emerald-800 font-medium"
        >
          <span>💬 Konfirmasi via WhatsApp Admin PCNU ➔</span>
        </a>
      </div>
    </div>
  ) : (
    <div class="space-y-3 pb-5 border-b border-slate-200">
      <div class="flex items-center justify-between pb-1 border-b border-slate-100">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">
          Daftar Jadi Kader Lapangan Ranting / MWC
        </h2>
      </div>

      <form id="petugas-register-form" class="space-y-3 max-w-2xl">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label for="regZoneId" class="block text-[11px] font-medium text-slate-700">
              Wilayah MWC NU (Kecamatan) <span class="text-rose-500">*</span>
            </label>
            <select
              id="regZoneId"
              name="zoneId"
              required
              class="w-full bg-white border border-slate-300 rounded p-1.5 text-xs font-medium text-slate-800 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 cursor-pointer"
            >
              <option value="" disabled selected>Pilih Wilayah MWC</option>
              {zones.map((z) => (
                <option value={z.id}>{z.name}</option>
              ))}
            </select>
          </div>

          <div class="space-y-1">
            <label for="regRanting" class="block text-[11px] font-medium text-slate-700">
              Ranting NU (Nama Desa / Kelurahan) <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="regRanting"
              name="ranting"
              placeholder="Contoh: Gapura Barat / Paberasan / Pajagalan"
              required
              class="w-full bg-white border border-slate-300 rounded p-1.5 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="space-y-1">
            <label for="regPhone" class="block text-[11px] font-medium text-slate-700">
              Nomor WhatsApp <span class="text-rose-500">*</span>
            </label>
            <input
              type="tel"
              id="regPhone"
              name="phone"
              placeholder="Contoh: 081234567890"
              required
              class="w-full bg-white border border-slate-300 rounded p-1.5 text-xs text-slate-900 font-mono focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
            />
          </div>

          <div class="space-y-1">
            <label for="regOrg" class="block text-[11px] font-medium text-slate-700">
              Afiliasi Banom / Lembaga NU <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="regOrg"
              name="org"
              placeholder="Contoh: Ansor Ranting / Fatayat / IPNU"
              required
              class="w-full bg-white border border-slate-300 rounded p-1.5 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
            />
          </div>
        </div>

        <button
          type="submit"
          id="btn-submit-petugas-reg"
          class="py-1.5 px-4 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded shadow-xs transition cursor-pointer"
        >
          Kirim Pengajuan Kader ➔
        </button>
      </form>
    </div>
  )}

  <!-- BAGIAN 2: KEMITRAAN USAHA (MODAL & LEGALITAS) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-1">
    <!-- Card 1: Permodalan Syariah -->
    <div class="space-y-2 pb-4 border-b md:border-b-0 md:border-r border-slate-200 md:pr-6">
      <div class="flex items-center gap-2">
        <span class="text-base">🏛️</span>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">Permodalan Syariah (BMTNU & Lazisnu)</h3>
      </div>
      <div class="space-y-1 text-xs text-slate-600">
        <p>• Pembiayaan syariah murabahah & mudharabah BMTNU</p>
        <p>• Modal peralatan bergulir Lazisnu Produktif</p>
      </div>
      <div class="pt-1">
        <a
          href={`https://wa.me/${SITE_CONFIG.whatsappHelp}?text=${encodeURIComponent("Assalamu'alaikum LPNU PCNU Sumenep, saya pemilik UMKM warga NU ingin konsultasi akses permodalan BMTNU / Lazisnu")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 text-xs font-medium text-emerald-700 hover:text-emerald-800"
        >
          <span>Konsultasi Permodalan ➔</span>
        </a>
      </div>
    </div>

    <!-- Card 2: Legalitas & Halal -->
    <div class="space-y-2">
      <div class="flex items-center gap-2">
        <span class="text-base">📜</span>
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">NIB & Sertifikasi Halal Gratis (SEHATI)</h3>
      </div>
      <div class="space-y-1 text-xs text-slate-600">
        <p>• Fasilitasi izin edar dan NIB online 100% gratis</p>
        <p>• Pendampingan PPH program SEHATI BPJPH</p>
      </div>
      <div class="pt-1 flex items-center gap-3">
        <a
          href="/edukasi/sertifikasi-halal-gratis-sehati-umkm-sumenep"
          class="text-xs font-medium text-slate-600 hover:text-slate-900 underline"
        >
          Panduan Halal
        </a>
        <span class="text-slate-300">•</span>
        <a
          href={`https://wa.me/${SITE_CONFIG.whatsappHelp}?text=${encodeURIComponent("Assalamu'alaikum LPNU Sumenep, saya butuh bantuan pendampingan NIB dan Sertifikasi Halal")}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-medium text-emerald-700 hover:text-emerald-800"
        >
          Dampingi Halal ➔
        </a>
      </div>
    </div>
  </div>
</section>
