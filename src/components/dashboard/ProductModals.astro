---
import { PRODUCT_CATEGORIES } from '../../lib/constants';
import AppIcon from '../common/AppIcon.astro';
---

<!-- MODAL: EDIT PRODUK -->
<div id="modal-edit-product" class="fixed inset-0 z-50 hidden flex items-end sm:items-center justify-center p-0 sm:p-4">
  <div class="modal-backdrop fixed inset-0 bg-slate-900/40 backdrop-blur-xs"></div>
  <div class="relative bg-white border border-slate-200 rounded-t-2xl sm:rounded-xl w-full max-w-lg shadow-2xl overflow-hidden z-10 max-h-[85vh] sm:max-h-[90vh] flex flex-col">
    <!-- Mobile Pill Drag Handle -->
    <div class="sm:hidden w-12 h-1 bg-slate-300 rounded-full mx-auto my-2 shrink-0"></div>

    <div class="p-4 sm:p-5 border-b border-slate-200 flex items-center justify-between">
      <h3 class="font-bold text-sm sm:text-base text-slate-900">Edit Iklan Produk</h3>
      <button type="button" data-close-modal="edit-product" aria-label="Tutup" class="text-slate-400 hover:text-slate-700 p-1 cursor-pointer flex items-center">
        <AppIcon name="close" size="xs" />
      </button>
    </div>

    <form id="edit-product-form" class="p-4 sm:p-6 space-y-4 overflow-y-auto flex-1">
      <input type="hidden" id="editProductId" name="productId" />
      <input type="hidden" id="editImageBase64" name="imageBase64" />

      <div class="space-y-1.5">
        <label for="editProdName" class="block text-xs font-medium text-slate-700">Nama Barang / Produk <span class="text-rose-500">*</span></label>
        <input
          type="text"
          id="editProdName"
          name="name"
          required
          class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label for="editProdCategory" class="block text-xs font-medium text-slate-700">Kategori <span class="text-rose-500">*</span></label>
          <select
            id="editProdCategory"
            name="category"
            required
            class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-xs font-medium text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 cursor-pointer"
          >
            {PRODUCT_CATEGORIES.map((cat) => (
              <option value={cat}>
                {cat}
              </option>
            ))}
          </select>
        </div>

        <div class="space-y-1.5">
          <label for="editProdPrice" class="block text-xs font-medium text-slate-700">Harga Jual Promo (IDR) <span class="text-rose-500">*</span></label>
          <input
            type="number"
            id="editProdPrice"
            name="price"
            required
            min="500"
            class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 font-mono focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
          />
        </div>
      </div>

      <div class="space-y-1.5">
        <label for="editProdOriginalPrice" class="block text-xs font-medium text-slate-700">Harga Normal / Coret (Opsional)</label>
        <input
          type="number"
          id="editProdOriginalPrice"
          name="originalPrice"
          min="500"
          placeholder="Contoh: 20000 (jika sedang promo diskon)"
          class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 font-mono focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
        />
        <p class="text-[10px] text-slate-400">Jika diisi lebih besar dari harga jual, sistem otomatis menampilkan harga coret dan badge diskon.</p>
      </div>

      <div class="space-y-1.5">
        <label class="block text-xs font-medium text-slate-700">Ganti Foto Produk (Opsional)</label>
        <input
          type="file"
          id="edit-dash-camera-input"
          accept="image/*"
          class="w-full text-xs text-slate-500 file:mr-2 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 cursor-pointer"
        />
        <p id="edit-dash-compress-info" class="text-[11px] text-slate-400 font-medium"></p>
      </div>

      <div class="space-y-1.5">
        <label for="editProdDesc" class="block text-xs font-medium text-slate-700">Deskripsi Produk</label>
        <textarea
          id="editProdDesc"
          name="description"
          rows="2"
          class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
        ></textarea>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="space-y-1.5">
          <label for="editProdStockStatus" class="block text-xs font-medium text-slate-700">Ketersediaan Stok <span class="text-rose-500">*</span></label>
          <select
            id="editProdStockStatus"
            name="stockStatus"
            required
            class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-xs font-medium text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 cursor-pointer"
          >
            <option value="ready">Ready Stock (Siap Kirim)</option>
            <option value="po">Pre-Order / Dibuat Berdasarkan Pesanan</option>
            <option value="sold_out">Habis / Kuota Penuh</option>
          </select>
        </div>

        <div class="space-y-1.5">
          <label for="editProdCapacity" class="block text-xs font-medium text-slate-700">Kapasitas / Estimasi (Opsional)</label>
          <input
            type="text"
            id="editProdCapacity"
            name="productionCapacity"
            placeholder="Contoh: 50 bungkus/hari atau PO 2-3 hari"
            class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
          />
        </div>
      </div>

      <div class="space-y-1.5">
        <label for="editProdShopee" class="block text-xs font-medium text-slate-700">Tautan Shopee (Opsional)</label>
        <input
          type="url"
          id="editProdShopee"
          name="shopeeUrl"
          class="w-full bg-white border border-slate-300 rounded-lg p-2.5 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
        />
      </div>

      <div class="pt-2">
        <button
          type="submit"
          id="btn-submit-edit-product"
          class="w-full py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs sm:text-sm rounded-lg transition shadow-xs cursor-pointer"
        >
          Simpan Perubahan Produk ➔
        </button>
      </div>
    </form>
  </div>
</div>
