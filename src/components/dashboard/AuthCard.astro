---
interface Props {
  authError?: string | null;
  isLoggedOut?: boolean;
  intent?: string | null;
}

const { authError, isLoggedOut = false, intent = null } = Astro.props;
const isKaderIntent = intent === 'daftar-kader';
---

<div class="max-w-md mx-auto py-12 sm:py-20 px-4">
  <div class="space-y-6 text-center">
    <div class="w-12 h-12 rounded-lg bg-emerald-700 text-white flex items-center justify-center text-xl mx-auto font-bold shadow-xs">
      {isKaderIntent ? '🤝' : '🏪'}
    </div>

    <div class="space-y-1.5">
      <h1 class="text-2xl font-bold tracking-tight text-slate-900">
        {isKaderIntent ? 'Masuk untuk Daftar Kader / Pengurus' : 'Masuk atau Daftar ke Mamasar'}
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 leading-relaxed max-w-sm mx-auto">
        {isKaderIntent
          ? 'Masuk dengan Google atau Email terlebih dahulu, lalu ajukan peran Kader Ranting atau Pengurus MWC NU langsung dari halaman berikutnya.'
          : 'Satu akun untuk kelola toko UMKM, pembukuan kas, pendaftaran kader Ranting atau Pengurus MWC, hingga konsol pengurus.'}
      </p>
    </div>

    {isLoggedOut && (
      <div class="p-2.5 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-lg text-xs font-medium text-left">
        ✓ Anda telah berhasil keluar dari akun.
      </div>
    )}

    {authError && (
      <div class="p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-lg text-xs font-medium text-left">
        Kendala autentikasi: {authError}. Silakan coba kembali beberapa saat lagi.
      </div>
    )}

    <div class="space-y-4 pt-2">
      <a
        href="/api/auth/login"
        data-astro-prefetch="false"
        data-astro-reload
        class="w-full py-2.5 px-4 bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 font-semibold text-xs sm:text-sm rounded-lg flex items-center justify-center gap-3 transition cursor-pointer"
      >
        <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
        </svg>
        <span>Masuk dengan Akun Google</span>
      </a>

      <div class="relative flex items-center justify-center my-4">
        <div class="border-t border-slate-200 w-full"></div>
        <span class="bg-white px-3 text-[11px] font-medium text-slate-600 uppercase tracking-wider relative">atau dengan email</span>
      </div>

      <form id="neon-auth-form" class="space-y-3.5 text-left" aria-label="Formulir masuk atau daftar dengan email">
        <input type="hidden" id="neonAuthAction" name="action" value="signin" />

        <div id="name-field-group" class="space-y-1 hidden">
          <label for="neonName" class="block text-xs font-medium text-slate-800">Nama Lengkap</label>
          <input
            type="text"
            id="neonName"
            name="name"
            autocomplete="name"
            placeholder="Contoh: H. Ahmad Zaini"
            class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg p-2.5 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>

        <div class="space-y-1">
          <label for="neonEmail" class="block text-xs font-medium text-slate-800">Alamat Email</label>
          <input
            type="email"
            id="neonEmail"
            name="email"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="none"
            spellcheck="false"
            required
            placeholder="nama@email.com"
            class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg p-2.5 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>

        <div class="space-y-1">
          <div class="flex items-center justify-between">
            <label for="neonPassword" class="block text-xs font-medium text-slate-800">Kata Sandi</label>
            <button
              type="button"
              id="toggle-neon-password"
              aria-pressed="false"
              class="text-[11px] font-semibold text-slate-600 hover:text-emerald-800 underline underline-offset-2 cursor-pointer"
            >
              Tampilkan
            </button>
          </div>
          <input
            type="password"
            id="neonPassword"
            name="password"
            autocomplete="current-password"
            required
            minlength="6"
            placeholder="Minimal 6 karakter"
            class="w-full min-h-[44px] bg-white border border-slate-300 rounded-lg p-2.5 text-sm sm:text-xs text-slate-900 focus:border-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-700/20"
          />
        </div>

        <button
          type="submit"
          id="neon-submit-btn"
          class="w-full min-h-[44px] py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs sm:text-sm rounded-lg transition shadow-xs cursor-pointer"
        >
          Masuk dengan Email
        </button>
      </form>

      <div id="neon-auth-msg" role="status" aria-live="polite" class="hidden p-2.5 rounded-lg text-xs font-medium"></div>

      <div class="pt-2">
        <button
          type="button"
          id="toggle-auth-mode"
          class="min-h-[40px] px-2 text-xs text-slate-600 hover:text-emerald-800 font-medium underline block mx-auto cursor-pointer"
        >
          Belum punya akun? Buat akun baru di sini ➔
        </button>
      </div>
    </div>
  </div>
</div>
