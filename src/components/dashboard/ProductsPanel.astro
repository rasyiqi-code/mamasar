---
import { formatRupiah } from '../../lib/utils';
import type { AdPromotion, BumpLedgerEntry, NotificationItem } from '../../lib/db';
import AppIcon from '../common/AppIcon.astro';

interface Product {
  id: number;
  name: string;
  slug: string;
  price: number;
  original_price?: number | null;
  category: string;
  image_url: string;
  is_sold_out?: boolean | number | null;
  stock_status?: string | null;
  production_capacity?: string | null;
  views?: number;
  description?: string;
  shopee_url?: string;
  is_featured?: number | null;
  featured_until?: string | null;
}

interface Props {
  store: {
    id: number;
    name: string;
    bump_credits?: number;
    products?: Product[];
  };
  adOrders?: AdPromotion[];
  bumpLedger?: BumpLedgerEntry[];
  notifications?: NotificationItem[];
}

const { store, adOrders = [], bumpLedger = [], notifications = [] } = Astro.props;
const products = store.products || [];
const bumpCredits = store.bump_credits ?? 3;
const now = new Date();
function isCurrentlyFeatured(p: Product): boolean {
  return p.is_featured === 1 && (!p.featured_until || new Date(p.featured_until) > now);
}

const promoStatusBadge: Record<string, { label: string; cls: string }> = {
  pending: { label: 'Menunggu Verifikasi', cls: 'bg-amber-100 text-amber-900 border-amber-300' },
  active: { label: 'Aktif / Disetujui', cls: 'bg-emerald-100 text-emerald-900 border-emerald-300' },
  rejected: { label: 'Ditolak', cls: 'bg-rose-100 text-rose-900 border-rose-300' },
  expired: { label: 'Kedaluwarsa', cls: 'bg-slate-100 text-slate-700 border-slate-300' },
};
---

<section id="panel-products" class="tab-panel space-y-5">
  {notifications.length > 0 && (
    <div class="rounded-xl border border-slate-200 bg-slate-50/70 p-3 space-y-2">
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Pemberitahuan Terbaru</h2>
        <span class="text-[11px] text-slate-500">{notifications.length} pesan</span>
      </div>
      <ul class="space-y-1.5">
        {notifications.map((n) => (
          <li class="text-xs bg-white border border-slate-200 rounded-lg px-3 py-2 flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <div>
              <span class="font-bold text-slate-900">{n.title}: </span>
              <span class="text-slate-600">{n.body}</span>
            </div>
            <span class="text-[11px] text-slate-500 shrink-0 font-mono">
              {new Date(n.created_at).toLocaleDateString('id-ID')}
            </span>
          </li>
        ))}
      </ul>
    </div>
  )}

  <!-- Top Bar: Kuota Token Sundul & Actions -->
  <div class="p-3.5 sm:p-4 rounded-xl bg-gradient-to-r from-amber-50/70 via-slate-50 to-white border border-amber-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-2xs">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-amber-400 text-slate-950 font-black text-sm flex items-center justify-center shrink-0 shadow-2xs">
        <AppIcon name="zap" size="md" />
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-slate-800">Kuota Token Sundul:</span>
          <span class="text-xs font-black font-mono px-2 py-0.5 rounded-md bg-amber-100 text-amber-950 border border-amber-300">
            {bumpCredits} Token
          </span>
        </div>
        <p class="text-[11px] text-slate-600 mt-0.5">
          1 token untuk sundul produk ke urutan pertama katalog seketika.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="btn-open-promo-modal"
        class="py-1.5 px-3 bg-amber-500 hover:bg-amber-600 active:bg-amber-700 text-slate-950 font-bold text-xs rounded-lg transition shadow-xs flex items-center gap-1.5 cursor-pointer"
      >
        <AppIcon name="star" size="xs" />
        <span>Pasang Iklan & Isi Token</span>
      </button>

      <a
        href="/pasang-iklan"
        class="py-1.5 px-3 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-lg transition shadow-xs flex items-center gap-1 shrink-0"
      >
        <span>+ Tambah Produk</span>
      </a>
    </div>
  </div>

  <!-- Header with Products Count -->
  <div class="flex items-center justify-between pb-2 border-b border-slate-200">
    <div class="flex items-center gap-2.5">
      <h2 class="text-base sm:text-lg font-bold text-slate-900">Katalog Produk</h2>
      <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700">
        {products.length} produk
      </span>
    </div>
  </div>

  <!-- Product List: Compact Table/List with Line Dividers -->
  {products.length > 0 ? (
    <div class="divide-y divide-slate-100 border-b border-slate-200">
      {products.map((prod) => (
        <div class="py-2.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 hover:bg-slate-50/60 px-1 transition">
          <div class="flex items-center gap-3 min-w-0">
            <img
              src={prod.image_url}
              alt={prod.name}
              class={`w-11 h-11 rounded object-cover border border-slate-200 shrink-0 bg-slate-50 ${
                prod.is_sold_out ? 'grayscale opacity-75' : ''
              }`}
            />
            <div class="min-w-0 space-y-0.5">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="font-bold text-xs sm:text-sm text-slate-900 truncate">{prod.name}</h3>
                <span class="text-[10px] text-slate-500 uppercase tracking-wider">{prod.category}</span>
                {isCurrentlyFeatured(prod) && (
                  <span class="text-[9px] font-bold bg-amber-100 text-amber-950 border border-amber-300 px-1.5 py-0.5 rounded inline-flex items-center gap-0.5">
                    <AppIcon name="star" size="xs" />
                    <span>Unggulan</span>
                  </span>
                )}
                {prod.is_sold_out ? (
                  <span class="text-[9px] font-semibold bg-rose-50 text-rose-700 border border-rose-200 px-1.5 py-0.5 rounded">
                    Habis
                  </span>
                ) : prod.stock_status === 'po' ? (
                  <span class="text-[9px] font-semibold bg-amber-50 text-amber-700 border border-amber-200 px-1.5 py-0.5 rounded">
                    Pre-Order
                  </span>
                ) : (
                  <span class="text-[9px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 px-1.5 py-0.5 rounded">
                    Ready Stock
                  </span>
                )}
              </div>
              <div class="flex items-center gap-3">
                <span class="text-xs font-semibold text-slate-900 font-mono tracking-wider">{formatRupiah(prod.price)}</span>
                {prod.original_price && prod.original_price > prod.price ? (
                  <span class="text-[10px] text-slate-400 line-through font-mono">
                    {formatRupiah(prod.original_price)}
                  </span>
                ) : null}
                {prod.production_capacity ? (
                  <span class="text-[10px] text-slate-500 font-medium">
                    ({prod.production_capacity})
                  </span>
                ) : null}
                {prod.views ? (
                  <span class="inline-flex items-center gap-1 text-[10px] text-slate-500">
                    <AppIcon name="eye" size="xs" />
                    <span>{prod.views}</span>
                  </span>
                ) : null}
              </div>
            </div>
          </div>

          <!-- Quick Actions: Compact -->
          <div class="flex items-center gap-1.5 shrink-0 w-full sm:w-auto flex-wrap sm:flex-nowrap">
            <button
              type="button"
              data-action="promote-single"
              data-id={prod.id}
              data-name={prod.name}
              title="Promosikan produk ini jadi iklan unggulan"
              class="px-2 py-1 bg-amber-50 hover:bg-amber-100 text-amber-950 font-bold text-xs rounded border border-amber-300 transition cursor-pointer inline-flex items-center gap-1"
            >
              <span>★ Unggulkan</span>
            </button>

            <button
              type="button"
              data-action="bump"
              data-id={prod.id}
              title="Sundul ke posisi teratas"
              class="px-2 py-1 bg-slate-50 hover:bg-amber-50 text-slate-700 hover:text-amber-950 font-medium text-xs rounded border border-slate-200 hover:border-amber-300 transition cursor-pointer inline-flex items-center gap-1"
            >
              <AppIcon name="zap" size="xs" />
              <span>Sundul</span>
            </button>

            <button
              type="button"
              data-action="edit-product"
              data-id={prod.id}
              data-name={prod.name}
              data-price={prod.price}
              data-original-price={prod.original_price || ''}
              data-category={prod.category}
              data-desc={prod.description || ''}
              data-shopee={prod.shopee_url || ''}
              data-stock-status={prod.stock_status || (prod.is_sold_out ? 'sold_out' : 'ready')}
              data-capacity={prod.production_capacity || ''}
              class="px-2 py-1 bg-white hover:bg-slate-100 text-slate-700 font-medium text-xs rounded border border-slate-200 transition cursor-pointer"
            >
              Edit
            </button>

            <button
              type="button"
              data-action="record-sale"
              data-title={`Penjualan ${prod.name}`}
              data-amount={prod.price}
              class="px-2 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-medium text-xs rounded border border-emerald-200 transition cursor-pointer"
            >
              + Kas
            </button>

            <button
              type="button"
              data-action="toggle-stock"
              data-id={prod.id}
              class={`px-2 py-1 font-medium text-xs rounded border transition cursor-pointer ${
                prod.is_sold_out
                  ? 'bg-emerald-50 text-emerald-800 border-emerald-200 hover:bg-emerald-100'
                  : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-100'
              }`}
            >
              {prod.is_sold_out ? 'Tersedia' : 'Habis'}
            </button>

            <a
              href={`/p/${prod.slug}`}
              target="_blank"
              class="px-2 py-1 text-slate-500 hover:text-slate-900 text-xs font-medium"
            >
              Lihat ➔
            </a>

            <button
              type="button"
              data-action="delete"
              data-id={prod.id}
              data-name={prod.name}
              class="p-1.5 text-slate-500 hover:text-rose-600 rounded transition cursor-pointer"
              title="Hapus Produk"
              aria-label={`Hapus produk ${prod.name}`}
            >
              <AppIcon name="trash" size="xs" />
            </button>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="py-12 text-center space-y-2">
      <p class="text-xs text-slate-500">Belum ada produk yang didaftarkan.</p>
      <a
        href="/pasang-iklan"
        class="py-1.5 px-3.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded transition shadow-xs inline-block"
      >
        + Tambah Produk Pertama
      </a>
    </div>
  )}

  {(adOrders.length > 0 || bumpLedger.length > 0) && (
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 pt-2">
      {adOrders.length > 0 && (
        <div class="border border-slate-200 rounded-xl p-4 space-y-3 bg-white">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100">
            <h3 class="text-xs font-bold text-slate-900">Riwayat Pengajuan Promosi</h3>
            <span class="text-[11px] text-slate-500">{adOrders.length} pesanan</span>
          </div>
          <div class="divide-y divide-slate-100">
            {adOrders.slice(0, 6).map((order) => {
              const badge = promoStatusBadge[order.status] || promoStatusBadge.pending;
              return (
                <div class="py-2 flex items-start justify-between gap-2 text-xs">
                  <div class="min-w-0">
                    <div class="font-semibold text-slate-900 truncate">
                      {order.product_name || order.type}
                    </div>
                    <div class="text-[11px] text-slate-600">
                      <span class="font-mono">{formatRupiah(order.amount)}</span>
                      {order.expires_at ? ` • Berakhir ${new Date(order.expires_at).toLocaleDateString('id-ID')}` : ''}
                    </div>
                    {order.status === 'rejected' && order.notes && (
                      <div class="text-[11px] text-rose-700 mt-0.5">Alasan: {order.notes}</div>
                    )}
                  </div>
                  <span class={`text-[10px] font-semibold px-2 py-0.5 rounded border shrink-0 ${badge.cls}`}>
                    {badge.label}
                  </span>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {bumpLedger.length > 0 && (
        <div class="border border-slate-200 rounded-xl p-4 space-y-3 bg-white">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100">
            <h3 class="text-xs font-bold text-slate-900">Mutasi Token Sundul</h3>
            <span class="text-[11px] text-slate-500">Saldo: {bumpCredits}</span>
          </div>
          <div class="divide-y divide-slate-100">
            {bumpLedger.map((item) => (
              <div class="py-2 flex items-center justify-between text-xs">
                <div>
                  <span class="font-medium text-slate-800 capitalize">
                    {item.reason === 'purchase' ? 'Isi ulang paket sundul' : item.reason === 'bump' ? 'Sundul produk' : item.reason}
                  </span>
                  <span class="text-[11px] text-slate-500 block font-mono">
                    {new Date(item.created_at).toLocaleString('id-ID')}
                  </span>
                </div>
                <div class="text-right font-mono">
                  <span class={item.delta >= 0 ? 'font-bold text-emerald-700' : 'font-bold text-amber-800'}>
                    {item.delta >= 0 ? `+${item.delta}` : item.delta}
                  </span>
                  <span class="block text-[10px] text-slate-500">Sisa {item.balance_after}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  )}
</section>
