---
import { formatRupiah } from '../../lib/utils';
import type { AdPromotion, BumpLedgerEntry, NotificationItem } from '../../lib/db';
import AppIcon from '../common/AppIcon.astro';

interface Product {
  id: number;
  name: string;
  slug: string;
  price: number;
  original_price?: number | null;
  category: string;
  image_url: string;
  is_sold_out?: boolean | number | null;
  stock_status?: string | null;
  production_capacity?: string | null;
  views?: number;
  description?: string;
  shopee_url?: string;
  is_featured?: number | null;
  featured_until?: string | null;
}

interface Props {
  store: {
    id: number;
    name: string;
    bump_credits?: number;
    products?: Product[];
  };
  adOrders?: AdPromotion[];
  bumpLedger?: BumpLedgerEntry[];
  notifications?: NotificationItem[];
}

const { store, adOrders = [], bumpLedger = [], notifications = [] } = Astro.props;
const products = store.products || [];
const bumpCredits = store.bump_credits ?? 3;
const now = new Date();
function isCurrentlyFeatured(p: Product): boolean {
  return p.is_featured === 1 && (!p.featured_until || new Date(p.featured_until) > now);
}

const promoStatusBadge: Record<string, { label: string; cls: string }> = {
  pending: { label: 'Menunggu Verifikasi', cls: 'bg-amber-100 text-amber-900 border-amber-300' },
  active: { label: 'Aktif / Disetujui', cls: 'bg-emerald-100 text-emerald-900 border-emerald-300' },
  rejected: { label: 'Ditolak', cls: 'bg-rose-100 text-rose-900 border-rose-300' },
  expired: { label: 'Kedaluwarsa', cls: 'bg-slate-100 text-slate-700 border-slate-300' },
};
---

<section id="panel-products" class="tab-panel space-y-5">
  {notifications.length > 0 && (
    <div class="rounded-lg border border-slate-200 bg-slate-50/70 p-3 space-y-2">
      <div class="flex items-center justify-between">
        <h2 class="text-xs font-bold text-slate-800 uppercase tracking-wider">Pemberitahuan Terbaru</h2>
        <span class="text-xs text-slate-600 font-mono tabular-nums">{notifications.length} pesan</span>
      </div>
      <ul class="space-y-1.5">
        {notifications.map((n) => (
          <li class="text-xs bg-white border border-slate-200 rounded-md px-3 py-2 flex flex-col sm:flex-row sm:items-center justify-between gap-1">
            <div>
              <span class="font-bold text-slate-900">{n.title}: </span>
              <span class="text-slate-600">{n.body}</span>
            </div>
            <span class="text-xs text-slate-600 shrink-0 font-mono tabular-nums">
              {new Date(n.created_at).toLocaleDateString('id-ID')}
            </span>
          </li>
        ))}
      </ul>
    </div>
  )}

  {/* Top Bar: Kuota Token Sundul & Actions */}
  <div class="p-3.5 sm:p-4 rounded-lg bg-amber-50/60 border border-amber-300/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-amber-400 text-slate-950 font-black text-sm flex items-center justify-center shrink-0">
        <AppIcon name="zap" size="md" />
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-slate-800">Kuota Token Sundul:</span>
          <span class="text-xs font-black font-mono tabular-nums px-2 py-0.5 rounded-md bg-amber-100 text-amber-950 border border-amber-300">
            {bumpCredits} Token
          </span>
        </div>
        <p class="text-xs text-slate-600 mt-0.5">
          1 token untuk sundul produk ke urutan pertama katalog seketika.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2 flex-wrap">
      <button
        type="button"
        id="btn-open-promo-modal"
        class="min-h-[40px] py-1.5 px-3 bg-amber-500 hover:bg-amber-600 active:bg-amber-700 text-slate-950 font-bold text-xs rounded-lg transition flex items-center gap-1.5 cursor-pointer"
      >
        <AppIcon name="star" size="xs" />
        <span>Promosi</span>
      </button>

      <a
        href="/pasang-iklan"
        class="min-h-[40px] py-1.5 px-3 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-lg transition flex items-center gap-1.5 shrink-0"
      >
        <AppIcon name="plus" size="xs" />
        <span>Tambah</span>
      </a>
    </div>
  </div>

  {/* Header with Products Count */}
  <div class="flex items-center justify-between pb-2 border-b border-slate-200">
    <div class="flex items-center gap-2.5">
      <h2 class="text-base sm:text-lg font-bold text-slate-900">Katalog Produk</h2>
      <span class="text-xs font-semibold font-mono tabular-nums px-2 py-0.5 rounded-md bg-slate-100 text-slate-700">
        {products.length} produk
      </span>
    </div>
  </div>

  {/* Product List: Compact Table/List with Line Dividers */}
  {products.length > 0 ? (
    <div class="divide-y divide-slate-100 border-b border-slate-200">
      {products.map((prod) => (
        <div class="py-3 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 hover:bg-slate-50/60 px-1 transition">
          <div class="flex items-center gap-3 min-w-0">
            <img
              src={prod.image_url}
              alt={prod.name}
              class={`w-12 h-12 rounded-md object-cover border border-slate-200 shrink-0 bg-slate-50 ${
                prod.is_sold_out ? 'grayscale opacity-75' : ''
              }`}
            />
            <div class="min-w-0 space-y-1">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="font-bold text-xs sm:text-sm text-slate-900 truncate">{prod.name}</h3>
                <span class="text-xs text-slate-600">{prod.category}</span>
                {isCurrentlyFeatured(prod) && (
                  <span class="text-xs font-bold bg-amber-100 text-amber-950 border border-amber-300 px-1.5 py-0.5 rounded-md inline-flex items-center gap-1">
                    <AppIcon name="star" size="xs" />
                    <span>Unggulan</span>
                  </span>
                )}
                {prod.is_sold_out ? (
                  <span class="text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200 px-1.5 py-0.5 rounded-md">
                    Habis
                  </span>
                ) : prod.stock_status === 'po' ? (
                  <span class="text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-200 px-1.5 py-0.5 rounded-md">
                    Pre-Order
                  </span>
                ) : (
                  <span class="text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 px-1.5 py-0.5 rounded-md">
                    Ready
                  </span>
                )}
              </div>
              <div class="flex items-center gap-3 flex-wrap">
                <span class="text-xs font-bold text-slate-900 font-mono tabular-nums">{formatRupiah(prod.price)}</span>
                {prod.original_price && prod.original_price > prod.price ? (
                  <span class="text-xs text-slate-500 line-through font-mono tabular-nums">
                    {formatRupiah(prod.original_price)}
                  </span>
                ) : null}
                {prod.production_capacity ? (
                  <span class="text-xs text-slate-600 font-medium">
                    ({prod.production_capacity})
                  </span>
                ) : null}
                {prod.views ? (
                  <span class="inline-flex items-center gap-1 text-xs text-slate-600 font-mono tabular-nums">
                    <AppIcon name="eye" size="xs" />
                    <span>{prod.views}</span>
                  </span>
                ) : null}
              </div>
            </div>
          </div>

          {/* Quick Actions */}
          <div class="flex items-center gap-1.5 shrink-0 w-full sm:w-auto flex-wrap sm:flex-nowrap">
            <button
              type="button"
              data-action="bump"
              data-id={prod.id}
              title="Sundul ke posisi teratas"
              class="min-h-[40px] px-2.5 py-1 bg-slate-50 hover:bg-amber-50 text-slate-700 hover:text-amber-950 font-medium text-xs rounded-lg border border-slate-200 hover:border-amber-300 transition cursor-pointer inline-flex items-center gap-1"
            >
              <AppIcon name="zap" size="xs" />
              <span>Sundul</span>
            </button>

            <button
              type="button"
              data-action="edit-product"
              data-id={prod.id}
              data-name={prod.name}
              data-price={prod.price}
              data-original-price={prod.original_price || ''}
              data-category={prod.category}
              data-desc={prod.description || ''}
              data-shopee={prod.shopee_url || ''}
              data-stock-status={prod.stock_status || (prod.is_sold_out ? 'sold_out' : 'ready')}
              data-capacity={prod.production_capacity || ''}
              class="min-h-[40px] px-3 py-1 bg-white hover:bg-slate-100 text-slate-700 font-medium text-xs rounded-lg border border-slate-200 transition cursor-pointer"
            >
              Edit
            </button>

            <details class="relative">
              <summary class="min-h-[40px] list-none px-2.5 py-1 bg-white hover:bg-slate-100 text-slate-700 font-medium text-xs rounded-lg border border-slate-200 transition cursor-pointer inline-flex items-center gap-1 select-none">
                <span>Lainnya</span>
                <AppIcon name="chevron-down" size="xs" />
              </summary>
              <div class="absolute right-0 mt-1 w-48 bg-white border border-slate-200 rounded-lg shadow-lg p-1.5 z-30 flex flex-col gap-1 text-xs">
                <button
                  type="button"
                  data-action="promote-single"
                  data-id={prod.id}
                  data-name={prod.name}
                  class="w-full text-left px-2.5 py-2 rounded-md hover:bg-amber-50 text-amber-950 font-bold cursor-pointer inline-flex items-center gap-1.5"
                >
                  <AppIcon name="star" size="xs" class="text-amber-600" />
                  <span>Unggulkan Iklan</span>
                </button>
                <button
                  type="button"
                  data-action="record-sale"
                  data-title={`Penjualan ${prod.name}`}
                  data-amount={prod.price}
                  class="w-full text-left px-2.5 py-2 rounded-md hover:bg-emerald-50 text-emerald-800 font-medium cursor-pointer inline-flex items-center gap-1.5"
                >
                  <AppIcon name="plus" size="xs" />
                  <span>Catat ke Buku Kas</span>
                </button>
                <button
                  type="button"
                  data-action="toggle-stock"
                  data-id={prod.id}
                  class="w-full text-left px-2.5 py-2 rounded-md hover:bg-slate-50 text-slate-700 font-medium cursor-pointer"
                >
                  {prod.is_sold_out ? 'Tandai Tersedia' : 'Tandai Stok Habis'}
                </button>
                <a
                  href={`/produk/${prod.slug}`}
                  target="_blank"
                  class="w-full text-left px-2.5 py-2 rounded-md hover:bg-slate-50 text-slate-700 font-medium flex items-center justify-between"
                >
                  <span>Lihat Halaman</span>
                  <AppIcon name="external-link" size="xs" />
                </a>
                <button
                  type="button"
                  data-action="delete"
                  data-id={prod.id}
                  data-name={prod.name}
                  class="w-full text-left px-2.5 py-2 rounded-md hover:bg-rose-50 text-rose-700 font-semibold cursor-pointer border-t border-slate-100 mt-0.5 pt-2"
                >
                  Hapus Produk
                </button>
              </div>
            </details>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="py-12 text-center space-y-2">
      <p class="text-xs text-slate-600">Belum ada produk yang didaftarkan.</p>
      <a
        href="/pasang-iklan"
        class="min-h-[44px] py-2 px-4 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-lg transition inline-flex items-center gap-1.5"
      >
        <AppIcon name="plus" size="xs" />
        <span>Tambah Produk Pertama</span>
      </a>
    </div>
  )}

  {(adOrders.length > 0 || bumpLedger.length > 0) && (
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 pt-2">
      {adOrders.length > 0 && (
        <div class="border border-slate-200 rounded-lg p-4 space-y-3 bg-white">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100">
            <h3 class="text-xs font-bold text-slate-900">Riwayat Pengajuan Promosi</h3>
            <span class="text-xs text-slate-600 font-mono tabular-nums">{adOrders.length} pesanan</span>
          </div>
          <div class="divide-y divide-slate-100">
            {adOrders.slice(0, 6).map((order) => {
              const badge = promoStatusBadge[order.status] || promoStatusBadge.pending;
              return (
                <div class="py-2 flex items-start justify-between gap-2 text-xs">
                  <div class="min-w-0">
                    <div class="font-semibold text-slate-900 truncate">
                      {order.product_name || order.type}
                    </div>
                    <div class="text-xs text-slate-600">
                      <span class="font-mono tabular-nums">{formatRupiah(order.amount)}</span>
                      {order.expires_at ? ` • Berakhir ${new Date(order.expires_at).toLocaleDateString('id-ID')}` : ''}
                    </div>
                    {order.status === 'rejected' && order.notes && (
                      <div class="text-xs text-rose-700 mt-0.5">Alasan: {order.notes}</div>
                    )}
                  </div>
                  <span class={`text-xs font-semibold px-2 py-0.5 rounded-md border shrink-0 ${badge.cls}`}>
                    {badge.label}
                  </span>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {bumpLedger.length > 0 && (
        <div class="border border-slate-200 rounded-lg p-4 space-y-3 bg-white">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100">
            <h3 class="text-xs font-bold text-slate-900">Mutasi Token Sundul</h3>
            <span class="text-xs text-slate-600 font-mono tabular-nums">Saldo: {bumpCredits}</span>
          </div>
          <div class="divide-y divide-slate-100">
            {bumpLedger.map((item) => (
              <div class="py-2 flex items-center justify-between text-xs">
                <div>
                  <span class="font-medium text-slate-800 capitalize">
                    {item.reason === 'purchase' ? 'Isi ulang paket sundul' : item.reason === 'bump' ? 'Sundul produk' : item.reason}
                  </span>
                  <span class="text-xs text-slate-600 block font-mono tabular-nums">
                    {new Date(item.created_at).toLocaleString('id-ID')}
                  </span>
                </div>
                <div class="text-right font-mono tabular-nums">
                  <span class={item.delta >= 0 ? 'font-bold text-emerald-700' : 'font-bold text-amber-800'}>
                    {item.delta >= 0 ? `+${item.delta}` : item.delta}
                  </span>
                  <span class="block text-xs text-slate-600">Sisa {item.balance_after}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  )}
</section>
