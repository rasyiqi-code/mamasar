---
import { formatRupiah } from '../../lib/utils';
import AppIcon from '../common/AppIcon.astro';

interface Product {
  id: number;
  name: string;
  slug: string;
  price: number;
  original_price?: number | null;
  category: string;
  image_url: string;
  is_sold_out?: boolean | number | null;
  stock_status?: string | null;
  production_capacity?: string | null;
  views?: number;
  description?: string;
  shopee_url?: string;
  is_featured?: number | null;
  featured_until?: string | null;
}

interface Props {
  store: {
    id: number;
    name: string;
    bump_credits?: number;
    products?: Product[];
  };
}

const { store } = Astro.props;
const products = store.products || [];
const bumpCredits = store.bump_credits ?? 3;
---

<section id="panel-products" class="tab-panel space-y-4">
  <!-- Top Bar: Kuota Token Sundul & Actions -->
  <div class="p-3.5 sm:p-4 rounded-xl bg-gradient-to-r from-amber-50/70 via-slate-50 to-white border border-amber-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-2xs">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-xl bg-amber-400 text-slate-950 font-black text-sm flex items-center justify-center shrink-0 shadow-2xs">
        ⚡
      </div>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-bold text-slate-800">Kuota Token Sundul:</span>
          <span class="text-xs font-black font-mono px-2 py-0.5 rounded-md bg-amber-100 text-amber-950 border border-amber-300">
            {bumpCredits} Token
          </span>
        </div>
        <p class="text-[11px] text-slate-500 mt-0.5">
          1 token untuk sundul produk ke urutan pertama katalog seketika.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="btn-open-promo-modal"
        class="py-1.5 px-3 bg-amber-500 hover:bg-amber-600 active:bg-amber-700 text-slate-950 font-bold text-xs rounded-lg transition shadow-xs flex items-center gap-1.5 cursor-pointer"
      >
        <span>★ Pasang Iklan & Isi Token</span>
      </button>

      <a
        href="/pasang-iklan"
        class="py-1.5 px-3 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded-lg transition shadow-xs flex items-center gap-1 shrink-0"
      >
        <span>+ Tambah Produk</span>
      </a>
    </div>
  </div>

  <!-- Header with Products Count -->
  <div class="flex items-center justify-between pb-2 border-b border-slate-200">
    <div class="flex items-center gap-2.5">
      <h2 class="text-base sm:text-lg font-bold text-slate-900">Katalog Produk</h2>
      <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700">
        {products.length} produk
      </span>
    </div>
  </div>

  <!-- Product List: Compact Table/List with Line Dividers -->
  {products.length > 0 ? (
    <div class="divide-y divide-slate-100 border-b border-slate-200">
      {products.map((prod) => (
        <div class="py-2.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 hover:bg-slate-50/60 px-1 transition">
          <div class="flex items-center gap-3 min-w-0">
            <img
              src={prod.image_url}
              alt={prod.name}
              class={`w-11 h-11 rounded object-cover border border-slate-200 shrink-0 bg-slate-50 ${
                prod.is_sold_out ? 'grayscale opacity-75' : ''
              }`}
            />
            <div class="min-w-0 space-y-0.5">
              <div class="flex items-center gap-2 flex-wrap">
                <h2 class="font-bold text-xs sm:text-sm text-slate-900 truncate">{prod.name}</h2>
                <span class="text-[10px] text-slate-400 uppercase tracking-wider">{prod.category}</span>
                {prod.is_featured === 1 && (
                  <span class="text-[9px] font-bold bg-amber-100 text-amber-950 border border-amber-300 px-1.5 py-0.5 rounded flex items-center gap-0.5">
                    ★ Unggulan
                  </span>
                )}
                {prod.is_sold_out ? (
                  <span class="text-[9px] font-semibold bg-rose-50 text-rose-700 border border-rose-200 px-1.5 py-0.5 rounded">
                    Habis
                  </span>
                ) : prod.stock_status === 'po' ? (
                  <span class="text-[9px] font-semibold bg-amber-50 text-amber-700 border border-amber-200 px-1.5 py-0.5 rounded">
                    Pre-Order
                  </span>
                ) : (
                  <span class="text-[9px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 px-1.5 py-0.5 rounded">
                    Ready Stock
                  </span>
                )}
              </div>
              <div class="flex items-center gap-3">
                <span class="text-xs font-semibold text-slate-900 font-mono tracking-wider">{formatRupiah(prod.price)}</span>
                {prod.original_price && prod.original_price > prod.price ? (
                  <span class="text-[10px] text-slate-400 line-through font-mono">
                    {formatRupiah(prod.original_price)}
                  </span>
                ) : null}
                {prod.production_capacity ? (
                  <span class="text-[10px] text-slate-500 font-medium">
                    ({prod.production_capacity})
                  </span>
                ) : null}
                {prod.views ? (
                  <span class="inline-flex items-center gap-1 text-[10px] text-slate-400">
                    <AppIcon name="eye" size="xs" />
                    <span>{prod.views}</span>
                  </span>
                ) : null}
              </div>
            </div>
          </div>

          <!-- Quick Actions: Compact -->
          <div class="flex items-center gap-1.5 shrink-0 w-full sm:w-auto flex-wrap sm:flex-nowrap">
            <button
              type="button"
              data-action="promote-single"
              data-id={prod.id}
              data-name={prod.name}
              title="Promosikan produk ini jadi iklan unggulan"
              class="px-2 py-1 bg-amber-50 hover:bg-amber-100 text-amber-950 font-bold text-xs rounded border border-amber-300 transition cursor-pointer inline-flex items-center gap-1"
            >
              <span>★ Unggulkan</span>
            </button>

            <button
              type="button"
              data-action="bump"
              data-id={prod.id}
              title="Sundul ke posisi teratas"
              class="px-2 py-1 bg-slate-50 hover:bg-amber-50 text-slate-700 hover:text-amber-950 font-medium text-xs rounded border border-slate-200 hover:border-amber-300 transition cursor-pointer inline-flex items-center gap-1"
            >
              <AppIcon name="zap" size="xs" />
              <span>Sundul</span>
            </button>

            <button
              type="button"
              data-action="edit-product"
              data-id={prod.id}
              data-name={prod.name}
              data-price={prod.price}
              data-original-price={prod.original_price || ''}
              data-category={prod.category}
              data-desc={prod.description || ''}
              data-shopee={prod.shopee_url || ''}
              data-stock-status={prod.stock_status || (prod.is_sold_out ? 'sold_out' : 'ready')}
              data-capacity={prod.production_capacity || ''}
              class="px-2 py-1 bg-white hover:bg-slate-100 text-slate-700 font-medium text-xs rounded border border-slate-200 transition cursor-pointer"
            >
              Edit
            </button>

            <button
              type="button"
              data-action="record-sale"
              data-title={`Penjualan ${prod.name}`}
              data-amount={prod.price}
              class="px-2 py-1 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 font-medium text-xs rounded border border-emerald-200 transition cursor-pointer"
            >
              + Kas
            </button>

            <button
              type="button"
              data-action="toggle-stock"
              data-id={prod.id}
              class={`px-2 py-1 font-medium text-xs rounded border transition cursor-pointer ${
                prod.is_sold_out
                  ? 'bg-emerald-50 text-emerald-800 border-emerald-200 hover:bg-emerald-100'
                  : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-100'
              }`}
            >
              {prod.is_sold_out ? 'Tersedia' : 'Habis'}
            </button>

            <a
              href={`/p/${prod.slug}`}
              target="_blank"
              class="px-2 py-1 text-slate-500 hover:text-slate-900 text-xs font-medium"
            >
              Lihat ➔
            </a>

            <button
              type="button"
              data-action="delete"
              data-id={prod.id}
              data-name={prod.name}
              class="p-1 text-slate-400 hover:text-rose-600 rounded transition cursor-pointer"
              title="Hapus Produk"
            >
              <AppIcon name="trash" size="xs" />
            </button>
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="py-12 text-center space-y-2">
      <p class="text-xs text-slate-400">Belum ada produk yang didaftarkan.</p>
      <a
        href="/pasang-iklan"
        class="py-1.5 px-3.5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded transition shadow-xs inline-block"
      >
        + Tambah Produk Pertama
      </a>
    </div>
  )}
</section>
