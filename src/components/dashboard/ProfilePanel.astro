---
interface Props {
  store: {
    id: number;
    name: string;
    phone: string;
    zone_id: number;
    address?: string | null;
  };
  zones: Array<{ id: number; name: string }>;
}

const { store, zones } = Astro.props;
---

<section id="panel-profile" class="tab-panel hidden space-y-4">
  <!-- Top Bar: Compact Header with Line Divider -->
  <div class="flex items-center justify-between pb-3 border-b border-slate-200">
    <div class="flex items-center gap-2.5">
      <h1 class="text-base sm:text-lg font-bold text-slate-900">Profil & Data Toko</h1>
      <span class="text-xs font-mono font-medium px-2 py-0.5 rounded bg-slate-100 text-slate-600">
        ID #{store.id}
      </span>
    </div>
  </div>

  <form id="edit-store-form" class="space-y-4 max-w-3xl">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-1">
        <label for="editStoreName" class="block text-xs font-medium text-slate-700">
          Nama Usaha / Toko <span class="text-rose-500">*</span>
        </label>
        <input
          type="text"
          id="editStoreName"
          name="name"
          value={store.name}
          required
          class="w-full bg-white border border-slate-300 rounded p-2 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
        />
      </div>

      <div class="space-y-1">
        <label for="editStorePhone" class="block text-xs font-medium text-slate-700">
          Nomor WhatsApp <span class="text-rose-500">*</span>
        </label>
        <input
          type="tel"
          id="editStorePhone"
          name="phone"
          value={store.phone}
          required
          class="w-full bg-white border border-slate-300 rounded p-2 text-xs text-slate-900 font-mono focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
        />
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="space-y-1">
        <label for="editStoreZone" class="block text-xs font-medium text-slate-700">
          Wilayah MWC NU <span class="text-rose-500">*</span>
        </label>
        <select
          id="editStoreZone"
          name="zoneId"
          required
          class="w-full bg-white border border-slate-300 rounded p-2 text-xs font-medium text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600 cursor-pointer"
        >
          {zones.map((z) => (
            <option value={z.id} selected={z.id === store.zone_id}>
              {z.name}
            </option>
          ))}
        </select>
      </div>

      <div class="space-y-1">
        <label for="editStoreAddress" class="block text-xs font-medium text-slate-700">
          Alamat Lengkap
        </label>
        <input
          type="text"
          id="editStoreAddress"
          name="address"
          value={store.address || ''}
          placeholder="Contoh: Jl. Raya Gapura No. 12"
          class="w-full bg-white border border-slate-300 rounded p-2 text-xs text-slate-900 focus:border-emerald-600 focus:ring-1 focus:ring-emerald-600"
        />
      </div>
    </div>

    <div class="pt-2 border-t border-slate-100">
      <button
        type="submit"
        id="btn-submit-edit-store"
        class="py-1.5 px-5 bg-emerald-700 hover:bg-emerald-800 text-white font-semibold text-xs rounded shadow-xs transition cursor-pointer"
      >
        Simpan Perubahan ➔
      </button>
    </div>
  </form>
</section>
