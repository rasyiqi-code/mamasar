---
import '../styles/global.css';
import { SITE_CONFIG } from '../lib/constants';
import { getAllZones } from '../lib/db';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  schema?: Record<string, any>;
  hideMobileNav?: boolean;
}

const {
  title,
  description = SITE_CONFIG.description,
  image = SITE_CONFIG.defaultOgImage,
  canonicalUrl = Astro.url.href,
  schema,
  hideMobileNav = false,
} = Astro.props;

const siteName = SITE_CONFIG.name;
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
const zones = getAllZones();
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="id" class="h-full bg-[#f8fafc] text-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- PWA & Mobile Meta Tags -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#059669" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Pasar NU" />

    <!-- Open Graph / WhatsApp / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class={`min-h-full flex flex-col font-sans antialiased bg-[#f8fafc] text-slate-900 ${hideMobileNav ? '' : 'pb-16 md:pb-0'}`}>
    
    <!-- Top Classifieds Header (OsClass Light Aesthetic) -->
    <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200/90 shadow-xs">
      <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-3 flex items-center justify-between gap-4">
        
        <!-- Mobile Hamburger Button & Brand Logo -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <button
            id="open-mobile-drawer"
            type="button"
            aria-label="Buka Menu Drawer"
            class="lg:hidden p-1.5 text-slate-600 hover:text-slate-900 rounded-lg focus:outline-none cursor-pointer"
          >
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>

          <a href="/" class="flex items-center gap-2.5 group">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-emerald-600 flex items-center justify-center font-black text-sm text-white shadow-sm group-hover:bg-emerald-500 transition">
              NU
            </div>
            <div>
              <div class="font-black text-sm sm:text-base tracking-tight leading-none text-slate-900 flex items-center gap-2">
                <span>Pasar Warga NU</span>
                <span class="text-[9px] sm:text-[10px] bg-emerald-50 text-emerald-700 border border-emerald-200 px-1.5 py-0.5 rounded font-bold uppercase tracking-wider">
                  Sumenep
                </span>
              </div>
              <p class="text-[10px] sm:text-xs text-slate-500 mt-0.5">Direktori Iklan UMKM Nahdliyin</p>
            </div>
          </a>
        </div>

        <!-- Desktop Navigation Links (OsClass Header Style with Icons) -->
        <nav aria-label="Navigasi Utama" class="hidden lg:flex items-center gap-5 text-xs font-semibold text-slate-600">
          <a href="/" class="hover:text-emerald-700 transition flex items-center gap-1.5">
            <span>📋</span>
            <span>Katalog</span>
          </a>
          <a href="/toko" class="hover:text-emerald-700 transition flex items-center gap-1.5">
            <span>🏪</span>
            <span>Toko Warga</span>
          </a>
          <a href="/kegiatan" class="hover:text-emerald-700 transition flex items-center gap-1.5">
            <span>🎪</span>
            <span>Kegiatan NU</span>
          </a>
          <a href="/edukasi" class="hover:text-emerald-700 transition flex items-center gap-1.5">
            <span>📖</span>
            <span>Panduan</span>
          </a>
          <a href="/favorit" class="hover:text-emerald-700 transition flex items-center gap-1.5">
            <span>⭐</span>
            <span>Favorit</span>
          </a>
          <a href="/?zona=mwc-kota-sumenep" class="hover:text-emerald-700 transition flex items-center gap-1.5">
            <span>📍</span>
            <span>MWC Kota</span>
          </a>
        </nav>

        <!-- Right Side: Post Ad Button (OsClass "+ Place an ad" Button) -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <a
            href="/dashboard"
            class="hidden sm:inline-flex items-center gap-1 text-xs text-slate-700 hover:text-emerald-700 font-bold transition px-2.5 py-1.5 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100"
          >
            <span>🏪</span>
            <span>Dashboard UMKM</span>
          </a>
          <a
            href="/agen"
            class="bg-[#4f46e5] hover:bg-[#4338ca] text-white font-black text-xs sm:text-sm px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-full shadow-sm transition flex items-center gap-1.5 active:scale-98"
          >
            <span class="text-base leading-none font-black">+</span>
            <span class="hidden sm:inline">Pasang Iklan</span>
            <span class="sm:hidden">Iklan</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Mobile Slide-out Drawer (Light Theme) -->
    <div id="mobile-drawer-backdrop" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden transition-opacity"></div>
    <aside
      id="mobile-drawer"
      class="fixed top-0 left-0 bottom-0 w-72 max-w-[85vw] bg-white border-r border-slate-200 z-50 transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col justify-between hidden shadow-2xl"
    >
      <!-- User / Brand Drawer Header -->
      <div class="p-4 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-emerald-600 flex items-center justify-center font-black text-white text-xs shadow-sm">
            NU
          </div>
          <div>
            <h3 class="text-xs font-black text-slate-900">Ahlan wa Sahlan!</h3>
            <p class="text-[10px] text-slate-500">Pasar Warga NU Sumenep</p>
          </div>
        </div>
        <button id="close-mobile-drawer" aria-label="Tutup Menu" class="text-slate-400 hover:text-slate-700 text-base p-1 cursor-pointer">
          ✕
        </button>
      </div>

      <!-- Drawer Nav Links -->
      <div class="p-3.5 space-y-1.5 flex-1 overflow-y-auto text-xs font-semibold text-slate-700">
        <a href="/dashboard" class="flex items-center gap-2.5 p-2.5 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 font-bold hover:bg-emerald-100 transition shadow-2xs">
          <span>🏪</span>
          <span>Dashboard Toko Saya (Login)</span>
        </a>
        <a href="/agen" class="flex items-center gap-2.5 p-2.5 rounded-xl bg-indigo-600 text-white font-black shadow-sm">
          <span class="text-base leading-none font-black">+</span>
          <span>Pasang Iklan Cepat (Agen)</span>
        </a>
        <a href="/" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition">
          <span>📋</span>
          <span>Katalog Iklan</span>
        </a>
        <a href="/toko" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition">
          <span>🏪</span>
          <span>Toko & Pengrajin Warga NU</span>
        </a>
        <a href="/kegiatan" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition">
          <span>🎪</span>
          <span>Pasar Kegiatan & Konsumsi NU</span>
        </a>
        <a href="/favorit" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition">
          <span>⭐</span>
          <span>Iklan Favorit Tersimpan</span>
        </a>
        <a href="/edukasi" class="flex items-center gap-2.5 p-2.5 rounded-xl hover:bg-slate-100 hover:text-slate-900 transition">
          <span>📖</span>
          <span>Panduan & Edukasi Santri</span>
        </a>

        <div class="pt-3 pb-1 text-[10px] uppercase font-bold text-slate-400 tracking-wider">
          Wilayah MWC NU Sumenep ({zones.length} Zona)
        </div>
        {zones.map((z) => (
          <a href={`/?zona=${z.slug}`} class="flex items-center gap-2.5 p-2 rounded-lg hover:bg-slate-100 text-slate-700">
            <span>📍</span> {z.name}
          </a>
        ))}
      </div>

      <!-- Drawer Footer -->
      <div class="p-3.5 border-t border-slate-200 bg-slate-50 text-xs">
        <a href="/agen" class="flex items-center justify-between text-emerald-700 font-bold hover:text-emerald-800">
          <span>Masuk Portal Agen Lapangan</span>
          <span>➔</span>
        </a>
      </div>
    </aside>

    <!-- Main Content Area: Zero margin on mobile (full-edge), Centered Container on Desktop -->
    <main class="flex-1 w-full mx-auto px-0 sm:px-6 lg:px-8 max-w-7xl">
      <slot />
    </main>

    <!-- Pre-Footer Strip (OsClass Blue Bar Signature) -->
    <section class="bg-[#4361ee] text-white py-6 sm:py-7 border-t border-indigo-500/30 mt-12 shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-center sm:text-left">
        <div class="space-y-0.5">
          <h2 class="text-base sm:text-lg font-black tracking-tight text-white">Punya Usaha atau Produk Warga NU di Sumenep?</h2>
          <p class="text-xs sm:text-sm text-indigo-100">
            Daftarkan produk Anda sekarang secara gratis agar langsung tampil di Google dan terhubung ke WhatsApp pembeli.
          </p>
        </div>
        <a
          href="/agen"
          class="shrink-0 bg-white hover:bg-slate-100 text-[#4361ee] font-black text-xs sm:text-sm px-5 py-2.5 rounded-full shadow-md transition active:scale-98"
        >
          + Pasang Iklan Sekarang
        </a>
      </div>
    </section>

    <!-- OsClass Light Classified Footer -->
    <footer class="bg-white border-t border-slate-200 py-10 text-xs text-slate-600">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
        
        <!-- Col 1: About -->
        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <div class="w-7 h-7 rounded-lg bg-emerald-600 flex items-center justify-center font-bold text-xs text-white">
              NU
            </div>
            <span class="font-extrabold text-sm text-slate-900">Pasar Warga NU</span>
          </div>
          <p class="text-xs text-slate-600 leading-relaxed">
            Portal direktori iklan baris digital untuk memajukan produk UMKM nahdliyin Kabupaten Sumenep. Transaksi langsung ke penjual tanpa perantara.
          </p>
          <div class="text-[11px] text-slate-500 space-y-1 pt-1">
            <p>📍 {SITE_CONFIG.address}</p>
            <p>📞 WhatsApp: +62 812-3456-7890</p>
          </div>
        </div>

        <!-- Col 2: Kategori Iklan -->
        <div class="space-y-2.5">
          <h3 class="font-bold text-xs uppercase tracking-wider text-slate-900">Kategori Iklan</h3>
          <ul class="space-y-1.5 text-xs text-slate-600">
            <li><a href="/?kategori=Makanan%20%26%20Minuman" class="hover:text-emerald-700 transition">Makanan & Minuman Khas</a></li>
            <li><a href="/?kategori=Batik%20%26%20Kerajinan" class="hover:text-emerald-700 transition">Batik & Kerajinan Madura</a></li>
            <li><a href="/?kategori=Hasil%20Laut%20%26%20Olahan" class="hover:text-emerald-700 transition">Hasil Laut, Ikan & Petis</a></li>
            <li><a href="/?kategori=Pertanian%20%26%20Perkebunan" class="hover:text-emerald-700 transition">Pertanian & Siwalan Nira</a></li>
            <li><a href="/?kategori=Fashion%20Muslim" class="hover:text-emerald-700 transition">Fashion & Busana Muslim</a></li>
            <li><a href="/?kategori=Herbal%20%26%20Jamu" class="hover:text-emerald-700 transition">Herbal & Ramuan Jamu</a></li>
          </ul>
        </div>

        <!-- Col 3: Wilayah MWC NU -->
        <div class="space-y-2.5">
          <h3 class="font-bold text-xs uppercase tracking-wider text-slate-900">Wilayah MWC NU</h3>
          <ul class="space-y-1.5 text-xs text-slate-600">
            {zones.slice(0, 8).map((z) => (
              <li>
                <a href={`/?zona=${z.slug}`} class="hover:text-emerald-700 transition">
                  {z.name}
                </a>
              </li>
            ))}
            {zones.length > 8 && (
              <li>
                <a href="/?zona=semua" class="text-emerald-700 font-bold hover:underline">
                  Lihat Semua {zones.length} MWC ➔
                </a>
              </li>
            )}
          </ul>
        </div>

        <!-- Col 4: Informasi & Bantuan -->
        <div class="space-y-2.5">
          <h3 class="font-bold text-xs uppercase tracking-wider text-slate-900">Informasi & Bantuan</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Pendataan dilakukan secara jemput bola oleh kader MWC NU untuk menjamin keaslian pelaku usaha nahdliyin.
          </p>
          <div class="pt-2">
            <a
              href="/agen"
              class="inline-block text-xs font-bold text-emerald-700 hover:text-emerald-800 underline"
            >
              Masuk Portal Agen Lapangan ➔
            </a>
          </div>
          <div class="pt-2">
            <span class="inline-block bg-slate-100 text-slate-700 px-2.5 py-1 rounded text-[11px] border border-slate-200">
              Kabupaten Sumenep, Madura
            </span>
          </div>
        </div>

      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 mt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-slate-500 text-[11px]">
        <p>© {currentYear} Pasar Digital Warga NU Kabupaten Sumenep. Seluruh hak cipta dilindungi.</p>
        <div class="flex items-center gap-4">
          <a href="/sitemap.xml" target="_blank" class="hover:text-slate-800">Sitemap XML</a>
          <span>•</span>
          <a href="/robots.txt" target="_blank" class="hover:text-slate-800">Robots.txt</a>
        </div>
      </div>
    </footer>

    <!-- Mobile Bottom Navigation Bar (OsClass 5-Button Light Theme) -->
    {!hideMobileNav && (
      <nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-xl px-2 py-1 pb-[calc(0.5rem+env(safe-area-inset-bottom,0px))] flex items-center justify-around">
        <a href="/" class="flex flex-col items-center gap-0.5 text-slate-600 hover:text-emerald-700 font-bold text-[10px] py-1">
          <span class="text-base leading-none">🏠</span>
          <span>Beranda</span>
        </a>
        <a href="/kegiatan" class="flex flex-col items-center gap-0.5 text-slate-600 hover:text-emerald-700 font-bold text-[10px] py-1">
          <span class="text-base leading-none">🎪</span>
          <span>Kegiatan</span>
        </a>
        
        <!-- Elevated Center Plus Button (OsClass Blue Center CTA) -->
        <a
          href="/agen"
          aria-label="Pasang Iklan Produk"
          class="w-12 h-12 -mt-5 rounded-full bg-[#4f46e5] text-white flex items-center justify-center text-2xl font-black shadow-lg border-4 border-white active:scale-95 transition"
        >
          +
        </a>

        <a href="/toko" class="flex flex-col items-center gap-0.5 text-slate-600 hover:text-emerald-700 font-bold text-[10px] py-1">
          <span class="text-base leading-none">🏪</span>
          <span>Toko</span>
        </a>
        <a href="/favorit" class="flex flex-col items-center gap-0.5 text-slate-600 hover:text-emerald-700 font-bold text-[10px] py-1">
          <span class="text-base leading-none">⭐</span>
          <span>Favorit</span>
        </a>
      </nav>
    )}

    <!-- Global Toast Feedback Container -->
    <div
      id="mamasar-toast"
      class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 bg-slate-900/95 text-white text-xs font-bold px-4 py-2.5 rounded-full shadow-2xl transition-all duration-300 opacity-0 pointer-events-none translate-y-2 backdrop-blur-sm flex items-center gap-2 border border-slate-800"
      role="status"
      aria-live="polite"
    >
      <span id="mamasar-toast-msg">Notifikasi</span>
    </div>

    <!-- Favorite Syncer & Drawer Script -->
    <script>
      // Drawer Logic
      const openDrawerBtn = document.getElementById('open-mobile-drawer');
      const closeDrawerBtn = document.getElementById('close-mobile-drawer');
      const drawer = document.getElementById('mobile-drawer');
      const backdrop = document.getElementById('mobile-drawer-backdrop');

      function openDrawer() {
        if (!drawer || !backdrop) return;
        drawer.classList.remove('hidden');
        backdrop.classList.remove('hidden');
        requestAnimationFrame(() => {
          drawer.classList.remove('-translate-x-full');
        });
      }

      function closeDrawer() {
        if (!drawer || !backdrop) return;
        drawer.classList.add('-translate-x-full');
        setTimeout(() => {
          drawer.classList.add('hidden');
          backdrop.classList.add('hidden');
        }, 300);
      }

      openDrawerBtn?.addEventListener('click', openDrawer);
      closeDrawerBtn?.addEventListener('click', closeDrawer);
      backdrop?.addEventListener('click', closeDrawer);

      // Global Favorite Sync & Toast System
      function initMamasarFavorites() {
        const toast = document.getElementById('mamasar-toast');
        const toastMsg = document.getElementById('mamasar-toast-msg');
        let toastTimeout: any;

        function showToast(msg: string) {
          if (!toast || !toastMsg) return;
          toastMsg.textContent = msg;
          toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-2');
          toast.classList.add('opacity-100', 'translate-y-0');
          clearTimeout(toastTimeout);
          toastTimeout = setTimeout(() => {
            toast.classList.remove('opacity-100', 'translate-y-0');
            toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-2');
          }, 2000);
        }

        function getFavorites(): number[] {
          try {
            return JSON.parse(localStorage.getItem('mamasar_favorites') || '[]');
          } catch {
            return [];
          }
        }

        function saveFavorites(favs: number[]) {
          localStorage.setItem('mamasar_favorites', JSON.stringify(favs));
        }

        function syncButtonStyles() {
          const favs = getFavorites();
          document.querySelectorAll<HTMLElement>('[data-fav-btn]').forEach((btn) => {
            const id = Number(btn.getAttribute('data-id'));
            if (!id) return;
            const isFav = favs.includes(id);
            if (isFav) {
              btn.classList.add('text-amber-500', 'bg-amber-50', 'border-amber-300');
              btn.classList.remove('text-slate-400');
            } else {
              btn.classList.remove('text-amber-500', 'bg-amber-50', 'border-amber-300');
              btn.classList.add('text-slate-400');
            }
          });
        }

        // Handle button clicks delegation
        document.addEventListener('click', (e) => {
          const target = (e.target as HTMLElement)?.closest('[data-fav-btn]') as HTMLElement | null;
          if (!target) return;

          e.preventDefault();
          e.stopPropagation();

          const id = Number(target.getAttribute('data-id'));
          if (!id) return;

          const favs = getFavorites();
          const idx = favs.indexOf(id);
          let isNowFav = false;

          if (idx > -1) {
            favs.splice(idx, 1);
            isNowFav = false;
          } else {
            favs.push(id);
            isNowFav = true;
          }

          saveFavorites(favs);
          syncButtonStyles();
          showToast(isNowFav ? '⭐ Disimpan ke Favorit' : 'Dihapus dari Favorit');
        });

        syncButtonStyles();
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMamasarFavorites);
      } else {
        initMamasarFavorites();
      }
    </script>
  </body>
</html>
