---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  schema?: Record<string, any>;
  hideMobileNav?: boolean;
}

const {
  title,
  description = 'Direktori Resmi Produk UMKM Nahdliyin Kabupaten Sumenep - Dukung ekonomi tetangga, transaksi langsung tanpa perantara.',
  image = '/og-image.jpg',
  canonicalUrl = Astro.url.href,
  schema,
  hideMobileNav = false,
} = Astro.props;

const siteName = 'Pasar Warga NU Sumenep';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="id" class="h-full bg-slate-100 text-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / WhatsApp / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class={`min-h-full flex flex-col font-sans antialiased ${hideMobileNav ? '' : 'pb-16 md:pb-0'}`}>
    
    <!-- Top Header Bar (Full edge on mobile, standard max-width on desktop) -->
    <header class="sticky top-0 z-30 bg-emerald-700 text-white shadow-md border-b border-emerald-800/40">
      <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-2.5 sm:py-3 flex items-center justify-between">
        
        <!-- Brand Logo & Title -->
        <a href="/" class="flex items-center gap-2.5 sm:gap-3 group">
          <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-xl bg-white/15 border border-white/20 flex items-center justify-center font-black text-xs sm:text-sm text-emerald-100 group-hover:bg-white/25 transition shrink-0">
            NU
          </div>
          <div>
            <div class="font-extrabold text-sm sm:text-base tracking-tight leading-none flex items-center gap-1.5">
              <span>Pasar Warga NU</span>
              <span class="text-[9px] sm:text-[10px] bg-emerald-500/40 text-emerald-100 px-1.5 py-0.5 rounded font-bold uppercase tracking-wider">Sumenep</span>
            </div>
            <p class="text-[10px] sm:text-xs text-emerald-200 mt-0.5">Direktori Digital UMKM Nahdliyin</p>
          </div>
        </a>

        <!-- Desktop Navigation & Actions (Standard Desktop) -->
        <div class="hidden md:flex items-center gap-6 text-sm">
          <a href="/" class="font-medium text-emerald-100 hover:text-white transition">
            Katalog Produk
          </a>
          <a href="/?zona=mwc-kota-sumenep" class="font-medium text-emerald-100 hover:text-white transition">
            MWC Kota
          </a>
          <a href="/?zona=mwc-gapura" class="font-medium text-emerald-100 hover:text-white transition">
            MWC Gapura
          </a>
          <a href="/?zona=mwc-kalianget" class="font-medium text-emerald-100 hover:text-white transition">
            MWC Kalianget
          </a>
          <a
            href="/agen"
            class="bg-white text-emerald-800 font-bold px-3.5 py-2 rounded-xl shadow-xs hover:bg-emerald-50 transition flex items-center gap-1.5"
          >
            <span>+</span>
            <span>Input Produk Agen</span>
          </a>
        </div>

        <!-- Mobile Header Quick Action (Small badge) -->
        <div class="md:hidden flex items-center gap-2">
          <a
            href="/agen"
            class="text-[11px] bg-white/15 hover:bg-white/25 text-white font-bold px-2.5 py-1.5 rounded-lg border border-white/20 transition flex items-center gap-1"
          >
            <span>+ Agen</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content Area: Zero margin/padding on mobile (full-edge), Centered Standard Container on Desktop -->
    <main class="flex-1 w-full mx-auto px-0 sm:px-6 lg:px-8 max-w-7xl">
      <slot />
    </main>

    <!-- Standard Desktop Footer (Hidden on mobile) -->
    <footer class="hidden md:block bg-white border-t border-slate-200 mt-12 py-8 text-xs text-slate-500">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <p class="font-bold text-slate-700 text-sm">Pasar Digital UMKM Nahdliyin Kabupaten Sumenep</p>
          <p class="text-slate-500">Mendorong kemandirian ekonomi umat melalui transaksi langsung tanpa perantara.</p>
        </div>
        <div class="flex items-center gap-4 text-slate-600 font-medium">
          <a href="/" class="hover:text-emerald-700">Katalog</a>
          <span>•</span>
          <a href="/agen" class="hover:text-emerald-700">Portal Pendata</a>
          <span>•</span>
          <a href="/sitemap.xml" target="_blank" class="hover:text-emerald-700">Sitemap XML</a>
        </div>
      </div>
    </footer>

    <!-- Mobile Bottom Navigation Bar (Edge-to-edge at bottom, hidden on desktop) -->
    {!hideMobileNav && (
      <nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-lg px-6 py-2 pb-[calc(0.5rem+env(safe-area-inset-bottom,0px))] flex items-center justify-around">
        <a href="/" class="flex flex-col items-center gap-1 text-emerald-700 font-bold text-[11px] py-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          <span>Katalog</span>
        </a>
        <a href="/agen" class="flex flex-col items-center gap-1 text-slate-500 hover:text-emerald-700 font-bold text-[11px] py-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Form Agen</span>
        </a>
      </nav>
    )}
  </body>
</html>
