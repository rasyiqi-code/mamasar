---
import '../styles/global.css';
import { PRODUCT_CATEGORIES } from '../lib/constants';
import { getAllZones } from '../lib/db';

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonicalUrl?: string;
  schema?: Record<string, any>;
  hideMobileNav?: boolean;
}

const {
  title,
  description = 'Direktori Resmi Produk UMKM Nahdliyin Kabupaten Sumenep - Dukung ekonomi tetangga, transaksi langsung tanpa perantara.',
  image = '/og-image.jpg',
  canonicalUrl = Astro.url.href,
  schema,
  hideMobileNav = false,
} = Astro.props;

const siteName = 'Pasar Warga NU Sumenep';
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;

const url = new URL(Astro.request.url);
const currentZone = url.searchParams.get('zona') || 'semua';
const currentSearch = url.searchParams.get('q') || '';
const currentCategory = url.searchParams.get('kategori') || 'semua';

const zones = getAllZones();
---

<!doctype html>
<html lang="id" class="h-full bg-slate-100 text-slate-900">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- SEO Meta Tags -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / WhatsApp / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body class={`min-h-full flex flex-col font-sans antialiased ${hideMobileNav ? '' : 'pb-16 md:pb-0'}`}>
    
    <!-- Top Classifieds Header (Desktop & Mobile) -->
    <header class="sticky top-0 z-30 bg-white border-b border-slate-200/90 shadow-xs">
      
      <!-- Top Row -->
      <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-2.5 sm:py-3.5 flex items-center justify-between gap-4">
        
        <!-- Brand Logo & Title -->
        <a href="/" class="flex items-center gap-2.5 sm:gap-3 shrink-0 group">
          <div class="w-9 h-9 sm:w-11 sm:h-11 rounded-xl bg-emerald-700 flex items-center justify-center font-black text-sm text-white shadow-xs group-hover:bg-emerald-800 transition">
            NU
          </div>
          <div>
            <div class="font-black text-sm sm:text-lg tracking-tight leading-none text-slate-900 flex items-center gap-1.5">
              <span>Pasar Warga NU</span>
              <span class="text-[9px] sm:text-[10px] bg-emerald-100 text-emerald-800 border border-emerald-300/80 px-1.5 py-0.5 rounded font-bold uppercase tracking-wider">
                Sumenep
              </span>
            </div>
            <p class="text-[10px] sm:text-xs text-slate-500 mt-0.5">Iklan Baris & Direktori UMKM Nahdliyin</p>
          </div>
        </a>

        <!-- Desktop Classified Search Bar (Center, Integrated Location & Keyword) -->
        <form method="GET" action="/" class="hidden md:flex flex-1 max-w-2xl items-center border-2 border-emerald-700 rounded-xl overflow-hidden bg-slate-50 shadow-xs">
          <!-- Location Dropdown -->
          <div class="relative border-r border-slate-200 bg-white shrink-0">
            <select
              name="zona"
              aria-label="Pilih Wilayah MWC"
              class="appearance-none bg-transparent pl-8 pr-7 py-2.5 text-xs font-bold text-slate-700 focus:outline-none cursor-pointer"
            >
              <option value="semua">Semua Wilayah</option>
              {zones.map((z) => (
                <option value={z.slug} selected={currentZone === z.slug}>
                  {z.name}
                </option>
              ))}
            </select>
            <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-emerald-700 pointer-events-none text-xs">
              📍
            </span>
            <span class="absolute right-2 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none text-[10px]">
              ▼
            </span>
          </div>

          <!-- Keyword Input -->
          <div class="relative flex-1 bg-white">
            <input
              type="text"
              name="q"
              value={currentSearch}
              placeholder="Cari produk di Sumenep: rengginang, batik, siwalan, petis..."
              class="w-full py-2.5 px-3 text-xs sm:text-sm text-slate-800 placeholder-slate-400 bg-transparent focus:outline-none"
            />
          </div>

          <!-- Search Button -->
          <button
            type="submit"
            aria-label="Cari Produk"
            class="bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs sm:text-sm px-5 py-2.5 flex items-center gap-1.5 transition cursor-pointer"
          >
            <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <span>Cari</span>
          </button>
        </form>

        <!-- Right Side: Post Ad / Agent Button -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <a
            href="/agen"
            class="bg-emerald-600 hover:bg-emerald-700 text-white font-extrabold text-xs sm:text-sm px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl shadow-xs transition flex items-center gap-1.5 active:scale-98"
          >
            <span class="text-base leading-none">+</span>
            <span class="hidden sm:inline">Input Produk Baru</span>
            <span class="sm:hidden">Input Produk</span>
          </a>
        </div>
      </div>

      <!-- Desktop Sub-Header Categories Bar (Classified Style) -->
      <div class="hidden md:block bg-slate-50 border-t border-slate-200/80">
        <div class="max-w-7xl mx-auto px-6 lg:px-8 flex items-center gap-6 py-2 text-xs font-semibold text-slate-600">
          <span class="text-slate-400 font-bold uppercase tracking-wider text-[10px]">
            Kategori:
          </span>
          <a
            href="/?kategori=semua"
            class={`hover:text-emerald-700 transition ${currentCategory === 'semua' ? 'text-emerald-700 font-bold' : ''}`}
          >
            Semua Kategori
          </a>
          {PRODUCT_CATEGORIES.map((cat) => (
            <a
              href={`/?kategori=${encodeURIComponent(cat)}${currentZone !== 'semua' ? `&zona=${currentZone}` : ''}`}
              class={`hover:text-emerald-700 transition ${currentCategory === cat ? 'text-emerald-700 font-bold' : ''}`}
            >
              {cat}
            </a>
          ))}
        </div>
      </div>
    </header>

    <!-- Main Content: Full-edge on mobile, Standard 2-column or centered container on desktop -->
    <main class="flex-1 w-full mx-auto px-0 sm:px-6 lg:px-8 max-w-7xl">
      <slot />
    </main>

    <!-- Standard Classified Desktop Footer -->
    <footer class="hidden md:block bg-white border-t border-slate-200 mt-12 py-8 text-xs text-slate-500">
      <div class="max-w-7xl mx-auto px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div class="space-y-1 text-center sm:text-left">
          <p class="font-bold text-slate-800 text-sm">Pasar Digital Warga NU Sumenep</p>
          <p class="text-slate-500">Direktori Iklan Baris UMKM Nahdliyin Se-Kabupaten Sumenep. Transaksi langsung via WhatsApp tanpa perantara.</p>
        </div>
        <div class="flex items-center gap-4 text-slate-600 font-medium">
          <a href="/" class="hover:text-emerald-700">Beranda</a>
          <span>•</span>
          <a href="/agen" class="hover:text-emerald-700">Form Agen Lapangan</a>
          <span>•</span>
          <a href="/sitemap.xml" target="_blank" class="hover:text-emerald-700">Sitemap XML</a>
        </div>
      </div>
    </footer>

    <!-- Mobile Bottom Navigation Bar (Edge-to-edge at bottom, hidden on desktop) -->
    {!hideMobileNav && (
      <nav class="md:hidden fixed bottom-0 inset-x-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 shadow-lg px-6 py-2 pb-[calc(0.5rem+env(safe-area-inset-bottom,0px))] flex items-center justify-around">
        <a href="/" class="flex flex-col items-center gap-1 text-emerald-700 font-bold text-[11px] py-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
          </svg>
          <span>Katalog</span>
        </a>
        <a href="/agen" class="flex flex-col items-center gap-1 text-slate-500 hover:text-emerald-700 font-bold text-[11px] py-1">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v3m0 0v3m0-3h3m-3 0H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <span>Form Agen</span>
        </a>
      </nav>
    )}
  </body>
</html>
