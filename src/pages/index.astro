---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import ZoneFilter from '../components/ZoneFilter.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import { getAllZones, getProducts } from '../lib/db';
import { PRODUCT_CATEGORIES } from '../lib/constants';

const url = new URL(Astro.request.url);
const currentZone = url.searchParams.get('zona') || 'semua';
const currentCategory = url.searchParams.get('kategori') || 'semua';
const searchQuery = url.searchParams.get('q') || '';

const zones = getAllZones();
const products = getProducts({
  zoneSlug: currentZone,
  category: currentCategory,
  search: searchQuery,
});
---

<Layout title="Katalog Produk UMKM NU Sumenep">
  <div class="space-y-3 sm:space-y-6 sm:py-6">
    
    <!-- Top Search & Banner Section -->
    <div class="bg-white sm:rounded-3xl border-b sm:border border-slate-200/80 p-3 sm:p-6 shadow-xs space-y-3 sm:space-y-4">
      
      <!-- Search Input (Edge-to-edge on mobile, Centered/Proportioned on Desktop) -->
      <form method="GET" action="/" class="relative">
        <input type="hidden" name="zona" value={currentZone} />
        <input type="hidden" name="kategori" value={currentCategory} />
        <div class="relative flex items-center">
          <input
            type="text"
            name="q"
            value={searchQuery}
            placeholder="Cari rengginang, batik, kopi, krupuk madura..."
            class="w-full bg-slate-50 sm:bg-white border border-slate-300 rounded-xl sm:rounded-2xl py-2.5 sm:py-3.5 pl-10 sm:pl-12 pr-10 text-xs sm:text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 shadow-xs"
          />
          <div class="absolute left-3 sm:left-4 text-slate-400 pointer-events-none">
            <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          {searchQuery && (
            <a
              href={`/?zona=${currentZone}&kategori=${currentCategory}`}
              aria-label="Hapus kata kunci pencarian"
              class="absolute right-3.5 text-slate-400 hover:text-slate-600 text-xs font-bold"
            >
              ✕
            </a>
          )}
        </div>
      </form>

      <!-- Sentimen Banner "Beli Tetangga" -->
      <div class="bg-gradient-to-r from-emerald-50 via-emerald-100/60 to-emerald-50 border border-emerald-200/80 rounded-xl sm:rounded-2xl p-2.5 sm:p-4 flex items-center sm:items-start gap-2.5 sm:gap-3.5">
        <div class="text-xl sm:text-2xl shrink-0">🤝</div>
        <div class="text-[11px] sm:text-xs text-emerald-950 leading-relaxed">
          <strong class="font-bold block text-xs sm:text-sm text-emerald-900">Gerakan Beli Produk Tetangga NU:</strong>
          Belanja langsung ke nomor WhatsApp pemilik usaha tanpa potongan aplikasi.
        </div>
      </div>
    </div>

    <!-- Filter 1: Wilayah Teritorial MWC NU (Modular Component) -->
    <ZoneFilter
      zones={zones}
      currentZone={currentZone}
      currentCategory={currentCategory}
      searchQuery={searchQuery}
    />

    <!-- Filter 2: Kategori Produk (Modular Component) -->
    <CategoryFilter
      categories={PRODUCT_CATEGORIES}
      currentCategory={currentCategory}
      currentZone={currentZone}
      searchQuery={searchQuery}
    />

    <!-- Status Bar & Count -->
    <div class="flex items-center justify-between text-[11px] sm:text-xs text-slate-500 px-3 sm:px-1">
      <span>Menampilkan <strong>{products.length}</strong> produk</span>
      {(currentZone !== 'semua' || currentCategory !== 'semua' || searchQuery !== '') && (
        <a href="/" class="text-emerald-700 font-bold hover:underline">
          Reset Filter
        </a>
      )}
    </div>

    <!-- Product Grid (Modular Card Component) -->
    {products.length > 0 ? (
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-4 md:gap-5 px-1.5 sm:px-0">
        {products.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
    ) : (
      <div class="bg-white border border-slate-200 sm:rounded-3xl p-8 text-center space-y-3 mx-2 sm:mx-0">
        <div class="text-4xl">🔍</div>
        <h3 class="font-bold text-slate-800 text-sm sm:text-base">Belum Ada Produk Ditemukan</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">
          Coba ubah kata kunci pencarian atau pilih wilayah MWC lainnya.
        </p>
        <a href="/" class="inline-block mt-2 text-xs font-bold bg-emerald-700 text-white px-4 py-2 rounded-xl">
          Kembali ke Semua Produk
        </a>
      </div>
    )}

  </div>
</Layout>
