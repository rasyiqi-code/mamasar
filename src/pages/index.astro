---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { getAllZones, getProducts, getAllUMKM } from '../lib/db';
import {
  PRODUCT_CATEGORIES,
  CATEGORY_ICONS,
  CATEGORY_BADGES,
  POPULAR_TAGS,
} from '../lib/constants';

const url = new URL(Astro.request.url);
const currentZone = url.searchParams.get('zona') || 'semua';
const currentCategory = url.searchParams.get('kategori') || 'semua';
const searchQuery = url.searchParams.get('q') || '';
const currentSort = url.searchParams.get('sort') || 'newest';

const zones = getAllZones();
const sellers = getAllUMKM();

// All products with current filters
const products = getProducts({
  zoneSlug: currentZone,
  category: currentCategory,
  search: searchQuery,
  sort: currentSort,
});

// Premium / Featured products (Top 4 products for the top showcase section)
const premiumProducts = products.slice(0, 4);

// Most favorited products (Middle showcase with seller avatars, items 4-8 or slice)
const favoritedProducts = products.length >= 8 ? products.slice(4, 8) : products.slice(0, 4);

const isFiltered = currentZone !== 'semua' || currentCategory !== 'semua' || searchQuery !== '';
---

<Layout title="Pasar Warga NU Sumenep | Direktori Iklan UMKM">
  <div class="space-y-8 sm:space-y-12 py-3 sm:py-6">

    <!-- 1. HERO SECTION: OsClass Headline + Large Central Search + Category Circles Hub -->
    <section class="text-center space-y-6 pt-3 sm:pt-6 px-3 sm:px-4">
      
      <!-- Big Classified Headline (OsClass Style: "What would you like to buy?") -->
      <div class="space-y-2">
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight">
          Mau beli apa dari <span class="text-[#5865f2] underline decoration-indigo-500/40">warga NU?</span>
        </h1>
        <p class="text-xs sm:text-sm text-slate-400 max-w-xl mx-auto">
          Temukan produk asli warga nahdliyin se-Kabupaten Sumenep. Transaksi langsung via WhatsApp tanpa perantara.
        </p>
      </div>

      <!-- Central Classified Search Bar with Location Dropdown -->
      <form
        method="GET"
        action="/"
        class="max-w-3xl mx-auto bg-[#151c28] border border-slate-700/80 rounded-2xl p-1.5 sm:p-2 shadow-2xl flex flex-col sm:flex-row items-center gap-2"
      >
        <!-- Location Dropdown inside search -->
        <div class="w-full sm:w-56 relative border-b sm:border-b-0 sm:border-r border-slate-700/70 shrink-0">
          <select
            name="zona"
            aria-label="Pilih Wilayah MWC"
            class="w-full appearance-none bg-transparent pl-8 pr-7 py-2.5 sm:py-3 text-xs sm:text-sm font-bold text-slate-200 focus:outline-none cursor-pointer"
          >
            <option value="semua" class="bg-slate-900 text-slate-100">Semua Wilayah MWC</option>
            {zones.map((z) => (
              <option value={z.slug} selected={currentZone === z.slug} class="bg-slate-900 text-slate-100">
                {z.name}
              </option>
            ))}
          </select>
          <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-indigo-400 text-xs sm:text-sm pointer-events-none">
            📍
          </span>
          <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[10px] pointer-events-none">
            ▼
          </span>
        </div>

        <!-- Keyword input -->
        <div class="relative w-full flex-1">
          <input
            type="text"
            name="q"
            value={searchQuery}
            placeholder="Cari rengginang, batik, siwalan, petis, jamu..."
            class="w-full py-2.5 sm:py-3 px-3 text-xs sm:text-sm text-white placeholder-slate-400 bg-transparent focus:outline-none"
          />
          {searchQuery && (
            <a
              href={`/?zona=${currentZone}&kategori=${currentCategory}`}
              aria-label="Hapus kata kunci"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-white font-bold text-xs"
            >
              ✕
            </a>
          )}
        </div>

        <!-- Submit Button in OsClass Indigo -->
        <button
          type="submit"
          class="w-full sm:w-auto bg-[#4f46e5] hover:bg-[#4338ca] text-white font-black text-xs sm:text-sm px-7 py-2.5 sm:py-3 rounded-xl transition flex items-center justify-center gap-2 shrink-0 cursor-pointer shadow-md active:scale-98"
        >
          <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <span>Cari Iklan</span>
        </button>
      </form>

      <!-- Popular Search Tag Pills (OsClass Style under Search Bar) -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 text-[11px] text-slate-400 max-w-2xl mx-auto">
        <span class="font-bold text-slate-500">Populer:</span>
        {POPULAR_TAGS.map((tag) => (
          <a
            href={`/?q=${encodeURIComponent(tag)}`}
            class="bg-[#141d2a] hover:bg-slate-800 border border-slate-800 text-slate-300 hover:text-indigo-400 px-2.5 py-1 rounded-full transition"
          >
            {tag}
          </a>
        ))}
      </div>

      <!-- Categories Circle Hub (OsClass Category Circles Row with Badges) -->
      <div class="pt-4 max-w-5xl mx-auto">
        <div class="text-left text-xs font-bold uppercase tracking-wider text-slate-400 mb-3 px-2 sm:px-0">
          Kategori Iklan
        </div>
        <div class="flex items-center justify-start sm:justify-center gap-3 sm:gap-6 overflow-x-auto pb-2 no-scrollbar px-2 sm:px-0">
          
          <!-- All Categories Circle -->
          <a
            href={`/?kategori=semua${currentZone !== 'semua' ? `&zona=${currentZone}` : ''}`}
            class="group flex flex-col items-center gap-2 shrink-0 text-center"
          >
            <div
              class={`relative w-14 h-14 sm:w-16 sm:h-16 rounded-full flex items-center justify-center text-xl sm:text-2xl transition border-2 ${
                currentCategory === 'semua'
                  ? 'bg-indigo-600/30 border-indigo-500 text-white shadow-lg shadow-indigo-950/50'
                  : 'bg-[#151f2e] border-slate-700/80 text-slate-300 group-hover:border-slate-500 group-hover:scale-105'
              }`}
            >
              🛍️
            </div>
            <span class={`text-[11px] sm:text-xs font-bold ${currentCategory === 'semua' ? 'text-indigo-400' : 'text-slate-300 group-hover:text-white'}`}>
              Semua
            </span>
          </a>

          <!-- Each Category Circle with Badge -->
          {PRODUCT_CATEGORIES.map((cat) => {
            const isActive = currentCategory === cat;
            const icon = CATEGORY_ICONS[cat] || '📦';
            const badge = CATEGORY_BADGES[cat];
            return (
              <a
                href={`/?kategori=${encodeURIComponent(cat)}${currentZone !== 'semua' ? `&zona=${currentZone}` : ''}`}
                class="group flex flex-col items-center gap-2 shrink-0 text-center"
              >
                <div
                  class={`relative w-14 h-14 sm:w-16 sm:h-16 rounded-full flex items-center justify-center text-xl sm:text-2xl transition border-2 ${
                    isActive
                      ? 'bg-indigo-600/30 border-indigo-500 text-white shadow-lg shadow-indigo-950/50'
                      : 'bg-[#151f2e] border-slate-700/80 text-slate-300 group-hover:border-slate-500 group-hover:scale-105'
                  }`}
                >
                  {icon}
                  {badge && (
                    <span
                      class={`absolute -top-1 -right-1 text-[8px] font-black uppercase px-1.5 py-0.2 rounded-full shadow-xs ${badge.color}`}
                    >
                      {badge.label}
                    </span>
                  )}
                </div>
                <span class={`text-[11px] sm:text-xs font-bold max-w-[85px] leading-tight truncate ${isActive ? 'text-indigo-400' : 'text-slate-300 group-hover:text-white'}`}>
                  {cat}
                </span>
              </a>
            );
          })}
        </div>
      </div>

    </section>

    <!-- 2. "TODAY'S PREMIUM SELECTION" (4-Column OsClass Premium Box with Cyan/Teal Border Accent) -->
    {premiumProducts.length > 0 && !isFiltered && (
      <section class="px-3 sm:px-0">
        <div class="bg-[#111724]/70 border-t-2 border-t-emerald-500 border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-xl space-y-4">
          <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
              <h2 class="text-base sm:text-lg font-black text-white tracking-tight">
                Produk Pilihan Warga NU Hari Ini
              </h2>
            </div>
            <span class="text-xs text-slate-400 font-medium hidden sm:inline">
              Pilihan Khusus Terverifikasi Kader NU
            </span>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
            {premiumProducts.map((p, index) => {
              const badges = ['Pilihan Hari Ini', 'Premium', 'Premium', 'Terlaris'];
              const badgeColors: ('indigo' | 'amber' | 'emerald')[] = ['indigo', 'amber', 'amber', 'emerald'];
              const photoCounts = [3, 4, 2, 2];
              const viewsList = [1191, 1806, 983, 1053];
              return (
                <ProductCard
                  product={p}
                  badge={badges[index]}
                  badgeColor={badgeColors[index]}
                  photoCount={photoCounts[index]}
                  views={viewsList[index]}
                />
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- 3. "NEWS ON BLOG" (OsClass Editorial Style: 3 Articles Grid) -->
    {!isFiltered && (
      <section id="panduan" class="space-y-4 px-3 sm:px-0">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-base sm:text-lg font-black text-white tracking-tight flex items-center gap-2">
              <span>📰</span> Kabar & Panduan UMKM Sumenep
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">Edukasi digital & panduan transaksi warga Nahdliyin</p>
          </div>
          <a
            href="/agen"
            class="text-xs font-bold text-slate-300 hover:text-white border border-slate-700 hover:border-slate-500 px-3 py-1.5 rounded-full transition hidden sm:inline-flex items-center gap-1"
          >
            <span>📖 Panduan Agen Lapangan</span>
            <span>➔</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4">
          <!-- Article 1 -->
          <div class="bg-[#141c2b] border border-slate-800 rounded-xl p-3 sm:p-4 flex gap-3 hover:border-slate-700 transition">
            <img
              src="https://images.unsplash.com/photo-1556742049-0a67c5574f73?auto=format&fit=crop&w=240&q=80"
              alt="Transaksi COD Aman"
              class="w-20 h-20 sm:w-24 sm:h-24 rounded-lg object-cover shrink-0"
              loading="lazy"
            />
            <div class="space-y-1">
              <span class="text-[10px] font-bold text-emerald-400 uppercase tracking-wider">Tips Transaksi</span>
              <h3 class="font-extrabold text-xs sm:text-sm text-slate-100 hover:text-emerald-400 line-clamp-2">
                Panduan Transaksi COD Aman di Sumenep
              </h3>
              <p class="text-[11px] text-slate-400 line-clamp-2">
                Tips ketemuan langsung dengan penjual warga NU, cek fisik barang, dan bayar di tempat.
              </p>
            </div>
          </div>

          <!-- Article 2 -->
          <div class="bg-[#141c2b] border border-slate-800 rounded-xl p-3 sm:p-4 flex gap-3 hover:border-slate-700 transition">
            <img
              src="https://images.unsplash.com/photo-1544717305-2782549b5136?auto=format&fit=crop&w=240&q=80"
              alt="Beli Produk Tetangga"
              class="w-20 h-20 sm:w-24 sm:h-24 rounded-lg object-cover shrink-0"
              loading="lazy"
            />
            <div class="space-y-1">
              <span class="text-[10px] font-bold text-indigo-400 uppercase tracking-wider">Gerakan Warga</span>
              <h3 class="font-extrabold text-xs sm:text-sm text-slate-100 hover:text-indigo-400 line-clamp-2">
                Gerakan Belanja Produk Tetangga Nahdliyin
              </h3>
              <p class="text-[11px] text-slate-400 line-clamp-2">
                Memperkuat ekonomi lokal Sumenep dengan memprioritaskan belanja dari warung tetangga sendiri.
              </p>
            </div>
          </div>

          <!-- Article 3 -->
          <div class="bg-[#141c2b] border border-slate-800 rounded-xl p-3 sm:p-4 flex gap-3 hover:border-slate-700 transition">
            <img
              src="https://images.unsplash.com/photo-1531497865144-0464ef8fb9a9?auto=format&fit=crop&w=240&q=80"
              alt="Pendaftaran Produk UMKM"
              class="w-20 h-20 sm:w-24 sm:h-24 rounded-lg object-cover shrink-0"
              loading="lazy"
            />
            <div class="space-y-1">
              <span class="text-[10px] font-bold text-amber-400 uppercase tracking-wider">Pemberdayaan</span>
              <h3 class="font-extrabold text-xs sm:text-sm text-slate-100 hover:text-amber-400 line-clamp-2">
                Cara Mendaftarkan Produk via Agen MWC
              </h3>
              <p class="text-[11px] text-slate-400 line-clamp-2">
                Hanya 90 detik melalui agen lapangan NU kecamatan, produk toko langsung tampil online.
              </p>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- 4. MIDDLE PROMOTIONAL BANNER (OsClass Middle Ad Style: hosting.com Style Banner) -->
    <section class="px-3 sm:px-0">
      <div class="bg-gradient-to-r from-[#0d2a1c] via-[#112433] to-[#141b2a] border border-emerald-600/40 rounded-2xl p-4 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-xl">
        <div class="flex items-center gap-3 sm:gap-4 text-center sm:text-left">
          <div class="w-12 h-12 rounded-2xl bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-2xl shrink-0">
            🤝
          </div>
          <div>
            <h3 class="font-black text-sm sm:text-base text-white">
              Gerakan Belanja Produk Tetangga Nahdliyin
            </h3>
            <p class="text-xs text-slate-300 mt-0.5">
              100% Nol Biaya Admin. Transaksi langsung masuk ke rekening atau disepakati dengan pengrajin & pedagang lokal se-Sumenep.
            </p>
          </div>
        </div>
        <a
          href="/agen"
          class="shrink-0 bg-white hover:bg-slate-100 text-slate-900 font-extrabold text-xs px-5 py-2.5 rounded-xl shadow-md transition"
        >
          + Pasang Iklan Toko Anda
        </a>
      </div>
    </section>

    <!-- 5. "MOST FAVORITED LISTINGS" (OsClass Style: 4 Cards with Seller Avatar Overlays) -->
    {favoritedProducts.length > 0 && !isFiltered && (
      <section class="space-y-4 px-3 sm:px-0">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-base sm:text-lg font-black text-white tracking-tight flex items-center gap-2">
              <span>⭐</span> Produk Paling Banyak Diminati
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">Iklan produk nahdliyin dengan interaksi tertinggi minggu ini</p>
          </div>
          <span class="text-xs font-semibold text-slate-300 border border-slate-700 px-3 py-1 rounded-full hidden sm:inline-block">
            4 Produk Terfavorit
          </span>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
          {favoritedProducts.map((p, index) => {
            const initials = ['SN', 'BR', 'TS', 'PL'][index] || p.umkm_name.slice(0, 2).toUpperCase();
            return (
              <ProductCard
                product={p}
                sellerAvatar={initials}
                photoCount={3}
                views={p.views || 400 + index * 120}
              />
            );
          })}
        </div>
      </section>
    )}

    <!-- 6. "BEST SELLERS" (Toko & Pengrajin Terverifikasi - OsClass Style Avatars) -->
    {sellers.length > 0 && !isFiltered && (
      <section id="toko-warga" class="space-y-4 px-3 sm:px-0">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-base sm:text-lg font-black text-white tracking-tight flex items-center gap-2">
              <span>🏪</span> Toko & Pengrajin Warga NU
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">Beli langsung dari produsen dan pedagang nahdliyin terdekat</p>
          </div>
          <span class="text-xs text-emerald-400 font-semibold hidden sm:inline">
            Terverifikasi MWC Setempat
          </span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
          {sellers.slice(0, 4).map((seller) => (
            <div class="bg-[#141c2b] border border-slate-800 rounded-2xl p-4 flex flex-col items-center text-center space-y-2 hover:border-slate-700 transition shadow-sm relative">
              <div class="relative">
                <div class="w-16 h-16 rounded-full bg-emerald-900/60 text-emerald-300 border-2 border-emerald-500/50 flex items-center justify-center font-black text-lg shadow-inner">
                  {seller.name.slice(0, 2).toUpperCase()}
                </div>
                <span class="absolute -top-1 -right-1 bg-indigo-600 text-white text-[9px] font-black px-1.5 py-0.2 rounded-full uppercase tracking-wider">
                  PRO
                </span>
              </div>
              <div class="space-y-0.5 w-full">
                <h4 class="font-extrabold text-xs sm:text-sm text-white truncate">
                  {seller.name}
                </h4>
                <p class="text-[11px] text-slate-400 truncate">
                  {seller.zone_name}
                </p>
                <span class="inline-block text-[10px] bg-slate-800/90 text-emerald-400 font-bold px-2 py-0.5 rounded-full mt-1 border border-slate-700/60">
                  {seller.product_count} Produk Aktif
                </span>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- 7. "LATEST LISTINGS" (OsClass 5-Column Grid with Filter Bar & Sold Badges) -->
    <section class="space-y-4 px-3 sm:px-0 pt-2">
      
      <!-- Section Header & Filter Controls -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-800">
        <div>
          <h2 class="text-base sm:text-xl font-black text-white tracking-tight flex items-center gap-2">
            <span>📋</span>
            {isFiltered ? 'Hasil Pencarian Produk' : 'Iklan Produk Terbaru'}
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">
            Menampilkan <strong>{products.length}</strong> produk iklan aktif di Kabupaten Sumenep
          </p>
        </div>

        <!-- MWC Pills & Sort Dropdown -->
        <div class="flex items-center gap-2.5 overflow-x-auto no-scrollbar">
          <!-- Sort Dropdown -->
          <form method="GET" action="/" class="flex items-center gap-1.5 shrink-0 text-xs">
            <input type="hidden" name="zona" value={currentZone} />
            <input type="hidden" name="kategori" value={currentCategory} />
            <input type="hidden" name="q" value={searchQuery} />
            <label for="sort-select" class="text-slate-400 font-bold">Urut:</label>
            <select
              id="sort-select"
              name="sort"
              onchange="this.form.submit()"
              class="bg-[#162030] border border-slate-700 text-slate-200 rounded-lg py-1.5 px-2 text-xs font-semibold focus:outline-none cursor-pointer"
            >
              <option value="newest" selected={currentSort === 'newest'}>Terbaru</option>
              <option value="price_asc" selected={currentSort === 'price_asc'}>Harga Termurah</option>
              <option value="price_desc" selected={currentSort === 'price_desc'}>Harga Termahal</option>
            </select>
          </form>

          {isFiltered && (
            <a
              href="/"
              class="shrink-0 text-xs font-bold text-rose-400 hover:text-rose-300 underline"
            >
              Reset Filter
            </a>
          )}
        </div>
      </div>

      <!-- Active Filter Tags -->
      {isFiltered && (
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="text-slate-500 font-bold">Filter Aktif:</span>
          {currentZone !== 'semua' && (
            <span class="bg-[#162030] border border-slate-700 text-slate-300 px-2.5 py-1 rounded-full font-medium">
              Wilayah: {currentZone.replace('mwc-', '').replace('-', ' ').toUpperCase()}
            </span>
          )}
          {currentCategory !== 'semua' && (
            <span class="bg-[#162030] border border-slate-700 text-slate-300 px-2.5 py-1 rounded-full font-medium">
              Kategori: {currentCategory}
            </span>
          )}
          {searchQuery && (
            <span class="bg-[#162030] border border-slate-700 text-slate-300 px-2.5 py-1 rounded-full font-medium">
              Kata Kunci: "{searchQuery}"
            </span>
          )}
        </div>
      )}

      <!-- Dense 5-Column Grid on Desktop (Matching OsClass "Latest listings" 5 Columns) -->
      {products.length > 0 ? (
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4">
          {products.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      ) : (
        <div class="bg-[#141c2b] border border-slate-800 rounded-2xl p-12 text-center space-y-3 shadow-md">
          <div class="text-4xl">🔍</div>
          <h3 class="font-extrabold text-white text-base">Tidak Ada Produk yang Cocok</h3>
          <p class="text-xs text-slate-400 max-w-sm mx-auto">
            Coba pilih wilayah MWC lainnya atau ubah kata kunci pencarian Anda.
          </p>
          <a
            href="/"
            class="inline-block mt-2 text-xs font-bold bg-[#4f46e5] hover:bg-[#4338ca] text-white px-5 py-2.5 rounded-xl transition"
          >
            Lihat Semua Produk
          </a>
        </div>
      )}

    </section>

  </div>
</Layout>