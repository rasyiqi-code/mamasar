---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import PromoSlider from '../components/PromoSlider.astro';
import { getAllZones, getProducts, getAllUMKM, getArticles } from '../lib/db';
import {
  PRODUCT_CATEGORIES,
  CATEGORY_ICONS,
  CATEGORY_BADGES,
  POPULAR_TAGS,
} from '../lib/constants';

const url = new URL(Astro.request.url);
const currentZone = url.searchParams.get('zona') || 'semua';
const currentCategory = url.searchParams.get('kategori') || 'semua';
const searchQuery = url.searchParams.get('q') || '';
const currentSort = url.searchParams.get('sort') || 'newest';

const zones = await getAllZones();
const sellers = await getAllUMKM();
const articles = await getArticles();

// All products with current filters
const products = await getProducts({
  zoneSlug: currentZone,
  category: currentCategory,
  search: searchQuery,
  sort: currentSort,
});

// Premium / Featured products (Top 4 products for the top showcase section)
const premiumProducts = products.slice(0, 4);

// Most favorited products (Middle showcase with seller avatars, items 4-8 or slice)
const favoritedProducts = products.length >= 8 ? products.slice(4, 8) : products.slice(0, 4);

const isFiltered = currentZone !== 'semua' || currentCategory !== 'semua' || searchQuery !== '';
---

<Layout title="Pasar Warga NU Sumenep | Direktori Iklan UMKM">
  <div class="space-y-8 sm:space-y-12 py-3 sm:py-6">

    <!-- 1. HERO SECTION: OsClass Headline + Large Central Search + Category Circles Hub -->
    <section class="text-center space-y-6 pt-3 sm:pt-6 px-3 sm:px-4">
      
      <!-- Big Classified Headline (OsClass Style: "What would you like to buy?") -->
      <div class="space-y-2">
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
          Mau beli apa dari <span class="text-[#4f46e5] underline decoration-indigo-300">warga NU?</span>
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 max-w-xl mx-auto">
          Temukan produk asli warga nahdliyin se-Kabupaten Sumenep. Transaksi langsung via WhatsApp tanpa perantara.
        </p>
      </div>

      <!-- Central Classified Search Bar with Location Dropdown -->
      <form
        method="GET"
        action="/"
        class="max-w-3xl mx-auto bg-white border border-slate-300 rounded-2xl p-1.5 sm:p-2 shadow-sm flex flex-col sm:flex-row items-center gap-2"
      >
        <!-- Location Dropdown inside search -->
        <div class="w-full sm:w-56 relative border-b sm:border-b-0 sm:border-r border-slate-200 shrink-0">
          <select
            name="zona"
            aria-label="Pilih Wilayah MWC"
            class="w-full appearance-none bg-transparent pl-8 pr-7 py-2.5 sm:py-3 text-xs sm:text-sm font-bold text-slate-800 focus:outline-none cursor-pointer"
          >
            <option value="semua" class="bg-white text-slate-900">Semua Wilayah MWC</option>
            {zones.map((z) => (
              <option value={z.slug} selected={currentZone === z.slug} class="bg-white text-slate-900">
                {z.name}
              </option>
            ))}
          </select>
          <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-indigo-600 text-xs sm:text-sm pointer-events-none">
            📍
          </span>
          <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-[10px] pointer-events-none">
            ▼
          </span>
        </div>

        <!-- Keyword input -->
        <div class="relative w-full flex-1">
          <input
            type="text"
            name="q"
            value={searchQuery}
            placeholder="Cari rengginang, batik, siwalan, petis, jamu..."
            class="w-full py-2.5 sm:py-3 px-3 text-xs sm:text-sm text-slate-900 placeholder-slate-400 bg-transparent focus:outline-none"
          />
          {searchQuery && (
            <a
              href={`/?zona=${currentZone}&kategori=${currentCategory}`}
              aria-label="Hapus kata kunci"
              class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-800 font-bold text-xs"
            >
              ✕
            </a>
          )}
        </div>

        <!-- Submit Button in OsClass Indigo -->
        <button
          type="submit"
          class="w-full sm:w-auto bg-[#4f46e5] hover:bg-[#4338ca] text-white font-black text-xs sm:text-sm px-7 py-2.5 sm:py-3 rounded-xl transition flex items-center justify-center gap-2 shrink-0 cursor-pointer shadow-xs active:scale-98"
        >
          <svg class="w-4 h-4 fill-none stroke-current" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <span>Cari Iklan</span>
        </button>
      </form>

      <!-- Popular Search Tag Pills (OsClass Style under Search Bar) -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 text-[11px] text-slate-600 max-w-2xl mx-auto">
        <span class="font-bold text-slate-500">Populer:</span>
        {POPULAR_TAGS.map((tag) => (
          <a
            href={`/?q=${encodeURIComponent(tag)}`}
            class="bg-white hover:bg-slate-100 border border-slate-200 text-slate-700 hover:text-indigo-600 px-2.5 py-1 rounded-full transition shadow-2xs"
          >
            {tag}
          </a>
        ))}
      </div>

      <!-- Categories Circle Hub (OsClass Category Circles Row with Badges) -->
      <div class="pt-4 max-w-5xl mx-auto">
        <div class="text-left text-xs font-bold uppercase tracking-wider text-slate-500 mb-3 px-2 sm:px-0">
          Kategori Iklan
        </div>
        <div class="flex items-center justify-start sm:justify-center gap-3 sm:gap-6 overflow-x-auto pb-2 no-scrollbar px-2 sm:px-0">
          
          <!-- All Categories Circle -->
          <a
            href={`/?kategori=semua${currentZone !== 'semua' ? `&zona=${currentZone}` : ''}`}
            class="group flex flex-col items-center gap-2 shrink-0 text-center"
          >
            <div
              class={`relative w-14 h-14 sm:w-16 sm:h-16 rounded-full flex items-center justify-center text-xl sm:text-2xl transition border-2 ${
                currentCategory === 'semua'
                  ? 'bg-indigo-50 border-indigo-600 text-indigo-700 shadow-sm'
                  : 'bg-white border-slate-200 text-slate-700 group-hover:border-slate-400 group-hover:scale-105 shadow-2xs'
              }`}
            >
              🛍️
            </div>
            <span class={`text-[11px] sm:text-xs font-bold ${currentCategory === 'semua' ? 'text-indigo-700' : 'text-slate-700 group-hover:text-slate-900'}`}>
              Semua
            </span>
          </a>

          <!-- Each Category Circle with Badge -->
          {PRODUCT_CATEGORIES.map((cat) => {
            const isActive = currentCategory === cat;
            const icon = CATEGORY_ICONS[cat] || '📦';
            const badge = CATEGORY_BADGES[cat];
            return (
              <a
                href={`/?kategori=${encodeURIComponent(cat)}${currentZone !== 'semua' ? `&zona=${currentZone}` : ''}`}
                class="group flex flex-col items-center gap-2 shrink-0 text-center"
              >
                <div
                  class={`relative w-14 h-14 sm:w-16 sm:h-16 rounded-full flex items-center justify-center text-xl sm:text-2xl transition border-2 ${
                    isActive
                      ? 'bg-indigo-50 border-indigo-600 text-indigo-700 shadow-sm'
                      : 'bg-white border-slate-200 text-slate-700 group-hover:border-slate-400 group-hover:scale-105 shadow-2xs'
                  }`}
                >
                  {icon}
                  {badge && (
                    <span
                      class={`absolute -top-1 -right-1 text-[8px] font-black uppercase px-1.5 py-0.2 rounded-full shadow-2xs ${badge.color}`}
                    >
                      {badge.label}
                    </span>
                  )}
                </div>
                <span class={`text-[11px] sm:text-xs font-bold max-w-[85px] leading-tight truncate ${isActive ? 'text-indigo-700' : 'text-slate-700 group-hover:text-slate-900'}`}>
                  {cat}
                </span>
              </a>
            );
          })}
        </div>
      </div>

    </section>

    <!-- 1.5. HERO INTERACTIVE PROMO SLIDER -->
    {!isFiltered && (
      <section class="py-1">
        <PromoSlider />
      </section>
    )}

    <!-- 2. "NEWEST LISTINGS" (4-Column OsClass Premium Box with Cyan/Teal Border Accent) -->
    {premiumProducts.length > 0 && !isFiltered && (
      <section class="px-3 sm:px-0">
        <div class="bg-white border-t-2 border-t-emerald-600 border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-xs space-y-4">
          <div class="flex items-center justify-between pb-2 border-b border-slate-100">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 animate-pulse"></span>
              <h2 class="text-base sm:text-lg font-black text-slate-900 tracking-tight">
                Produk Terbaru Warga NU
              </h2>
            </div>
            <span class="text-xs text-slate-500 font-medium hidden sm:inline">
              Iklan baru dipasang oleh UMKM Nahdliyin
            </span>
          </div>

          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
            {premiumProducts.map((p) => (
              <ProductCard
                product={p}
                badge="Baru Dipasang"
                badgeColor="indigo"
              />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 3. "NEWS ON BLOG" (OsClass Editorial Style: 3 Articles Grid) -->
    {!isFiltered && (
      <section id="panduan" class="space-y-4 px-3 sm:px-0">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-base sm:text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
              <span>📰</span> Kabar & Panduan UMKM Sumenep
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">Edukasi ekonomi pekarangan, legalitas halal & panduan usaha nahdliyin</p>
          </div>
          <a
            href="/edukasi"
            class="text-xs font-bold text-emerald-700 hover:text-emerald-800 border border-emerald-200 bg-emerald-50/50 hover:bg-emerald-50 px-3.5 py-1.5 rounded-full transition inline-flex items-center gap-1.5 shadow-2xs"
          >
            <span>Semua Panduan ({articles.length})</span>
            <span>➔</span>
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4">
          {articles.slice(0, 3).map((art) => (
            <a
              href={`/edukasi/${art.slug}`}
              class="bg-white border border-slate-200 rounded-xl p-3 sm:p-4 flex gap-3 hover:border-emerald-500 hover:shadow-sm transition group cursor-pointer"
            >
              <img
                src={art.image_url}
                alt={art.title}
                class="w-20 h-20 sm:w-24 sm:h-24 rounded-lg object-cover shrink-0 group-hover:scale-102 transition"
                loading="lazy"
              />
              <div class="space-y-1 min-w-0">
                <span class="text-[10px] font-bold text-emerald-700 uppercase tracking-wider block">{art.category}</span>
                <h3 class="font-extrabold text-xs sm:text-sm text-slate-900 group-hover:text-emerald-700 line-clamp-2 leading-snug">
                  {art.title}
                </h3>
                <p class="text-[11px] text-slate-600 line-clamp-2">
                  {art.summary}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 4. MIDDLE PROMOTIONAL BANNER (OsClass Middle Ad Style: hosting.com Style Banner) -->
    <section class="px-3 sm:px-0">
      <div class="bg-gradient-to-r from-emerald-800 via-emerald-700 to-teal-800 border border-emerald-600 rounded-2xl p-4 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-md text-white">
        <div class="flex items-center gap-3 sm:gap-4 text-center sm:text-left">
          <div class="w-12 h-12 rounded-2xl bg-white/20 text-white border border-white/30 flex items-center justify-center text-2xl shrink-0">
            🤝
          </div>
          <div>
            <h3 class="font-black text-sm sm:text-base text-white">
              Gerakan Belanja Produk Tetangga Nahdliyin
            </h3>
            <p class="text-xs text-emerald-100 mt-0.5">
              100% Nol Biaya Admin. Transaksi langsung masuk ke rekening atau disepakati dengan pengrajin & pedagang lokal se-Sumenep.
            </p>
          </div>
        </div>
        <a
          href="/dashboard"
          class="shrink-0 bg-white hover:bg-slate-100 text-emerald-900 font-extrabold text-xs px-5 py-2.5 rounded-xl shadow-xs transition"
        >
          + Pasang Iklan Toko Anda
        </a>
      </div>
    </section>

    <!-- 5. "MORE LISTINGS" (OsClass Style: 4 Cards with Seller Avatar Overlays) -->
    {favoritedProducts.length > 0 && !isFiltered && (
      <section class="space-y-4 px-3 sm:px-0">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-base sm:text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
              <span>⭐</span> Produk Warga NU Lainnya
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">Lanjutkan menjelajah etalase UMKM Nahdliyin se-Sumenep</p>
          </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
          {favoritedProducts.map((p) => {
            const initials = p.umkm_name.slice(0, 2).toUpperCase();
            return (
              <ProductCard
                product={p}
                sellerAvatar={initials}
              />
            );
          })}
        </div>
      </section>
    )}

    <!-- 6. "BEST SELLERS" (Toko & Pengrajin - OsClass Style Avatars) -->
    {sellers.length > 0 && !isFiltered && (
      <section id="toko-warga" class="space-y-4 px-3 sm:px-0">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-base sm:text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
              <span>🏪</span> Toko & Pengrajin Warga NU
            </h2>
            <p class="text-xs text-slate-500 mt-0.5">Beli langsung dari produsen dan pedagang nahdliyin terdekat</p>
          </div>
          <a href="/toko" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 transition">
            Lihat Semua Toko ({sellers.length}) ➔
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
          {sellers.slice(0, 4).map((seller) => (
            <a
              href={`/toko/${seller.id}`}
              class="bg-white border border-slate-200 rounded-2xl p-4 flex flex-col items-center text-center space-y-2 hover:border-indigo-400 hover:shadow-xs transition relative group cursor-pointer"
            >
              <div class="relative">
                <div class="w-16 h-16 rounded-full bg-emerald-50 text-emerald-800 border-2 border-emerald-300 flex items-center justify-center font-black text-lg shadow-inner group-hover:bg-emerald-100 transition">
                  {seller.name.slice(0, 2).toUpperCase()}
                </div>
                {Boolean(seller.is_verified) && (
                  <span class="absolute -top-1 -right-1 bg-emerald-600 text-white text-[9px] font-black w-5 h-5 rounded-full flex items-center justify-center shadow-xs" title="Terverifikasi MWC NU">
                    ✓
                  </span>
                )}
              </div>
              <div class="space-y-0.5 w-full">
                <h4 class="font-extrabold text-xs sm:text-sm text-slate-900 group-hover:text-emerald-700 transition truncate">
                  {seller.name}
                </h4>
                <p class="text-[11px] text-slate-500 truncate">
                  {seller.zone_name}
                </p>
                <span class="inline-block text-[10px] bg-slate-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full mt-1 border border-slate-200">
                  {seller.product_count} Produk Aktif
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 7. "LATEST LISTINGS" (OsClass 5-Column Grid with Filter Bar & Sold Badges) -->
    <section id="katalog-terbaru" class="space-y-4 px-3 sm:px-0 pt-2">
      
      <!-- Section Header & Filter Controls -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
        <div>
          <h2 class="text-base sm:text-xl font-black text-slate-900 tracking-tight flex items-center gap-2">
            <span>📋</span>
            {isFiltered ? 'Hasil Pencarian Produk' : 'Iklan Produk Terbaru'}
          </h2>
          <p class="text-xs text-slate-500 mt-0.5">
            Menampilkan <strong>{products.length}</strong> produk iklan aktif di Kabupaten Sumenep
          </p>
        </div>

        <!-- MWC Pills & Sort Dropdown -->
        <div class="flex items-center gap-2.5 overflow-x-auto no-scrollbar">
          <!-- Sort Dropdown -->
          <form method="GET" action="/" class="flex items-center gap-1.5 shrink-0 text-xs">
            <input type="hidden" name="zona" value={currentZone} />
            <input type="hidden" name="kategori" value={currentCategory} />
            <input type="hidden" name="q" value={searchQuery} />
            <label for="sort-select" class="text-slate-600 font-bold">Urut:</label>
            <select
              id="sort-select"
              name="sort"
              onchange="this.form.submit()"
              class="bg-white border border-slate-300 text-slate-800 rounded-lg py-1.5 px-2 text-xs font-semibold focus:outline-none cursor-pointer"
            >
              <option value="newest" selected={currentSort === 'newest'}>Terbaru</option>
              <option value="price_asc" selected={currentSort === 'price_asc'}>Harga Termurah</option>
              <option value="price_desc" selected={currentSort === 'price_desc'}>Harga Termahal</option>
            </select>
          </form>

          {isFiltered && (
            <a
              href="/"
              class="shrink-0 text-xs font-bold text-rose-600 hover:text-rose-700 underline"
            >
              Reset Filter
            </a>
          )}
        </div>
      </div>

      <!-- Active Filter Tags -->
      {isFiltered && (
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="text-slate-500 font-bold">Filter Aktif:</span>
          {currentZone !== 'semua' && (
            <span class="bg-white border border-slate-300 text-slate-700 px-2.5 py-1 rounded-full font-medium shadow-2xs">
              Wilayah: {currentZone.replace('mwc-', '').replace('-', ' ').toUpperCase()}
            </span>
          )}
          {currentCategory !== 'semua' && (
            <span class="bg-white border border-slate-300 text-slate-700 px-2.5 py-1 rounded-full font-medium shadow-2xs">
              Kategori: {currentCategory}
            </span>
          )}
          {searchQuery && (
            <span class="bg-white border border-slate-300 text-slate-700 px-2.5 py-1 rounded-full font-medium shadow-2xs">
              Kata Kunci: "{searchQuery}"
            </span>
          )}
        </div>
      )}

      <!-- Dense 5-Column Grid on Desktop (Matching OsClass "Latest listings" 5 Columns) -->
      {products.length > 0 ? (
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4">
          {products.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      ) : (
        <div class="bg-white border border-slate-200 rounded-2xl p-12 text-center space-y-3 shadow-xs">
          <div class="text-4xl">🔍</div>
          <h3 class="font-extrabold text-slate-900 text-base">Tidak Ada Produk yang Cocok</h3>
          <p class="text-xs text-slate-500 max-w-sm mx-auto">
            Coba pilih wilayah MWC lainnya atau ubah kata kunci pencarian Anda.
          </p>
          <a
            href="/"
            class="inline-block mt-2 text-xs font-bold bg-[#4f46e5] hover:bg-[#4338ca] text-white px-5 py-2.5 rounded-xl transition"
          >
            Lihat Semua Produk
          </a>
        </div>
      )}

    </section>

  </div>
</Layout>