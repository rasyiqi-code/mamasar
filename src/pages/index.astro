---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import PromoSlider from '../components/PromoSlider.astro';
import AppIcon from '../components/common/AppIcon.astro';
import EmptyState from '../components/common/EmptyState.astro';
import { getAllZones, getProducts, getProductsCount, getAllUMKM, getArticles } from '../lib/db';
import {
  PRODUCT_CATEGORIES,
  CATEGORY_ICONS,
  CATEGORY_BADGES,
  POPULAR_TAGS,
} from '../lib/constants';

const url = new URL(Astro.request.url);
const currentZone = url.searchParams.get('zona') || 'semua';
const currentCategory = url.searchParams.get('kategori') || 'semua';
const currentStock = url.searchParams.get('stok') || 'semua';
const currentVerified = url.searchParams.get('terverifikasi') || '0';
const searchQuery = url.searchParams.get('q') || '';
const currentSort = url.searchParams.get('sort') || 'newest';
const PAGE_SIZE = 12;
const requestedPage = Number.parseInt(url.searchParams.get('page') || '1', 10);
const currentPage = Number.isFinite(requestedPage) && requestedPage > 0 ? requestedPage : 1;

const zones = await getAllZones();
const sellers = await getAllUMKM();
const articles = await getArticles();

const filterOptions = {
  zoneSlug: currentZone,
  category: currentCategory,
  search: searchQuery,
  stockStatus: currentStock,
  sort: currentSort,
  verifiedOnly: currentVerified === '1',
};

const totalProducts = await getProductsCount(filterOptions);
const totalPages = Math.max(1, Math.ceil(totalProducts / PAGE_SIZE));
const safePage = Math.min(currentPage, totalPages);
const offset = (safePage - 1) * PAGE_SIZE;

const products = await getProducts({
  ...filterOptions,
  limit: PAGE_SIZE,
  offset,
});

const verifiedSellers = [...sellers].sort((a, b) => Number(Boolean(b.is_verified)) - Number(Boolean(a.is_verified)));

const isFiltered =
  currentZone !== 'semua' ||
  currentCategory !== 'semua' ||
  searchQuery !== '' ||
  currentStock !== 'semua' ||
  currentVerified === '1';

const showDiscoverySections = !isFiltered && safePage === 1;

function buildFilterUrl(updates: Record<string, string | null>) {
  const params = new URLSearchParams(url.searchParams);
  if (!('page' in updates)) {
    params.delete('page');
  }
  for (const [key, val] of Object.entries(updates)) {
    if (val === null || val === 'semua' || val === '' || val === '0' || (key === 'page' && val === '1')) {
      params.delete(key);
    } else {
      params.set(key, val);
    }
  }
  const str = params.toString();
  return str ? `/?${str}#katalog-terbaru` : `/#katalog-terbaru`;
}
---

<Layout
  title="Mamasar | Direktori Iklan UMKM Sumenep"
  noindex={isFiltered || safePage > 1}
  canonicalUrl={`${Astro.url.origin}/`}
>
  <div class="space-y-8 sm:space-y-12 py-3 sm:py-6">

    <!-- 1. HERO SECTION: Headline + Search Bar + Category Strip -->
    <section class="text-center space-y-5 pt-3 sm:pt-6 px-3 sm:px-4">
      <div class="space-y-2">
        <h1 class="text-2xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight">
          Mau beli apa dari <span class="text-emerald-700 underline decoration-emerald-300">warga NU?</span>
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 max-w-xl mx-auto">
          Temukan produk asli warga nahdliyin se-Kabupaten Sumenep. Transaksi langsung via WhatsApp tanpa komisi perantara.
        </p>
      </div>

      <!-- Central Classified Search Bar with Location Dropdown -->
      <form
        method="GET"
        action="/"
        class="max-w-3xl mx-auto bg-white border border-slate-300 rounded-2xl p-1.5 sm:p-2 shadow-sm flex flex-col sm:flex-row items-center gap-2"
      >
        <div class="w-full sm:w-56 relative border-b sm:border-b-0 sm:border-r border-slate-200 shrink-0">
          <select
            name="zona"
            aria-label="Pilih Wilayah MWC"
            class="w-full min-h-[44px] appearance-none bg-transparent pl-8 pr-7 py-2.5 text-xs sm:text-sm font-bold text-slate-800 cursor-pointer"
          >
            <option value="semua" class="bg-white text-slate-900">Semua Wilayah MWC</option>
            {zones.map((z) => (
              <option value={z.slug} selected={currentZone === z.slug} class="bg-white text-slate-900">
                {z.name}
              </option>
            ))}
          </select>
          <span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-emerald-700 pointer-events-none flex items-center">
            <AppIcon name="map-pin" size="xs" />
          </span>
          <span class="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 pointer-events-none flex items-center">
            <AppIcon name="chevron-down" size="xs" />
          </span>
        </div>

        <div class="relative w-full flex-1">
          <input
            type="text"
            name="q"
            value={searchQuery}
            aria-label="Kata kunci produk"
            placeholder="Cari rengginang, batik, siwalan, petis, jamu..."
            class="w-full min-h-[44px] py-2.5 px-3 text-xs sm:text-sm text-slate-900 placeholder-slate-500 bg-transparent focus:outline-none"
          />
          {searchQuery && (
            <a
              href={buildFilterUrl({ q: null })}
              aria-label="Hapus kata kunci"
              class="absolute right-2 top-1/2 -translate-y-1/2 min-w-[36px] min-h-[36px] text-slate-500 hover:text-slate-900 font-bold text-xs flex items-center justify-center"
            >
              <AppIcon name="close" size="xs" />
            </a>
          )}
        </div>

        <button
          type="submit"
          class="w-full sm:w-auto min-h-[44px] bg-emerald-700 hover:bg-emerald-800 text-white font-extrabold text-xs sm:text-sm px-7 py-2.5 rounded-xl transition flex items-center justify-center gap-2 shrink-0 cursor-pointer shadow-xs active:scale-98"
        >
          <AppIcon name="search" size="xs" />
          <span>Cari</span>
        </button>
      </form>

      <!-- Popular Search Tag Pills -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 sm:gap-2 text-xs text-slate-600 max-w-2xl mx-auto">
        <span class="font-bold text-slate-500">Populer:</span>
        {POPULAR_TAGS.map((tag) => (
          <a
            href={`/?q=${encodeURIComponent(tag)}`}
            class="bg-white hover:bg-emerald-50 border border-slate-200 text-slate-700 hover:text-emerald-800 px-3 py-1 rounded-full transition shadow-2xs"
          >
            {tag}
          </a>
        ))}
      </div>

      <!-- Single Category Strip -->
      <div class="pt-3 max-w-5xl mx-auto">
        <div class="text-left text-xs font-bold uppercase tracking-wider text-slate-600 mb-3 px-2 sm:px-0">
          Kategori Iklan
        </div>
        <div class="flex items-center justify-start sm:justify-center gap-3 sm:gap-6 overflow-x-auto pb-2 no-scrollbar px-2 sm:px-0">
          <a
            href={`/?kategori=semua${currentZone !== 'semua' ? `&zona=${currentZone}` : ''}`}
            class="group flex flex-col items-center gap-2 shrink-0 text-center"
          >
            <div
              class={`relative w-14 h-14 sm:w-16 sm:h-16 rounded-full flex items-center justify-center transition border-2 ${
                currentCategory === 'semua'
                  ? 'bg-emerald-50 border-emerald-700 text-emerald-800 shadow-sm'
                  : 'bg-white border-slate-200 text-slate-700 group-hover:border-emerald-400 group-hover:scale-105 shadow-2xs'
              }`}
            >
              <AppIcon name="shopping-bag" size="lg" class={currentCategory === 'semua' ? 'text-emerald-700' : 'text-slate-600'} />
            </div>
            <span class={`text-xs font-bold ${currentCategory === 'semua' ? 'text-emerald-800' : 'text-slate-700 group-hover:text-slate-900'}`}>
              Semua
            </span>
          </a>

          {PRODUCT_CATEGORIES.map((cat) => {
            const isActive = currentCategory === cat;
            const icon = CATEGORY_ICONS[cat] || 'package';
            const badge = CATEGORY_BADGES[cat];
            return (
              <a
                href={`/?kategori=${encodeURIComponent(cat)}${currentZone !== 'semua' ? `&zona=${currentZone}` : ''}`}
                class="group flex flex-col items-center gap-2 shrink-0 text-center"
              >
                <div
                  class={`relative w-14 h-14 sm:w-16 sm:h-16 rounded-full flex items-center justify-center transition border-2 ${
                    isActive
                      ? 'bg-emerald-50 border-emerald-700 text-emerald-800 shadow-sm'
                      : 'bg-white border-slate-200 text-slate-700 group-hover:border-emerald-400 group-hover:scale-105 shadow-2xs'
                  }`}
                >
                  <AppIcon name={icon} size="lg" class={isActive ? 'text-emerald-700' : 'text-slate-600'} />
                  {badge && (
                    <span
                      class={`absolute -top-1 -right-1 text-[10px] font-black uppercase px-1.5 py-0.5 rounded-full shadow-2xs ${badge.color}`}
                    >
                      {badge.label}
                    </span>
                  )}
                </div>
                <span class={`text-xs font-bold max-w-[92px] leading-tight truncate ${isActive ? 'text-emerald-800' : 'text-slate-700 group-hover:text-slate-900'}`}>
                  {cat}
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <!-- 2. PRIMARY CATALOG GRID (12-item Server Pagination) -->
    <section id="katalog-terbaru" class="space-y-4 px-3 sm:px-0 pt-2">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-slate-200">
        <div>
          <h2 class="text-base sm:text-xl font-black text-slate-900 tracking-tight flex items-center gap-2">
            <AppIcon name="clipboard" size="sm" class="text-emerald-700" />
            <span>{isFiltered ? 'Hasil Pencarian Produk' : 'Katalog Produk Warga NU'}</span>
          </h2>
          <p class="text-xs text-slate-600 mt-0.5">
            Menampilkan <strong>{products.length}</strong> dari <strong>{totalProducts}</strong> produk aktif (Halaman {safePage} / {totalPages})
          </p>
        </div>

        <div class="flex items-center gap-2.5 overflow-x-auto no-scrollbar">
          <form method="GET" action="/" class="flex items-center gap-1.5 shrink-0 text-xs">
            <input type="hidden" name="zona" value={currentZone} />
            <input type="hidden" name="kategori" value={currentCategory} />
            <input type="hidden" name="stok" value={currentStock} />
            <input type="hidden" name="terverifikasi" value={currentVerified} />
            <input type="hidden" name="q" value={searchQuery} />
            <label for="sort-select" class="text-slate-600 font-bold">Urut:</label>
            <select
              id="sort-select"
              name="sort"
              onchange="this.form.submit()"
              class="min-h-[40px] bg-white border border-slate-300 text-slate-800 rounded-lg py-1.5 px-2.5 text-xs font-semibold cursor-pointer"
            >
              <option value="newest" selected={currentSort === 'newest'}>Terbaru</option>
              <option value="price_asc" selected={currentSort === 'price_asc'}>Harga Termurah</option>
              <option value="price_desc" selected={currentSort === 'price_desc'}>Harga Termahal</option>
            </select>
          </form>

          {isFiltered && (
            <a
              href="/"
              class="shrink-0 min-h-[40px] inline-flex items-center px-2.5 text-xs font-bold text-rose-700 hover:text-rose-800 underline"
            >
              Reset Filter
            </a>
          )}
        </div>
      </div>

      <!-- Quick Filter Pills -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar py-0.5 text-xs">
        <span class="text-slate-600 text-xs font-bold uppercase tracking-wider shrink-0 mr-1">
          Filter:
        </span>
        <a
          href={buildFilterUrl({ stok: 'semua' })}
          class={`min-h-[38px] inline-flex items-center px-3.5 py-1.5 rounded-full font-semibold transition shrink-0 border text-xs ${
            currentStock === 'semua'
              ? 'bg-slate-900 text-white border-slate-900 shadow-2xs'
              : 'bg-white text-slate-700 border-slate-200 hover:border-slate-400'
          }`}
        >
          Semua Stok
        </a>
        <a
          href={buildFilterUrl({ stok: 'ready' })}
          class={`min-h-[38px] inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full font-semibold transition shrink-0 border text-xs ${
            currentStock === 'ready'
              ? 'bg-emerald-700 text-white border-emerald-700 shadow-2xs'
              : 'bg-white text-emerald-800 border-emerald-200 hover:bg-emerald-50'
          }`}
        >
          <span class={`w-1.5 h-1.5 rounded-full ${currentStock === 'ready' ? 'bg-white' : 'bg-emerald-600'}`}></span>
          <span>Ready Stock</span>
        </a>
        <a
          href={buildFilterUrl({ stok: 'po' })}
          class={`min-h-[38px] inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full font-semibold transition shrink-0 border text-xs ${
            currentStock === 'po'
              ? 'bg-amber-400 text-slate-950 border-amber-400 shadow-2xs font-bold'
              : 'bg-white text-amber-900 border-amber-300 hover:bg-amber-50'
          }`}
        >
          <span class={`w-1.5 h-1.5 rounded-full ${currentStock === 'po' ? 'bg-slate-900' : 'bg-amber-600'}`}></span>
          <span>Pre-Order (PO)</span>
        </a>
        <a
          href={buildFilterUrl({ terverifikasi: currentVerified === '1' ? '0' : '1' })}
          class={`min-h-[38px] inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full font-semibold transition shrink-0 border text-xs ${
            currentVerified === '1'
              ? 'bg-emerald-700 text-white border-emerald-700 shadow-2xs'
              : 'bg-white text-emerald-800 border-emerald-300 hover:bg-emerald-50'
          }`}
        >
          <AppIcon name="verified" size="xs" />
          <span>Hanya Toko Terverifikasi</span>
        </a>
      </div>

      {isFiltered && (
        <div class="flex flex-wrap items-center gap-2 text-xs">
          <span class="text-slate-600 font-bold">Filter Aktif:</span>
          {currentZone !== 'semua' && (
            <span class="bg-white border border-slate-300 text-slate-700 px-2.5 py-1 rounded-full font-medium shadow-2xs">
              Wilayah: {zones.find((z) => z.slug === currentZone)?.name || currentZone}
            </span>
          )}
          {currentCategory !== 'semua' && (
            <span class="bg-white border border-slate-300 text-slate-700 px-2.5 py-1 rounded-full font-medium shadow-2xs">
              Kategori: {currentCategory}
            </span>
          )}
          {searchQuery && (
            <span class="bg-white border border-slate-300 text-slate-700 px-2.5 py-1 rounded-full font-medium shadow-2xs">
              Kata Kunci: "{searchQuery}"
            </span>
          )}
          {currentStock !== 'semua' && (
            <span class="bg-white border border-slate-300 text-slate-700 px-2.5 py-1 rounded-full font-medium shadow-2xs">
              Stok: <strong class="text-slate-900">{currentStock === 'ready' ? 'Ready Stock' : currentStock === 'po' ? 'Pre-Order' : 'Habis'}</strong>
            </span>
          )}
        </div>
      )}

      {products.length > 0 ? (
        <div class="space-y-6">
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
            {products.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>

          {totalPages > 1 && (
            <nav aria-label="Navigasi Halaman Katalog" class="flex items-center justify-center gap-2 pt-2">
              {safePage > 1 ? (
                <a
                  href={buildFilterUrl({ page: String(safePage - 1) })}
                  rel="prev"
                  class="min-h-[44px] inline-flex items-center px-4 py-2 bg-white hover:bg-slate-50 border border-slate-300 rounded-xl text-xs font-bold text-slate-700 transition"
                >
                  ← Sebelumnya
                </a>
              ) : (
                <span class="min-h-[44px] inline-flex items-center px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-400">
                  ← Sebelumnya
                </span>
              )}

              <span class="text-xs font-bold text-slate-700 px-3 tabular-nums">
                Halaman {safePage} dari {totalPages}
              </span>

              {safePage < totalPages ? (
                <a
                  href={buildFilterUrl({ page: String(safePage + 1) })}
                  rel="next"
                  class="min-h-[44px] inline-flex items-center px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-xs font-bold transition shadow-xs"
                >
                  Berikutnya →
                </a>
              ) : (
                <span class="min-h-[44px] inline-flex items-center px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold text-slate-400">
                  Berikutnya →
                </span>
              )}
            </nav>
          )}
        </div>
      ) : (
        <EmptyState
          icon="search"
          title="Tidak Ada Produk yang Cocok"
          description="Coba pilih wilayah MWC lainnya atau ubah kata kunci pencarian Anda."
          actionHref="/"
          actionLabel="Lihat Semua Produk"
        />
      )}
    </section>

    <!-- 3. INTERACTIVE PROMO SLIDER -->
    {showDiscoverySections && (
      <section class="py-1">
        <PromoSlider />
      </section>
    )}

    <!-- 4. VALUE PROPOSITION BANNER (Honest 0% Commission Copy) -->
    {showDiscoverySections && (
      <section class="px-3 sm:px-0">
        <div class="bg-gradient-to-r from-emerald-800 via-emerald-700 to-teal-800 border border-emerald-600 rounded-2xl p-4 sm:p-6 flex flex-col sm:flex-row items-center justify-between gap-4 shadow-md text-white">
          <div class="flex items-center gap-3 sm:gap-4 text-center sm:text-left">
            <div class="w-12 h-12 rounded-2xl bg-white/20 text-white border border-white/30 flex items-center justify-center shrink-0">
              <AppIcon name="store" size="lg" />
            </div>
            <div>
              <h3 class="font-black text-sm sm:text-base text-white">
                0% Komisi Transaksi (Layanan Promosi Opsional)
              </h3>
              <p class="text-xs text-emerald-100 mt-0.5">
                Pasang katalog produk gratis tanpa potongan penjualan. Pembeli terhubung langsung ke WhatsApp pemilik usaha se-Sumenep.
              </p>
            </div>
          </div>
          <a
            href="/pasang-iklan"
            class="shrink-0 min-h-[44px] inline-flex items-center justify-center bg-white hover:bg-slate-100 text-emerald-900 font-extrabold text-xs px-5 py-2.5 rounded-xl shadow-xs transition"
          >
            + Pasang Iklan Toko Anda
          </a>
        </div>
      </section>
    )}

    <!-- 5. VERIFIED & FEATURED STORES -->
    {verifiedSellers.length > 0 && showDiscoverySections && (
      <section id="toko-warga" class="space-y-4 px-3 sm:px-0">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-base sm:text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
              <AppIcon name="store" size="sm" class="text-emerald-700" />
              <span>Toko & Pengrajin Warga NU</span>
            </h2>
            <p class="text-xs text-slate-600 mt-0.5">Beli langsung dari produsen dan pedagang nahdliyin terdekat</p>
          </div>
          <a href="/toko" class="text-xs font-bold text-emerald-700 hover:text-emerald-800 transition flex items-center gap-1">
            <span>Lihat Semua Toko ({sellers.length})</span>
            <AppIcon name="arrow-right" size="xs" />
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4">
          {verifiedSellers.slice(0, 4).map((seller) => (
            <a
              href={`/toko/${seller.slug || seller.id}`}
              class="bg-white border border-slate-200 rounded-2xl p-4 flex flex-col items-center text-center space-y-2 hover:border-emerald-500 hover:shadow-xs transition relative group cursor-pointer"
            >
              <div class="relative">
                <div class="w-16 h-16 rounded-full bg-emerald-50 text-emerald-800 border-2 border-emerald-300 flex items-center justify-center font-black text-lg shadow-inner group-hover:bg-emerald-100 transition">
                  {seller.name.slice(0, 2).toUpperCase()}
                </div>
                {Boolean(seller.is_verified) && (
                  <span class="absolute -top-1 -right-1 bg-emerald-700 text-white w-5 h-5 rounded-full flex items-center justify-center shadow-xs" title="Terverifikasi MWC NU">
                    <AppIcon name="check" size="xs" />
                  </span>
                )}
              </div>
              <div class="space-y-1 w-full">
                <h3 class="font-extrabold text-xs sm:text-sm text-slate-900 group-hover:text-emerald-700 transition truncate">
                  {seller.name}
                </h3>
                <p class="text-xs text-slate-600 truncate">
                  {seller.zone_name}
                </p>
                <span class="inline-block text-xs bg-slate-100 text-emerald-800 font-bold px-2.5 py-0.5 rounded-full border border-slate-200">
                  {seller.product_count} Produk Aktif
                </span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 6. KABAR & PANDUAN UMKM (3 Cards) -->
    {articles.length > 0 && showDiscoverySections && (
      <section id="panduan" class="space-y-4 px-3 sm:px-0">
        <div class="flex items-center justify-between">
          <div>
            <h2 class="text-base sm:text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
              <AppIcon name="book" size="sm" class="text-emerald-700" />
              <span>Kabar & Panduan UMKM Sumenep</span>
            </h2>
            <p class="text-xs text-slate-600 mt-0.5">Edukasi ekonomi pekarangan, legalitas halal & panduan usaha nahdliyin</p>
          </div>
          <a
            href="/edukasi"
            class="text-xs font-bold text-emerald-700 hover:text-emerald-800 border border-emerald-200 bg-emerald-50/50 hover:bg-emerald-50 px-3.5 py-1.5 rounded-full transition inline-flex items-center gap-1.5 shadow-2xs"
          >
            <span>Semua Panduan ({articles.length})</span>
            <AppIcon name="arrow-right" size="xs" />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4">
          {articles.slice(0, 3).map((art) => (
            <a
              href={`/edukasi/${art.slug}`}
              class="bg-white border border-slate-200 rounded-xl p-3 sm:p-4 flex gap-3 hover:border-emerald-500 hover:shadow-sm transition group cursor-pointer"
            >
              <img
                src={art.image_url}
                alt={art.title}
                width="96"
                height="96"
                decoding="async"
                class="w-20 h-20 sm:w-24 sm:h-24 rounded-lg object-cover shrink-0 group-hover:scale-102 transition"
                loading="lazy"
              />
              <div class="space-y-1 min-w-0">
                <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider block">{art.category}</span>
                <h3 class="font-extrabold text-xs sm:text-sm text-slate-900 group-hover:text-emerald-700 line-clamp-2 leading-snug">
                  {art.title}
                </h3>
                <p class="text-xs text-slate-600 line-clamp-2">
                  {art.summary}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>