---
import Layout from '../layouts/Layout.astro';
import { getAllZones, getProducts } from '../lib/db';

const url = new URL(Astro.request.url);
const currentZone = url.searchParams.get('zona') || 'semua';
const currentCategory = url.searchParams.get('kategori') || 'semua';
const searchQuery = url.searchParams.get('q') || '';

const zones = getAllZones();
const products = getProducts({
  zoneSlug: currentZone,
  category: currentCategory,
  search: searchQuery,
});

const categories = [
  'Semua',
  'Makanan & Minuman',
  'Batik & Kerajinan',
  'Hasil Laut & Olahan',
  'Pertanian & Perkebunan',
];

function formatRupiah(amount: number) {
  return new Intl.NumberFormat('id-ID', {
    style: 'currency',
    currency: 'IDR',
    maximumFractionDigits: 0,
  }).format(amount);
}
---

<Layout title="Katalog Produk UMKM NU Sumenep">
  <div class="space-y-4">
    <!-- Search Form (Mobile Optimized) -->
    <form method="GET" action="/" class="relative">
      <input type="hidden" name="zona" value={currentZone} />
      <input type="hidden" name="kategori" value={currentCategory} />
      <div class="relative flex items-center">
        <input
          type="text"
          name="q"
          value={searchQuery}
          placeholder="Cari rengginang, batik, kopi, krupuk..."
          class="w-full bg-white border border-slate-300 rounded-2xl py-3 pl-11 pr-10 text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-emerald-500 shadow-sm"
        />
        <div class="absolute left-3.5 text-slate-400 pointer-events-none">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
        </div>
        {searchQuery && (
          <a href={`/?zona=${currentZone}&kategori=${currentCategory}`} class="absolute right-3.5 text-slate-400 hover:text-slate-600 text-sm font-bold">
            ✕
          </a>
        )}
      </div>
    </form>

    <!-- Sentimen Banner "Beli Tetangga" -->
    <div class="bg-gradient-to-r from-emerald-50 to-emerald-100/70 border border-emerald-200/80 rounded-2xl p-3 sm:p-4 flex items-start gap-3 shadow-xs">
      <div class="text-2xl mt-0.5">🤝</div>
      <div class="text-xs text-emerald-900 leading-relaxed">
        <strong class="font-bold text-emerald-950 block text-xs sm:text-sm">Gerakan Beli Produk Tetangga NU:</strong>
        Semua transaksi 100% langsung terhubung ke nomor WhatsApp penjual. Tanpa potongan aplikasi, tanpa biaya perantara!
      </div>
    </div>

    <!-- Filter 1: Wilayah Teritorial MWC (Horizontal Scroll Bar) -->
    <div class="space-y-1.5">
      <div class="flex items-center justify-between text-xs px-1">
        <span class="font-bold text-slate-700 uppercase tracking-wider text-[11px]">📍 Pilih Wilayah (MWC NU):</span>
        {currentZone !== 'semua' && (
          <a href={`/?zona=semua&kategori=${currentCategory}&q=${searchQuery}`} class="text-emerald-700 font-semibold hover:underline">
            Reset Wilayah
          </a>
        )}
      </div>
      <div class="flex gap-2 overflow-x-auto pb-1 no-scrollbar text-xs scroll-smooth">
        <a
          href={`/?zona=semua&kategori=${currentCategory}&q=${searchQuery}`}
          class={`px-3 py-1.5 rounded-full whitespace-nowrap font-medium transition shrink-0 ${
            currentZone === 'semua'
              ? 'bg-emerald-700 text-white shadow-xs'
              : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100'
          }`}
        >
          Semua Wilayah
        </a>
        {zones.map((z) => (
          <a
            href={`/?zona=${z.slug}&kategori=${currentCategory}&q=${searchQuery}`}
            class={`px-3 py-1.5 rounded-full whitespace-nowrap font-medium transition shrink-0 ${
              currentZone === z.slug
                ? 'bg-emerald-700 text-white shadow-xs'
                : 'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100'
            }`}
          >
            {z.name}
          </a>
        ))}
      </div>
    </div>

    <!-- Filter 2: Kategori Produk -->
    <div class="flex gap-1.5 overflow-x-auto pb-1 text-xs no-scrollbar">
      {categories.map((cat) => {
        const catVal = cat === 'Semua' ? 'semua' : cat;
        const isActive = (currentCategory === 'semua' && cat === 'Semua') || currentCategory === cat;
        return (
          <a
            href={`/?zona=${currentZone}&kategori=${encodeURIComponent(catVal)}&q=${searchQuery}`}
            class={`px-3 py-1 rounded-xl text-xs font-semibold whitespace-nowrap transition shrink-0 ${
              isActive
                ? 'bg-slate-800 text-white'
                : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'
            }`}
          >
            {cat}
          </a>
        );
      })}
    </div>

    <!-- Product List Status Bar -->
    <div class="flex items-center justify-between text-xs text-slate-500 pt-1 px-1">
      <span>Menampilkan <strong>{products.length}</strong> produk</span>
      {(currentZone !== 'semua' || currentCategory !== 'semua' || searchQuery !== '') && (
        <a href="/" class="text-emerald-700 font-bold hover:underline">
          Hapus Semua Filter
        </a>
      )}
    </div>

    <!-- Grid Produk 2-Kolom (Mobile-First) -->
    {products.length > 0 ? (
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 sm:gap-4">
        {products.map((p) => {
          const waMessage = encodeURIComponent(
            `Halo ${p.umkm_name}, saya melihat produk *${p.name}* seharga ${formatRupiah(p.price)} di Pasar Digital UMKM NU Sumenep.\n\nApakah stok masih ada dan bisa dikirim ke daerah saya? Terima kasih.`
          );
          const waLink = `https://wa.me/${p.umkm_phone}?text=${waMessage}`;

          return (
            <article class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-xs hover:shadow-md transition flex flex-col group">
              <!-- Thumbnail Link to Detail Page -->
              <a href={`/p/${p.slug}`} class="block relative aspect-square bg-slate-100 overflow-hidden">
                <img
                  src={p.image_url}
                  alt={p.name}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                />
                <!-- Location Chip -->
                <span class="absolute top-2 left-2 bg-slate-900/75 backdrop-blur-xs text-white text-[10px] font-medium px-2 py-0.5 rounded-md shadow-xs">
                  {p.zone_name.replace('MWC ', '')}
                </span>
              </a>

              <!-- Card Content -->
              <div class="p-3 flex-1 flex flex-col justify-between space-y-2">
                <div>
                  <div class="flex items-center gap-1 text-[11px] font-bold text-emerald-600 mb-1">
                    <span>✓</span>
                    <span>Warga NU</span>
                  </div>
                  <a href={`/p/${p.slug}`} class="font-bold text-xs sm:text-sm text-slate-800 line-clamp-2 hover:text-emerald-700 leading-snug">
                    {p.name}
                  </a>
                </div>

                <div class="pt-1 border-t border-slate-100 space-y-2">
                  <div>
                    <span class="text-xs sm:text-sm font-black text-emerald-700 block">
                      {formatRupiah(p.price)}
                    </span>
                    <span class="text-[11px] text-slate-500 truncate block mt-0.5">
                      {p.umkm_name}
                    </span>
                  </div>

                  <!-- Direct WA CTA Button -->
                  <a
                    href={waLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full py-2 px-2.5 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white rounded-xl text-xs font-bold flex items-center justify-center gap-1.5 shadow-xs transition"
                  >
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                    </svg>
                    <span>Chat WA</span>
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="bg-white border border-slate-200 rounded-2xl p-8 text-center space-y-3">
        <div class="text-4xl">🔍</div>
        <h3 class="font-bold text-slate-800 text-sm sm:text-base">Belum Ada Produk Ditemukan</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">
          Coba ubah kata kunci pencarian atau pilih wilayah MWC lainnya.
        </p>
        <a href="/" class="inline-block mt-2 text-xs font-bold bg-emerald-700 text-white px-4 py-2 rounded-xl">
          Kembali ke Semua Produk
        </a>
      </div>
    )}
  </div>
</Layout>
