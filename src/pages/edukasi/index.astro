---
import Layout from '../../layouts/Layout.astro';
import { getArticles } from '../../lib/db';

const allArticles = await getArticles();
const url = new URL(Astro.request.url);
const currentCategory = url.searchParams.get('kategori') || 'semua';

const categories = [
  'Semua',
  'Ekonomi Pekarangan',
  'Panduan Usaha',
  'Legalitas & Halal',
  'Tips Transaksi',
  'Gerakan Warga',
];

const filteredArticles =
  currentCategory === 'semua'
    ? allArticles
    : allArticles.filter((art) => art.category.toLowerCase() === currentCategory.toLowerCase());

const featuredArticle = allArticles[0];
const otherArticles = filteredArticles.filter((art) => art.id !== featuredArticle?.id);
---

<Layout
  title="Pusat Edukasi & Panduan Usaha Nahdliyin | Pasar Warga NU Sumenep"
  description="Kumpulan panduan praktis ekonomi pekarangan, kiat merintis usaha santri, pengurusan sertifikasi halal gratis, dan panduan transaksi aman warga NU Sumenep."
>
  <div class="max-w-7xl mx-auto space-y-6 sm:space-y-8 py-4 sm:py-8 px-3 sm:px-6 lg:px-8">
    
    <!-- Top Breadcrumb -->
    <div class="flex items-center justify-between text-xs text-slate-500 pb-2 border-b border-slate-200">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2">
        <a href="/" class="hover:text-emerald-700">Beranda</a>
        <span>›</span>
        <span class="text-slate-900 font-bold">Pusat Edukasi & Panduan Usaha</span>
        {currentCategory !== 'semua' && (
          <>
            <span>›</span>
            <span class="text-emerald-700 font-bold">{currentCategory}</span>
          </>
        )}
      </nav>

      <a
        href="/agen"
        class="hidden sm:inline-flex text-xs font-semibold text-emerald-700 hover:text-emerald-800 transition items-center gap-1"
      >
        <span>+ Daftarkan Usaha Anda</span>
      </a>
    </div>

    <!-- Hero Header -->
    <div class="bg-white border-y sm:border border-slate-200 sm:rounded-2xl p-5 sm:p-8 shadow-xs space-y-3">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold">
        <span>📖</span>
        <span>Literasi & Pemberdayaan Ekonomi Santri</span>
      </div>
      <h1 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
        Pusat Edukasi & Panduan Usaha Warga NU
      </h1>
      <p class="text-xs sm:text-sm text-slate-600 max-w-3xl leading-relaxed">
        Kumpulan panduan taktis untuk memajukan usaha nahdliyin di Sumenep: mulai dari optimalisasi ekonomi pekarangan, pendampingan sertifikasi halal gratis (SEHATI), kiat memulai usaha santri, hingga etika transaksi berkah antar-tetangga.
      </p>

      <!-- Category Filter Pills -->
      <div class="flex items-center gap-2 overflow-x-auto pt-3 no-scrollbar pb-1">
        {categories.map((cat) => {
          const isActive = currentCategory.toLowerCase() === cat.toLowerCase();
          return (
            <a
              href={cat === 'Semua' ? '/edukasi' : `/edukasi?kategori=${encodeURIComponent(cat)}`}
              class={`px-3.5 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition cursor-pointer shrink-0 ${
                isActive
                  ? 'bg-emerald-700 text-white shadow-xs'
                  : 'bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-900 border border-slate-200'
              }`}
            >
              {cat}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Featured Top Article (Only on All / Default View) -->
    {currentCategory === 'semua' && featuredArticle && (
      <section class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-xs hover:border-slate-300 transition group">
        <a href={`/edukasi/${featuredArticle.slug}`} class="grid grid-cols-1 md:grid-cols-12 gap-0 md:gap-6 items-center">
          <div class="md:col-span-6 lg:col-span-7 aspect-16/9 md:aspect-4/3 overflow-hidden bg-slate-100">
            <img
              src={featuredArticle.image_url}
              alt={featuredArticle.title}
              class="w-full h-full object-cover group-hover:scale-103 transition duration-300"
            />
          </div>
          <div class="md:col-span-6 lg:col-span-5 p-5 sm:p-8 space-y-3">
            <span class="inline-block text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-200 px-2.5 py-0.5 rounded-full">
              {featuredArticle.category}
            </span>
            <h2 class="text-lg sm:text-2xl font-black text-slate-900 group-hover:text-emerald-700 transition leading-snug">
              {featuredArticle.title}
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-3">
              {featuredArticle.summary}
            </p>
            <div class="pt-2 flex items-center gap-2 text-xs font-bold text-emerald-700 group-hover:translate-x-1 transition">
              <span>Baca Panduan Lengkap</span>
              <span>➔</span>
            </div>
          </div>
        </a>
      </section>
    )}

    <!-- Articles Grid -->
    <section class="space-y-4">
      <div class="flex items-center justify-between">
        <h3 class="text-sm sm:text-base font-black text-slate-900 tracking-tight flex items-center gap-2">
          <span>📚</span>
          <span>Daftar Artikel & Panduan ({filteredArticles.length})</span>
        </h3>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {(currentCategory === 'semua' ? otherArticles : filteredArticles).map((article) => (
          <article class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-xs hover:border-slate-300 hover:shadow-md transition flex flex-col justify-between group">
            <div>
              <a href={`/edukasi/${article.slug}`} class="block aspect-16/10 overflow-hidden bg-slate-100 relative">
                <img
                  src={article.image_url}
                  alt={article.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition duration-300"
                />
                <span class="absolute top-2 left-2 bg-white/95 backdrop-blur-xs text-emerald-800 border border-emerald-200 text-[10px] font-bold px-2 py-0.5 rounded shadow-xs">
                  {article.category}
                </span>
              </a>

              <div class="p-4 space-y-2">
                <a
                  href={`/edukasi/${article.slug}`}
                  class="font-black text-sm sm:text-base text-slate-900 group-hover:text-emerald-700 line-clamp-2 leading-snug transition"
                >
                  {article.title}
                </a>
                <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                  {article.summary}
                </p>
              </div>
            </div>

            <div class="p-4 pt-0 border-t border-slate-100 mt-2 flex items-center justify-between text-xs pt-3">
              <span class="text-slate-400 text-[11px]">
                {new Date(article.created_at).toLocaleDateString('id-ID', {
                  day: 'numeric',
                  month: 'short',
                  year: 'numeric',
                })}
              </span>
              <a
                href={`/edukasi/${article.slug}`}
                class="font-bold text-emerald-700 group-hover:underline flex items-center gap-1"
              >
                <span>Baca</span>
                <span>➔</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- FITUR LPNU SLIDE 10: DOKUMENTASI & STUDI KASUS INSPIRASI LAPANGAN -->
    <section class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-8 shadow-xs space-y-6">
      <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 pb-4 border-b border-slate-100">
        <div class="space-y-1">
          <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-900 border border-amber-200 text-[10px] font-black uppercase tracking-wider">
            <span>🎬</span>
            <span>Slide 10 LPNU • Studi Kasus & Dokumentasi</span>
          </div>
          <h2 class="text-lg sm:text-2xl font-black text-slate-900">
            Inspirasi Nyata Ekonomi Pekarangan & Santri
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 max-w-2xl">
            Tonton dokumentasi praktik lapangan mandiri pangan dan budidaya pekarangan sebagai percontohan unit usaha santri di lingkungan MWC Sumenep.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        
        <!-- Video 01: Yoso Farm -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden flex flex-col justify-between hover:shadow-sm transition">
          <div class="space-y-3 p-4">
            <div class="relative aspect-16/9 rounded-xl overflow-hidden bg-slate-900 group">
              <img
                src="https://images.unsplash.com/photo-1595974482597-4b8da8879bc5?auto=format&fit=crop&w=600&q=80"
                alt="Yoso Farm: Kebun & Ternak"
                class="w-full h-full object-cover opacity-85 group-hover:scale-103 transition duration-300"
              />
              <div class="absolute inset-0 bg-black/30 flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-rose-600/90 text-white flex items-center justify-center text-lg shadow-md group-hover:scale-110 transition">
                  ▶
                </div>
              </div>
              <span class="absolute bottom-2 right-2 bg-black/80 text-white text-[10px] font-mono px-2 py-0.5 rounded">
                22 Menit
              </span>
            </div>

            <div class="space-y-1">
              <span class="text-[10px] font-bold text-emerald-700 uppercase tracking-wider block">Video 01 • Integrasi Pangan</span>
              <h3 class="font-black text-sm text-slate-900 leading-snug">
                Yoso Farm: Kebun Sayur & Ternak Mandiri
              </h3>
              <p class="text-[11px] text-slate-500 font-semibold">Channel OASIS</p>
            </div>

            <div class="space-y-1.5 text-xs text-slate-600 pt-1 border-t border-slate-200/60">
              <p class="leading-relaxed">
                <strong>Praktik Nyata:</strong> Integrasi tanaman sayur pekarangan & ternak tanpa perlu belanja kebutuhan harian.
              </p>
              <p class="leading-relaxed">
                <strong>Peluang Usaha:</strong> Surplus panen segar & bibit diserap langsung oleh tetangga sekitar.
              </p>
            </div>
          </div>

          <div class="p-4 pt-0">
            <a
              href="https://www.youtube.com/results?search_query=yoso+farm+kebun+ternak+oasis"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-2.5 px-3 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl flex items-center justify-center gap-2 transition"
            >
              <span>▶ Tonton di YouTube</span>
              <span>➔</span>
            </a>
          </div>
        </div>

        <!-- Video 02: Kebun Galon -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden flex flex-col justify-between hover:shadow-sm transition">
          <div class="space-y-3 p-4">
            <div class="relative aspect-16/9 rounded-xl overflow-hidden bg-slate-900 group">
              <img
                src="https://images.unsplash.com/photo-1530836369250-ef72a3f5cda8?auto=format&fit=crop&w=600&q=80"
                alt="Kebun Galon: Hemat Siram"
                class="w-full h-full object-cover opacity-85 group-hover:scale-103 transition duration-300"
              />
              <div class="absolute inset-0 bg-black/30 flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-rose-600/90 text-white flex items-center justify-center text-lg shadow-md group-hover:scale-110 transition">
                  ▶
                </div>
              </div>
              <span class="absolute bottom-2 right-2 bg-black/80 text-white text-[10px] font-mono px-2 py-0.5 rounded">
                20 Menit
              </span>
            </div>

            <div class="space-y-1">
              <span class="text-[10px] font-bold text-emerald-700 uppercase tracking-wider block">Video 02 • Sistem Cerdas</span>
              <h3 class="font-black text-sm text-slate-900 leading-snug">
                Kebun Galon: Sistem Kapiler Hemat Siram
              </h3>
              <p class="text-[11px] text-slate-500 font-semibold">Channel OASIS</p>
            </div>

            <div class="space-y-1.5 text-xs text-slate-600 pt-1 border-t border-slate-200/60">
              <p class="leading-relaxed">
                <strong>Praktik Nyata:</strong> Daur ulang galon bekas air mineral dengan sistem sumbu kapiler tanpa siram setiap hari.
              </p>
              <p class="leading-relaxed">
                <strong>Peluang Usaha:</strong> Solusi lahan sempit di perumahan santri dengan panen sayur bernilai jual tinggi.
              </p>
            </div>
          </div>

          <div class="p-4 pt-0">
            <a
              href="https://www.youtube.com/results?search_query=kebun+galon+hemat+siram+oasis"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-2.5 px-3 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl flex items-center justify-center gap-2 transition"
            >
              <span>▶ Tonton di YouTube</span>
              <span>➔</span>
            </a>
          </div>
        </div>

        <!-- Video 03: Sayur Teras -->
        <div class="bg-slate-50 border border-slate-200 rounded-2xl overflow-hidden flex flex-col justify-between hover:shadow-sm transition">
          <div class="space-y-3 p-4">
            <div class="relative aspect-16/9 rounded-xl overflow-hidden bg-slate-900 group">
              <img
                src="https://images.unsplash.com/photo-1592417817098-8f3d69104a47?auto=format&fit=crop&w=600&q=80"
                alt="Sayur Teras: Cuan Bulanan"
                class="w-full h-full object-cover opacity-85 group-hover:scale-103 transition duration-300"
              />
              <div class="absolute inset-0 bg-black/30 flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-rose-600/90 text-white flex items-center justify-center text-lg shadow-md group-hover:scale-110 transition">
                  ▶
                </div>
              </div>
              <span class="absolute bottom-2 right-2 bg-black/80 text-white text-[10px] font-mono px-2 py-0.5 rounded">
                12 Menit
              </span>
            </div>

            <div class="space-y-1">
              <span class="text-[10px] font-bold text-emerald-700 uppercase tracking-wider block">Video 03 • Bisnis Sayur</span>
              <h3 class="font-black text-sm text-slate-900 leading-snug">
                Sayur Teras: Panen Rutin Cuan Bulanan
              </h3>
              <p class="text-[11px] text-slate-500 font-semibold">Channel Cerita Alam</p>
            </div>

            <div class="space-y-1.5 text-xs text-slate-600 pt-1 border-t border-slate-200/60">
              <p class="leading-relaxed">
                <strong>Praktik Nyata:</strong> Budidaya aneka sayuran segar di teras rumah santri sebagai unit usaha sampingan produktif.
              </p>
              <p class="leading-relaxed">
                <strong>Peluang Usaha:</strong> Menghasilkan arus kas rutin mingguan dari pembeli tetangga komplek & warung terdekat.
              </p>
            </div>
          </div>

          <div class="p-4 pt-0">
            <a
              href="https://www.youtube.com/results?search_query=sayur+teras+cuan+bulanan+cerita+alam"
              target="_blank"
              rel="noopener noreferrer"
              class="w-full py-2.5 px-3 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl flex items-center justify-center gap-2 transition"
            >
              <span>▶ Tonton di YouTube</span>
              <span>➔</span>
            </a>
          </div>
        </div>

      </div>
    </section>

    <!-- Bottom Call to Action -->
    <div class="bg-gradient-to-r from-emerald-800 to-teal-800 rounded-2xl p-6 sm:p-8 text-white flex flex-col sm:flex-row items-center justify-between gap-4 shadow-sm">
      <div class="space-y-1 text-center sm:text-left">
        <h3 class="text-base sm:text-xl font-black">Punya Usaha atau Produk Rumah Tangga di Sumenep?</h3>
        <p class="text-xs sm:text-sm text-emerald-100 max-w-xl">
          Terapkan panduan di atas dan pasang iklan produk Anda secara gratis. Terhubung langsung ke WhatsApp pembeli tanpa potongan biaya.
        </p>
      </div>
      <a
        href="/agen"
        class="shrink-0 bg-white hover:bg-slate-100 text-emerald-900 font-black text-xs sm:text-sm px-6 py-3 rounded-full transition shadow-md active:scale-98"
      >
        + Pasang Iklan Sekarang
      </a>
    </div>

  </div>
</Layout>
