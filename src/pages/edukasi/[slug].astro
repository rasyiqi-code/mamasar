---
import Layout from '../../layouts/Layout.astro';
import { getArticleBySlug, getArticles, getProducts } from '../../lib/db';
import ProductCard from '../../components/ProductCard.astro';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/edukasi');
}

const article = await getArticleBySlug(slug);

if (!article) {
  return new Response(null, {
    status: 404,
    statusText: 'Artikel Tidak Ditemukan',
  });
}

const currentUrl = Astro.url.href;
const allArticles = await getArticles();
const relatedArticles = allArticles.filter((a) => a.id !== article.id).slice(0, 3);
const sampleProducts = (await getProducts()).slice(0, 4);

// Schema.org Article Structured Data
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  image: [article.image_url],
  datePublished: article.created_at,
  dateModified: article.created_at,
  author: {
    '@type': 'Organization',
    name: 'PCNU Kabupaten Sumenep',
    url: currentUrl,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Pasar Warga NU Sumenep',
    logo: {
      '@type': 'ImageObject',
      url: `${Astro.url.origin}/favicon.svg`,
    },
  },
  description: article.summary,
};

// Simple Markdown to HTML formatter for headings and lists
function formatContent(text: string): string {
  if (!text) return '';
  return text
    .replace(/^### (.*$)/gim, '<h3 class="text-base sm:text-lg font-black text-slate-900 mt-6 mb-2">$1</h3>')
    .replace(/^## (.*$)/gim, '<h2 class="text-lg sm:text-xl font-black text-slate-900 mt-8 mb-3">$1</h2>')
    .replace(/^\- (.*$)/gim, '<li class="ml-4 list-disc text-slate-700 leading-relaxed">$1</li>')
    .replace(/\*\*(.*?)\*\*/gim, '<strong class="text-slate-900 font-bold">$1</strong>')
    .replace(/\*(.*?)\*/gim, '<em class="italic">$1</em>')
    .replace(/\n\n/gim, '</p><p class="text-xs sm:text-sm text-slate-700 leading-relaxed mb-4">');
}

const renderedContent = formatContent(article.content || article.summary);
---

<Layout
  title={`${article.title} | Edukasi UMKM NU Sumenep`}
  description={article.summary}
  image={article.image_url}
  canonicalUrl={currentUrl}
  schema={articleSchema}
>
  <div class="max-w-7xl mx-auto space-y-6 py-4 sm:py-8 px-3 sm:px-6 lg:px-8">
    
    <!-- Top Breadcrumb -->
    <div class="flex items-center justify-between text-xs text-slate-500 pb-2 border-b border-slate-200">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 truncate">
        <a href="/" class="hover:text-emerald-700">Beranda</a>
        <span>›</span>
        <a href="/edukasi" class="hover:text-emerald-700">Pusat Edukasi</a>
        <span>›</span>
        <span class="text-slate-900 font-bold truncate max-w-xs">{article.title}</span>
      </nav>

      <a
        href="/edukasi"
        class="hidden sm:inline-flex text-xs font-semibold text-slate-500 hover:text-slate-900 transition items-center gap-1"
      >
        <span>← Semua Artikel</span>
      </a>
    </div>

    <!-- Main Grid Layout (Article Body on Left, Sidebar on Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT COLUMN: Article Content Container (8 cols) -->
      <main class="lg:col-span-8 bg-white border border-slate-200 rounded-2xl p-5 sm:p-8 shadow-xs space-y-6">
        
        <!-- Article Header -->
        <header class="space-y-3 pb-5 border-b border-slate-100">
          <div class="flex items-center gap-2">
            <span class="text-[10px] sm:text-xs font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 border border-emerald-200 px-2.5 py-0.5 rounded-full">
              {article.category}
            </span>
            <span class="text-xs text-slate-400">•</span>
            <span class="text-xs text-slate-500">
              Diterbitkan: {new Date(article.created_at).toLocaleDateString('id-ID', {
                day: 'numeric',
                month: 'long',
                year: 'numeric',
              })}
            </span>
          </div>

          <h1 class="text-xl sm:text-3xl font-black text-slate-900 leading-tight">
            {article.title}
          </h1>

          <p class="text-xs sm:text-sm text-slate-600 font-medium leading-relaxed italic border-l-4 border-emerald-600 pl-3 py-1">
            "{article.summary}"
          </p>
        </header>

        <!-- Featured Hero Image -->
        <div class="w-full aspect-16/9 rounded-xl overflow-hidden bg-slate-100">
          <img
            src={article.image_url}
            alt={article.title}
            class="w-full h-full object-cover"
            fetchpriority="high"
          />
        </div>

        <!-- Article Prose Content -->
        <article class="prose max-w-none text-xs sm:text-sm text-slate-700 leading-relaxed space-y-4">
          <p class="text-xs sm:text-sm text-slate-700 leading-relaxed mb-4" set:html={renderedContent} />
        </article>

        <!-- Share Buttons Bar -->
        <footer class="pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
          <span class="font-bold text-slate-700">Bagikan panduan ini ke sesama warga:</span>
          <div class="flex items-center gap-2">
            <a
              href={`https://wa.me/?text=${encodeURIComponent(`${article.title}\nBaca panduan lengkapnya di:\n${currentUrl}`)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold px-3.5 py-1.5 rounded-lg flex items-center gap-1.5 shadow-2xs transition"
            >
              <span>WhatsApp</span>
            </a>
            <a
              href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="bg-blue-600 hover:bg-blue-700 text-white font-bold px-3.5 py-1.5 rounded-lg flex items-center gap-1.5 shadow-2xs transition"
            >
              <span>Facebook</span>
            </a>
          </div>
        </footer>

      </main>

      <!-- RIGHT COLUMN: Sticky Sidebar (4 cols) -->
      <aside class="lg:col-span-4 space-y-5 lg:sticky lg:top-20">
        
        <!-- Post Your Ad Callout Card -->
        <div class="bg-gradient-to-br from-emerald-800 to-teal-800 text-white p-5 rounded-2xl shadow-xs space-y-3">
          <div class="w-10 h-10 rounded-xl bg-white/20 border border-white/30 flex items-center justify-center text-xl">
            🏪
          </div>
          <h3 class="font-black text-sm sm:text-base">Punya Usaha di Sumenep?</h3>
          <p class="text-xs text-emerald-100 leading-relaxed">
            Daftarkan produk Anda secara gratis. Hubungi agen lapangan MWC terdekat atau masukkan produk sendiri.
          </p>
          <a
            href="/agen"
            class="block w-full py-2.5 px-4 bg-white hover:bg-slate-100 text-emerald-900 rounded-xl font-black text-xs text-center transition shadow-xs active:scale-98"
          >
            + Pasang Iklan Toko Anda
          </a>
        </div>

        <!-- Other Guides / Articles List -->
        <div class="bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-xs space-y-3">
          <h3 class="font-black text-xs uppercase tracking-wider text-slate-800 flex items-center gap-1.5">
            <span>📰</span> Panduan Terkait Lainnya
          </h3>
          <div class="divide-y divide-slate-100 text-xs">
            {relatedArticles.map((ra) => (
              <a href={`/edukasi/${ra.slug}`} class="py-2.5 block group">
                <span class="text-[10px] font-bold text-emerald-700 uppercase tracking-wider block">
                  {ra.category}
                </span>
                <h4 class="font-bold text-slate-900 group-hover:text-emerald-700 transition line-clamp-2 mt-0.5">
                  {ra.title}
                </h4>
              </a>
            ))}
          </div>
          <div class="pt-2 border-t border-slate-100">
            <a href="/edukasi" class="text-xs font-bold text-indigo-600 hover:underline block text-center">
              Lihat Semua Panduan ({allArticles.length}) ➔
            </a>
          </div>
        </div>

      </aside>

    </div>

    <!-- Related Products Section -->
    {sampleProducts.length > 0 && (
      <section class="space-y-4 pt-6 border-t border-slate-200">
        <div class="flex items-center justify-between">
          <h3 class="text-base sm:text-lg font-black text-slate-900 tracking-tight flex items-center gap-2">
            <span>🛍️</span> Dukung Produk Warga Nahdliyin Sumenep
          </h3>
          <a href="/" class="text-xs font-bold text-emerald-700 hover:underline">
            Katalog Lengkap ➔
          </a>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
          {sampleProducts.map((p) => (
            <ProductCard product={p} />
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>
