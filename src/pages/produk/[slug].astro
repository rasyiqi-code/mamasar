---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import NotFoundView from '../../components/common/NotFoundView.astro';
import { getProductBySlug, getProducts, incrementProductViews } from '../../lib/db';
import { formatRupiah, createProductWhatsAppUrl, getOptimizedImageUrl, getImageSrcSet } from '../../lib/utils';
import { DEFAULT_PRODUCT_IMAGE, SITE_CONFIG } from '../../lib/constants';
import { isHttpsRequest } from '../../lib/security';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/', 301);
}

const product = await getProductBySlug(slug);

if (!product) {
  Astro.response.status = 404;
}

const canonicalPath = product ? `/produk/${product.slug}` : Astro.url.pathname;
const currentUrl = new URL(canonicalPath, Astro.url.origin).href;

// Bounded single view-counter cookie (max 20 product IDs, 1 hour TTL)
let currentViews = product?.views || 0;
if (product) {
  const rawViewed = Astro.cookies.get('mamasar_viewed')?.value;
  let viewedIds: number[] = [];
  if (rawViewed) {
    try {
      const parsed = JSON.parse(rawViewed);
      if (Array.isArray(parsed)) {
        viewedIds = parsed.filter((n) => typeof n === 'number' && Number.isInteger(n)).slice(-20);
      }
    } catch {
      viewedIds = [];
    }
  }

  if (!viewedIds.includes(product.id)) {
    await incrementProductViews(product.slug);
    currentViews += 1;
    const nextViewed = [...viewedIds, product.id].slice(-20);
    Astro.cookies.set('mamasar_viewed', JSON.stringify(nextViewed), {
      maxAge: 3600,
      path: '/',
      httpOnly: true,
      sameSite: 'lax',
      secure: isHttpsRequest(Astro.request),
    });
  }
}

const hasDiscount = Boolean(product?.original_price && product.original_price > product.price);
const discountPercent =
  product && hasDiscount
    ? Math.round(((product.original_price! - product.price) / product.original_price!) * 100)
    : 0;

const allImages: string[] = product
  ? [product.image_url, ...(Array.isArray(product.gallery_images) ? product.gallery_images : [])].filter(Boolean)
  : [];
const primaryImage = allImages[0] || DEFAULT_PRODUCT_IMAGE;

const qrCodeUrl = product
  ? `https://api.qrserver.com/v1/create-qr-code/?size=320x320&margin=8&data=${encodeURIComponent(currentUrl)}`
  : '';

const storeHref = product ? `/toko/${product.umkm_slug || product.umkm_id}` : '/toko';
const sellerUrl = new URL(storeHref, Astro.url.origin).href;

const waLink = product
  ? createProductWhatsAppUrl({
      phone: product.umkm_phone,
      storeName: product.umkm_name,
      productName: product.name,
      price: product.price,
      zoneName: product.zone_name,
      productUrl: currentUrl,
    })
  : '#';

const relatedProducts = product
  ? await getProducts({
      category: product.category,
      excludeProductId: product.id,
      limit: 4,
    })
  : [];

const priceValidUntil = new Date(Date.now() + 90 * 24 * 60 * 60 * 1000).toISOString().split('T')[0];

const productSchema = product
  ? {
      '@context': 'https://schema.org/',
      '@type': 'Product',
      sku: `MAMASAR-${product.id}`,
      name: product.name,
      image: (allImages.length > 0 ? allImages : [DEFAULT_PRODUCT_IMAGE]).map((img) =>
        img.startsWith('http') ? img : new URL(img, Astro.url.origin).href
      ),
      description: product.description,
      offers: {
        '@type': 'Offer',
        priceCurrency: 'IDR',
        price: product.price,
        priceValidUntil,
        availability: product.is_sold_out ? 'https://schema.org/OutOfStock' : 'https://schema.org/InStock',
        url: currentUrl,
      },
      seller: {
        '@type': 'LocalBusiness',
        '@id': sellerUrl,
        url: sellerUrl,
        name: product.umkm_name,
        telephone: `+${product.umkm_phone}`,
        address: {
          '@type': 'PostalAddress',
          addressLocality: product.zone_name,
          addressRegion: 'Sumenep, Jawa Timur',
          addressCountry: 'ID',
        },
      },
    }
  : undefined;

const pageTitle = product
  ? `${product.name} - ${formatRupiah(product.price)} | Mamasar`
  : 'Produk Tidak Ditemukan (404) | Mamasar';
const pageDescription = product
  ? `Beli ${product.name} langsung dari ${product.umkm_name} (${product.zone_name}, Sumenep) seharga ${formatRupiah(product.price)}. Hubungi penjual warga NU langsung via WhatsApp tanpa perantara.`
  : 'Maaf, produk UMKM yang Anda cari tidak tersedia atau telah dihapus oleh penjual.';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={product ? primaryImage : undefined}
  canonicalUrl={currentUrl}
  noindex={!product}
  schema={productSchema}
  hideMobileNav={Boolean(product)}
>
  {!product ? (
    <NotFoundView
      heading="Produk Tidak Ditemukan"
      message="Produk UMKM yang Anda cari mungkin telah habis, dihapus oleh pemilik toko, atau tautan berubah."
      primaryHref="/"
      primaryLabel="Lihat Katalog Produk"
    />
  ) : (
    <>
      <div class="pb-24 md:pb-12 py-3 sm:py-6 max-w-7xl mx-auto space-y-4 sm:space-y-6">
        <!-- Top Breadcrumb -->
        <div class="px-3 sm:px-0 flex items-center justify-between text-xs text-slate-500 pb-2 border-b border-slate-200">
          <nav aria-label="Breadcrumb" class="flex items-center gap-2 truncate">
            <a href="/" class="hover:text-emerald-700">Beranda</a>
            <span aria-hidden="true">›</span>
            <a href={`/?zona=${product.zone_slug}`} class="hover:text-emerald-700 truncate">{product.zone_name}</a>
            <span aria-hidden="true">›</span>
            <a href={`/?kategori=${encodeURIComponent(product.category)}`} class="hover:text-emerald-700 truncate">{product.category}</a>
            <span aria-hidden="true">›</span>
            <span class="text-slate-800 font-bold truncate max-w-xs">{product.name}</span>
          </nav>
        </div>

        <!-- Main Classified 2-Column Grid -->
        <div class="md:grid md:grid-cols-12 md:gap-8 items-start">
          <!-- LEFT COLUMN -->
          <div class="md:col-span-7 lg:col-span-8">
            <div class="bg-white border-y sm:border border-slate-200 sm:rounded-2xl shadow-xs overflow-hidden divide-y divide-slate-100">
              <!-- 1. Large Photo Container with Multi-Photo Thumbnails -->
              <div class="p-3 sm:p-5 space-y-3">
                <div class="relative w-full aspect-4/3 sm:aspect-16/10 bg-slate-100 rounded-xl overflow-hidden group">
                  <img
                    id="main-product-image"
                    src={getOptimizedImageUrl(primaryImage, 800)}
                    srcset={getImageSrcSet(primaryImage)}
                    sizes="(max-width: 768px) 100vw, 800px"
                    width="800"
                    height="500"
                    alt={product.name}
                    fetchpriority="high"
                    class="w-full h-full object-cover transition duration-300"
                  />

                  <div class="absolute top-3 left-3 flex flex-wrap gap-1.5">
                    <span class="bg-white/95 backdrop-blur-md text-slate-900 text-xs font-bold px-2.5 py-1 rounded-lg shadow-sm border border-slate-200">
                      📍 {product.umkm_ranting ? `Ranting ${product.umkm_ranting}, ` : ''}{product.zone_name}
                    </span>
                    {Boolean(product.is_featured) && (
                      <span class="bg-amber-400 text-slate-950 border border-amber-300 text-xs font-black px-2.5 py-1 rounded-lg shadow-sm flex items-center gap-1">
                        <span>★</span>
                        <span>Iklan Unggulan</span>
                      </span>
                    )}
                    {Boolean(product.is_verified) && (
                      <span class="bg-emerald-50 text-emerald-800 border border-emerald-300 text-xs font-black px-2.5 py-1 rounded-lg shadow-sm">
                        Terverifikasi
                      </span>
                    )}
                    {hasDiscount && (
                      <span class="bg-rose-600 text-white text-xs font-black px-2.5 py-1 rounded-lg shadow-sm">
                        Diskon {discountPercent}%
                      </span>
                    )}
                  </div>

                  {Boolean(product.is_sold_out) && (
                    <div class="absolute -left-12 top-6 -rotate-45 bg-rose-600 text-white font-black text-xs uppercase tracking-wider py-1.5 w-48 text-center shadow-lg z-20 pointer-events-none">
                      Habis Terjual
                    </div>
                  )}
                </div>

                {allImages.length > 1 && (
                  <div class="flex items-center gap-2 overflow-x-auto pb-1 pt-1 scrollbar-none">
                    {allImages.map((imgUrl, idx) => (
                      <button
                        type="button"
                        class={`gallery-thumb relative w-16 h-16 sm:w-20 sm:h-20 rounded-xl overflow-hidden border-2 transition cursor-pointer shrink-0 ${
                          idx === 0 ? 'border-emerald-700 ring-2 ring-emerald-700/30' : 'border-slate-200 hover:border-slate-400 opacity-75 hover:opacity-100'
                        }`}
                        data-img-src={getOptimizedImageUrl(imgUrl, 800)}
                        aria-label={`Lihat Foto ${idx + 1}`}
                      >
                        <img src={getOptimizedImageUrl(imgUrl, 200)} alt={`Thumbnail ${idx + 1}`} width="80" height="80" decoding="async" class="w-full h-full object-cover" />
                        <span class="absolute bottom-0.5 right-0.5 text-[10px] font-bold px-1 rounded bg-black/60 text-white">
                          {idx + 1}
                        </span>
                      </button>
                    ))}
                  </div>
                )}
              </div>

              <!-- 2. Product Title & Price Header -->
              <div class="p-4 sm:p-6 space-y-4">
                <div class="flex items-start justify-between gap-4">
                  <div class="space-y-1.5 flex-1">
                    <div class="flex items-center gap-2">
                      <span class="text-xs text-slate-500 font-medium">
                        {product.category}
                      </span>
                    </div>
                    <h1 class="text-xl sm:text-2xl lg:text-3xl font-black text-slate-900 leading-tight">
                      {product.name}
                    </h1>
                    <div class="text-xs text-slate-600 flex flex-wrap items-center gap-x-3 gap-y-1 pt-1">
                      <span>📍 {product.zone_name}, Sumenep</span>
                      <span>•</span>
                      <span>{currentViews} kali dilihat</span>
                      <span>•</span>
                      <span>ID Iklan: #{product.id}</span>
                    </div>
                  </div>

                  <button
                    type="button"
                    data-fav-btn
                    data-id={product.id}
                    data-name={product.name}
                    aria-label="Simpan Iklan Favorit"
                    class="w-11 h-11 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-600 hover:text-amber-600 flex items-center justify-center text-lg transition shrink-0 shadow-2xs cursor-pointer select-none"
                  >
                    ★
                  </button>
                </div>

                <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row sm:items-baseline justify-between gap-2">
                  <div>
                    <div class="flex items-baseline gap-2.5 flex-wrap">
                      <span class="text-2xl sm:text-3xl font-black text-emerald-700 font-mono">
                        {formatRupiah(product.price)}
                      </span>
                      {hasDiscount && (
                        <>
                          <span class="text-sm sm:text-base font-bold text-slate-500 line-through font-mono">
                            {formatRupiah(product.original_price!)}
                          </span>
                          <span class="bg-rose-100 text-rose-800 text-xs font-black px-2 py-0.5 rounded-lg border border-rose-200">
                            Diskon {discountPercent}%
                          </span>
                        </>
                      )}
                    </div>
                    <span class="block text-xs text-slate-600 mt-0.5">
                      Harga langsung dari pengrajin/produsen (bisa tawar-menawar langsung via WhatsApp)
                    </span>
                  </div>
                  <span class="text-xs text-slate-500">
                    Diterbitkan: {new Date(product.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' })}
                  </span>
                </div>

                <!-- Attributes / Specs Grid -->
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5 p-3.5 rounded-xl bg-slate-50 border border-slate-200 text-xs">
                  <div>
                    <span class="text-slate-500 block text-[11px] uppercase font-bold">Wilayah MWC</span>
                    <span class="font-bold text-slate-800">{product.zone_name}</span>
                  </div>
                  <div>
                    <span class="text-slate-500 block text-[11px] uppercase font-bold">Kategori</span>
                    <span class="font-bold text-slate-800">{product.category}</span>
                  </div>
                  <div>
                    <span class="text-slate-500 block text-[11px] uppercase font-bold">Status Stok</span>
                    <span class={`font-bold ${
                      product.is_sold_out ? 'text-rose-700' :
                      product.stock_status === 'po' ? 'text-amber-700' : 'text-emerald-700'
                    }`}>
                      {product.is_sold_out ? 'Habis / Penuh' :
                       product.stock_status === 'po' ? 'Pre-Order' : 'Ready Stock'}
                    </span>
                  </div>
                  <div>
                    <span class="text-slate-500 block text-[11px] uppercase font-bold">Kapasitas</span>
                    <span class="font-bold text-slate-800">
                      {product.production_capacity || (product.stock_status === 'po' ? 'Sesuai Antrean PO' : 'Siap Kirim')}
                    </span>
                  </div>
                  <div>
                    <span class="text-slate-500 block text-[11px] uppercase font-bold">Status Toko</span>
                    <span class="font-bold text-emerald-700">{product.is_verified ? 'Terverifikasi MWC' : 'Terdaftar'}</span>
                  </div>
                </div>
              </div>

              <!-- 3. Middle Callout Banner -->
              <div class="p-4 sm:p-5 bg-gradient-to-r from-emerald-800 via-emerald-700 to-teal-800 text-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="space-y-0.5">
                  <h2 class="font-black text-xs sm:text-sm text-white">
                    Gerakan Belanja Produk Tetangga Nahdliyin
                  </h2>
                  <p class="text-xs text-emerald-100">
                    0% komisi transaksi. Kesepakatan harga dan pengiriman berlangsung langsung dengan pengrajin.
                  </p>
                </div>
                <a
                  href={waLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="shrink-0 min-h-[44px] inline-flex items-center bg-white hover:bg-slate-100 text-emerald-900 font-extrabold text-xs px-4 py-2 rounded-xl shadow-xs transition cursor-pointer"
                >
                  Hubungi Penjual
                </a>
              </div>

              <!-- 4. Description Box -->
              <div class="p-4 sm:p-6 space-y-4">
                <h2 class="text-sm font-black uppercase tracking-wider text-slate-800">
                  Deskripsi Iklan Produk
                </h2>

                <div class="flex flex-col sm:flex-row gap-6 items-start">
                  <div class="flex-1 text-xs sm:text-sm text-slate-700 leading-relaxed whitespace-pre-line space-y-3">
                    <p>{product.description}</p>
                    <p class="text-slate-600 text-xs">
                      Diproduksi oleh pelaku usaha warga NU Sumenep. Pembelian dapat dilakukan secara langsung (COD) atau dikirim sesuai kesepakatan dengan penjual.
                    </p>
                  </div>
                </div>

                <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-600">
                  <div class="flex items-center gap-2">
                    <span class="text-base text-emerald-700" aria-hidden="true">📍</span>
                    <div>
                      <strong class="text-slate-800">Alamat Usaha:</strong>
                      <span>{product.umkm_address || `${product.zone_name}, Kabupaten Sumenep, Jawa Timur`}</span>
                    </div>
                  </div>
                  <a
                    href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${product.umkm_name} ${product.zone_name} Sumenep`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-emerald-700 hover:text-emerald-900 font-bold underline shrink-0"
                  >
                    Petunjuk Arah Maps ➔
                  </a>
                </div>
              </div>

              <!-- 5. Page Actions Strip -->
              <div class="px-4 py-3.5 sm:px-6 bg-slate-50/70 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-600">
                <div class="flex items-center gap-3 sm:gap-4 flex-wrap">
                  <button
                    type="button"
                    id="btn-open-label-modal"
                    class="min-h-[40px] text-emerald-700 hover:text-emerald-900 font-bold flex items-center gap-1.5 transition cursor-pointer"
                  >
                    <span>Cetak Label QR Iklan</span>
                  </button>
                  <span aria-hidden="true">•</span>
                  <button
                    type="button"
                    onclick="window.print()"
                    class="min-h-[40px] hover:text-slate-900 flex items-center gap-1.5 transition cursor-pointer"
                  >
                    <span>Cetak Halaman</span>
                  </button>
                  <span aria-hidden="true">•</span>
                  <a
                    href={waLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="min-h-[40px] hover:text-emerald-700 flex items-center gap-1.5 transition cursor-pointer"
                  >
                    <span>Bagikan via WhatsApp</span>
                  </a>
                </div>

                <div class="flex items-center gap-2">
                  <span class="text-slate-600 text-xs">Bagikan:</span>
                  <a
                    href={`https://wa.me/?text=${encodeURIComponent(`${product.name} - ${currentUrl}`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Bagikan ke WhatsApp"
                    class="w-9 h-9 rounded-full bg-white hover:bg-emerald-700 border border-slate-200 text-slate-700 hover:text-white flex items-center justify-center text-xs transition shadow-2xs"
                  >
                    WA
                  </a>
                  <a
                    href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(currentUrl)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="Bagikan ke Facebook"
                    class="w-9 h-9 rounded-full bg-white hover:bg-blue-600 border border-slate-200 text-slate-700 hover:text-white flex items-center justify-center text-xs transition shadow-2xs"
                  >
                    FB
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- RIGHT COLUMN: Sticky Unified Seller Sidebar -->
          <aside class="md:col-span-5 lg:col-span-4 md:sticky md:top-20 self-start space-y-4 px-3 sm:px-0 mt-4 md:mt-0">
            <div class="bg-white border border-slate-200 rounded-2xl shadow-xs overflow-hidden">
              <div class="p-4 sm:p-5 bg-gradient-to-b from-emerald-50/70 via-emerald-50/20 to-white border-b border-slate-100 space-y-2.5">
                <a
                  href={waLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full min-h-[48px] py-3.5 px-4 bg-emerald-700 hover:bg-emerald-800 active:bg-emerald-900 text-white rounded-xl font-black text-sm sm:text-base flex items-center justify-center gap-2.5 shadow-md hover:shadow-lg transition active:scale-95 cursor-pointer"
                >
                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                  </svg>
                  <span>Kirim Pesan WhatsApp</span>
                </a>

                {product.shopee_url && (
                  <a
                    href={product.shopee_url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full min-h-[44px] py-2.5 px-4 bg-[#ee4d2d] hover:bg-[#d73211] active:bg-[#c22a0a] text-white rounded-xl font-black text-xs sm:text-sm flex items-center justify-center gap-2 shadow-xs transition active:scale-95 cursor-pointer"
                  >
                    <span>Checkout di Shopee</span>
                  </a>
                )}
              </div>

              <!-- Seller Profile Section -->
              <div class="p-4 sm:p-5 space-y-4">
                <div class="flex items-start gap-3">
                  <a href={storeHref} class="shrink-0 block group">
                    <div class="w-14 h-14 rounded-full bg-emerald-50 text-emerald-800 border-2 border-emerald-300 flex items-center justify-center font-black text-lg shadow-inner group-hover:border-emerald-500 transition">
                      {product.umkm_name.slice(0, 2).toUpperCase()}
                    </div>
                  </a>
                  <div class="space-y-0.5 min-w-0">
                    <a
                      href={storeHref}
                      class="font-extrabold text-sm sm:text-base text-slate-900 hover:text-emerald-700 transition truncate block"
                      title={`Kunjungi Toko ${product.umkm_name}`}
                    >
                      {product.umkm_name}
                    </a>
                    <p class="text-xs text-slate-600 truncate">
                      Penjual Terdaftar di {product.zone_name}
                    </p>
                  </div>
                </div>

                <div class="pt-3 border-t border-slate-100 space-y-1.5 text-xs text-slate-600">
                  <div class="flex items-center justify-between">
                    <span>Status Penjual:</span>
                    {product.is_verified ? (
                      <span class="text-emerald-700 font-bold">Terverifikasi MWC</span>
                    ) : (
                      <span class="text-slate-600 font-semibold">Belum Verifikasi</span>
                    )}
                  </div>
                  <div class="flex items-center justify-between">
                    <span>Wilayah MWC:</span>
                    <span class="text-slate-800">{product.zone_name}</span>
                  </div>
                  {product.umkm_ranting && (
                    <div class="flex items-center justify-between">
                      <span>Ranting NU:</span>
                      <span class="text-emerald-800 font-bold">Desa {product.umkm_ranting}</span>
                    </div>
                  )}
                  {Boolean(product.umkm_halal_cert || product.umkm_nib || product.umkm_pirt || product.umkm_bpom) && (
                    <div class="pt-1 flex items-center justify-between">
                      <span>Legalitas:</span>
                      <div class="flex flex-wrap gap-1 justify-end">
                        {product.umkm_halal_cert && (
                          <span class="text-[11px] font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded" title={`Halal: ${product.umkm_halal_cert}`}>
                            Halal
                          </span>
                        )}
                        {product.umkm_nib && (
                          <span class="text-[11px] font-bold text-slate-800 bg-slate-100 border border-slate-200 px-1.5 py-0.5 rounded" title={`NIB: ${product.umkm_nib}`}>
                            NIB
                          </span>
                        )}
                        {product.umkm_pirt && (
                          <span class="text-[11px] font-bold text-amber-800 bg-amber-50 border border-amber-200 px-1.5 py-0.5 rounded" title={`P-IRT: ${product.umkm_pirt}`}>
                            P-IRT
                          </span>
                        )}
                        {product.umkm_bpom && (
                          <span class="text-[11px] font-bold text-sky-800 bg-sky-50 border border-sky-200 px-1.5 py-0.5 rounded" title={`BPOM: ${product.umkm_bpom}`}>
                            BPOM
                          </span>
                        )}
                      </div>
                    </div>
                  )}
                </div>

                <div class="pt-2 space-y-2">
                  <a
                    href={waLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="w-full min-h-[44px] py-2.5 px-3 bg-slate-50 hover:bg-slate-100 border border-slate-200 text-slate-800 rounded-xl text-xs font-bold flex items-center justify-center gap-2 transition cursor-pointer"
                  >
                    <span>+62 {product.umkm_phone.slice(2, 6)}•••• (Hubungi WA)</span>
                  </a>

                  <a
                    href={storeHref}
                    class="w-full min-h-[44px] py-2 px-3 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 text-emerald-800 hover:text-emerald-950 text-xs font-bold rounded-xl flex items-center justify-center gap-1.5 transition cursor-pointer"
                  >
                    <span>Kunjungi Profil Toko Ini →</span>
                  </a>

                  <a
                    href={`/?zona=${product.zone_slug}`}
                    class="w-full min-h-[44px] py-2 px-3 bg-transparent hover:bg-slate-50 border border-slate-200 text-slate-700 hover:text-slate-900 text-xs font-semibold rounded-xl flex items-center justify-center transition cursor-pointer"
                  >
                    Lihat Semua Iklan di {product.zone_name}
                  </a>

                  <button
                    type="button"
                    id="btn-sidebar-label"
                    class="w-full min-h-[44px] py-2 px-3 bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 hover:text-slate-900 text-xs font-bold rounded-xl flex items-center justify-center gap-1.5 transition cursor-pointer"
                  >
                    <span>Cetak Label QR Produk</span>
                  </button>
                </div>
              </div>

              <!-- Safety Tips -->
              <div class="p-4 sm:p-5 bg-amber-50/80 border-t border-amber-200/80 space-y-3">
                <h3 class="text-xs font-black text-amber-900 uppercase tracking-wider">
                  Tips Transaksi Aman Warga NU
                </h3>

                <ul class="text-xs text-amber-950 space-y-2 leading-relaxed">
                  <li>• Utamakan transaksi COD (Cash on Delivery) atau bayar di tempat setelah barang diterima dan diperiksa.</li>
                  <li>• Pastikan keaslian penjual dan detail produk via WhatsApp sebelum melakukan transfer pembayaran.</li>
                  <li>• Kunjungi alamat toko UMKM jika ingin melihat langsung proses produksi di Sumenep.</li>
                </ul>

                <div class="pt-2 border-t border-amber-200/70">
                  <a
                    href={`https://wa.me/${SITE_CONFIG.whatsappHelp}?text=${encodeURIComponent(`Halo Pengurus PCNU, saya ingin melaporkan iklan mencurigakan: ${currentUrl}`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs font-bold text-slate-600 hover:text-rose-700 inline-flex items-center gap-1 transition cursor-pointer"
                  >
                    <span>Laporkan Iklan Ini</span>
                  </a>
                </div>
              </div>
            </div>
          </aside>
        </div>

        <!-- Related Items Section -->
        {relatedProducts.length > 0 && (
          <section class="space-y-4 px-3 sm:px-0 pt-6 border-t border-slate-200/80 mt-6">
            <div class="flex items-center justify-between">
              <h2 class="text-base sm:text-lg font-black text-slate-900 tracking-tight">
                Iklan Terkait Lainnya
              </h2>
              <a href={`/?kategori=${encodeURIComponent(product.category)}`} class="text-xs text-emerald-700 hover:text-emerald-900 font-semibold cursor-pointer">
                Lihat Kategori Ini ➔
              </a>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
              {relatedProducts.map((rp) => (
                <ProductCard product={rp} />
              ))}
            </div>
          </section>
        )}

        <!-- Mobile Sticky Bottom Action Bar -->
        <div class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-200 p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom,0px))] shadow-2xl">
          <div class="flex items-center gap-2">
            <div class="shrink-0 pl-1">
              <span class="text-[11px] text-slate-500 block leading-tight">Harga Iklan</span>
              {hasDiscount && (
                <span class="text-[11px] text-slate-500 line-through block leading-tight font-mono">
                  {formatRupiah(product.original_price!)}
                </span>
              )}
              <span class="text-sm font-black text-emerald-700 block leading-tight font-mono">
                {formatRupiah(product.price)}
              </span>
            </div>
            {product.shopee_url && (
              <a
                href={product.shopee_url}
                target="_blank"
                rel="noopener noreferrer"
                class="min-h-[44px] py-2.5 px-3 bg-[#ee4d2d] active:bg-[#d73211] text-white rounded-xl font-bold text-xs flex items-center justify-center gap-1 shadow-xs transition active:scale-95 shrink-0"
                title="Beli di Shopee"
              >
                <span>Shopee</span>
              </a>
            )}
            <a
              href={waLink}
              target="_blank"
              rel="noopener noreferrer"
              class="flex-1 min-h-[44px] py-2.5 px-3 bg-emerald-700 active:bg-emerald-800 text-white rounded-xl font-black text-xs flex items-center justify-center gap-1.5 shadow-md transition active:scale-95"
            >
              <svg class="w-4 h-4 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
              </svg>
              <span class="truncate">Chat WA Penjual</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Native <dialog> Printable Label & QR Code Modal -->
      <dialog
        id="label-modal"
        aria-labelledby="modal-label-title"
        class="m-auto p-0 bg-transparent border-0 max-w-md w-[calc(100%-2rem)] overflow-visible"
      >
        <div class="bg-white rounded-2xl w-full shadow-2xl border border-slate-200 overflow-hidden">
          <div class="p-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">
            <h3 id="modal-label-title" class="text-sm font-black text-slate-900">
              Label QR Iklan Produk UMKM
            </h3>
            <button
              type="button"
              id="btn-close-label-modal"
              autofocus
              class="w-10 h-10 rounded-lg hover:bg-slate-200 text-slate-600 hover:text-slate-900 flex items-center justify-center font-bold text-sm cursor-pointer transition"
              aria-label="Tutup"
            >
              ✕
            </button>
          </div>

          <div class="p-4 sm:p-6 bg-slate-100/70 flex justify-center">
            <div
              id="printable-label-card"
              class="w-full max-w-sm bg-white border-2 border-dashed border-slate-400 rounded-2xl p-5 shadow-sm space-y-4 text-slate-900"
            >
              <div class="text-center pb-3 border-b-2 border-slate-800 space-y-1">
                <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-800 text-white text-[11px] font-black uppercase tracking-widest">
                  <span>MAMASAR SUMENEP</span>
                </div>
                <p class="text-xs font-semibold text-slate-600">
                  Direktori Produk UMKM Warga Nahdliyin
                </p>
              </div>

              <div class="space-y-1.5 text-center">
                <p class="text-xs font-bold text-slate-600 uppercase tracking-wider">
                  {product.umkm_name} • {product.zone_name}
                </p>
                <h4 class="text-base sm:text-lg font-black text-slate-900 leading-tight">
                  {product.name}
                </h4>
                <div class="pt-1 flex items-center justify-center gap-2 flex-wrap">
                  <span class="text-xl sm:text-2xl font-black text-emerald-800 font-mono">
                    {formatRupiah(product.price)}
                  </span>
                  {hasDiscount && (
                    <span class="text-xs font-bold text-slate-500 line-through font-mono">
                      {formatRupiah(product.original_price!)}
                    </span>
                  )}
                </div>
                <div class="flex items-center justify-center gap-1.5 pt-1 text-[11px]">
                  <span class="px-2 py-0.5 rounded bg-slate-100 font-bold text-slate-700 border border-slate-200">
                    {product.category}
                  </span>
                  <span class="px-2 py-0.5 rounded bg-emerald-50 font-bold text-emerald-800 border border-emerald-200">
                    {product.stock_status === 'po' ? 'Pre-Order' : 'Ready Stock'}
                  </span>
                  {product.umkm_halal_cert && (
                    <span class="px-1.5 py-0.5 rounded bg-emerald-100 font-bold text-emerald-900">
                      Halal
                    </span>
                  )}
                  {product.umkm_nib && (
                    <span class="px-1.5 py-0.5 rounded bg-slate-100 font-bold text-slate-900 border border-slate-200">
                      NIB
                    </span>
                  )}
                </div>
              </div>

              <div class="py-2 flex flex-col items-center justify-center space-y-2 bg-slate-50 rounded-xl p-3 border border-slate-200">
                <img
                  src={qrCodeUrl}
                  alt={`QR Code untuk ${product.name}`}
                  width="176"
                  height="176"
                  class="w-44 h-44 object-contain bg-white p-1 rounded-lg border border-slate-300 shadow-2xs"
                  loading="eager"
                />
                <div class="text-center space-y-0.5">
                  <p class="text-xs font-black text-slate-800">
                    Scan QR via Kamera HP
                  </p>
                  <p class="text-[11px] text-slate-600">
                    Lihat detail produk & transaksi langsung via WhatsApp
                  </p>
                </div>
              </div>

              <div class="pt-2 border-t border-slate-200 text-center space-y-0.5 text-xs">
                <span class="text-[11px] text-slate-600 block">WhatsApp Pemilik Usaha:</span>
                <strong class="font-mono text-slate-900 text-sm font-black">+62 {product.umkm_phone}</strong>
                <p class="text-[11px] text-slate-600">mamasar.id • Pasar Digital Warga NU</p>
              </div>
            </div>
          </div>

          <div class="p-4 bg-white border-t border-slate-200 flex flex-col sm:flex-row items-center justify-end gap-2.5">
            <button
              type="button"
              id="btn-close-label-modal-bottom"
              class="w-full sm:w-auto min-h-[44px] px-4 py-2.5 text-xs font-bold text-slate-700 hover:text-slate-900 border border-slate-200 rounded-xl transition cursor-pointer"
            >
              Tutup
            </button>
            <button
              type="button"
              id="btn-do-print-label"
              class="w-full sm:w-auto min-h-[44px] px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs rounded-xl shadow-md transition flex items-center justify-center gap-1.5 cursor-pointer active:scale-95"
            >
              <span>Cetak Label / Simpan PDF</span>
            </button>
          </div>
        </div>
      </dialog>

      <style>
        @media print {
          body.printing-label {
            background: white !important;
          }
          body.printing-label * {
            visibility: hidden;
          }
          body.printing-label #label-modal,
          body.printing-label #label-modal * {
            visibility: visible;
          }
          body.printing-label #label-modal {
            position: fixed !important;
            inset: 0 !important;
            background: white !important;
            padding: 0 !important;
            margin: 0 auto !important;
          }
          body.printing-label #label-modal > div {
            box-shadow: none !important;
            border: none !important;
            width: 100% !important;
            max-width: 100% !important;
            margin: 0 !important;
          }
          body.printing-label #label-modal > div > div:not(:nth-child(2)) {
            display: none !important;
          }
          body.printing-label #printable-label-card {
            border: 2px dashed #000 !important;
            box-shadow: none !important;
            margin: 15px auto !important;
            width: 360px !important;
          }
        }
      </style>

      <script>
        const mainImg = document.getElementById('main-product-image') as HTMLImageElement | null;
        const thumbs = document.querySelectorAll<HTMLButtonElement>('.gallery-thumb');

        thumbs.forEach((thumb) => {
          thumb.addEventListener('click', () => {
            const targetSrc = thumb.getAttribute('data-img-src');
            if (mainImg && targetSrc) {
              mainImg.removeAttribute('srcset');
              mainImg.src = targetSrc;
              thumbs.forEach((t) => {
                t.classList.remove('border-emerald-700', 'ring-2', 'ring-emerald-700/30');
                t.classList.add('border-slate-200', 'opacity-75');
              });
              thumb.classList.remove('border-slate-200', 'opacity-75');
              thumb.classList.add('border-emerald-700', 'ring-2', 'ring-emerald-700/30');
            }
          });
        });

        const labelModal = document.getElementById('label-modal') as HTMLDialogElement | null;
        const btnOpenLabelModal = document.getElementById('btn-open-label-modal');
        const btnSidebarLabel = document.getElementById('btn-sidebar-label');
        const btnCloseLabelModal = document.getElementById('btn-close-label-modal');
        const btnCloseLabelModalBottom = document.getElementById('btn-close-label-modal-bottom');
        const btnDoPrintLabel = document.getElementById('btn-do-print-label');

        function openLabelModal() {
          if (labelModal && !labelModal.open) {
            labelModal.returnValue = '';
            labelModal.showModal();
          }
        }

        function closeLabelModal() {
          if (labelModal?.open) {
            labelModal.close();
          }
        }

        btnOpenLabelModal?.addEventListener('click', openLabelModal);
        btnSidebarLabel?.addEventListener('click', openLabelModal);
        btnCloseLabelModal?.addEventListener('click', closeLabelModal);
        btnCloseLabelModalBottom?.addEventListener('click', closeLabelModal);

        labelModal?.addEventListener('click', (e) => {
          if (e.target === labelModal) closeLabelModal();
        });

        labelModal?.addEventListener('close', () => {
          labelModal.returnValue = '';
        });

        btnDoPrintLabel?.addEventListener('click', () => {
          document.body.classList.add('printing-label');
          window.print();
        });

        window.addEventListener('afterprint', () => {
          document.body.classList.remove('printing-label');
        });
      </script>
    </>
  )}
</Layout>
