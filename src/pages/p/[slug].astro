---
import Layout from '../../layouts/Layout.astro';
import BadgeVerified from '../../components/BadgeVerified.astro';
import { getProductBySlug } from '../../lib/db';
import { formatRupiah, createProductWhatsAppUrl } from '../../lib/utils';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

const product = getProductBySlug(slug);

if (!product) {
  return new Response(null, {
    status: 404,
    statusText: 'Produk Tidak Ditemukan',
  });
}

const currentUrl = Astro.url.href;

// Shared WhatsApp direct-chat link generator
const waLink = createProductWhatsAppUrl({
  phone: product.umkm_phone,
  storeName: product.umkm_name,
  productName: product.name,
  price: product.price,
  zoneName: product.zone_name,
  productUrl: currentUrl,
});

// Schema.org Product Structured Data for Google Rich Snippets
const productSchema = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: product.name,
  image: [product.image_url],
  description: product.description,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'IDR',
    price: product.price,
    availability: 'https://schema.org/InStock',
    url: currentUrl,
  },
  seller: {
    '@type': 'LocalBusiness',
    name: product.umkm_name,
    telephone: `+${product.umkm_phone}`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: product.zone_name,
      addressRegion: 'Sumenep, Jawa Timur',
      addressCountry: 'ID',
    },
  },
};

const pageTitle = `${product.name} - ${formatRupiah(product.price)} | UMKM NU Sumenep`;
const pageDescription = `Beli ${product.name} langsung dari ${product.umkm_name} (${product.zone_name}, Sumenep) seharga ${formatRupiah(product.price)}. Hubungi penjual warga NU langsung via WhatsApp tanpa perantara.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={product.image_url}
  canonicalUrl={currentUrl}
  schema={productSchema}
  hideMobileNav={true}
>
  <div class="pb-24 md:pb-12 md:py-8 max-w-5xl mx-auto">
    
    <!-- Top Breadcrumb (Desktop Only) -->
    <div class="hidden md:flex items-center justify-between text-xs mb-6">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-emerald-700 font-bold hover:underline py-1"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span>Kembali ke Katalog Produk</span>
      </a>
      <span class="text-slate-500 font-medium">
        Kategori: <strong>{product.category}</strong>
      </span>
    </div>

    <!-- Main Responsive Layout: Full Edge-to-Edge on Mobile, Standard 2-Column on Desktop -->
    <div class="md:grid md:grid-cols-12 md:gap-8 lg:gap-10 items-start">
      
      <!-- Left Column: Hero Image (Full-bleed on mobile, rounded card on desktop) -->
      <div class="md:col-span-6 lg:col-span-6 relative">
        
        <!-- Mobile Floating Back Button with accessible name (R-39) -->
        <a
          href="/"
          aria-label="Kembali ke Katalog Produk"
          class="md:hidden absolute top-3 left-3 z-20 w-9 h-9 rounded-full bg-black/50 backdrop-blur-md text-white flex items-center justify-center shadow-md active:scale-95 transition"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
          </svg>
        </a>

        <!-- Hero Image Container: fetchpriority="high" for optimal LCP as per modern-web-guidance -->
        <div class="relative w-full aspect-square md:aspect-4/3 bg-slate-100 overflow-hidden md:rounded-3xl md:border md:border-slate-200/80 md:shadow-sm">
          <img
            src={product.image_url}
            alt={product.name}
            fetchpriority="high"
            class="w-full h-full object-cover"
          />
          
          <!-- Chips (Location & Verification) -->
          <div class="absolute bottom-3 left-3 sm:bottom-4 sm:left-4 flex flex-wrap gap-1.5">
            <span class="bg-slate-900/80 backdrop-blur-md text-white text-xs font-bold px-2.5 py-1 rounded-lg shadow-sm">
              📍 {product.zone_name}
            </span>
            <BadgeVerified label="Terverifikasi NU" size="md" class="backdrop-blur-md shadow-sm" />
          </div>
        </div>
      </div>

      <!-- Right Column: Product Info & Actions -->
      <div class="md:col-span-6 lg:col-span-6 bg-white md:border md:border-slate-200/80 md:rounded-3xl p-4 sm:p-6 md:p-8 space-y-5 md:shadow-xs">
        
        <!-- Category & Title -->
        <div>
          <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider block mb-1">
            {product.category}
          </span>
          <h1 class="text-xl sm:text-2xl lg:text-3xl font-black text-slate-900 leading-tight">
            {product.name}
          </h1>
          <p class="text-2xl sm:text-3xl font-black text-emerald-700 mt-2 sm:mt-3">
            {formatRupiah(product.price)}
          </p>
        </div>

        <!-- Profil Penjual / Toko Warga NU -->
        <div class="p-3.5 sm:p-4 rounded-2xl bg-slate-50 border border-slate-200 flex items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 rounded-xl bg-emerald-700 text-white font-black flex items-center justify-center text-sm shadow-xs shrink-0">
              {product.umkm_name.slice(0, 2).toUpperCase()}
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900 leading-tight">
                {product.umkm_name}
              </h3>
              <p class="text-xs text-slate-500 mt-0.5">
                {product.umkm_address || `${product.zone_name}, Sumenep`}
              </p>
            </div>
          </div>
          <BadgeVerified label="Warga NU" size="sm" />
        </div>

        <!-- Desktop WhatsApp CTA Button (Visible on md and above) -->
        <div class="hidden md:block space-y-2 pt-2">
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3.5 px-6 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white rounded-2xl font-bold text-base flex items-center justify-center gap-2.5 shadow-md transition hover:shadow-lg active:scale-98"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>Hubungi Penjual via WhatsApp</span>
          </a>
          <p class="text-[11px] text-center text-slate-500">
            Nol biaya transaksi. Langsung tersambung ke WhatsApp penjual dengan pesan otomatis.
          </p>
        </div>

        <!-- Deskripsi Produk -->
        <div class="space-y-2 border-t border-slate-100 pt-4">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">
            Deskripsi Produk
          </h2>
          <p class="text-xs sm:text-sm text-slate-700 leading-relaxed whitespace-pre-line">
            {product.description}
          </p>
        </div>

        <!-- Panduan Transaksi Langsung -->
        <div class="p-3.5 rounded-2xl bg-amber-50/70 border border-amber-200/80 text-xs text-amber-900 space-y-1">
          <strong class="font-bold flex items-center gap-1.5 text-amber-950">
            <span>ℹ️</span> Panduan Transaksi Langsung:
          </strong>
          <p class="text-[11px] leading-relaxed text-amber-800">
            Kesepakatan pengiriman (COD, ojek lokal, atau ambil di tempat) dan pembayaran dibahas langsung dengan pemilik usaha secara kekeluargaan.
          </p>
        </div>

      </div>
    </div>

    <!-- Mobile Full Edge-to-Edge Sticky Bottom Action Bar (Hidden on desktop) -->
    <div class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-200 p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom,0px))] shadow-2xl">
      <div class="flex items-center gap-3">
        <div class="shrink-0 pl-1">
          <span class="text-[10px] text-slate-500 block leading-tight">Harga Satuan</span>
          <span class="text-sm font-black text-emerald-700 block leading-tight">
            {formatRupiah(product.price)}
          </span>
        </div>
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 py-3 px-4 bg-emerald-600 active:bg-emerald-800 text-white rounded-xl font-bold text-xs flex items-center justify-center gap-2 shadow-md transition active:scale-98"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>Beli via WhatsApp</span>
        </a>
      </div>
    </div>

  </div>
</Layout>
