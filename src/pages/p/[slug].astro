---
import Layout from '../../layouts/Layout.astro';
import BadgeVerified from '../../components/BadgeVerified.astro';
import { getProductBySlug } from '../../lib/db';
import { formatRupiah, createProductWhatsAppUrl } from '../../lib/utils';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

const product = getProductBySlug(slug);

if (!product) {
  return new Response(null, {
    status: 404,
    statusText: 'Produk Tidak Ditemukan',
  });
}

const currentUrl = Astro.url.href;

// Shared WhatsApp direct-chat link generator
const waLink = createProductWhatsAppUrl({
  phone: product.umkm_phone,
  storeName: product.umkm_name,
  productName: product.name,
  price: product.price,
  zoneName: product.zone_name,
  productUrl: currentUrl,
});

// Schema.org Product Structured Data for Google Rich Snippets
const productSchema = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: product.name,
  image: [product.image_url],
  description: product.description,
  offers: {
    '@type': 'Offer',
    priceCurrency: 'IDR',
    price: product.price,
    availability: 'https://schema.org/InStock',
    url: currentUrl,
  },
  seller: {
    '@type': 'LocalBusiness',
    name: product.umkm_name,
    telephone: `+${product.umkm_phone}`,
    address: {
      '@type': 'PostalAddress',
      addressLocality: product.zone_name,
      addressRegion: 'Sumenep, Jawa Timur',
      addressCountry: 'ID',
    },
  },
};

const pageTitle = `${product.name} - ${formatRupiah(product.price)} | UMKM NU Sumenep`;
const pageDescription = `Beli ${product.name} langsung dari ${product.umkm_name} (${product.zone_name}, Sumenep) seharga ${formatRupiah(product.price)}. Hubungi penjual warga NU langsung via WhatsApp tanpa perantara.`;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={product.image_url}
  canonicalUrl={currentUrl}
  schema={productSchema}
  hideMobileNav={true}
>
  <div class="pb-24 md:pb-12 md:py-6 max-w-6xl mx-auto space-y-4">
    
    <!-- Top Breadcrumb (Desktop Only) -->
    <nav aria-label="Breadcrumb" class="hidden md:flex items-center gap-2 text-xs text-slate-500 font-medium">
      <a href="/" class="hover:text-emerald-700">Beranda</a>
      <span>›</span>
      <a href={`/?zona=${product.zone_slug}`} class="hover:text-emerald-700">{product.zone_name}</a>
      <span>›</span>
      <a href={`/?kategori=${encodeURIComponent(product.category)}`} class="hover:text-emerald-700">{product.category}</a>
      <span>›</span>
      <span class="text-slate-800 font-bold truncate max-w-xs">{product.name}</span>
    </nav>

    <!-- Main Classified Detail Layout (2 Columns: Left Gallery & Content, Right Sticky Seller Box) -->
    <div class="md:grid md:grid-cols-12 md:gap-8 items-start">
      
      <!-- LEFT COLUMN: Main Gallery, Attributes & Description (7 cols) -->
      <div class="md:col-span-7 lg:col-span-8 space-y-4">
        
        <!-- Mobile Floating Back Button -->
        <a
          href="/"
          aria-label="Kembali ke Katalog Produk"
          class="md:hidden absolute top-3 left-3 z-20 w-9 h-9 rounded-full bg-black/50 backdrop-blur-md text-white flex items-center justify-center shadow-md active:scale-95 transition"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path>
          </svg>
        </a>

        <!-- Large Photo Container (Full bleed on mobile, framed on desktop) -->
        <div class="bg-white md:border md:border-slate-200/90 md:rounded-2xl overflow-hidden shadow-xs">
          <div class="relative w-full aspect-square md:aspect-16/10 bg-slate-100 overflow-hidden">
            <img
              src={product.image_url}
              alt={product.name}
              fetchpriority="high"
              class="w-full h-full object-cover"
            />
            <div class="absolute bottom-3 left-3 flex flex-wrap gap-1.5">
              <span class="bg-slate-900/80 backdrop-blur-md text-white text-xs font-bold px-2.5 py-1 rounded-lg shadow-sm">
                📍 {product.zone_name}
              </span>
              <BadgeVerified label="Terverifikasi NU" size="md" class="backdrop-blur-md shadow-sm" />
            </div>
          </div>
        </div>

        <!-- Product Details Box (Desktop & Mobile) -->
        <div class="bg-white border-y sm:border border-slate-200/90 sm:rounded-2xl p-4 sm:p-6 shadow-xs space-y-5">
          
          <!-- Title & Category -->
          <div class="space-y-1">
            <span class="text-xs font-bold text-emerald-700 uppercase tracking-wider block">
              {product.category}
            </span>
            <h1 class="text-xl sm:text-2xl font-black text-slate-900 leading-snug">
              {product.name}
            </h1>
            <p class="md:hidden text-2xl font-black text-emerald-700 pt-1">
              {formatRupiah(product.price)}
            </p>
          </div>

          <!-- Classified Specs Table / Attributes -->
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 p-3.5 rounded-xl bg-slate-50 border border-slate-200/80 text-xs">
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-bold">Wilayah</span>
              <span class="font-bold text-slate-800">{product.zone_name}</span>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-bold">Kategori</span>
              <span class="font-bold text-slate-800">{product.category}</span>
            </div>
            <div>
              <span class="text-slate-400 block text-[10px] uppercase font-bold">Verifikasi</span>
              <span class="font-bold text-emerald-700">Warga NU Resmi</span>
            </div>
          </div>

          <!-- Description -->
          <div class="space-y-2 pt-2 border-t border-slate-100">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500">
              Deskripsi Iklan
            </h2>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed whitespace-pre-line">
              {product.description}
            </p>
          </div>

          <!-- Location Note -->
          <div class="pt-3 border-t border-slate-100 flex items-start gap-2 text-xs text-slate-500">
            <span class="text-base">📍</span>
            <div>
              <strong class="text-slate-800">Alamat Usaha:</strong>
              <p class="mt-0.5">{product.umkm_address || `${product.zone_name}, Kabupaten Sumenep`}</p>
            </div>
          </div>

        </div>

      </div>

      <!-- RIGHT COLUMN: Sticky Classified Contact & Seller Sidebar (5 cols, Desktop) -->
      <aside class="md:col-span-5 lg:col-span-4 space-y-4">
        
        <!-- Price & Contact Card (Desktop Only) -->
        <div class="hidden md:block bg-white border border-slate-200/90 rounded-2xl p-6 shadow-xs space-y-5 sticky top-24">
          
          <!-- Big Price -->
          <div>
            <span class="text-xs text-slate-400 font-bold block uppercase tracking-wider">Harga Iklan</span>
            <span class="text-3xl font-black text-emerald-700 block mt-1">
              {formatRupiah(product.price)}
            </span>
          </div>

          <!-- WhatsApp Primary Contact Button -->
          <a
            href={waLink}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full py-3.5 px-4 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white rounded-xl font-bold text-sm flex items-center justify-center gap-2 shadow-sm transition hover:shadow-md active:scale-98 cursor-pointer"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>Chat Penjual di WhatsApp</span>
          </a>

          <!-- Seller Profile Card (Classified Style) -->
          <div class="pt-4 border-t border-slate-100 space-y-3">
            <span class="text-xs text-slate-400 font-bold block uppercase tracking-wider">Profil Penjual</span>
            <div class="flex items-center gap-3">
              <div class="w-12 h-12 rounded-full bg-emerald-700 text-white font-black flex items-center justify-center text-sm shadow-xs shrink-0">
                {product.umkm_name.slice(0, 2).toUpperCase()}
              </div>
              <div>
                <h3 class="text-sm font-bold text-slate-900 leading-tight">
                  {product.umkm_name}
                </h3>
                <p class="text-xs text-slate-500 mt-0.5">
                  {product.zone_name}, Sumenep
                </p>
                <div class="mt-1">
                  <BadgeVerified label="Warga NU" size="sm" />
                </div>
              </div>
            </div>
          </div>

          <!-- Classified Safety Tips -->
          <div class="p-3.5 rounded-xl bg-amber-50/70 border border-amber-200/80 text-xs text-amber-900 space-y-1">
            <strong class="font-bold flex items-center gap-1.5 text-amber-950">
              <span>💡</span> Tips Transaksi Aman:
            </strong>
            <ul class="text-[11px] leading-relaxed text-amber-800 list-disc list-inside space-y-0.5">
              <li>Hubungi penjual melalui tombol WhatsApp resmi di atas.</li>
              <li>Tanyakan kesiapan stok barang & lokasi pengambilan.</li>
              <li>Prioritaskan transaksi COD langsung tanpa perantara.</li>
            </ul>
          </div>

        </div>

      </aside>

    </div>

    <!-- Mobile Full Edge-to-Edge Sticky Bottom Action Bar (Hidden on desktop) -->
    <div class="md:hidden fixed bottom-0 inset-x-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-200 p-3 pb-[calc(0.75rem+env(safe-area-inset-bottom,0px))] shadow-2xl">
      <div class="flex items-center gap-3">
        <div class="shrink-0 pl-1">
          <span class="text-[10px] text-slate-500 block leading-tight">Harga Iklan</span>
          <span class="text-sm font-black text-emerald-700 block leading-tight">
            {formatRupiah(product.price)}
          </span>
        </div>
        <a
          href={waLink}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-1 py-3 px-4 bg-emerald-600 active:bg-emerald-800 text-white rounded-xl font-bold text-xs flex items-center justify-center gap-2 shadow-md transition active:scale-98"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
          </svg>
          <span>Chat via WhatsApp</span>
        </a>
      </div>
    </div>

  </div>
</Layout>
