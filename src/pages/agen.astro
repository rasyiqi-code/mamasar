---
import Layout from '../layouts/Layout.astro';
import { getAllZones, getProducts } from '../lib/db';
import {
  PRODUCT_CATEGORIES,
  TARGET_MVP_PRODUCTS,
  DEFAULT_AGENT_PIN,
} from '../lib/constants';
import { formatRupiah } from '../lib/utils';

const zones = getAllZones();
const allProducts = getProducts();
const totalCount = allProducts.length;
const progressPercent = Math.min(
  Math.round((totalCount / TARGET_MVP_PRODUCTS) * 100),
  100
);

const recentProducts = allProducts.slice(0, 6);
---

<Layout title="Portal Input Agen Lapangan | Direktori UMKM NU Sumenep">
  <div class="max-w-xl mx-auto space-y-3 sm:space-y-6 sm:py-6">
    
    <!-- Header Banner: Edge-to-edge on mobile, rounded card on desktop -->
    <div class="bg-emerald-800 text-white sm:rounded-3xl p-4 sm:p-6 shadow-xs space-y-2.5">
      <div class="flex items-center justify-between">
        <span class="text-[10px] font-black uppercase tracking-wider bg-emerald-600/60 px-2.5 py-0.5 rounded-md">
          Portal Kader Lapangan
        </span>
        <span class="text-xs text-emerald-200">Mode Jemput Bola</span>
      </div>
      <h1 class="text-lg sm:text-2xl font-black">Form Entri Cepat Produk UMKM</h1>
      <p class="text-xs sm:text-sm text-emerald-100 leading-relaxed">
        Khusus tim pendata dan kader NU. Formulir ringkas (&lt;90 detik) dengan kompresi foto otomatis di HP.
      </p>

      <!-- Target Fase 1 Progress Bar -->
      <div class="pt-3 border-t border-emerald-700/80 space-y-1.5">
        <div class="flex items-center justify-between text-xs font-bold">
          <span>Target Fase 1 (14 Hari):</span>
          <span>{totalCount} / {TARGET_MVP_PRODUCTS} Produk ({progressPercent}%)</span>
        </div>
        <div class="w-full bg-emerald-950/60 rounded-full h-2.5 overflow-hidden p-0.5">
          <div
            class="bg-emerald-400 h-full rounded-full transition-all duration-500"
            style={`width: ${progressPercent}%`}
          ></div>
        </div>
      </div>
    </div>

    <!-- Feedback Message Box (Client Side) -->
    <div id="status-box" class="hidden p-4 mx-3 sm:mx-0 rounded-2xl text-xs font-semibold"></div>

    <!-- Agent Form: Full edge-to-edge on mobile, rounded card on desktop -->
    <form id="agent-form" class="bg-white border-y sm:border border-slate-200 sm:rounded-3xl p-4 sm:p-8 space-y-4 sm:space-y-5 shadow-xs">
      <input type="hidden" id="imageBase64" name="imageBase64" />

      <!-- PIN Agen Lapangan -->
      <div class="space-y-1.5 bg-emerald-50/70 p-3 sm:p-4 rounded-2xl border border-emerald-200/80">
        <div class="flex items-center justify-between">
          <label for="agentPin" class="text-xs font-bold text-emerald-950 uppercase tracking-wider flex items-center gap-1.5">
            <span>🔑</span> PIN Akses Agen <span class="text-rose-500">*</span>
          </label>
          <span class="text-[11px] text-emerald-700 font-medium">Default: <strong>{DEFAULT_AGENT_PIN}</strong></span>
        </div>
        <input
          type="password"
          id="agentPin"
          name="agentPin"
          placeholder={`Masukkan PIN (Default: ${DEFAULT_AGENT_PIN})`}
          required
          class="w-full bg-white border border-emerald-300 rounded-xl p-2.5 sm:p-3 text-xs sm:text-sm font-mono tracking-widest text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500"
        />
      </div>

      <!-- 1. Foto Produk dengan Auto-Compression Canvas -->
      <div class="space-y-1.5">
        <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider">
          1. Foto Produk (Kamera HP) <span class="text-rose-500">*</span>
        </label>
        
        <label for="camera-input" class="relative group cursor-pointer block border-2 border-dashed border-emerald-300 hover:border-emerald-500 bg-emerald-50/40 hover:bg-emerald-50 rounded-2xl p-4 sm:p-6 text-center transition">
          <input
            type="file"
            id="camera-input"
            accept="image/*"
            capture="environment"
            class="hidden"
          />
          <div id="upload-placeholder" class="space-y-1">
            <div class="text-3xl sm:text-4xl">📷</div>
            <span class="text-xs sm:text-sm font-extrabold text-emerald-800 block">
              Ketuk untuk Ambil Foto Kamera / Galeri
            </span>
            <span class="text-[11px] sm:text-xs text-slate-500 block">
              Foto otomatis dikompres sebelum dikirim (hemat kuota di lapangan)
            </span>
          </div>

          <!-- Preview & Compression Status -->
          <div id="upload-preview-container" class="hidden space-y-2">
            <img id="upload-preview" src="" alt="Preview" class="w-32 h-32 sm:w-40 sm:h-40 object-cover mx-auto rounded-2xl border border-emerald-300 shadow-xs" />
            <div id="compression-info" class="text-[11px] sm:text-xs font-bold text-emerald-700 bg-emerald-100/80 px-3 py-1 rounded-lg inline-block"></div>
            <span class="block text-[11px] text-slate-400">Ketuk jika ingin mengganti foto</span>
          </div>
        </label>
      </div>

      <!-- 2. Wilayah / MWC & Kategori -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
        <div class="space-y-1">
          <label for="zoneId" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
            2. Wilayah / MWC <span class="text-rose-500">*</span>
          </label>
          <select
            id="zoneId"
            name="zoneId"
            required
            class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 sm:p-3 text-xs sm:text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          >
            <option value="" disabled selected>Pilih MWC...</option>
            {zones.map((z) => (
              <option value={z.id}>{z.name}</option>
            ))}
          </select>
        </div>

        <div class="space-y-1">
          <label for="category" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
            Kategori <span class="text-rose-500">*</span>
          </label>
          <select
            id="category"
            name="category"
            required
            class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 sm:p-3 text-xs sm:text-sm font-medium text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          >
            {PRODUCT_CATEGORIES.map((c) => (
              <option value={c}>{c}</option>
            ))}
          </select>
        </div>
      </div>

      <!-- 3. Profil Toko / UMKM -->
      <div class="space-y-3 pt-2 border-t border-slate-100">
        <div class="space-y-1">
          <label for="umkmName" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
            3. Nama Usaha / Toko <span class="text-rose-500">*</span>
          </label>
          <input
            type="text"
            id="umkmName"
            name="umkmName"
            placeholder="Contoh: UD Barokah Jaya / Dapur Bu Aminah"
            required
            class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 sm:p-3 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />
        </div>

        <div class="space-y-1">
          <label for="phone" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
            4. Nomor WhatsApp Penjual <span class="text-rose-500">*</span>
          </label>
          <div class="flex">
            <span class="inline-flex items-center px-3 sm:px-4 rounded-l-xl border border-r-0 border-slate-300 bg-slate-100 text-slate-600 font-bold text-xs sm:text-sm">
              +62
            </span>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="81234567890"
              required
              class="w-full bg-slate-50 border border-slate-300 rounded-r-xl p-2.5 sm:p-3 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>
          <span class="text-[10px] sm:text-[11px] text-slate-400 block">
            Nomor yang aktif WhatsApp untuk menerima pesanan langsung dari pembeli.
          </span>
        </div>
      </div>

      <!-- 4. Detail Produk -->
      <div class="space-y-3 pt-2 border-t border-slate-100">
        <div class="space-y-1">
          <label for="productName" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
            5. Nama Barang / Produk <span class="text-rose-500">*</span>
          </label>
          <input
            type="text"
            id="productName"
            name="productName"
            placeholder="Contoh: Rengginang Lorjuk Super 250gr"
            required
            class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 sm:p-3 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          />
        </div>

        <div class="space-y-1">
          <label for="price" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
            6. Harga Jual (Rp) <span class="text-rose-500">*</span>
          </label>
          <div class="flex">
            <span class="inline-flex items-center px-3 sm:px-4 rounded-l-xl border border-r-0 border-slate-300 bg-slate-100 text-slate-600 font-bold text-xs sm:text-sm">
              Rp
            </span>
            <input
              type="number"
              id="price"
              name="price"
              placeholder="25000"
              required
              min="500"
              step="500"
              class="w-full bg-slate-50 border border-slate-300 rounded-r-xl p-2.5 sm:p-3 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500"
            />
          </div>
        </div>

        <div class="space-y-1">
          <label for="description" class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
            Deskripsi Singkat (Opsional)
          </label>
          <textarea
            id="description"
            name="description"
            rows="2"
            placeholder="Rasa gurih, bahan alami, cocok untuk camilan atau oleh-oleh..."
            class="w-full bg-slate-50 border border-slate-300 rounded-xl p-2.5 sm:p-3 text-xs sm:text-sm text-slate-800 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          ></textarea>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="pt-3 space-y-2.5">
        <button
          type="submit"
          id="btn-submit"
          class="w-full py-3.5 px-4 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-bold text-xs sm:text-sm rounded-xl sm:rounded-2xl shadow-md transition flex items-center justify-center gap-2 cursor-pointer active:scale-98"
        >
          <span>✓ Simpan & Tayangkan Sekarang</span>
        </button>

        <button
          type="button"
          id="btn-submit-another"
          class="w-full py-2.5 sm:py-3 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs sm:text-sm rounded-xl sm:rounded-2xl transition cursor-pointer"
        >
          + Simpan & Tambah Varian Produk Toko Ini
        </button>
      </div>
    </form>

    <!-- Riwayat Produk Terakhir Diinput -->
    {recentProducts.length > 0 && (
      <div class="bg-white border-y sm:border border-slate-200 sm:rounded-3xl p-4 sm:p-6 space-y-3 shadow-xs">
        <h3 class="text-xs font-bold uppercase tracking-wider text-slate-700">
          📋 Produk Terakhir yang Baru Diinput:
        </h3>
        <div class="divide-y divide-slate-100">
          {recentProducts.map((rp) => (
            <div class="py-2.5 flex items-center justify-between gap-2 text-xs">
              <div class="truncate">
                <a href={`/p/${rp.slug}`} target="_blank" class="font-bold text-slate-800 hover:text-emerald-700 truncate block">
                  {rp.name}
                </a>
                <span class="text-[11px] text-slate-500">
                  {rp.umkm_name} • {formatRupiah(rp.price)} • {rp.zone_name}
                </span>
              </div>
              <a
                href={`/p/${rp.slug}`}
                target="_blank"
                class="shrink-0 text-[11px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-1 rounded-lg hover:bg-emerald-100"
              >
                Lihat ➔
              </a>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Client-side Image Compression & State Script -->
  <script>
    const cameraInput = document.getElementById('camera-input') as HTMLInputElement;
    const uploadPlaceholder = document.getElementById('upload-placeholder');
    const uploadPreviewContainer = document.getElementById('upload-preview-container');
    const uploadPreview = document.getElementById('upload-preview') as HTMLImageElement;
    const compressionInfo = document.getElementById('compression-info');
    const imageBase64Input = document.getElementById('imageBase64') as HTMLInputElement;
    const agentPinInput = document.getElementById('agentPin') as HTMLInputElement;
    const form = document.getElementById('agent-form') as HTMLFormElement;
    const statusBox = document.getElementById('status-box');
    const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;
    const btnSubmitAnother = document.getElementById('btn-submit-another') as HTMLButtonElement;

    // Load saved PIN from localStorage if available
    const savedPin = localStorage.getItem('mamasar_agent_pin');
    if (savedPin && agentPinInput) {
      agentPinInput.value = savedPin;
    } else if (agentPinInput && !agentPinInput.value) {
      agentPinInput.value = '1926'; // default
    }

    let keepStoreInfo = false;

    btnSubmitAnother?.addEventListener('click', () => {
      keepStoreInfo = true;
      form.requestSubmit();
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!imageBase64Input.value) {
        showStatus('Peringatan: Silakan ambil atau pilih foto produk terlebih dahulu!', 'warning');
        return;
      }

      // Save PIN in localStorage
      if (agentPinInput.value) {
        localStorage.setItem('mamasar_agent_pin', agentPinInput.value.trim());
      }

      setLoading(true);

      try {
        const formData = new FormData(form);
        const res = await fetch('/api/products', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json();

        if (res.ok && data.success) {
          showStatus(
            `Alhamdulillah! Produk berhasil tersimpan dan langsung aktif. <a href="/p/${data.slug}" class="underline font-bold" target="_blank">Buka Halaman Produk ➔</a>`,
            'success'
          );

          if (keepStoreInfo) {
            // Keep MWC, Toko, WA, reset only product name, price, description
            (document.getElementById('productName') as HTMLInputElement).value = '';
            (document.getElementById('price') as HTMLInputElement).value = '';
            (document.getElementById('description') as HTMLTextAreaElement).value = '';
            resetImage();
            keepStoreInfo = false;
          } else {
            form.reset();
            // Restore PIN
            if (savedPin) agentPinInput.value = savedPin;
            else agentPinInput.value = '1926';
            resetImage();
          }
        } else {
          showStatus(`Gagal: ${data.message || 'Terjadi kesalahan sistem.'}`, 'error');
        }
      } catch (err: any) {
        showStatus(`Gagal terhubung ke server: ${err.message}`, 'error');
      } finally {
        setLoading(false);
      }
    });

    function resetImage() {
      imageBase64Input.value = '';
      if (uploadPreview) uploadPreview.src = '';
      uploadPlaceholder?.classList.remove('hidden');
      uploadPreviewContainer?.classList.add('hidden');
    }

    cameraInput?.addEventListener('change', () => {
      const file = cameraInput.files?.[0];
      if (!file) return;

      const originalSizeKB = Math.round(file.size / 1024);

      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          // Compress via Canvas to max 1200x1200px and JPEG quality 0.8
          const canvas = document.createElement('canvas');
          const maxDim = 1200;
          let width = img.width;
          let height = img.height;

          if (width > maxDim || height > maxDim) {
            if (width > height) {
              height = Math.round((height * maxDim) / width);
              width = maxDim;
            } else {
              width = Math.round((width * maxDim) / height);
              height = maxDim;
            }
          }

          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          if (ctx) {
            ctx.drawImage(img, 0, 0, width, height);
            const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.8);
            imageBase64Input.value = compressedDataUrl;

            // Calculate compressed size
            const compressedBytes = Math.round((compressedDataUrl.length * 3) / 4);
            const compressedKB = Math.round(compressedBytes / 1024);

            uploadPreview.src = compressedDataUrl;
            uploadPlaceholder?.classList.add('hidden');
            uploadPreviewContainer?.classList.remove('hidden');
            if (compressionInfo) {
              compressionInfo.textContent = `✓ Siap Upload: ${originalSizeKB} KB ➔ ${compressedKB} KB`;
            }
          }
        };
        img.src = e.target?.result as string;
      };
      reader.readAsDataURL(file);
    });

    function setLoading(isLoading: boolean) {
      if (isLoading) {
        btnSubmit.disabled = true;
        btnSubmitAnother.disabled = true;
        btnSubmit.classList.add('opacity-60', 'cursor-not-allowed');
        btnSubmit.innerHTML = '<span>Mengunggah & Menyimpan...</span>';
      } else {
        btnSubmit.disabled = false;
        btnSubmitAnother.disabled = false;
        btnSubmit.classList.remove('opacity-60', 'cursor-not-allowed');
        btnSubmit.innerHTML = '<span>✓ Simpan & Tayangkan Sekarang</span>';
      }
    }

    function showStatus(html: string, type: 'success' | 'error' | 'warning') {
      if (!statusBox) return;
      statusBox.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-900', 'border-emerald-300', 'bg-rose-100', 'text-rose-900', 'border-rose-300', 'bg-amber-100', 'text-amber-900', 'border-amber-300');
      
      if (type === 'success') {
        statusBox.classList.add('bg-emerald-100', 'text-emerald-900', 'border', 'border-emerald-300');
      } else if (type === 'error') {
        statusBox.classList.add('bg-rose-100', 'text-rose-900', 'border', 'border-rose-300');
      } else {
        statusBox.classList.add('bg-amber-100', 'text-amber-900', 'border', 'border-amber-300');
      }

      statusBox.innerHTML = html;
      statusBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  </script>
</Layout>
