---
import Layout from '../layouts/Layout.astro';
import { getAllZones, getProducts } from '../lib/db';
import {
  PRODUCT_CATEGORIES,
  CATEGORY_ICONS,
  TARGET_MVP_PRODUCTS,
  DEFAULT_AGENT_PIN,
} from '../lib/constants';
import { formatRupiah } from '../lib/utils';

const zones = getAllZones();
const allProducts = getProducts();
const totalCount = allProducts.length;
const progressPercent = Math.min(
  Math.round((totalCount / TARGET_MVP_PRODUCTS) * 100),
  100
);

const recentProducts = allProducts.slice(0, 5);
---

<Layout title="Pasang Iklan Produk | Pasar Warga NU Sumenep">
  <div class="max-w-3xl mx-auto space-y-6 py-4 sm:py-8 px-3 sm:px-6">
    
    <!-- Page Header: OsClass "Post your ad" Aesthetic -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 border-b border-slate-800">
      <div>
        <h1 class="text-xl sm:text-3xl font-black text-white tracking-tight flex items-center gap-2">
          <span>📝</span> Pasang Iklan Produk
        </h1>
        <p class="text-xs sm:text-sm text-slate-400 mt-1">
          Daftarkan produk UMKM nahdliyin ke direktori digital Kabupaten Sumenep
        </p>
      </div>

      <!-- Fase 1 Badge & Progress Bar -->
      <div class="bg-[#141d2a] border border-slate-700/80 rounded-xl p-3 shrink-0 space-y-1.5 w-full sm:w-64">
        <div class="flex items-center justify-between text-xs font-bold">
          <span class="text-slate-300">Target Fase 1:</span>
          <span class="text-emerald-400">{totalCount} / {TARGET_MVP_PRODUCTS} Produk ({progressPercent}%)</span>
        </div>
        <div class="w-full bg-slate-900 rounded-full h-2 overflow-hidden border border-slate-700">
          <div
            class="bg-indigo-500 h-full rounded-full transition-all duration-500"
            style={`width: ${progressPercent}%`}
          ></div>
        </div>
      </div>
    </div>

    <!-- Feedback Message Box (Client Side) -->
    <div id="status-box" class="hidden p-4 rounded-xl text-xs font-semibold"></div>

    <!-- OsClass "Post your ad" Form Sections (Structured Cards) -->
    <form id="agent-form" class="space-y-5">
      <input type="hidden" id="imageBase64" name="imageBase64" />

      <!-- Section 1: Category Card (OsClass Style) -->
      <div class="bg-[#141c2b] border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-sm space-y-3">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
          <h2 class="text-xs font-black uppercase tracking-wider text-slate-200">
            Kategori Produk
          </h2>
          <span class="w-5 h-5 rounded-full bg-indigo-600/30 text-indigo-400 border border-indigo-500/40 text-[10px] flex items-center justify-center font-bold">
            ?
          </span>
        </div>

        <div class="space-y-1.5">
          <label for="category" class="block text-xs font-bold text-slate-300">
            Pilih Kategori Iklan <span class="text-rose-400">*</span>
          </label>
          <select
            id="category"
            name="category"
            required
            class="w-full bg-[#182334] border border-slate-700 rounded-xl p-3 text-xs sm:text-sm font-semibold text-slate-100 focus:outline-none focus:border-indigo-500 cursor-pointer"
          >
            <option value="" disabled selected>-- Pilih Kategori Produk --</option>
            {PRODUCT_CATEGORIES.map((cat) => (
              <option value={cat}>
                {CATEGORY_ICONS[cat] || '📦'} {cat}
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- Section 2: Listing Location Card (OsClass Style) -->
      <div class="bg-[#141c2b] border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-sm space-y-3">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
          <h2 class="text-xs font-black uppercase tracking-wider text-slate-200">
            Lokasi Usaha (Kabupaten Sumenep)
          </h2>
          <span class="w-5 h-5 rounded-full bg-indigo-600/30 text-indigo-400 border border-indigo-500/40 text-[10px] flex items-center justify-center font-bold">
            ?
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div class="space-y-1.5">
            <label for="zoneId" class="block text-xs font-bold text-slate-300">
              Wilayah MWC NU <span class="text-rose-400">*</span>
            </label>
            <select
              id="zoneId"
              name="zoneId"
              required
              class="w-full bg-[#182334] border border-slate-700 rounded-xl p-3 text-xs sm:text-sm font-semibold text-slate-100 focus:outline-none focus:border-indigo-500 cursor-pointer"
            >
              <option value="" disabled selected>-- Pilih MWC Kecamatan --</option>
              {zones.map((z) => (
                <option value={z.id}>{z.name}</option>
              ))}
            </select>
          </div>

          <div class="space-y-1.5">
            <label for="address" class="block text-xs font-bold text-slate-300">
              Desa / Dusun / Alamat Toko
            </label>
            <input
              type="text"
              id="address"
              name="address"
              placeholder="Contoh: Dusun Karang Anyar, Desa Gapura Timur"
              class="w-full bg-[#182334] border border-slate-700 rounded-xl p-3 text-xs sm:text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
            />
          </div>
        </div>
      </div>

      <!-- Section 3: Seller's Information Card (OsClass Style) -->
      <div class="bg-[#141c2b] border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-sm space-y-3">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
          <h2 class="text-xs font-black uppercase tracking-wider text-slate-200">
            Informasi Penjual / Toko
          </h2>
          <span class="w-5 h-5 rounded-full bg-indigo-600/30 text-indigo-400 border border-indigo-500/40 text-[10px] flex items-center justify-center font-bold">
            ?
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div class="space-y-1.5">
            <label for="umkmName" class="block text-xs font-bold text-slate-300">
              Nama Toko / Pengrajin <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              id="umkmName"
              name="umkmName"
              placeholder="Contoh: UD Barokah Jaya / Dapur Bu Fatimah"
              required
              class="w-full bg-[#182334] border border-slate-700 rounded-xl p-3 text-xs sm:text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
            />
          </div>

          <div class="space-y-1.5">
            <label for="phone" class="block text-xs font-bold text-slate-300">
              Nomor WhatsApp Aktif <span class="text-rose-400">*</span>
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="Contoh: 081234567890"
              required
              class="w-full bg-[#182334] border border-slate-700 rounded-xl p-3 text-xs sm:text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-mono"
            />
            <div class="flex items-center gap-1.5 pt-1">
              <input type="checkbox" id="phoneVisible" checked disabled class="accent-indigo-600 rounded" />
              <label for="phoneVisible" class="text-[11px] text-slate-400">Nomor WhatsApp tampil di iklan untuk transaksi langsung</label>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 4: Pricing Options & Status (OsClass Style) -->
      <div class="bg-[#141c2b] border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-sm space-y-3">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
          <h2 class="text-xs font-black uppercase tracking-wider text-slate-200">
            Harga Produk
          </h2>
          <span class="w-5 h-5 rounded-full bg-indigo-600/30 text-indigo-400 border border-indigo-500/40 text-[10px] flex items-center justify-center font-bold">
            ?
          </span>
        </div>

        <div class="space-y-2">
          <label for="price" class="block text-xs font-bold text-slate-300">
            Nominal Harga (Rupiah) <span class="text-rose-400">*</span>
          </label>
          <div class="relative">
            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 font-bold text-xs text-slate-400">
              IDR (Rp)
            </span>
            <input
              type="number"
              id="price"
              name="price"
              min="0"
              step="500"
              placeholder="Contoh: 25000"
              required
              class="w-full bg-[#182334] border border-slate-700 rounded-xl py-3 pl-20 pr-4 text-xs sm:text-sm font-black text-emerald-400 placeholder-slate-500 focus:outline-none focus:border-indigo-500"
            />
          </div>
          <p class="text-[11px] text-slate-400">
            Tulis angka saja tanpa titik atau koma. Masukkan 0 jika barang gratis atau sampel.
          </p>
        </div>
      </div>

      <!-- Section 5: Photos Dropzone (OsClass Style with Fast Client Compression) -->
      <div class="bg-[#141c2b] border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-sm space-y-3">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
          <h2 class="text-xs font-black uppercase tracking-wider text-slate-200">
            Foto Produk (Kamera HP / Galeri)
          </h2>
          <span class="w-5 h-5 rounded-full bg-indigo-600/30 text-indigo-400 border border-indigo-500/40 text-[10px] flex items-center justify-center font-bold">
            ?
          </span>
        </div>

        <div>
          <label
            for="camera-input"
            class="relative group cursor-pointer block border-2 border-dashed border-slate-700 hover:border-indigo-500 bg-[#182334] hover:bg-[#1d2b40] rounded-2xl p-6 text-center transition"
          >
            <input
              type="file"
              id="camera-input"
              accept="image/*"
              capture="environment"
              class="hidden"
            />
            
            <div id="upload-placeholder" class="space-y-1.5">
              <div class="text-4xl text-slate-400">📷</div>
              <span class="text-xs sm:text-sm font-black text-indigo-400 block">
                Klik atau Tarik Foto Produk di Sini
              </span>
              <span class="text-[11px] text-slate-400 block max-w-sm mx-auto">
                Foto otomatis dikompres via HTML5 Canvas ke resolusi optimal (&lt;150KB) sebelum dikirim, hemat kuota di lapangan.
              </span>
            </div>

            <!-- Preview & Compression Status -->
            <div id="upload-preview-container" class="hidden space-y-2">
              <img
                id="upload-preview"
                src=""
                alt="Preview"
                class="w-32 h-32 sm:w-40 sm:h-40 object-cover mx-auto rounded-2xl border-2 border-indigo-500 shadow-md"
              />
              <div
                id="compression-info"
                class="text-xs font-bold text-emerald-300 bg-emerald-950 px-3 py-1 rounded-lg inline-block border border-emerald-800"
              ></div>
              <span class="block text-[11px] text-slate-400">Ketuk untuk mengganti foto</span>
            </div>
          </label>
        </div>
      </div>

      <!-- Section 6: Title & Description (OsClass Style) -->
      <div class="bg-[#141c2b] border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-sm space-y-3">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
          <h2 class="text-xs font-black uppercase tracking-wider text-slate-200">
            Judul & Deskripsi Iklan
          </h2>
          <span class="w-5 h-5 rounded-full bg-indigo-600/30 text-indigo-400 border border-indigo-500/40 text-[10px] flex items-center justify-center font-bold">
            ?
          </span>
        </div>

        <div class="space-y-3">
          <div class="space-y-1.5">
            <label for="productName" class="block text-xs font-bold text-slate-300">
              Judul Iklan / Nama Produk <span class="text-rose-400">*</span>
            </label>
            <input
              type="text"
              id="productName"
              name="productName"
              placeholder="Contoh: Rengginang Lorjuk Super Asli Gapura 250g"
              required
              class="w-full bg-[#182334] border border-slate-700 rounded-xl p-3 text-xs sm:text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 font-semibold"
            />
          </div>

          <div class="space-y-1.5">
            <label for="description" class="block text-xs font-bold text-slate-300">
              Deskripsi Lengkap Produk
            </label>
            <textarea
              id="description"
              name="description"
              rows="3"
              placeholder="Jelaskan keistimewaan rasa, bahan baku lokal, proses pembuatan, dan pilihan rasa/ukuran..."
              class="w-full bg-[#182334] border border-slate-700 rounded-xl p-3 text-xs sm:text-sm text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 resize-none"
            ></textarea>
          </div>
        </div>
      </div>

      <!-- Section 7: PIN Akses Agen (Verifikasi) -->
      <div class="bg-[#141c2b] border border-slate-800 rounded-2xl p-4 sm:p-5 shadow-sm space-y-3">
        <div class="flex items-center justify-between pb-2 border-b border-slate-800/80">
          <h2 class="text-xs font-black uppercase tracking-wider text-slate-200">
            Verifikasi & PIN Agen
          </h2>
          <span class="text-[11px] text-emerald-400 font-medium">Default: <strong>{DEFAULT_AGENT_PIN}</strong></span>
        </div>

        <div class="space-y-1.5">
          <label for="agentPin" class="block text-xs font-bold text-slate-300">
            PIN Agen Lapangan NU <span class="text-rose-400">*</span>
          </label>
          <input
            type="password"
            id="agentPin"
            name="agentPin"
            placeholder={`Masukkan PIN Agen (Default: ${DEFAULT_AGENT_PIN})`}
            required
            class="w-full bg-[#182334] border border-slate-700 rounded-xl p-3 text-xs sm:text-sm font-mono tracking-widest text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500"
          />
        </div>
      </div>

      <!-- Action Buttons: Large Indigo Submit (OsClass Signature) -->
      <div class="pt-2 space-y-2.5">
        <button
          type="submit"
          id="btn-submit"
          class="w-full py-4 px-6 bg-[#4f46e5] hover:bg-[#4338ca] active:bg-[#3730a3] text-white font-black text-sm sm:text-base rounded-xl shadow-xl transition active:scale-98 cursor-pointer flex items-center justify-center gap-2"
        >
          <span>✓ Terbitkan Iklan Sekarang</span>
        </button>

        <button
          type="button"
          id="btn-submit-another"
          class="w-full py-3 px-4 bg-[#182334] hover:bg-[#1f2d42] border border-slate-700 text-slate-200 text-xs font-bold rounded-xl transition cursor-pointer"
        >
          + Simpan & Lanjut Tambah Produk Lain Toko Ini
        </button>
      </div>

    </form>

    <!-- Recent Uploads List (Audit Ringkas) -->
    <div class="bg-[#141c2b] border border-slate-800 rounded-2xl p-4 sm:p-6 shadow-sm space-y-3">
      <h3 class="text-xs font-black uppercase tracking-wider text-slate-300">
        Iklan Terakhir yang Terdaftar ({allProducts.length} Produk Aktif)
      </h3>
      <div class="divide-y divide-slate-800/80 text-xs">
        {recentProducts.map((p) => (
          <div class="py-2.5 flex items-center justify-between gap-3">
            <div class="flex items-center gap-3 truncate">
              <img
                src={p.image_url}
                alt={p.name}
                class="w-9 h-9 rounded-lg object-cover shrink-0"
              />
              <div class="truncate">
                <span class="font-bold text-white block truncate">{p.name}</span>
                <span class="text-[11px] text-slate-400">{p.umkm_name} • {p.zone_name}</span>
              </div>
            </div>
            <div class="text-right shrink-0">
              <span class="font-black text-emerald-400 block">{formatRupiah(p.price)}</span>
              <a href={`/p/${p.slug}`} target="_blank" class="text-[10px] text-indigo-400 hover:text-indigo-300 underline font-semibold">
                Lihat ➔
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>

  <!-- Client Side Script: Canvas Auto-Compression & Fetch -->
  <script>
    const form = document.getElementById('agent-form') as HTMLFormElement;
    const cameraInput = document.getElementById('camera-input') as HTMLInputElement;
    const imageBase64Input = document.getElementById('imageBase64') as HTMLInputElement;
    const uploadPlaceholder = document.getElementById('upload-placeholder');
    const uploadPreviewContainer = document.getElementById('upload-preview-container');
    const uploadPreview = document.getElementById('upload-preview') as HTMLImageElement;
    const compressionInfo = document.getElementById('compression-info');
    const statusBox = document.getElementById('status-box');
    const agentPinInput = document.getElementById('agentPin') as HTMLInputElement;
    const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;
    const btnSubmitAnother = document.getElementById('btn-submit-another') as HTMLButtonElement;

    // Load saved PIN from localStorage if available
    const savedPin = localStorage.getItem('mamasar_agent_pin');
    if (savedPin && agentPinInput) {
      agentPinInput.value = savedPin;
    } else if (agentPinInput && !agentPinInput.value) {
      agentPinInput.value = '1926';
    }

    let keepStoreInfo = false;

    btnSubmitAnother?.addEventListener('click', () => {
      keepStoreInfo = true;
      form.requestSubmit();
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (!imageBase64Input.value) {
        showStatus('Peringatan: Silakan ambil atau pilih foto produk terlebih dahulu!', 'warning');
        return;
      }

      if (agentPinInput.value) {
        localStorage.setItem('mamasar_agent_pin', agentPinInput.value.trim());
      }

      setLoading(true);

      try {
        const formData = new FormData(form);
        const res = await fetch('/api/products', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json();

        if (res.ok && data.success) {
          showStatus(
            `Alhamdulillah! Iklan berhasil diterbitkan. <a href="/p/${data.slug}" class="underline font-bold text-white" target="_blank">Lihat Iklan Tayang ➔</a>`,
            'success'
          );

          if (keepStoreInfo) {
            (document.getElementById('productName') as HTMLInputElement).value = '';
            (document.getElementById('price') as HTMLInputElement).value = '';
            (document.getElementById('description') as HTMLTextAreaElement).value = '';
            resetImage();
            keepStoreInfo = false;
          } else {
            form.reset();
            if (savedPin) agentPinInput.value = savedPin;
            else agentPinInput.value = '1926';
            resetImage();
          }
        } else {
          showStatus(`Gagal: ${data.message || 'Terjadi kesalahan sistem.'}`, 'error');
        }
      } catch (err: any) {
        showStatus(`Gagal terhubung ke server: ${err.message}`, 'error');
      } finally {
        setLoading(false);
      }
    });

    function resetImage() {
      imageBase64Input.value = '';
      if (uploadPreview) uploadPreview.src = '';
      uploadPlaceholder?.classList.remove('hidden');
      uploadPreviewContainer?.classList.add('hidden');
    }

    cameraInput?.addEventListener('change', () => {
      const file = cameraInput.files?.[0];
      if (!file) return;

      const originalSizeKB = Math.round(file.size / 1024);

      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          // Compress via Canvas to max 1200x1200px and JPEG quality 0.8
          const canvas = document.createElement('canvas');
          const maxDim = 1200;
          let width = img.width;
          let height = img.height;

          if (width > maxDim || height > maxDim) {
            if (width > height) {
              height = Math.round((height * maxDim) / width);
              width = maxDim;
            } else {
              width = Math.round((width * maxDim) / height);
              height = maxDim;
            }
          }

          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          if (ctx) {
            ctx.drawImage(img, 0, 0, width, height);
            const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.8);
            imageBase64Input.value = compressedDataUrl;

            const compressedBytes = Math.round((compressedDataUrl.length * 3) / 4);
            const compressedKB = Math.round(compressedBytes / 1024);

            uploadPreview.src = compressedDataUrl;
            uploadPlaceholder?.classList.add('hidden');
            uploadPreviewContainer?.classList.remove('hidden');
            if (compressionInfo) {
              compressionInfo.textContent = `✓ Siap Upload: ${originalSizeKB} KB ➔ ${compressedKB} KB`;
            }
          }
        };
        img.src = e.target?.result as string;
      };
      reader.readAsDataURL(file);
    });

    function setLoading(isLoading: boolean) {
      if (isLoading) {
        btnSubmit.disabled = true;
        btnSubmitAnother.disabled = true;
        btnSubmit.classList.add('opacity-60', 'cursor-not-allowed');
        btnSubmit.innerHTML = '<span>Mengunggah & Menyimpan...</span>';
      } else {
        btnSubmit.disabled = false;
        btnSubmitAnother.disabled = false;
        btnSubmit.classList.remove('opacity-60', 'cursor-not-allowed');
        btnSubmit.innerHTML = '<span>✓ Terbitkan Iklan Sekarang</span>';
      }
    }

    function showStatus(html: string, type: 'success' | 'error' | 'warning') {
      if (!statusBox) return;
      statusBox.classList.remove('hidden', 'bg-emerald-950', 'text-emerald-200', 'border-emerald-700', 'bg-rose-950', 'text-rose-200', 'border-rose-700', 'bg-amber-950', 'text-amber-200', 'border-amber-700');
      
      if (type === 'success') {
        statusBox.classList.add('bg-emerald-950', 'text-emerald-200', 'border', 'border-emerald-700');
      } else if (type === 'error') {
        statusBox.classList.add('bg-rose-950', 'text-rose-200', 'border', 'border-rose-700');
      } else {
        statusBox.classList.add('bg-amber-950', 'text-amber-200', 'border', 'border-amber-700');
      }

      statusBox.innerHTML = html;
      statusBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  </script>
</Layout>