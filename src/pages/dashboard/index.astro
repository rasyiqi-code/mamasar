  <!-- Client-side Interactive Script for Dashboard -->
  <script>
    // 0. Neon Auth Email & Password Form Handling
    const neonAuthForm = document.getElementById('neon-auth-form') as HTMLFormElement;
    const neonAuthMsg = document.getElementById('neon-auth-msg');
    const toggleAuthModeBtn = document.getElementById('toggle-auth-mode');
    const nameFieldGroup = document.getElementById('name-field-group');
    const neonAuthAction = document.getElementById('neonAuthAction') as HTMLInputElement;
    const neonSubmitBtn = document.getElementById('neon-submit-btn') as HTMLButtonElement;

    toggleAuthModeBtn?.addEventListener('click', () => {
      const isSignIn = neonAuthAction.value === 'signin';
      if (isSignIn) {
        neonAuthAction.value = 'signup';
        nameFieldGroup?.classList.remove('hidden');
        if (neonSubmitBtn) neonSubmitBtn.textContent = 'Daftar Akun Baru';
        toggleAuthModeBtn.textContent = 'Sudah punya akun? Masuk di sini ➔';
      } else {
        neonAuthAction.value = 'signin';
        nameFieldGroup?.classList.add('hidden');
        if (neonSubmitBtn) neonSubmitBtn.textContent = 'Masuk dengan Email';
        toggleAuthModeBtn.textContent = 'Belum punya akun? Daftar Baru di Neon Auth ➔';
      }
      if (neonAuthMsg) neonAuthMsg.classList.add('hidden');
    });

    neonAuthForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (neonSubmitBtn) neonSubmitBtn.disabled = true;
      if (neonAuthMsg) {
        neonAuthMsg.className = 'p-2.5 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200';
        neonAuthMsg.textContent = 'Menghubungi Neon Auth...';
        neonAuthMsg.classList.remove('hidden');
      }

      const formData = new FormData(neonAuthForm);
      const payload = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/auth/email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const data = await res.json();
        if (res.ok && data.ok) {
          if (neonAuthMsg) {
            neonAuthMsg.textContent = 'Berhasil masuk! Membuka dashboard...';
          }
          window.location.href = data.redirect || '/dashboard';
        } else {
          if (neonAuthMsg) {
            neonAuthMsg.className = 'p-2.5 rounded-xl text-xs font-semibold bg-rose-50 text-rose-800 border border-rose-200';
            neonAuthMsg.textContent = data.error || 'Autentikasi gagal.';
          }
        }
      } catch (err: any) {
        if (neonAuthMsg) {
          neonAuthMsg.className = 'p-2.5 rounded-xl text-xs font-semibold bg-rose-50 text-rose-800 border border-rose-200';
          neonAuthMsg.textContent = 'Kendala koneksi: ' + err.message;
        }
      } finally {
        if (neonSubmitBtn) neonSubmitBtn.disabled = false;
      }
    });

    // 1. Store Setup Submission (+ orphan-store claim flow)
    const storeSetupForm = document.getElementById('store-setup-form') as HTMLFormElement;
    const setupStatus = document.getElementById('setup-status');
    const claimOffer = document.getElementById('claim-offer');
    const claimOfferText = document.getElementById('claim-offer-text');
    let pendingClaimId = 0;

    function hideClaimOffer() {
      pendingClaimId = 0;
      const claimInput = document.getElementById('claimStoreIdInput') as HTMLInputElement | null;
      const skipInput = document.getElementById('skipClaimInput') as HTMLInputElement | null;
      if (claimInput) claimInput.value = '';
      if (skipInput) skipInput.value = '';
      claimOffer?.classList.add('hidden');
    }

    async function submitStoreSetup() {
      const btn = document.getElementById('btn-save-store') as HTMLButtonElement;
      if (btn) btn.disabled = true;

      try {
        const formData = new FormData(storeSetupForm);
        const res = await fetch('/api/umkm/setup', {
          method: 'POST',
          body: formData,
        });
        const data = await res.json();

        if (data.claim_available) {
          pendingClaimId = data.candidate?.id || 0;
          if (claimOfferText) claimOfferText.textContent = data.message || '';
          if (claimOffer) {
            claimOffer.classList.remove('hidden');
            claimOffer.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          return;
        }

        if (res.ok && data.success) {
          window.location.reload();
          return;
        }

        hideClaimOffer();
        if (setupStatus) {
          setupStatus.className = 'p-3 rounded-xl text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200';
          setupStatus.textContent = data.message || 'Gagal menyimpan profil toko.';
          setupStatus.classList.remove('hidden');
        }
      } catch (err: any) {
        alert('Gagal menghubungi server: ' + err.message);
      } finally {
        if (btn) btn.disabled = false;
      }
    }

    storeSetupForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      submitStoreSetup();
    });

    document.getElementById('btn-claim-yes')?.addEventListener('click', () => {
      const input = document.getElementById('claimStoreIdInput') as HTMLInputElement | null;
      if (input && pendingClaimId) input.value = String(pendingClaimId);
      submitStoreSetup();
    });

    document.getElementById('btn-claim-no')?.addEventListener('click', () => {
      const input = document.getElementById('skipClaimInput') as HTMLInputElement | null;
      if (input) input.value = '1';
      submitStoreSetup();
    });

    // Mengubah nomor WhatsApp membatalkan tawaran klaim yang tertunda.
    document.getElementById('storePhone')?.addEventListener('input', hideClaimOffer);

    // 2. Toggle Add Product Accordion
    const btnToggleAdd = document.getElementById('btn-toggle-add-product');
    const btnCloseAdd = document.getElementById('btn-close-add-product');
    const addProductContainer = document.getElementById('add-product-container');

    btnToggleAdd?.addEventListener('click', () => {
      addProductContainer?.classList.toggle('hidden');
      if (!addProductContainer?.classList.contains('hidden')) {
        document.getElementById('prodName')?.focus();
      }
    });
    btnCloseAdd?.addEventListener('click', () => {
      addProductContainer?.classList.add('hidden');
    });

    // 3. Client Canvas Auto-Compression for Dashboard Uploads
    const dashCameraInput = document.getElementById('dash-camera-input') as HTMLInputElement;
    const dashImageBase64 = document.getElementById('dashImageBase64') as HTMLInputElement;
    const dashCompressInfo = document.getElementById('dash-compress-info');

    dashCameraInput?.addEventListener('change', () => {
      const file = dashCameraInput.files?.[0];
      if (!file) return;

      const originalSizeKB = Math.round(file.size / 1024);
      const reader = new FileReader();

      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');
          const maxDim = 1200;
          let width = img.width;
          let height = img.height;

          if (width > height) {
            if (width > maxDim) {
              height = Math.round((height * maxDim) / width);
              width = maxDim;
            }
          } else {
            if (height > maxDim) {
              width = Math.round((width * maxDim) / height);
              height = maxDim;
            }
          }

          canvas.width = width;
          canvas.height = height;
          ctx?.drawImage(img, 0, 0, width, height);

          const compressedBase64 = canvas.toDataURL('image/jpeg', 0.82);
          if (dashImageBase64) dashImageBase64.value = compressedBase64;

          const compressedSizeKB = Math.round((compressedBase64.length * 3) / 4 / 1024);
          if (dashCompressInfo) {
            dashCompressInfo.textContent = `✓ Foto dikompres: ${originalSizeKB} KB ➔ ~${compressedSizeKB} KB (Hemat data)`;
            dashCompressInfo.className = 'text-[10px] font-bold text-emerald-600';
          }
        };
        img.src = e.target?.result as string;
      };
      reader.readAsDataURL(file);
    });

    // 4. Add Product Submission
    const addProductForm = document.getElementById('add-product-form') as HTMLFormElement;
    addProductForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = document.getElementById('btn-submit-product') as HTMLButtonElement;
      if (btn) btn.disabled = true;

      try {
        const formData = new FormData(addProductForm);
        const res = await fetch('/api/umkm/add-product', {
          method: 'POST',
          body: formData,
        });
        const data = await res.json();

        if (res.ok && data.success) {
          window.location.reload();
        } else {
          alert('Gagal menambah produk: ' + (data.message || 'Terjadi kesalahan sistem.'));
        }
      } catch (err: any) {
        alert('Gagal mengirim ke server: ' + err.message);
      } finally {
        if (btn) btn.disabled = false;
      }
    });

    // 5. Quick Actions: Bump, Toggle Stock, Delete
    const actionStatus = document.getElementById('action-status');

    function showStatus(msg: string, isError = false) {
      if (!actionStatus) return;
      actionStatus.className = isError
        ? 'p-3 rounded-xl text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200'
        : 'p-3 rounded-xl text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200';
      actionStatus.textContent = msg;
      actionStatus.classList.remove('hidden');
      setTimeout(() => actionStatus.classList.add('hidden'), 4000);
    }

    document.querySelectorAll('[data-action="bump"]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const formData = new FormData();
        formData.append('productId', id || '');

        const res = await fetch('/api/products/bump', { method: 'POST', body: formData });
        const data = await res.json();
        if (res.ok && data.success) {
          showStatus('⚡ Berhasil! Iklan disundul ke posisi teratas.');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showStatus(data.message || 'Gagal menyundul produk.', true);
        }
      });
    });

    document.querySelectorAll('[data-action="toggle-stock"]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const formData = new FormData();
        formData.append('productId', id || '');

        const res = await fetch('/api/products/toggle-stock', { method: 'POST', body: formData });
        const data = await res.json();
        if (res.ok && data.success) {
          window.location.reload();
        } else {
          showStatus(data.message || 'Gagal mengubah status stok.', true);
        }
      });
    });

    document.querySelectorAll('[data-action="delete"]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        if (!confirm(`Hapus produk "${name}" dari katalog toko Anda?`)) return;

        const formData = new FormData();
        formData.append('productId', id || '');

        const res = await fetch('/api/products/delete', { method: 'POST', body: formData });
        const data = await res.json();
        if (res.ok && data.success) {
          window.location.reload();
        } else {
          showStatus(data.message || 'Gagal menghapus produk.', true);
        }
      });
    });

    // 5. Cashbook Form & Interactivity (Slide 4 LPNU)
    const btnToggleCash = document.getElementById('btn-toggle-cashbook-form');
    const btnCancelCash = document.getElementById('btn-cancel-cashbook');
    const cashContainer = document.getElementById('cashbook-form-container');
    const cashForm = document.getElementById('cashbook-entry-form') as HTMLFormElement;

    btnToggleCash?.addEventListener('click', () => {
      cashContainer?.classList.toggle('hidden');
      if (!cashContainer?.classList.contains('hidden')) {
        document.getElementById('cashTitle')?.focus();
      }
    });

    btnCancelCash?.addEventListener('click', () => {
      cashContainer?.classList.add('hidden');
    });

    cashForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const title = (document.getElementById('cashTitle') as HTMLInputElement).value;
      const amount = Number((document.getElementById('cashAmount') as HTMLInputElement).value);
      const type = (document.getElementById('cashType') as HTMLSelectElement).value;

      try {
        const res = await fetch('/api/user/cashbook', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ title, amount, type }),
        });
        const data = await res.json();
        if (res.ok && data.success) {
          window.location.reload();
        } else {
          alert(data.message || 'Gagal menyimpan catatan kas.');
        }
      } catch (err: any) {
        alert('Gagal menghubungi server: ' + err.message);
      }
    });

    document.querySelectorAll('.btn-delete-cash').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id');
        if (!confirm('Hapus baris catatan buku kas ini?')) return;

        try {
          const res = await fetch('/api/user/cashbook', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id }),
          });
          const data = await res.json();
          if (res.ok && data.success) {
            const row = document.getElementById(`cash-row-${id}`);
            row?.remove();
          } else {
            alert(data.message || 'Gagal menghapus baris kas.');
          }
        } catch (err: any) {
          alert('Gagal menghubungi server: ' + err.message);
        }
      });
    });
  </script>
</Layout>
