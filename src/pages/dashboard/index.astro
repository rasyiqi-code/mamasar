---
import AppLayout from '../../layouts/AppLayout.astro';
import {
  getUMKMByUserId,
  getAllZones,
  getCashbookSummary,
  getCashbookEntries,
  isSuperadmin,
  isPetugas,
} from '../../lib/db';
import { resolveUser } from '../../lib/neon-auth';
import { resolveAvatarUrl } from '../../lib/storage';

import AuthCard from '../../components/dashboard/AuthCard.astro';
import StoreSetupCard from '../../components/dashboard/StoreSetupCard.astro';
import DashboardSidebar from '../../components/dashboard/DashboardSidebar.astro';
import ProductsPanel from '../../components/dashboard/ProductsPanel.astro';
import CashbookPanel from '../../components/dashboard/CashbookPanel.astro';
import ProfilePanel from '../../components/dashboard/ProfilePanel.astro';
import ServicesPanel from '../../components/dashboard/ServicesPanel.astro';
import ProductModals from '../../components/dashboard/ProductModals.astro';

const user = await resolveUser(Astro.request);
const store = user ? await getUMKMByUserId(user.id) : undefined;
const zones = await getAllZones();
const avatarUrl = await resolveAvatarUrl(user?.avatar_url);

const cashbookSummary = user
  ? await getCashbookSummary(user.id)
  : { totalIncome: 0, totalExpense: 0, balance: 0 };
const cashbookEntries = user ? await getCashbookEntries(user.id, 50) : [];

const authError = Astro.url.searchParams.get('error');
const isLoggedOut = Astro.url.searchParams.get('logged_out') === '1';
const isSuper = isSuperadmin(user);
const isCadre = isPetugas(user);
---

<AppLayout
  title={user ? `Dashboard Toko: ${store?.name || user.name} | Pasar Warga NU` : 'Masuk ke Dashboard UMKM | Pasar Warga NU Sumenep'}
  description="Portal swalayan pemilik UMKM Nahdliyin untuk mengelola etalase produk, pembukuan kas santri, dan profil usaha secara mandiri."
>
  <!-- KONDISI 1: Belum Login -->
  {!user && <AuthCard authError={authError} isLoggedOut={isLoggedOut} />}

  <!-- KONDISI 2: Sudah Login, Belum Punya Profil Toko -->
  {user && !store && <StoreSetupCard user={user} zones={zones} />}

  <!-- KONDISI 3: Workspace Toko Siap (Modern SaaS Shell) -->
  {user && store && (
    <div class="min-h-screen bg-white flex flex-col md:flex-row">
      <!-- Sidebar Navigasi -->
      <DashboardSidebar
        user={user}
        store={store}
        avatarUrl={avatarUrl}
        isSuper={isSuper}
        isCadre={isCadre}
        productCount={store.products?.length || 0}
        cashbookCount={cashbookEntries.length}
      />

      <!-- Workspace Utama (Fullwidth & Compact) -->
      <main class="flex-1 min-w-0 overflow-y-auto p-4 sm:p-6 w-full space-y-6">
        <!-- Status Notification Box -->
        <div id="action-status" class="hidden mb-4 p-2.5 rounded-lg text-xs font-semibold"></div>

        <!-- Tab 1: Katalog Produk -->
        <ProductsPanel store={store} />

        <!-- Tab 2: Buku Kas Santri -->
        <CashbookPanel
          summary={cashbookSummary}
          entries={cashbookEntries}
          products={store.products}
        />

        <!-- Tab 3: Profil Usaha -->
        <ProfilePanel store={store} zones={zones} />

        <!-- Tab 4: Layanan Kemitraan & Kaderisasi -->
        <ServicesPanel
          user={user}
          zones={zones}
          assignedZone={zones.find((z) => z.id === user.assigned_zone_id)}
        />
      </main>

      <!-- Modal Dialogs -->
      <ProductModals />
    </div>
  )}

  <style is:global>
    .nav-tab-btn {
      color: #64748b;
      transition: all 0.15s ease;
    }
    .nav-tab-btn:hover {
      background-color: #f8fafc;
      color: #0f172a;
    }
    .nav-tab-btn.active {
      background-color: #f1f5f9;
      color: #0f172a;
      font-weight: 600;
    }
    .nav-tab-btn.active span[class*="text-[10px]"] {
      background-color: #e2e8f0;
      color: #0f172a;
      border-color: transparent;
    }
  </style>

  <script src="../../scripts/dashboard.client.ts"></script>
</AppLayout>
