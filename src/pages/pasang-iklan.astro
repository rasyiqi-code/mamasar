---
import Layout from '../layouts/Layout.astro';
import AppIcon from '../components/common/AppIcon.astro';
import { getUMKMByUserId } from '../lib/db';
import { resolveUser } from '../lib/neon-auth';
import { PRODUCT_CATEGORIES } from '../lib/constants';

const user = await resolveUser(Astro.request);
const userStore = user ? await getUMKMByUserId(user.id) : null;
---

<Layout
  title="Pasang Iklan Produk | Mamasar"
  description="Pasang iklan produk UMKM Anda langsung di direktori Mamasar Sumenep. Transaksi langsung via WhatsApp tanpa potongan biaya komisi."
>
  <div class="max-w-4xl mx-auto py-4 sm:py-8 px-4 sm:px-6">
    
    <!-- Header: Compact Title & Breadcrumb with Line Divider -->
    <div class="pb-4 mb-6 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
      <div>
        <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
          <AppIcon name="plus" size="md" class="text-indigo-600" />
          <span>Pasang Iklan Produk</span>
        </h1>
        <p class="text-xs text-slate-500 mt-0.5">
          Etalase digital produk UMKM warga Nahdliyin se-Kabupaten Sumenep
        </p>
      </div>

      <a
        href="/"
        class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition flex items-center gap-1.5 self-start sm:self-auto"
      >
        <AppIcon name="arrow-left" size="xs" />
        <span>Kembali ke Katalog</span>
      </a>
    </div>

    <!-- Store Status Banner (Pure Product Flow) -->
    {userStore ? (
      <div class="mb-6 p-3.5 rounded-xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-2.5 text-xs">
        <div class="flex items-center gap-2.5 text-slate-800">
          <AppIcon name="store" size="sm" class="text-emerald-700 shrink-0" />
          <div>
            <span class="text-slate-500">Iklan diterbitkan atas nama toko:</span>
            <strong class="text-slate-900 ml-1">{userStore.name}</strong>
            <span class="text-slate-400 mx-1.5">•</span>
            <span class="text-slate-600">{userStore.zone_name}</span>
            <span class="text-slate-400 mx-1.5">•</span>
            <span class="font-mono text-slate-600">{userStore.phone}</span>
          </div>
        </div>
        <a
          href="/dashboard"
          class="text-indigo-600 hover:text-indigo-800 font-bold text-xs underline self-start sm:self-auto shrink-0"
        >
          Kelola Profil Toko di Dashboard ➔
        </a>
      </div>
    ) : (
      <div class="mb-6 p-4 rounded-xl bg-amber-50 border border-amber-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
        <div class="flex items-center gap-2.5 text-amber-900">
          <AppIcon name="info" size="sm" class="text-amber-700 shrink-0" />
          <span>
            {user
              ? 'Anda belum melengkapi profil toko. Setiap produk dinaungi oleh toko agar nomor WhatsApp penjual tampil di katalog.'
              : 'Silakan masuk ke akun Anda untuk melengkapi profil toko sebelum memasang iklan produk.'}
          </span>
        </div>
        <a
          href="/dashboard"
          class="shrink-0 px-4 py-2 bg-amber-700 hover:bg-amber-800 text-white font-bold rounded-lg transition text-center"
        >
          {user ? 'Buka Profil Toko di Dashboard ➔' : 'Masuk ke Dashboard ➔'}
        </a>
      </div>
    )}

    <!-- Notification Toast Box -->
    <div id="form-alert" class="hidden mb-6 p-4 rounded-xl text-xs font-semibold"></div>

    <!-- Main Product Form (100% Pure Product Fields) -->
    <form id="product-form" class="space-y-6">
      <input type="hidden" id="productImageBase64" name="imageBase64" />
      <input type="hidden" id="galleryImagesInput" name="galleryImages" value="[]" />
      {userStore && <input type="hidden" name="umkmId" value={userStore.id} />}

      <!-- Section: Detail Produk -->
      <div class="space-y-4">
        <div class="pb-2 border-b border-slate-200 flex items-center justify-between">
          <h2 class="text-xs font-black uppercase tracking-wider text-slate-800 flex items-center gap-2">
            <AppIcon name="box" size="xs" class="text-slate-500" />
            <span>Informasi Produk</span>
          </h2>
          <span class="text-[11px] text-slate-400">* Wajib diisi</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label for="productName" class="block text-xs font-bold text-slate-700">
              Nama Produk / Judul Iklan <span class="text-rose-500">*</span>
            </label>
            <input
              type="text"
              id="productName"
              name="productName"
              required
              placeholder="Contoh: Keripik Pisang Madu Gurih Manis"
              class="w-full bg-white border border-slate-300 rounded-xl p-2.5 text-xs sm:text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition"
            />
          </div>

          <div class="space-y-1.5">
            <label for="category" class="block text-xs font-bold text-slate-700">
              Kategori Produk <span class="text-rose-500">*</span>
            </label>
            <select
              id="category"
              name="category"
              required
              class="w-full bg-white border border-slate-300 rounded-xl p-2.5 text-xs sm:text-sm font-semibold text-slate-900 focus:outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 cursor-pointer transition"
            >
              <option value="" disabled selected>Pilih Kategori</option>
              {PRODUCT_CATEGORIES.map((cat) => (
                <option value={cat}>{cat}</option>
              ))}
            </select>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="space-y-1.5">
            <label for="price" class="block text-xs font-bold text-slate-700">
              Harga Jual (Rp) <span class="text-rose-500">*</span>
            </label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">Rp</span>
              <input
                type="number"
                id="price"
                name="price"
                required
                min="0"
                step="500"
                placeholder="16000"
                class="w-full bg-white border border-slate-300 rounded-xl p-2.5 pl-9 text-xs sm:text-sm font-mono font-bold text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition"
              />
            </div>
          </div>

          <div class="space-y-1.5">
            <label for="originalPrice" class="block text-xs font-bold text-slate-700">
              Harga Coret / Normal (Opsional)
            </label>
            <div class="relative">
              <span class="absolute left-3 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400">Rp</span>
              <input
                type="number"
                id="originalPrice"
                name="originalPrice"
                min="0"
                step="500"
                placeholder="20000"
                class="w-full bg-white border border-slate-300 rounded-xl p-2.5 pl-9 text-xs sm:text-sm font-mono text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition"
              />
            </div>
            <p class="text-[11px] text-slate-400">Untuk diskon / promo.</p>
          </div>

          <div class="space-y-1.5">
            <label for="shopeeUrl" class="block text-xs font-bold text-slate-700">
              Tautan Marketplace (Opsional)
            </label>
            <input
              type="url"
              id="shopeeUrl"
              name="shopeeUrl"
              placeholder="https://shopee.co.id/product/..."
              class="w-full bg-white border border-slate-300 rounded-xl p-2.5 text-xs sm:text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition"
            />
          </div>
        </div>

        <!-- Section: Ketersediaan Stok & Kapasitas Produksi -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-1">
          <div class="space-y-1.5">
            <label for="stockStatus" class="block text-xs font-bold text-slate-700">
              Ketersediaan Stok <span class="text-rose-500">*</span>
            </label>
            <select
              id="stockStatus"
              name="stockStatus"
              required
              class="w-full bg-white border border-slate-300 rounded-xl p-2.5 text-xs sm:text-sm font-semibold text-slate-900 focus:outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 cursor-pointer transition"
            >
              <option value="ready" selected>Ready Stock (Barang Siap Kirim)</option>
              <option value="po">Pre-Order / Dibuat Berdasarkan Pesanan</option>
              <option value="sold_out">Habis / Kuota Produksi Penuh</option>
            </select>
            <p class="text-[11px] text-slate-500">Representasi ketersediaan barang fisik saat ini.</p>
          </div>

          <div class="space-y-1.5">
            <label for="productionCapacity" class="block text-xs font-bold text-slate-700">
              Kapasitas Produksi / Estimasi (Opsional)
            </label>
            <input
              type="text"
              id="productionCapacity"
              name="productionCapacity"
              placeholder="Contoh: 50 bungkus/hari atau PO 2-3 hari"
              class="w-full bg-white border border-slate-300 rounded-xl p-2.5 text-xs sm:text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition"
            />
            <p class="text-[11px] text-slate-500">Estimasi volume produksi per hari/minggu untuk pembeli.</p>
          </div>
        </div>

        <div class="space-y-1.5">
          <label for="description" class="block text-xs font-bold text-slate-700">
            Deskripsi Lengkap Produk <span class="text-rose-500">*</span>
          </label>
          <textarea
            id="description"
            name="description"
            required
            rows="4"
            placeholder="Jelaskan rasa, bahan baku, berat kemasan, varian, atau ketentuan pembelian..."
            class="w-full bg-white border border-slate-300 rounded-xl p-3 text-xs sm:text-sm text-slate-900 placeholder:text-slate-400 focus:outline-none focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 transition"
          ></textarea>
        </div>
      </div>

      <!-- Section: Foto Produk (Multi-Foto hingga 4 foto) -->
      <div class="space-y-4 pt-2">
        <div class="pb-2 border-b border-slate-200 flex items-center justify-between">
          <h2 class="text-xs font-black uppercase tracking-wider text-slate-800 flex items-center gap-2">
            <AppIcon name="camera" size="xs" class="text-slate-500" />
            <span>Foto Produk (Maks. 4 Foto)</span>
          </h2>
          <span id="photo-counter" class="text-[11px] font-semibold text-slate-500">0 dari 4 foto dipilih</span>
        </div>

        <div class="space-y-3">
          <!-- Upload Pickers (Hidden when 4 photos selected) -->
          <div id="upload-boxes" class="flex flex-col sm:flex-row gap-3">
            <label class="flex-1 border-2 border-dashed border-slate-300 hover:border-indigo-500 rounded-2xl p-4 sm:p-5 text-center cursor-pointer transition bg-slate-50 hover:bg-white group">
              <input type="file" id="imageInput" accept="image/*" multiple class="hidden" />
              <div class="space-y-1.5 flex flex-col items-center">
                <AppIcon name="camera" size="lg" class="text-slate-400 group-hover:text-indigo-600 transition" />
                <span class="text-xs font-bold text-slate-800 group-hover:text-indigo-600">Pilih Foto dari Galeri</span>
                <span class="text-[11px] text-slate-400">Bisa pilih sekaligus (JPG, PNG, WEBP)</span>
              </div>
            </label>

            <label class="flex-1 border-2 border-dashed border-slate-300 hover:border-emerald-500 rounded-2xl p-4 sm:p-5 text-center cursor-pointer transition bg-slate-50 hover:bg-white group">
              <input type="file" id="cameraInput" accept="image/*" capture="environment" class="hidden" />
              <div class="space-y-1.5 flex flex-col items-center">
                <AppIcon name="sparkles" size="lg" class="text-slate-400 group-hover:text-emerald-600 transition" />
                <span class="text-xs font-bold text-slate-800 group-hover:text-emerald-600">Jepret Kamera HP Langsung</span>
                <span class="text-[11px] text-slate-400">Ambil foto fisik produk</span>
              </div>
            </label>
          </div>

          <!-- Compression indicator -->
          <p id="compress-status" class="hidden text-xs font-semibold text-indigo-700 animate-pulse"></p>

          <!-- Dynamic Photos Grid -->
          <div id="photos-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-3"></div>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3">
        <a
          href="/"
          class="w-full sm:w-auto px-5 py-2.5 text-xs font-bold text-slate-600 hover:text-slate-900 border border-slate-200 rounded-xl text-center hover:bg-slate-50 transition"
        >
          Batal
        </a>

        <button
          type="submit"
          id="btn-submit-product"
          class="w-full sm:w-auto px-8 py-3 bg-[#4f46e5] hover:bg-[#4338ca] text-white font-black text-sm rounded-xl transition shadow-md flex items-center justify-center gap-2 cursor-pointer active:scale-98"
        >
          <span>Terbitkan Produk ➔</span>
        </button>
      </div>
    </form>

  </div>

  <script>
    const productForm = document.getElementById('product-form') as HTMLFormElement | null;
    const alertBox = document.getElementById('form-alert');

    // Product Multi-Photo State (up to 4 photos)
    let photos: string[] = [];
    const imageInput = document.getElementById('imageInput') as HTMLInputElement | null;
    const cameraInput = document.getElementById('cameraInput') as HTMLInputElement | null;
    const base64Input = document.getElementById('productImageBase64') as HTMLInputElement | null;
    const galleryImagesInput = document.getElementById('galleryImagesInput') as HTMLInputElement | null;
    const photosGrid = document.getElementById('photos-grid');
    const photoCounter = document.getElementById('photo-counter');
    const uploadBoxes = document.getElementById('upload-boxes');
    const compressStatusEl = document.getElementById('compress-status');
    const btnSubmitProduct = document.getElementById('btn-submit-product') as HTMLButtonElement | null;

    function showAlert(msg: string, isError = false) {
      if (!alertBox) return;
      alertBox.textContent = msg;
      alertBox.classList.remove('hidden', 'bg-rose-50', 'text-rose-900', 'border-rose-200', 'bg-emerald-50', 'text-emerald-900', 'border-emerald-200');
      if (isError) {
        alertBox.classList.add('bg-rose-50', 'text-rose-900', 'border', 'border-rose-200');
      } else {
        alertBox.classList.add('bg-emerald-50', 'text-emerald-900', 'border', 'border-emerald-200');
      }
      alertBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function syncHiddenInputs() {
      if (photos.length > 0) {
        if (base64Input) base64Input.value = photos[0];
        if (galleryImagesInput) galleryImagesInput.value = JSON.stringify(photos.slice(1));
      } else {
        if (base64Input) base64Input.value = '';
        if (galleryImagesInput) galleryImagesInput.value = '[]';
      }
      renderPhotosGrid();
    }

    function renderPhotosGrid() {
      if (!photosGrid) return;
      photosGrid.innerHTML = '';

      if (photoCounter) {
        photoCounter.textContent = `${photos.length} dari 4 foto dipilih`;
      }

      if (uploadBoxes) {
        if (photos.length >= 4) {
          uploadBoxes.classList.add('hidden');
        } else {
          uploadBoxes.classList.remove('hidden');
        }
      }

      photos.forEach((dataUrl, idx) => {
        const item = document.createElement('div');
        item.className = 'relative group rounded-xl overflow-hidden border border-slate-200 bg-slate-50 aspect-square flex items-center justify-center';

        const img = document.createElement('img');
        img.src = dataUrl;
        img.alt = `Foto ${idx + 1}`;
        img.className = 'w-full h-full object-cover';
        item.appendChild(img);

        const badge = document.createElement('span');
        badge.className = `absolute bottom-1.5 left-1.5 text-[10px] font-bold px-1.5 py-0.5 rounded shadow-xs ${
          idx === 0 ? 'bg-indigo-600 text-white' : 'bg-slate-900/80 text-white backdrop-blur-xs'
        }`;
        badge.textContent = idx === 0 ? 'Foto Utama' : `Foto ${idx + 1}`;
        item.appendChild(badge);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'absolute top-1.5 right-1.5 w-6 h-6 rounded-full bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs flex items-center justify-center shadow-sm cursor-pointer transition';
        removeBtn.setAttribute('aria-label', `Hapus foto ${idx + 1}`);
        removeBtn.textContent = '✕';
        removeBtn.onclick = (e) => {
          e.preventDefault();
          photos.splice(idx, 1);
          syncHiddenInputs();
        };
        item.appendChild(removeBtn);

        photosGrid.appendChild(item);
      });
    }

    function compressFileToDataUrl(file: File): Promise<string> {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onload = (e) => {
          const img = new Image();
          img.onload = () => {
            const canvas = document.createElement('canvas');
            const maxDim = 1200;
            let w = img.width;
            let h = img.height;

            if (w > maxDim || h > maxDim) {
              if (w > h) {
                h = Math.round((h * maxDim) / w);
                w = maxDim;
              } else {
                w = Math.round((w * maxDim) / h);
                h = maxDim;
              }
            }

            canvas.width = w;
            canvas.height = h;
            const ctx = canvas.getContext('2d');
            ctx?.drawImage(img, 0, 0, w, h);

            resolve(canvas.toDataURL('image/jpeg', 0.82));
          };
          img.onerror = reject;
          img.src = e.target?.result as string;
        };
        reader.onerror = reject;
        reader.readAsDataURL(file);
      });
    }

    async function handleFiles(files: FileList | null) {
      if (!files || files.length === 0) return;
      const remainingSlots = 4 - photos.length;
      if (remainingSlots <= 0) {
        showAlert('Maksimal 4 foto per produk telah tercapai.', true);
        return;
      }

      const filesToProcess = Array.from(files).slice(0, remainingSlots);
      if (compressStatusEl) {
        compressStatusEl.textContent = `Mengompres ${filesToProcess.length} foto otomatis...`;
        compressStatusEl.classList.remove('hidden');
      }

      for (const file of filesToProcess) {
        try {
          const dataUrl = await compressFileToDataUrl(file);
          if (photos.length < 4) {
            photos.push(dataUrl);
          }
        } catch (err) {
          console.error('Failed to compress image:', err);
        }
      }

      if (compressStatusEl) compressStatusEl.classList.add('hidden');
      syncHiddenInputs();
    }

    imageInput?.addEventListener('change', () => {
      handleFiles(imageInput.files);
      imageInput.value = '';
    });

    cameraInput?.addEventListener('change', () => {
      handleFiles(cameraInput.files);
      cameraInput.value = '';
    });

    // Submit Iklan Produk
    productForm?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (btnSubmitProduct) {
        btnSubmitProduct.disabled = true;
        btnSubmitProduct.innerHTML = '<span>Menerbitkan Produk...</span>';
      }

      try {
        const formData = new FormData(productForm);
        const res = await fetch('/api/products', {
          method: 'POST',
          body: formData,
        });

        const data = await res.json();

        if (res.ok && data.success) {
          showAlert('Alhamdulillah! Iklan produk berhasil diterbitkan. Mengalihkan ke halaman produk...', false);
          setTimeout(() => {
            window.location.href = `/p/${data.slug}`;
          }, 900);
        } else {
          if (res.status === 401) {
            showAlert('Sesi Anda belum aktif. Silakan masuk terlebih dahulu dengan Google/Email.', true);
            setTimeout(() => {
              window.location.href = '/dashboard';
            }, 1800);
          } else {
            showAlert(data.message || 'Gagal menerbitkan produk. Silakan periksa kembali formulir.', true);
          }
        }
      } catch (err: any) {
        showAlert(err.message || 'Terjadi gangguan koneksi internet. Silakan coba kembali.', true);
      } finally {
        if (btnSubmitProduct) {
          btnSubmitProduct.disabled = false;
          btnSubmitProduct.innerHTML = '<span>Terbitkan Produk ➔</span>';
        }
      }
    });
  </script>
</Layout>
