---
import Layout from '../layouts/Layout.astro';
import { getUMKMForVerification } from '../lib/db';
import { resolveUser } from '../lib/neon-auth';

const user = await resolveUser(Astro.request);

// Hanya pengurus MWC (users.role = 'pengurus') yang boleh membuka halaman ini;
// selain itu diarahkan ke dashboard untuk login terlebih dahulu.
if (!user || user.role !== 'pengurus') {
  return Astro.redirect('/dashboard');
}

const stores = await getUMKMForVerification();
const pending = stores.filter((s) => !s.is_verified);
const verified = stores.filter((s) => s.is_verified);

function formatDate(iso: string): string {
  return new Date(iso).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' });
}
---

<Layout title="Verifikasi Toko Pengurus MWC | Pasar Warga NU Sumenep">
  <div class="max-w-5xl mx-auto space-y-6 py-4 sm:py-8 px-3 sm:px-6 lg:px-8">

    <!-- Page Header -->
    <div class="flex items-center justify-between pb-3 border-b border-slate-200">
      <div>
        <h1 class="text-xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Verifikasi Toko UMKM
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
          Periksa keanggotaan jamaah sebelum mengesahkan badge Verified, Pengurus MWC {user.name}.
        </p>
      </div>

      <a
        href="/dashboard"
        class="hidden sm:inline-flex text-xs font-semibold text-slate-500 hover:text-slate-900 transition items-center gap-1.5"
      >
        <span>← Ke Dashboard</span>
      </a>
    </div>

    <div id="status-box" class="hidden p-4 rounded-xl text-xs font-semibold"></div>

    <!-- Section 1: Menunggu Verifikasi -->
    <section class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-sm sm:text-base font-black text-slate-900">
          Menunggu Verifikasi
          <span class={`ml-1.5 px-2 py-0.5 rounded text-[10px] font-bold ${pending.length ? 'bg-amber-100 text-amber-800 border border-amber-300' : 'bg-slate-100 text-slate-500 border border-slate-200'}`}>
            {pending.length} toko
          </span>
        </h2>
      </div>

      {pending.length === 0 ? (
        <div class="bg-white border border-slate-200 rounded-xl p-6 text-center shadow-2xs">
          <p class="text-xs sm:text-sm text-slate-500">
            Alhamdulillah, tidak ada toko yang menunggu verifikasi saat ini.
          </p>
        </div>
      ) : (
        <div class="space-y-3">
          {pending.map((store) => (
            <article class="bg-white border border-amber-300 rounded-xl p-4 sm:p-5 shadow-2xs">
              <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-4">
                <div class="space-y-1.5 min-w-0">
                  <div class="flex items-center gap-2 flex-wrap">
                    <h3 class="text-sm font-black text-slate-900">{store.name}</h3>
                    <span class="text-[10px] font-bold uppercase tracking-wide bg-slate-100 text-slate-600 border border-slate-200 px-2 py-0.5 rounded">
                      {store.zone_name}
                    </span>
                  </div>
                  <p class="text-xs text-slate-600">
                    {store.product_count} produk · terdaftar {formatDate(store.created_at)}
                  </p>
                  <p class="text-xs text-slate-500">
                    {store.owner_email
                      ? `Dikelola akun: ${store.owner_email}`
                      : 'Hasil pendataan petugas /agen — belum berpemilik akun'}
                  </p>
                  {store.address && (
                    <p class="text-xs text-slate-500">{store.address}</p>
                  )}
                </div>

                <div class="flex flex-col gap-2 shrink-0">
                  <a
                    href={`https://wa.me/${store.phone}?text=${encodeURIComponent(`Assalamu'alaikum, saya pengurus MWC NU ${store.zone_name}. Mohon konfirmasi kepemilikan toko "${store.name}" di Pasar Warga NU.`)}`}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-center py-2 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-lg border border-slate-300 transition cursor-pointer"
                  >
                    Cek via WhatsApp
                  </a>
                  <a
                    href={`/toko/${store.id}`}
                    class="text-center py-2 px-4 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs rounded-lg border border-slate-300 transition cursor-pointer"
                  >
                    Lihat Toko
                  </a>
                </div>
              </div>

              <div class="flex flex-col sm:flex-row gap-2 pt-3 mt-3 border-t border-slate-100">
                <button
                  type="button"
                  data-verify
                  data-umkm-id={store.id}
                  data-verified="1"
                  class="flex-1 py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-black text-xs rounded-lg transition shadow-2xs cursor-pointer"
                >
                  ✓ Verifikasi Toko
                </button>
                <button
                  type="button"
                  data-delete
                  data-umkm-id={store.id}
                  data-umkm-name={store.name}
                  class="flex-1 py-2.5 px-4 bg-white hover:bg-rose-50 text-rose-700 font-bold text-xs rounded-lg border border-rose-300 transition cursor-pointer"
                >
                  Hapus Toko
                </button>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>

    <!-- Section 2: Toko Terverifikasi -->
    {verified.length > 0 && (
      <section class="space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm sm:text-base font-black text-slate-900">
            Toko Terverifikasi
            <span class="ml-1.5 px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800 border border-emerald-300">
              {verified.length} toko
            </span>
          </h2>
        </div>

        <div class="bg-white border border-slate-200 rounded-xl divide-y divide-slate-100 shadow-2xs">
          {verified.map((store) => (
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 p-3.5 sm:p-4">
              <div class="min-w-0">
                <div class="flex items-center gap-2 flex-wrap">
                  <a href={`/toko/${store.id}`} class="text-xs font-bold text-slate-900 hover:text-emerald-700 transition">
                    {store.name}
                  </a>
                  <span class="text-[10px] font-bold uppercase tracking-wide bg-slate-100 text-slate-600 border border-slate-200 px-1.5 py-0.5 rounded">
                    {store.zone_name}
                  </span>
                </div>
                <p class="text-[11px] text-slate-500 mt-0.5">
                  {store.product_count} produk
                  {store.owner_email ? ` · ${store.owner_email}` : ' · hasil pendataan /agen'}
                </p>
              </div>

              <div class="flex gap-2 shrink-0">
                <button
                  type="button"
                  data-verify
                  data-umkm-id={store.id}
                  data-verified="0"
                  class="py-1.5 px-3 bg-white hover:bg-amber-50 text-amber-700 font-bold text-[11px] rounded-lg border border-amber-300 transition cursor-pointer"
                >
                  Cabut Verifikasi
                </button>
                <button
                  type="button"
                  data-delete
                  data-umkm-id={store.id}
                  data-umkm-name={store.name}
                  class="py-1.5 px-3 bg-white hover:bg-rose-50 text-rose-700 font-bold text-[11px] rounded-lg border border-rose-300 transition cursor-pointer"
                >
                  Hapus
                </button>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    <p class="text-[10px] text-slate-400">
      Verifikasi mengesahkan badge Verified di katalog publik. Menghapus toko berarti menghapus seluruh produknya — akun pemiliknya tetap utuh.
    </p>

    <a
      href="/kegiatan"
      class="block text-center text-xs font-bold text-emerald-700 hover:text-emerald-800 hover:underline transition"
    >
      Kelola publikasi agenda kegiatan NU ➔
    </a>
  </div>
</Layout>

<script>
  const statusBox = document.getElementById('status-box');

  function showStatus(ok: boolean, message: string) {
    if (!statusBox) return;
    statusBox.className = `p-4 rounded-xl text-xs font-bold ${ok
      ? 'bg-emerald-50 text-emerald-800 border border-emerald-200'
      : 'bg-rose-50 text-rose-800 border border-rose-200'}`;
    statusBox.textContent = message;
    statusBox.classList.remove('hidden');
    statusBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }

  async function postAction(url: string, fields: Record<string, string>): Promise<{ ok: boolean; message: string }> {
    try {
      const body = new FormData();
      for (const [key, value] of Object.entries(fields)) body.set(key, value);
      const res = await fetch(url, { method: 'POST', body });
      const data = await res.json();
      return { ok: res.ok && data.success, message: data.message || 'Terjadi kesalahan.' };
    } catch (err: any) {
      return { ok: false, message: 'Gagal menghubungi server: ' + err.message };
    }
  }

  function refreshSoon() {
    setTimeout(() => window.location.reload(), 900);
  }

  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;

    const verifyBtn = target.closest<HTMLButtonElement>('[data-verify]');
    if (verifyBtn) {
      verifyBtn.disabled = true;
      // Kirim status target (bukan flip) agar klik ganda tidak membalik hasil.
      const result = await postAction('/api/umkm/verify', {
        umkmId: verifyBtn.dataset.umkmId || '',
        verified: verifyBtn.dataset.verified === '1' ? '1' : '0',
      });
      if (result.ok) {
        showStatus(true, result.message);
        refreshSoon();
      } else {
        showStatus(false, result.message);
        verifyBtn.disabled = false;
      }
      return;
    }

    const deleteBtn = target.closest<HTMLButtonElement>('[data-delete]');
    if (deleteBtn) {
      const umkmName = deleteBtn.dataset.umkmName || '';
      if (!confirm(`Hapus toko "${umkmName}" beserta SELURUH produknya dari Pasar Warga NU? Tindakan ini tidak dapat dibatalkan.`)) return;

      deleteBtn.disabled = true;
      const result = await postAction('/api/umkm/delete', { umkmId: deleteBtn.dataset.umkmId || '' });
      if (result.ok) {
        showStatus(true, result.message);
        refreshSoon();
      } else {
        showStatus(false, result.message);
        deleteBtn.disabled = false;
      }
    }
  });
</script>
