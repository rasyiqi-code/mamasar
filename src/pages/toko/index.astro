---
import Layout from '../../layouts/Layout.astro';
import AppIcon from '../../components/common/AppIcon.astro';
import EmptyState from '../../components/common/EmptyState.astro';
import { getAllZones, getAllUMKM } from '../../lib/db';
import { formatPhoneForWhatsApp } from '../../lib/utils';

const currentZone = Astro.url.searchParams.get('zona') || 'semua';
const searchQuery = Astro.url.searchParams.get('q') || '';

const zones = await getAllZones();
const stores = await getAllUMKM({
  zoneSlug: currentZone,
  search: searchQuery,
});

const totalStores = stores.length;
const activeZone = zones.find((z) => z.slug === currentZone);
---

<Layout
  title="Direktori Toko UMKM Warga NU | Mamasar Sumenep"
  description="Daftar toko, produsen, dan pengrajin UMKM Nahdliyin terverifikasi se-Kabupaten Sumenep. Belanja langsung tanpa perantara."
>
  <div class="pb-10">
    <!-- Full-Bleed Top Header & Filter Strip (Hairline Architectural Grid) -->
    <section class="w-screen relative left-1/2 -translate-x-1/2 bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-4">
        <div class="flex items-center justify-between text-xs text-slate-600">
          <nav aria-label="Breadcrumb" class="flex items-center gap-2 truncate">
            <a href="/" class="hover:text-emerald-700 transition">Beranda</a>
            <span aria-hidden="true">›</span>
            <span class="text-slate-900 font-bold">Direktori Toko</span>
            {activeZone && (
              <>
                <span aria-hidden="true">›</span>
                <span class="text-emerald-700 font-bold truncate">{activeZone.name}</span>
              </>
            )}
          </nav>

          <a
            href="/dashboard"
            class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 hover:text-emerald-800 transition shrink-0"
          >
            <AppIcon name="plus" size="xs" />
            <span>Daftarkan Toko</span>
          </a>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
          <div class="space-y-1">
            <h1 class="text-xl sm:text-3xl font-black text-slate-900 tracking-tight">
              Toko Warga NU
            </h1>
            <p class="text-xs sm:text-sm text-slate-600">
              Sentra produksi dan pengrajin UMKM Sumenep terhubung langsung via WhatsApp.
            </p>
          </div>
          <span class="text-xs font-bold text-slate-700 tabular-nums shrink-0">
            {totalStores} toko terdaftar
          </span>
        </div>

        <form method="GET" action="/toko" class="space-y-3 pt-1">
          <div class="flex flex-col sm:flex-row gap-2">
            <div class="relative flex-1">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-500">
                <AppIcon name="search" size="sm" />
              </span>
              <input
                type="text"
                name="q"
                value={searchQuery}
                aria-label="Cari nama toko atau wilayah"
                placeholder="Cari nama toko, desa, atau produk..."
                class="w-full min-h-[44px] pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-300 rounded-lg text-xs sm:text-sm text-slate-900 placeholder-slate-500 focus:border-emerald-700 focus:bg-white focus:outline-none transition"
              />
            </div>

            <div class="flex items-center gap-2">
              <select
                name="zona"
                aria-label="Filter wilayah MWC"
                class="flex-1 sm:w-52 min-h-[44px] py-2.5 px-3 bg-slate-50 border border-slate-300 rounded-lg text-xs sm:text-sm font-semibold text-slate-800 focus:border-emerald-700 focus:bg-white cursor-pointer"
              >
                <option value="semua">Semua Wilayah MWC</option>
                {zones.map((z) => (
                  <option value={z.slug} selected={currentZone === z.slug}>
                    {z.name}
                  </option>
                ))}
              </select>

              <button
                type="submit"
                class="min-h-[44px] px-5 bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] text-white font-bold text-xs sm:text-sm rounded-lg transition cursor-pointer shrink-0"
              >
                Cari
              </button>
            </div>
          </div>

          <!-- Horizontal Snap Zone Chips -->
          <div
            class="pt-2 border-t border-slate-200 flex items-center gap-1.5 overflow-x-auto snap-x snap-mandatory pb-1 no-scrollbar text-xs"
            style="mask-image: linear-gradient(to right, black 92%, transparent 100%);"
          >
            <span class="text-xs font-bold text-slate-600 shrink-0 pr-1">MWC:</span>
            <a
              href={`/toko?zona=semua&q=${encodeURIComponent(searchQuery)}`}
              class={`snap-start px-3 py-1.5 rounded-full whitespace-nowrap font-semibold transition shrink-0 ${
                currentZone === 'semua'
                  ? 'bg-emerald-700 text-white'
                  : 'bg-slate-100 hover:bg-slate-200 text-slate-700'
              }`}
            >
              Semua
            </a>
            {zones.map((z) => (
              <a
                href={`/toko?zona=${z.slug}&q=${encodeURIComponent(searchQuery)}`}
                class={`snap-start px-3 py-1.5 rounded-full whitespace-nowrap font-semibold transition shrink-0 ${
                  currentZone === z.slug
                    ? 'bg-emerald-700 text-white'
                    : 'bg-slate-100 hover:bg-slate-200 text-slate-700'
                }`}
              >
                {z.name}
              </a>
            ))}
          </div>
        </form>
      </div>
    </section>

    <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8 pt-6 space-y-4">
      {(activeZone || searchQuery) && (
        <div class="flex items-center justify-between gap-3 pb-2 border-b border-slate-200 text-xs">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="font-bold text-slate-900">Filter aktif:</span>
            {activeZone && (
              <span class="bg-emerald-50 text-emerald-800 font-semibold px-2.5 py-0.5 rounded-md border border-emerald-200">
                {activeZone.name}
              </span>
            )}
            {searchQuery && (
              <span class="bg-slate-100 text-slate-800 font-mono px-2.5 py-0.5 rounded-md border border-slate-200">
                "{searchQuery}"
              </span>
            )}
          </div>
          <a
            href="/toko"
            class="inline-flex items-center gap-1 text-xs font-bold text-rose-700 hover:underline shrink-0"
          >
            <AppIcon name="x" size="xs" />
            <span>Reset</span>
          </a>
        </div>
      )}

      {stores.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {stores.map((store) => {
            const initials =
              store.name
                .trim()
                .split(/\s+/)
                .slice(0, 2)
                .map((w) => w[0]?.toUpperCase() || '')
                .join('')
                .slice(0, 2) || 'NU';
            const waLink = `https://wa.me/${formatPhoneForWhatsApp(store.phone)}?text=${encodeURIComponent(
              `Assalamu'alaikum ${store.name}, saya menemukan toko Anda di Mamasar Sumenep. Saya tertarik dengan produk Anda.`
            )}`;

            return (
              <article class="bg-white border-y sm:border border-slate-200 sm:rounded-lg hover:border-emerald-400 transition p-4 sm:p-5 flex flex-col justify-between gap-4 -mx-3 sm:mx-0">
                <div class="space-y-3">
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex items-start gap-3 min-w-0">
                      <a href={`/toko/${store.slug || store.id}`} class="relative shrink-0 block group">
                        <div class="w-12 h-12 rounded-lg bg-emerald-800 text-white flex items-center justify-center font-black text-base group-hover:bg-emerald-900 transition">
                          {initials}
                        </div>
                        {Boolean(store.is_verified) && (
                          <span
                            class="absolute -bottom-1 -right-1 bg-emerald-700 text-white w-5 h-5 rounded-full border-2 border-white flex items-center justify-center"
                            title="Terverifikasi MWC NU"
                          >
                            <AppIcon name="check" size="xs" />
                          </span>
                        )}
                      </a>

                      <div class="space-y-0.5 min-w-0">
                        <a
                          href={`/toko/${store.slug || store.id}`}
                          class="font-extrabold text-sm sm:text-base text-slate-900 hover:text-emerald-700 transition truncate block leading-snug"
                          title={store.name}
                        >
                          {store.name}
                        </a>
                        <div class="text-xs text-slate-600 truncate flex items-center gap-1">
                          <AppIcon name="map-pin" size="xs" class="text-emerald-700 shrink-0" />
                          <span class="truncate">{store.zone_name}</span>
                        </div>
                        <div class="text-xs text-slate-600 tabular-nums font-medium">
                          {store.product_count} produk aktif
                        </div>
                      </div>
                    </div>

                    {Boolean(store.is_verified) && (
                      <span
                        class="shrink-0 inline-flex items-center gap-1 text-xs font-bold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-md"
                        title="Terverifikasi MWC NU"
                      >
                        <AppIcon name="check" size="xs" />
                        <span class="hidden sm:inline">Terverifikasi</span>
                      </span>
                    )}
                  </div>

                  <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed pt-2 border-t border-slate-100">
                    {store.address || 'Kabupaten Sumenep, Madura'}
                  </p>

                  {store.sample_images.length > 0 && (
                    <div class="flex items-center gap-2 overflow-hidden pt-1">
                      {store.sample_images.slice(0, 3).map((imgUrl, idx) => (
                        <div class="w-16 h-16 rounded-md overflow-hidden border border-slate-200 bg-slate-100 shrink-0">
                          <img
                            src={imgUrl}
                            alt={`Produk ${idx + 1} ${store.name}`}
                            loading="lazy"
                            class="w-full h-full object-cover"
                          />
                        </div>
                      ))}
                      {store.product_count > 3 && (
                        <a
                          href={`/toko/${store.slug || store.id}`}
                          class="w-16 h-16 rounded-md border border-dashed border-slate-300 bg-slate-50 hover:bg-slate-100 flex flex-col items-center justify-center text-center p-1 text-slate-700 shrink-0 transition"
                        >
                          <span class="font-bold text-xs font-mono">+{store.product_count - 3}</span>
                          <span class="text-xs leading-tight">lain</span>
                        </a>
                      )}
                    </div>
                  )}
                </div>

                <div class="pt-3 border-t border-slate-200 flex items-center gap-2">
                  <a
                    href={`/toko/${store.slug || store.id}`}
                    class="flex-1 min-h-[44px] px-3 bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 text-xs font-bold rounded-lg inline-flex items-center justify-center gap-1 transition"
                  >
                    <span>Etalase</span>
                    <AppIcon name="arrow-right" size="xs" />
                  </a>

                  <a
                    href={waLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Hubungi WhatsApp Toko ${store.name}`}
                    class="min-h-[44px] px-4 bg-emerald-700 hover:bg-emerald-800 active:scale-[0.98] text-white text-xs font-bold rounded-lg transition inline-flex items-center justify-center gap-1.5 shrink-0"
                  >
                    <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z" />
                    </svg>
                    <span>WhatsApp</span>
                  </a>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <EmptyState
          icon="store"
          title="Tidak Ada Toko yang Cocok"
          description="Coba ubah kata pencarian atau pilih wilayah MWC NU lainnya."
          actionHref="/toko"
          actionLabel="Semua Toko"
        />
      )}
    </div>
  </div>
</Layout>
