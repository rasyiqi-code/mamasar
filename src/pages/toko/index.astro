---
import Layout from '../../layouts/Layout.astro';
import { getAllZones, getAllUMKM } from '../../lib/db';
import { formatPhoneForWhatsApp } from '../../lib/utils';

// Read query params for filtering
const currentZone = Astro.url.searchParams.get('zona') || 'semua';
const searchQuery = Astro.url.searchParams.get('q') || '';

const zones = await getAllZones();
const stores = await getAllUMKM({
  zoneSlug: currentZone,
  search: searchQuery,
});

const totalStores = stores.length;
const activeZone = zones.find((z) => z.slug === currentZone);
---

<Layout
  title="Direktori Toko UMKM Warga NU | Pasar Warga NU Sumenep"
  description="Daftar toko, produsen, dan pengrajin UMKM Nahdliyin terverifikasi se-Kabupaten Sumenep. Belanja langsung tanpa perantara."
>
  <div class="max-w-7xl mx-auto space-y-6 py-4 sm:py-8 px-3 sm:px-6 lg:px-8">
    
    <!-- Top Breadcrumb -->
    <div class="flex items-center justify-between text-xs text-slate-500 pb-2 border-b border-slate-200">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2">
        <a href="/" class="hover:text-emerald-700">Beranda</a>
        <span>›</span>
        <span class="text-slate-900 font-bold">Direktori Toko Warga NU</span>
        {activeZone && (
          <>
            <span>›</span>
            <span class="text-emerald-700 font-bold">{activeZone.name}</span>
          </>
        )}
      </nav>

      <a
        href="/dashboard"
        class="hidden sm:inline-flex text-xs font-semibold text-indigo-600 hover:text-indigo-800 transition items-center gap-1"
      >
        <span>+ Daftarkan Toko Anda</span>
      </a>
    </div>

    <!-- Hero Header & Search Section -->
    <div class="bg-white border-y sm:border border-slate-200 sm:rounded-2xl p-4 sm:p-8 shadow-xs space-y-5">
      <div class="max-w-3xl space-y-2">
        <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-emerald-50 text-emerald-800 border border-emerald-200 text-xs font-bold">
          <span>🏪</span>
          <span>Ekosistem Ekonomi Nahdliyin</span>
        </div>
        <h1 class="text-xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Direktori Toko UMKM Warga NU Sumenep
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Temukan sentra produksi, pengrajin lokal, dan pedagang terpercaya warga NU dari seluruh MWC Kecamatan di Kabupaten Sumenep. Transaksi langsung via WhatsApp tanpa perantara dan 0% potongan biaya.
        </p>
      </div>

      <!-- Search & Filter Bar -->
      <form method="GET" action="/toko" class="space-y-4 pt-2">
        <div class="flex flex-col sm:flex-row gap-2.5">
          <div class="relative flex-1">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400 text-sm">
              🔍
            </span>
            <input
              type="text"
              name="q"
              value={searchQuery}
              placeholder="Cari nama toko, dusun/desa, atau produk..."
              class="w-full pl-10 pr-4 py-2.5 sm:py-3 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm text-slate-900 placeholder-slate-400 focus:outline-none focus:border-indigo-600 focus:bg-white transition"
            />
          </div>

          <div class="flex items-center gap-2">
            <select
              name="zona"
              class="flex-1 sm:w-56 py-2.5 sm:py-3 px-3.5 bg-slate-50 border border-slate-300 rounded-xl text-xs sm:text-sm font-semibold text-slate-800 focus:outline-none focus:border-indigo-600 focus:bg-white cursor-pointer"
            >
              <option value="semua">Semua Wilayah MWC</option>
              {zones.map((z) => (
                <option value={z.slug} selected={currentZone === z.slug}>
                  {z.name}
                </option>
              ))}
            </select>

            <button
              type="submit"
              class="py-2.5 sm:py-3 px-5 sm:px-6 bg-[#4f46e5] hover:bg-[#4338ca] active:bg-[#3730a3] text-white font-black text-xs sm:text-sm rounded-xl transition shadow-xs cursor-pointer shrink-0"
            >
              Cari
            </button>
          </div>
        </div>

        <!-- MWC Quick Filter Horizontal Pills -->
        <div class="pt-2 border-t border-slate-100 flex items-center gap-1.5 overflow-x-auto pb-1 no-scrollbar text-xs">
          <span class="text-[11px] font-bold text-slate-500 uppercase tracking-wider shrink-0 pr-1">
            MWC:
          </span>
          <a
            href={`/toko?zona=semua&q=${searchQuery}`}
            class={`px-3 py-1.5 rounded-full whitespace-nowrap font-semibold transition shrink-0 text-xs ${
              currentZone === 'semua'
                ? 'bg-emerald-700 text-white shadow-xs'
                : 'bg-slate-100 hover:bg-slate-200 text-slate-700'
            }`}
          >
            Semua Wilayah
          </a>
          {zones.map((z) => (
            <a
              href={`/toko?zona=${z.slug}&q=${searchQuery}`}
              class={`px-3 py-1.5 rounded-full whitespace-nowrap font-semibold transition shrink-0 text-xs ${
                currentZone === z.slug
                  ? 'bg-emerald-700 text-white shadow-xs'
                  : 'bg-slate-100 hover:bg-slate-200 text-slate-700'
              }`}
            >
              {z.name}
            </a>
          ))}
        </div>
      </form>
    </div>

    <!-- Active Filter Status & Store Count Bar -->
    <div class="flex items-center justify-between text-xs px-3 sm:px-1">
      <div class="flex items-center gap-2">
        <span class="font-extrabold text-slate-900 text-sm">
          {totalStores} Toko Warga Ditemukan
        </span>
        {activeZone && (
          <span class="text-xs bg-indigo-50 text-indigo-700 font-semibold px-2 py-0.5 rounded border border-indigo-200">
            di {activeZone.name}
          </span>
        )}
      </div>

      {(currentZone !== 'semua' || searchQuery) && (
        <a
          href="/toko"
          class="text-xs font-semibold text-rose-600 hover:underline flex items-center gap-1 cursor-pointer"
        >
          <span>✕</span>
          <span>Reset Filter</span>
        </a>
      )}
    </div>

    <!-- Store Cards Grid -->
    {stores.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {stores.map((store) => {
          const initials = store.name.slice(0, 2).toUpperCase();
          const waLink = `https://wa.me/${formatPhoneForWhatsApp(store.phone)}?text=${encodeURIComponent(
            `Assalamu'alaikum ${store.name}, saya menemukan toko Anda di Pasar Warga NU Sumenep. Saya tertarik dengan produk Anda.`
          )}`;

          return (
            <div class="bg-white border-y sm:border border-slate-200 sm:rounded-2xl shadow-xs hover:shadow-md hover:border-slate-300 transition duration-200 p-4 sm:p-5 flex flex-col justify-between space-y-4">
              
              <!-- Store Header Info -->
              <div class="space-y-3">
                <div class="flex items-start justify-between gap-3">
                  <div class="flex items-start gap-3 min-w-0">
                    <a href={`/toko/${store.id}`} class="relative shrink-0 block group">
                      <div class="w-13 h-13 rounded-2xl bg-emerald-50 text-emerald-800 border-2 border-emerald-400 flex items-center justify-center font-black text-lg shadow-inner group-hover:bg-emerald-100 transition">
                        {initials}
                      </div>
                      {Boolean(store.is_verified) && (
                        <span class="absolute -top-1 -right-1 bg-emerald-600 text-white text-[9px] font-black w-5 h-5 rounded-full flex items-center justify-center shadow-xs" title="Terverifikasi MWC NU">
                          ✓
                        </span>
                      )}
                    </a>

                    <div class="space-y-0.5 min-w-0">
                      <a
                        href={`/toko/${store.id}`}
                        class="font-extrabold text-sm sm:text-base text-slate-900 hover:text-emerald-700 transition truncate block leading-snug"
                        title={store.name}
                      >
                        {store.name}
                      </a>
                      <div class="text-[11px] text-slate-500 truncate flex items-center gap-1">
                        <span>📍</span>
                        <span class="font-medium truncate">{store.zone_name}</span>
                      </div>
                      <div class="flex items-center gap-1 text-amber-500 text-xs pt-0.5">
                        <span>★★★★★</span>
                        <span class="text-slate-600 text-[10px] font-bold">5.0 (Warga NU)</span>
                      </div>
                    </div>
                  </div>

                  <!-- Verified Shield -->
                  {Boolean(store.is_verified) && (
                    <span
                      class="shrink-0 inline-flex items-center gap-1 text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-md"
                      title="Verified"
                    >
                      <span>✓</span>
                      <span class="hidden sm:inline">Verified</span>
                    </span>
                  )}
                </div>

                <!-- Store Address Details -->
                <div class="bg-slate-50 rounded-xl p-2.5 text-xs text-slate-600 border border-slate-100 space-y-1">
                  <div class="flex items-start gap-1.5 text-[11px] leading-relaxed">
                    <span class="text-slate-400 shrink-0">🏠</span>
                    <span class="line-clamp-2">{store.address || 'Kabupaten Sumenep, Madura'}</span>
                  </div>
                  <div class="flex items-center justify-between text-[11px] pt-1 border-t border-slate-200/60 text-slate-500 font-medium">
                    <span>Etalase Iklan:</span>
                    <strong class="text-slate-900 font-bold">{store.product_count} Produk Aktif</strong>
                  </div>
                </div>

                <!-- Sample Product Images Row -->
                {store.sample_images.length > 0 && (
                  <div class="space-y-1.5 pt-1">
                    <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider block">
                      Produk Toko Ini:
                    </span>
                    <div class="flex items-center gap-2 overflow-hidden">
                      {store.sample_images.slice(0, 3).map((imgUrl, idx) => (
                        <div class="w-16 h-16 sm:w-18 sm:h-18 rounded-lg overflow-hidden border border-slate-200 bg-slate-100 shrink-0">
                          <img
                            src={imgUrl}
                            alt={`Produk ${idx + 1}`}
                            loading="lazy"
                            class="w-full h-full object-cover hover:scale-105 transition duration-200"
                          />
                        </div>
                      ))}
                      {store.product_count > 3 && (
                        <a
                          href={`/toko/${store.id}`}
                          class="w-16 h-16 sm:w-18 sm:h-18 rounded-lg border border-dashed border-slate-300 bg-slate-50 hover:bg-slate-100 flex flex-col items-center justify-center text-center p-1 text-slate-500 shrink-0 transition"
                        >
                          <span class="font-black text-xs text-slate-700">+{store.product_count - 3}</span>
                          <span class="text-[9px] leading-tight">Lainnya</span>
                        </a>
                      )}
                    </div>
                  </div>
                )}
              </div>

              <!-- Store Action Buttons -->
              <div class="pt-3 border-t border-slate-100 flex items-center gap-2">
                <a
                  href={`/toko/${store.id}`}
                  class="flex-1 py-2 px-3 bg-white hover:bg-slate-50 active:bg-slate-100 border border-slate-300 text-slate-800 text-xs font-bold rounded-xl text-center shadow-2xs transition cursor-pointer"
                >
                  Kunjungi Toko →
                </a>

                <a
                  href={waLink}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Hubungi WhatsApp Toko ${store.name}`}
                  class="py-2 px-3.5 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white text-xs font-bold rounded-xl transition shadow-xs flex items-center justify-center gap-1.5 shrink-0 cursor-pointer active:scale-98"
                >
                  <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
                  </svg>
                  <span>Chat WA</span>
                </a>
              </div>

            </div>
          );
        })}
      </div>
    ) : (
      <div class="bg-white border-y sm:border border-slate-200 sm:rounded-2xl p-8 sm:p-12 text-center space-y-4 shadow-xs">
        <div class="w-16 h-16 mx-auto rounded-full bg-slate-100 flex items-center justify-center text-3xl">
          🏪
        </div>
        <div class="space-y-1">
          <h3 class="text-base sm:text-lg font-bold text-slate-800">
            Tidak ada toko warga yang cocok
          </h3>
          <p class="text-xs sm:text-sm text-slate-500 max-w-md mx-auto">
            Tidak ditemukan toko UMKM dengan kata kunci atau filter wilayah yang dipilih. Coba ganti kata pencarian atau pilih wilayah MWC lain.
          </p>
        </div>
        <a
          href="/toko"
          class="inline-block px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-xs font-bold transition shadow-xs cursor-pointer"
        >
          Lihat Semua Toko Warga
        </a>
      </div>
    )}

  </div>
</Layout>
