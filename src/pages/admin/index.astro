---
import AppLayout from '../../layouts/AppLayout.astro';
import { resolveUser } from '../../lib/neon-auth';
import {
  isSuperadmin,
  isPetugas,
  getPendingPetugas,
  getAllUsersForAdmin,
  getUMKMForVerification,
  getAllZones,
  getEvents,
  getAllPendingAdOrders,
} from '../../lib/db';

import AdminSidebar from '../../components/admin/AdminSidebar.astro';
import AgentsPanel from '../../components/admin/AgentsPanel.astro';
import StoresPanel from '../../components/admin/StoresPanel.astro';
import EntryPanel from '../../components/admin/EntryPanel.astro';
import EventsPanel from '../../components/admin/EventsPanel.astro';
import ZonesPanel from '../../components/admin/ZonesPanel.astro';
import PromotionsPanel from '../../components/admin/PromotionsPanel.astro';

const user = await resolveUser(Astro.request);
const isSuper = !!user && isSuperadmin(user);
const isCadre = !!user && isPetugas(user);

// Proteksi akses: Khusus semua role selain warga (superadmin, pengurus, atau petugas aktif)
if (!user || (!isSuper && !isCadre)) {
  return Astro.redirect('/dashboard?error=unauthorized_admin');
}

const zones = await getAllZones();
const assignedZone = zones.find((z) => z.id === user.assigned_zone_id);

const pendingPetugas = isSuper ? await getPendingPetugas() : [];
const allUsers = isSuper ? await getAllUsersForAdmin() : [];
const allStores = await getUMKMForVerification();

// Jika petugas/pengurus MWC, batasi daftar toko ke MWC penugasannya
const stores = isSuper
  ? allStores
  : (user.assigned_zone_id ? allStores.filter((s) => s.zone_id === user.assigned_zone_id) : allStores);

const events = isSuper
  ? await getEvents()
  : await getEvents({ zoneSlug: assignedZone?.slug });

const pendingStores = stores.filter((s) => !s.is_verified);
const verifiedStores = stores.filter((s) => s.is_verified);
const pendingPromotions = await getAllPendingAdOrders();
const portalHeading = isSuper
  ? 'Pusat Kendali Admin PCNU Sumenep'
  : user.role === 'mwcnu'
    ? `Portal Pengurus MWC ${assignedZone?.name || 'Sumenep'}`
    : `Portal Kader MWC ${assignedZone?.name || 'Sumenep'}`;
---

<AppLayout
  title={`${portalHeading} | Mamasar`}
  description="Panel kendali operasional terpadu PCNU untuk manajemen akun & peran, persetujuan kader MWC, moderasi toko, dan pendataan UMKM jemput bola."
>
  <div class="min-h-screen bg-white flex flex-col md:flex-row">
    <!-- Sidebar Navigasi Admin / Pengurus / Petugas -->
    <AdminSidebar
      user={user}
      isSuper={isSuper}
      userRole={user.role}
      assignedZoneName={assignedZone?.name}
      pendingPetugasCount={pendingPetugas.length}
      pendingStoresCount={pendingStores.length}
      zonesCount={zones.length}
      pendingPromotionsCount={pendingPromotions.length}
    />

    <!-- Workspace Utama Admin / Petugas (Fullwidth & Compact) -->
    <main class="flex-1 min-w-0 overflow-y-auto p-4 sm:p-6 w-full space-y-6">
      <h1 class="sr-only">{portalHeading}</h1>

      <!-- Status Box Fallback -->
      <div id="admin-status-box" role="status" aria-live="polite" class="hidden mb-4 p-2.5 rounded-lg text-xs font-semibold"></div>

      <!-- Tab: Manajemen Akun, Peran & Persetujuan Kader/MWC (Khusus Superadmin) -->
      {isSuper && <AgentsPanel pendingPetugas={pendingPetugas} allUsers={allUsers} zones={zones} />}

      <!-- Tab: Kurasi & Moderasi Toko Warga -->
      <StoresPanel pendingStores={pendingStores} verifiedStores={verifiedStores} />

      <!-- Tab: Pendataan Jemput Bola (Formulir Kamera & Entri Lapangan 2-Step) -->
      <EntryPanel user={user} assignedZone={assignedZone} zones={zones} stores={stores} isDefaultActive={!isSuper} />

      <!-- Tab: Agenda Kegiatan NU & Pasar Konsumsi -->
      <EventsPanel events={events} zones={zones} />

      <!-- Tab: Moderasi Iklan & Promosi Berbayar -->
      <PromotionsPanel pendingPromotions={pendingPromotions} />

      <!-- Tab: Sebaran Wilayah 27 MWC NU Sumenep (Peta Sebaran Maps) -->
      <ZonesPanel zones={zones} allStores={allStores} />
    </main>
  </div>

  <style is:global>
    .admin-nav-tab {
      color: #64748b;
      transition: all 0.15s ease;
    }
    .admin-nav-tab:hover {
      background-color: #f8fafc;
      color: #0f172a;
    }
    .admin-nav-tab.active {
      background-color: #f1f5f9;
      color: #0f172a;
      font-weight: 600;
    }
    .admin-nav-tab.active span[class*="text-[10px]"] {
      background-color: #e2e8f0;
      color: #0f172a;
      border-color: transparent;
    }
  </style>

  <script src="../../scripts/admin.client.ts"></script>
</AppLayout>
