---
import Layout from '../layouts/Layout.astro';
import { getProducts } from '../lib/db';
import { DEFAULT_PRODUCT_IMAGE } from '../lib/constants';

const catalog = await getProducts();

// Slim projection: only fields the client needs, keeps page payload small.
const allProducts = catalog.map((p) => ({
  id: p.id,
  slug: p.slug,
  name: p.name,
  price: p.price,
  image_url: p.image_url || DEFAULT_PRODUCT_IMAGE,
  zone_name: p.zone_name,
  umkm_name: p.umkm_name,
  umkm_phone: p.umkm_phone,
}));
---

<Layout
  title="Iklan Produk Favorit Tersimpan | Pasar Warga NU Sumenep"
  description="Daftar produk UMKM Nahdliyin yang Anda simpan untuk dibeli atau dihubungi via WhatsApp."
>
  <div class="max-w-7xl mx-auto space-y-6 py-4 sm:py-8 px-3 sm:px-6 lg:px-8">
    
    <!-- Top Breadcrumb -->
    <div class="flex items-center justify-between text-xs text-slate-500 pb-2 border-b border-slate-200">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2">
        <a href="/" class="hover:text-emerald-700">Beranda</a>
        <span>›</span>
        <span class="text-slate-900 font-bold">Produk Favorit Tersimpan</span>
      </nav>

      <a
        href="/"
        class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition flex items-center gap-1"
      >
        <span>← Kembali ke Katalog</span>
      </a>
    </div>

    <!-- Header -->
    <div class="bg-white border-y sm:border border-slate-200 sm:rounded-2xl p-5 sm:p-6 shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
      <div class="space-y-1">
        <h1 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight flex items-center gap-2">
          <span>⭐</span> Produk yang Anda Simpan
        </h1>
        <p class="text-xs text-slate-500">
          Produk yang Anda tandai bintang di HP ini agar mudah dicek kembali sebelum menghubungi penjual via WhatsApp.
        </p>
      </div>

      <button
        id="btn-clear-favorites"
        type="button"
        class="text-xs text-rose-600 hover:text-rose-800 font-bold underline cursor-pointer"
      >
        Hapus Semua Simpanan
      </button>
    </div>

    <!-- Container Rendered Client-Side based on localStorage -->
    <div id="favorites-container" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 sm:gap-4">
      <!-- Injected by client script below -->
    </div>

    <!-- Empty State (Hidden by default, shown by script if zero favorites) -->
    <div id="empty-favorites" class="hidden bg-white border border-slate-200 rounded-3xl p-10 text-center space-y-3">
      <div class="text-4xl">⭐</div>
      <h3 class="font-extrabold text-slate-900 text-base">Belum Ada Produk yang Disimpan</h3>
      <p class="text-xs text-slate-500 max-w-sm mx-auto leading-relaxed">
        Jelajahi produk UMKM warga Nahdliyin di beranda, lalu klik ikon bintang ⭐ pada produk yang Anda minati.
      </p>
      <a
        href="/"
        class="inline-block mt-2 text-xs font-bold bg-[#4f46e5] hover:bg-[#4338ca] text-white px-5 py-2.5 rounded-xl transition shadow-xs"
      >
        Mulai Jelajahi Produk ➔
      </a>
    </div>

  </div>

  <!-- Client Side Script: Read favorites from localStorage and match with preloaded catalog -->
  <script define:vars={{ allProducts }}>
    const container = document.getElementById('favorites-container');
    const emptyState = document.getElementById('empty-favorites');
    const clearBtn = document.getElementById('btn-clear-favorites');

    function getSavedFavorites() {
      try {
        const raw = localStorage.getItem('mamasar_favorites');
        const parsed = raw ? JSON.parse(raw) : [];
        return Array.isArray(parsed) ? parsed.filter((id) => typeof id === 'number') : [];
      } catch {
        return [];
      }
    }

    function formatPriceIDR(value) {
      return new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        maximumFractionDigits: 0,
      }).format(value);
    }

    // Builds a favorite card via DOM APIs (never innerHTML) so product names,
    // store names and zones coming from user input cannot inject HTML.
    function createFavCard(p) {
      const formattedPrice = formatPriceIDR(p.price);
      const waMsg = encodeURIComponent(
        'Halo *' + p.umkm_name + '*, saya tertarik dengan produk Anda di Pasar Warga NU Sumenep:\n\u{1F4E6} *' +
          p.name +
          '* (' +
          formattedPrice +
          ')\nApakah barang masih tersedia?'
      );
      const detailHref = '/p/' + encodeURIComponent(p.slug);

      const card = document.createElement('div');
      card.className =
        'bg-white border border-slate-200 rounded-xl overflow-hidden shadow-xs hover:shadow-md transition flex flex-col justify-between group relative';

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.title = 'Hapus dari simpanan';
      removeBtn.setAttribute('data-remove-fav', String(p.id));
      removeBtn.className =
        'absolute top-2 right-2 z-20 w-7 h-7 rounded-full bg-white/90 hover:bg-white text-rose-600 border border-slate-200 flex items-center justify-center text-xs shadow-xs cursor-pointer';
      removeBtn.textContent = '\u2715';
      card.appendChild(removeBtn);

      const top = document.createElement('div');

      const imgLink = document.createElement('a');
      imgLink.href = detailHref;
      imgLink.className = 'block relative aspect-4/3 bg-slate-100 overflow-hidden';

      const img = document.createElement('img');
      img.src = p.image_url;
      img.alt = p.name;
      img.loading = 'lazy';
      img.className = 'w-full h-full object-cover group-hover:scale-105 transition duration-300';
      imgLink.appendChild(img);

      const priceOverlay = document.createElement('div');
      priceOverlay.className =
        'absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent p-2 text-white font-black text-xs';
      priceOverlay.textContent = formattedPrice;
      imgLink.appendChild(priceOverlay);

      top.appendChild(imgLink);

      const body = document.createElement('div');
      body.className = 'p-2.5 space-y-1';

      const zone = document.createElement('span');
      zone.className = 'text-[10px] text-slate-500 font-medium truncate block';
      zone.textContent = '\u{1F4CD} ' + p.zone_name;

      const titleLink = document.createElement('a');
      titleLink.href = detailHref;
      titleLink.className =
        'font-bold text-xs text-slate-900 group-hover:text-emerald-700 line-clamp-2 leading-tight block';
      titleLink.textContent = p.name;

      const seller = document.createElement('span');
      seller.className = 'text-[10px] text-slate-500 block truncate';
      seller.textContent = '\u{1F3EA} ' + p.umkm_name;

      body.append(zone, titleLink, seller);
      top.appendChild(body);
      card.appendChild(top);

      const foot = document.createElement('div');
      foot.className = 'p-2.5 pt-0';

      const waLink = document.createElement('a');
      waLink.href = 'https://wa.me/' + encodeURIComponent(String(p.umkm_phone)) + '?text=' + waMsg;
      waLink.target = '_blank';
      waLink.rel = 'noopener noreferrer';
      waLink.className =
        'w-full py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg text-xs font-bold flex items-center justify-center gap-1 transition';

      const waLabel = document.createElement('span');
      waLabel.textContent = 'Chat WA';
      waLink.appendChild(waLabel);

      foot.appendChild(waLink);
      card.appendChild(foot);

      return card;
    }

    function renderFavorites() {
      const favIds = getSavedFavorites();

      if (!container) return;

      while (container.firstChild) {
        container.removeChild(container.firstChild);
      }

      const hasFavorites = favIds && favIds.length > 0;
      const savedProducts = hasFavorites ? allProducts.filter((p) => favIds.includes(p.id)) : [];

      if (savedProducts.length === 0) {
        emptyState?.classList.remove('hidden');
        if (clearBtn) clearBtn.classList.add('hidden');
        return;
      }

      emptyState?.classList.add('hidden');
      if (clearBtn) clearBtn.classList.remove('hidden');

      const fragment = document.createDocumentFragment();
      for (const p of savedProducts) {
        fragment.appendChild(createFavCard(p));
      }
      container.appendChild(fragment);
    }

    // Event delegation survives re-renders without re-attaching listeners.
    container?.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-remove-fav]');
      if (!btn) return;
      const id = Number(btn.getAttribute('data-remove-fav'));
      const currentFavs = getSavedFavorites().filter((fid) => fid !== id);
      localStorage.setItem('mamasar_favorites', JSON.stringify(currentFavs));
      renderFavorites();
    });

    clearBtn?.addEventListener('click', () => {
      if (confirm('Hapus semua daftar produk favorit yang tersimpan?')) {
        localStorage.removeItem('mamasar_favorites');
        renderFavorites();
      }
    });

    renderFavorites();
  </script>
</Layout>
